-- ===== TCP Loopback =====
-- Sockets stay on the stack: each step hands them on, and every one is closed.
-- open-pair: (port -- server peer client)
('port let port tcp-listen must "127.0.0.1" port tcp-connect must swap tcp-accept must rot) 'open-pair let

(
  19201 open-pair
  "hello" tcp-send must drop swap
  1099511627776 tcp-recv must "hello" eq assert
  "world" tcp-send must drop swap
  1024 tcp-recv must "world" eq assert
  tcp-close tcp-close tcp-close
) 'tcp-roundtrip let tcp-roundtrip

(
  19202 open-pair
  "aaa" tcp-send must drop "bbb" tcp-send must drop "ccc" tcp-send must drop swap
  1024 tcp-recv must len 0 gt assert
  tcp-close tcp-close tcp-close
) 'tcp-multi-send let tcp-multi-send

(
  19203 open-pair
  [] tcp-send must drop
  tcp-close tcp-close tcp-close
) 'tcp-empty-send let tcp-empty-send

-- read, write and ls fail with the path and the reason; a NUL byte keeps the path's bytes
"a\0b" read {'ok (drop 0) 'no ("a\0b: contains a NUL byte" eq assert 1)} case 1 eq assert
"a\0b" "x" write {'ok (drop 0) 'no ("a\0b: contains a NUL byte" eq assert 1)} case 1 eq assert
"a\0b" ls {'ok (drop 0) 'no ("a\0b: contains a NUL byte" eq assert 1)} case 1 eq assert
"/nonexistent-slap-dir/x" read {'ok (drop "") 'no ()} case "/nonexistent-slap-dir/x: No such file or directory" eq assert
"." read {'ok (drop "") 'no ()} case ".: Is a directory" eq assert
"." "x" write {'ok (drop "") 'no ()} case ".: Is a directory" eq assert
"/nonexistent-slap-dir" ls {'ok (drop "") 'no ()} case "/nonexistent-slap-dir: No such file or directory" eq assert
