5 'pb tag 'px let px {'pa (1 plus) '_ (drop 0)} case drop px {'pb (drop 1)} case drop
5 'pb tag 'py let py {'pa (len) '_ (drop 0)} case drop py {'pb (drop 1)} case drop
[px py] len 2 eq assert
