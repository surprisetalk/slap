-- ===== Tagged Unions (Sum Types) =====

-- basic tag and case
123 'foo tag {'foo ()} case 123 eq assert

-- a '_ clause gets the tagged value itself, a result's too
5 'wb tag {'wa (drop 0) '_ (5 'wb tag eq)} case assert
"e" no {'ok (drop 1) '_ ("e" no eq)} case assert
-- a result case with 'ok and 'no clauses needs no '_
5 ok {'ok (1 plus) 'no (drop 0)} case 6 eq assert

-- a '_ clause runs on a tag no clause names
123 'bar tag {'foo (1 plus) '_ (drop 999)} case 999 eq assert

-- case unifies case + case
