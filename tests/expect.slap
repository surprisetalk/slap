5 ok {'ok (drop 1) 'no (drop 2) '_ (drop 3)} case 1 eq assert

-- a case adds its clause tags to a value's type only as tags it may carry, so a later case without '_ drops them
5 'wb tag 'wx let
wx {'wa (drop 1) '_ (drop 0)} case 0 eq assert
wx {'wb (drop 1)} case 1 eq assert
({'wc (drop 1) '_ (drop 0)} case) 'wide let
5 'wd tag 'wy let wy wide 0 eq assert wy {'wd (drop 1)} case 1 eq assert
5 'na tag 'nx let nx {'na (drop 1) 'nb (drop 2)} case 1 eq assert nx {'na (drop 1)} case 1 eq assert
