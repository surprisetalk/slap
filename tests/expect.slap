([] 1 push len) 'fresh-list let fresh-list fresh-list plus 2 eq assert
({'x 1} 'x at) 'fresh-rec let fresh-rec fresh-rec plus 2 eq assert

-- nth reads its list's name from the symbol written right before it; every symbol has one type
[1 2] 'xs let 1 'xs nth must 2 eq assert
[1 2] 'xs2 let 1 'xs2 nth must 2 eq assert 'xs2 'k let 1 (k) ('ys) if drop
[1 2] 'xs3 let 'xs3 'k3 let [] k3 push 'ys3 member 0 eq assert
{'kind 'atom} 'kind at 'atom eq assert
(drop 'xs) 'nm let [1 2] 'xs4 let 5 nm drop [1] nm drop

