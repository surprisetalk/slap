-- ===== datetime =====
-- Nine fields: year month(0-11) day hour minute second dotw(0-6) doty(0-365) isdst.
datetime 'dt let
dt len 9 eq assert
0 'dt nth must 'y let   1 'dt nth must 'mo let  2 'dt nth must 'da let
3 'dt nth must 'hh let  4 'dt nth must 'mi let  5 'dt nth must 'se let
6 'dt nth must 'dw let  7 'dt nth must 'dy let  8 'dt nth must 'ds let

y 2020 lt not assert   y 2200 lt assert
mo 0 lt not assert     mo 12 lt assert
da 1 lt not assert     da 32 lt assert
hh 0 lt not assert     hh 24 lt assert
mi 0 lt not assert     mi 60 lt assert
se 0 lt not assert     se 61 lt assert          -- 60 is a leap second, and legal
dw 0 lt not assert     dw 7 lt assert
dy 0 lt not assert     dy 366 lt assert
ds 0 eq ds 1 eq or assert

-- Ranges alone would pass on a shuffled struct tm -- month, hour and minute are
-- all small ints and each other's plausible values. dotw and doty are the two
-- fields C derives rather than copies, so recomputing them here from year/month/
-- day is a real cross-check: any field swap breaks at least one of the two.
('yy let yy 4 mod 0 eq  yy 100 mod 0 neq  yy 400 mod 0 eq or  and) 'leap? let
2024 leap? assert  1900 leap? not assert  2000 leap? assert  2026 leap? not assert

-- Sakamoto's congruence: 0 = Sunday, the same convention as tm_wday.
[0 3 2 5 0 3 5 1 4 6 2 4] 'sak let
y mo 2 lt (1 sub) () if 'sy let
sy  sy 4 div plus  sy 100 div sub  sy 400 div plus  mo 'sak nth must plus  da plus
7 mod dw eq assert

-- doty from the cumulative month table, +1 from March onward in a leap year.
[0 31 59 90 120 151 181 212 243 273 304 334] 'cum let
mo 'cum nth must da plus 1 sub  mo 1 gt y leap? and (1 plus) () if
dy eq assert

