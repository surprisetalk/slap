[10 20 30] pop must 30 eq assert [10 20] eq assert

-- ===== Lists: get / set =====
[10 20 30] 1 get must 20 eq assert
[10 20 30] 1 99 set must [10 99 30] eq assert

-- ===== Lists: peek (get without the consume) =====
[10 20 30] 1 peek must 20 eq assert [10 20 30] eq assert
[10 20 30] 0 peek must 10 eq assert 2 peek must 30 eq assert drop  -- chains, no dup
[10 20 30] 99 peek none eq assert [10 20 30] eq assert             -- OOB is 'no, list stays
[10 20 30] -1 peek none eq assert drop
[] 0 peek none eq assert [] eq assert
[[1 2] [3 4]] 1 peek must [3 4] eq assert [[1 2] [3 4]] eq assert  -- multi-slot elem, O(n) path
"hello" 1 peek must 101 eq assert drop
[1 2 3] 0 peek -1 default 1 eq assert drop                         -- either plumbing
[0 0 0] 1 peek must 0 eq assert 1 7 set must 1 peek must 7 eq assert drop
[1 2 3] box (1 get must) lend 2 eq assert () lend [1 2 3] eq assert free  -- no snapshot alias
-- peek deep-copies, so the extracted dict is independent of the one the list holds
dict "k" 1 insert [] swap push 0 peek must dict-keys len 1 eq assert drop drop

-- ===== Lists: len =====
[1 2 3] len 3 eq assert

-- ===== Lists: cat =====
[1 2] [3 4] cat [1 2 3 4] eq assert

-- ===== Lists: take-n / drop-n =====
[1 2 3 4 5] 3 take-n [1 2 3] eq assert
[1 2 3 4 5] 2 drop-n [3 4 5] eq assert
[1 2 3 4 5] 0 take-n [] eq assert
[1 2 3 4 5] 5 drop-n [] eq assert
[1 2 3 4 5] 5 take-n [1 2 3 4 5] eq assert
[1 2 3 4 5] 0 drop-n [1 2 3 4 5] eq assert
[1 2 3 4 5] 99 take-n [1 2 3 4 5] eq assert   -- clamps rather than panicking
-- multi-slot elements: the slice is a contiguous run, so the header's slot
-- count has to be recomputed from the element boundaries, not from the length
[(1 2) (3 4) (5 6)] 1 drop-n 0 get must (3 4) eq assert
[(1 2) (3 4) (5 6)] 2 take-n 1 get must (3 4) eq assert
["ab" "cd" "ef"] 1 drop-n 0 get must "cd" eq assert
-- slices past 16384 slots
[] 20000 (1 push) repeat 1 drop-n len 19999 eq assert
[] 20000 (1 push) repeat 20000 take-n len 20000 eq assert
[] 20000 (1 push) repeat 19000 drop-n 0 get must 1 eq assert

-- ===== Lists: binding and lending 300000-element values =====
[] 300000 (1 push) repeat 'vla1 let 0 'vla1 nth must 1 eq assert
[] 300000 (1 push) repeat 'vla2 let 299999 'vla2 nth must 1 eq assert
[] 300000 (7 push) repeat box ('snap let 0 'snap nth must) lend swap free 7 eq assert

-- ===== Frames: the save buffer grows, and gives back what it took =====
-- Recursion is what fills it: each level rebinds a name the level above already
-- put in the same frame, so the old value is staged until the call returns.
-- Eight levels x a ~20000-slot list drives five reallocs (4096 -> 262144), well
-- past anything a fixed array sized off this suite would have allowed.
-- Each level hands DOWN a shorter list and reads its OWN back AFTER the
-- recursive call returns, so the restore is what the length is measuring --
-- reading sbl before recursing would pass no matter what came back.
('sbn let 'sbl let
   sbn 0 gt
     (sbl 1 drop-n  sbn 1 sub sb-rec drop  sbl len)
     (sbl len)
   if) 'sb-rec let
0 20000 range 8 sb-rec 20000 eq assert

