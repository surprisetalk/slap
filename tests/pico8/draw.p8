pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- frames: 2
-- draws every primitive lua.slap has, for the reference diff
function _init() srand(7) end
t = 0
function _update() t += 1 end
function _draw()
  cls(1)
  rectfill(2, 2, 40, 20, 8)
  rect(44, 2, 80, 20, 9)
  rectfill(90, 30, 84, 22, 3)
  circfill(20, 40, 10, 12)
  circ(50, 40, 12, 7)
  circ(70, 40, 0, 10)
  line(0, 127, 127, 60, 11)
  line(100, 10, 105, 50, 14)
  line(120, 5, 90, 8, 15)
  for i = 0, 15 do pset(i, 62, i) end
  print("hello, pico8!", 4, 66, 7)
  print(tostr(sqrt(2)) .. " " .. tostr(sin(0.1)) .. " " .. tostr(atan2(1, 2)), 4, 74, 6)
  print(flr(rnd(100)) .. " " .. flr(rnd(100)) .. " " .. t, 4, 82)
  spr(0, 4, 92) spr(1, 14, 92) spr(1, 24, 92, 1, 1, true) spr(16, 34, 92)
  sspr(0, 0, 8, 8, 44, 90, 16, 12)
  map(0, 0, 64, 90, 6, 4)
  map(0, 0, 64, 110, 6, 4, 2)
  pal(12, 8) circfill(110, 100, 6) pal()
  palt(0, false) spr(1, 4, 104) palt()
  camera(-2, -2) rect(0, 0, 10, 10, 13) camera()
  clip(100, 110, 20, 10) rectfill(90, 105, 127, 127, 4) clip()
  color(5) print("pen")
  print(pget(3, 3) .. " " .. mget(1, 0) .. " " .. tostr(fget(1, 0)) .. " " .. fget(16))
end
