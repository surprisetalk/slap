-- EXPECT: unknown word 'rec'
-- the empty record is {}, not a word
rec

-- EXPECT: nth needs the list's name written right before it
[1 2] 'xs let
'xs 1 nth must print

-- EXPECT: nth needs the list's name written right before it
[1 2] 'xs let
'xs 'k let 1 k nth must print

-- EXPECT: int is not float
1 2 fsub print

-- EXPECT: float is not int
-- plus takes ints; fplus takes floats
1.0 2.0 plus print

-- EXPECT: int is not float
-- fplus takes floats
1 2 fplus print

-- EXPECT: float is not int
-- sort takes ints: nan has no order
[1.5 2.5] sort print

-- ===== Messages read in one direction, with one name per variable =====

-- EXPECT: nth reads a list, but 'xs is not one: int is not a list.
5 'xs let 1 'xs nth must print

-- EXPECT: a [...] or {...} literal starts from an empty stack
-- EXPECT: 'drop' takes 'a copyable
1 [drop]

-- EXPECT: but the stack has tagged | ..a int
(1 plus) [tagged own in tagged own out] effect

-- EXPECT: a record or either type takes one '|' row name
(dup) [{'a int | 'r | 's} own in] effect

-- EXPECT: unknown type word 'strng'
-- EXPECT-LINE: 2
-- EXPECT-COL: 8
1 drop
(dup) [strng own in] effect

-- EXPECT: unknown type word 'strng'
-- EXPECT-COL: 12
(dup) [int strng own in] effect

-- EXPECT: this slot is copyable, but tag 't holds int box
-- EXPECT-LINE: 2
-- EXPECT-COL: 29
1 drop
(drop) [{'t int box} either lent in] effect 'f let

-- EXPECT: '|' needs a 'row name after it
-- EXPECT-COL: 18
(dup) [{'a int | | 'r} own in] effect

-- EXPECT: '|' needs a 'row name after it
-- EXPECT-COL: 18
(dup) [{'a int | strng} own in] effect

-- EXPECT: but | follows the type
-- EXPECT-COL: 15
(dup) [tagged | | own in] effect


-- EXPECT: 'push' takes 'b copyable list 'b copyable
-- EXPECT: but the stack has 'a copyable list 'a copyable list
-- EXPECT: as 'a copyable list.
-- the takes line, the stack line and the why line use one name per variable
(dup len drop dup push) drop

-- EXPECT: but the stack has int list sym
-- an int list from a literal prints as int list
[3 1] sort 'x at

-- EXPECT: but the stack has int list
5 [1 2] (plus) ('f let (f apply) each) 'm let m

-- EXPECT: 'plus' takes int int
-- EXPECT: but the stack has str int
-- a string literal prints as str
"a" 1 plus

-- EXPECT: type annotation: a slot ends with in or out
-- EXPECT-LINE: 2
-- EXPECT-COL: 16
1 drop
(dup) [int own sideways] effect

-- EXPECT: type annotation: each slot ends with own/lent/copy/move/auto and in/out
-- EXPECT-LINE: 2
-- EXPECT-COL: 8
1 drop
(dup) [int out] effect

-- EXPECT: type annotation: a type is missing before '|'
-- EXPECT-COL: 12
(dup) [{'a | } own in] effect

-- EXPECT: bytes cut]
"" 1 0 div

-- EXPECT: but the stack has int list int
-- a str unified with an int list still prints as the int list the program wrote
"hi" [104 105] eq drop [104 105] 1 plus
