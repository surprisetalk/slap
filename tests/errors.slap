-- a declared 'b output that is the 'a input
(drop) ['a own in  'b own in  'b move out] effect 'f let {'b 1} {'a 1} f 'a at

-- EXPECT: TYPE ERROR
-- a declared 'a output joined with another input
(0 (drop) (nip) if) ['a own in  'b own in  'a move out] effect 'f let {'a 1} {'b 1} f 'a at

