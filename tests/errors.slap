-- ===== Adversarial probes =====

-- EXPECT: linear value created here was never consumed (must free, lend, mutate, or clone)
-- box is linear: must be consumed, not abandoned
42 box

-- EXPECT: 'free' expected box, got dict
-- free rejects dicts at type time
dict free

-- ===== protocol constraints =====
-- EXPECT: 'lt' expected ord, got sym
-- symbols are Eq-only, never Ord
'a 'b lt

-- EXPECT: 'sort' type variable 'a' mismatch: expected ord, got sym
-- sort needs Ord; symbols are not
['a 'b] sort

-- EXPECT: 'mod' expected int, got float
-- mod is Integral: floats are not
1.0 2.0 mod

-- EXPECT: 'default' type variable 'a is list, but the 'ok variant carries int — they must agree
-- ...and a string fallback cannot stand in for an int payload either
[1 2 3] pop "str" default len drop

