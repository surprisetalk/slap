-- a message that shows a record of 35 fields
rec 0 'k0 into 1 'k1 into 2 'k2 into 3 'k3 into 4 'k4 into 5 'k5 into 6 'k6 into 7 'k7 into 8 'k8 into 9 'k9 into 10 'k10 into 11 'k11 into 12 'k12 into 13 'k13 into 14 'k14 into 15 'k15 into 16 'k16 into 17 'k17 into 18 'k18 into 19 'k19 into 20 'k20 into 21 'k21 into 22 'k22 into 23 'k23 into 24 'k24 into 25 'k25 into 26 'k26 into 27 'k27 into 28 'k28 into 29 'k29 into 30 'k30 into 31 'k31 into 32 'k32 into 33 'k33 into 34 'k34 into 'zz at

-- EXPECT: cannot reach the stack below them
-- each's body gets one element; the runtime keeps earlier results under it
"s" [1 2] (over len plus) each print print

-- EXPECT: cannot reach the stack below them
-- edit's body gets the field; the runtime keeps the record under it
5 {'x 1} 'x (over plus) edit print print

-- EXPECT: top-level
-- a body inside a literal is built when the program is read, so it sees only top-level names
( 'n let [ (n) ] ) 'mk let
5 mk first apply 1 plus print

-- EXPECT: declared
-- a forward declaration is defined by a body in its own scope, not by a value
'v [int move out] effect
( 1 ("s" 'v let) () if v ) 'g let
(5) 'v let
g 1 plus print

-- EXPECT: event
'tock (drop) on

-- EXPECT: cannot reach the stack below them
-- fold's body gets the accumulator and one element; the runtime counts the values below it
"ab" [1 2] 0 (rot "c" cat rot rot plus) fold print print

-- EXPECT: cannot reach the stack below them
"ab" 5 box (swap "c" cat swap 1 plus) mutate free print

-- EXPECT: is a 'tag or a (predicate)
5 0 { [] (drop 1) } case print

-- EXPECT: cannot bind
-- a literal is built when the program is read, so a let inside it would bind for the whole program
( {5 'x let} drop x 1 plus ) 'f let
"s" 'x let
f print

-- EXPECT: cannot run
-- a literal's own code runs when the program is read, before any let
5 'v let
{ (v) apply } apply print

-- EXPECT: bound when the program runs
5 'v let
{ 'v quote } apply 1 plus print

-- EXPECT: bound when the program runs
( 'x let [ 'x 0 nth ] ) 'mk let
[5] mk print

-- EXPECT: top-level
-- a literal inside a body inside a literal is built when the program is read, too
[ ( 'n let [ (n) ] ) ] first 'mk let
5 mk apply first apply 1 plus print

-- EXPECT: the clause for 'q gets its payload, str
-- a {...} word generalizes only what it made itself: 'q's payload is one type for the program
{ ( 'q tag ) } 'mk let
"s" mk apply 0 {'q (1 plus)} case print

-- EXPECT: case pushes its default
{ ( "d" {'a (drop 1)} case ) } 'h let
5 'b tag h apply 1 plus print

-- EXPECT: 'outer' calls itself
-- a call of the word being defined, inside a {...} word, is checked against the word's body
( 1 plus  dup 5 lt ( { (outer) } 'g let  drop "s" g apply apply ) () if ) 'outer let
0 outer print

-- EXPECT: 'outer' calls itself
-- a call of the outer word inside a nested word belongs to the outer word
( 1 plus  dup 5 lt ( ( "s" outer ) 'inner let inner ) () if ) 'outer let
0 outer print

-- EXPECT: a type from outside the body
-- a signature's 'a may not become a type from outside the body, here 'r's payload
'f ['a own in  {'r 'b} either move out] effect
( "s" f ) 'g let
( 'r tag ) 'f let
g 0 {'r (1 plus)} case print

