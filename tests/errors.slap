(drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop "a" drop [9]) 'f let 0 f 1 plus

-- EXPECT: 'drop' takes 'a copyable
-- EXPECT: but the stack has nothing
-- on takes an event name and a handler
'tick () on drop

-- EXPECT: `(` is never closed
(1 2

-- EXPECT: `)` closes nothing
1 2)

-- EXPECT: `]` closes the `(` opened at line 1
(1 ]

-- EXPECT: 'fold' takes
-- EXPECT: cannot reach the stack below them
-- a fold body that eats values below its inputs
('f let [1 2 3] 0 (f) fold) 'red let 10 20 30 40 (drop drop) red print print

-- EXPECT: 'mutate' takes
-- EXPECT: cannot reach the stack below them
-- a mutate body that eats values below the box
('f let 42 box (f) mutate free) 'mu let 7 (drop drop 1) mu

-- EXPECT: 'tcp-close' takes socket
-- EXPECT: int box is not socket.
-- a boxed int that is not a socket
1 box tcp-close 42 print

-- EXPECT: type annotation: each slot ends with own/lent/copy/move/auto and in/out
-- a slot with no direction
(drop) [int in  {'ok int 'no ()} either] effect 'f1 let

-- EXPECT: type annotation: unknown type word 'strng'
-- a misspelt type inside an either
(drop) [int own in  {'ok strng 'no ()} either move out] effect 'f2 let

-- EXPECT: type annotation: a record or either type takes 'name type pairs
-- unquoted either variants
(drop) [int own in  {ok int no ()} either move out] effect 'f3 let

-- EXPECT: take-n: count -5 is negative
-- a negative slice count
[1 2 3] -5 take-n drop

-- EXPECT: drop-n: count -3 is negative
[1 2 3 4 5] -3 drop-n drop

-- EXPECT: 'sig-bad' declares ( ..a -> ..a int ), but its body is ( ..a -> ..a )
-- a body that calls a user word and leaves nothing
(drop) 'sig-drop let (1 sig-drop) [int move out] effect 'sig-bad let

-- EXPECT: 'plus' takes 'a num 'a num
-- EXPECT: the body takes or leaves a different number of values than the signature declares.
-- a body that consumes more than it declares
(plus) [int lent in  int move out] effect 'sig-under let

-- EXPECT: 'sig-str' declares ( ..a -> ..a int ), but its body is ( ..a -> ..a str ): str is not int.
-- a body whose output has the wrong type
("x") [int move out] effect 'sig-str let

-- EXPECT: 'drop' takes 'a copyable
-- EXPECT: the body takes or leaves a different number of values than the signature declares.
-- the same check through a forward declaration
'sig-fwd [int lent in  int move out] effect (drop drop 1) 'sig-fwd let

-- EXPECT: 'drop' takes 'a copyable
-- EXPECT: but the stack has nothing
-- a declared word inside an applied body: its real effect reaches the caller
((drop) [int own in] effect 'f let 1 f) apply drop

-- EXPECT: 'outer' declares ( ..a -> ..a int ), but its body is ( ..a -> ..a int int int )
-- a declared word defined inside a body does not hide the body's own count
((1 plus) [int own in  int move out] effect 'inner let 4 inner 1 2) [int move out] effect 'outer let

-- EXPECT: unknown word 'later': it is defined later, on line 1. A word used before its definition needs `'later [sig] effect` before its first use.
-- a word used before its definition: its effect is unknown where it is used
(later 1 plus) 'early let (2) 'later let

-- EXPECT: 'if' takes int
-- EXPECT: one path leaves 1 more value on the stack than the other
-- a word's branches must leave the same count
(dup 0 gt (1 sub down2 drop) () if) [int lent in  int move out] effect 'down2 let

-- EXPECT: the clause for 'no does not leave what the other clauses leave
-- a word's case clauses must leave the same count
(0 {'ok () 'no (drop 1 2)} case) 'cc let

-- EXPECT: case pushes its default when no clause may match, so the default must leave what the clauses leave.
-- a result case with no 'no clause: the default runs for 'no and leaves the scrutinee's place filled
(5 swap 0 {'ok (plus)} case) 'cd let

-- EXPECT: record literal: key 'b has no value.
-- EXPECT-LINE: 1
-- a {...} literal whose last key has no value is a tuple, not a record
{'a 1 'b} 'a at

-- EXPECT: each case clause is a key and a body in parentheses.
1 ok 0 {'ok 1 'no 2} case

-- EXPECT: a case clause key is a 'tag or a (predicate), not this.
1 rec {1 (drop 7)} case

-- EXPECT: each case clause is a key and a body in parentheses.
3 0 {(5 lt) "abc"} case

-- EXPECT: case with 'ok/'no clauses takes a result, but this value is not one
5 0 {'ok (drop 1)} case

-- EXPECT: 'x' is bound when the program runs, but a [...] or {...} literal is built when it is read.
5 'x let {'a x}

-- EXPECT: 'drop' takes 'a copyable
-- EXPECT: but the stack has nothing
1 [drop]

-- EXPECT: 'f' declares ( ..a 'b num list -> ..a 'c num list )
-- EXPECT: a type the signature leaves open is int here.
(1 push) [num list own in  num list move out] effect 'f let

-- EXPECT: 'my-double' declares ( ..a 'b num -> ..a 'b num )
-- EXPECT: a type the signature leaves open is int here.
-- a literal inside the body does not make a declared input narrower
(2 mul) ['a num lent in  'a num move out] effect 'my-double let

-- EXPECT: 'inc' takes int
-- EXPECT: float is not int.
1.5 inc

-- EXPECT: 'gt' takes 'a ord 'a ord
-- EXPECT: str is not ord.
[1] [2] gt

-- EXPECT: 'apply' takes ( ..a -> ..b )
-- EXPECT: str is not int.
"a" (1 plus) apply

-- EXPECT: 'dip' takes 'a ( ..b -> ..c )
-- EXPECT: str is not int.
"a" 5 (1 plus) dip

-- EXPECT: 'at' takes {'z 'a copyable | ..b} sym
-- EXPECT: one record has 'z and the other has not.
{'x 10 'y 20} 'z at

-- EXPECT: 'at' needs its key written right before it
'a 'k let {'a 1} k at

-- EXPECT: dup: stack overflow: this needs 1100001 more value slots, but only
0 1100000 range dup

-- EXPECT: 'sxy' takes {'x 'a num 'y 'a num | ..b}
-- EXPECT: one record has 'y and the other has not.
('r let r 'x at r 'y at plus) 'sxy let {'x 1} sxy

-- EXPECT: 'cnt' calls itself here with a stack its body does not take: one record has 'n and the other has not.
(dup 'n at 0 eq (drop 0) (drop {'m 1} cnt) if) 'cnt let {'n 3} cnt

-- EXPECT: lend's body does not fit the box's contents: one record has 'x and the other has not.
-- a lend body gets the box's contents
{'y 1} box ('x at) lend drop free

-- EXPECT: 'if' takes int
-- EXPECT: one record has 'b and the other has not.
-- either branch of an if may make the record
1 ({'a 1}) ({'b 1}) if 'b at

-- EXPECT: this case predicate does not fit the value: one record has 'z and the other has not.
-- a predicate runs on the scrutinee too
{'x 1} 0 {(dup 'z at 1 eq) (drop 5)} case

-- EXPECT: 'xs-of' takes {'x 'a copyable | ..b} list
-- EXPECT: one record has 'x and the other has not.
(('x at) each) 'xs-of let [{'y 1}] xs-of

