-- EXPECT: TYPE ERROR
-- a declared list output holds values the checker has not seen
([{'b 1}]) [list move out] effect 'f let f 0 (drop [{'a 1}]) () if first 'a at

-- EXPECT: TYPE ERROR
-- a list of tagged values meets a list of lists
[{'b 1} ok] [[{'a 1}]] cat 0 get must ('a at) each

-- EXPECT: TYPE ERROR
-- default's payload and fallback of different types
{'b 1} ok ok [{'a 1}] default ('a at) each

-- EXPECT: TYPE ERROR
-- if branches that leave different types
{'b 1} ok [{'a 1}] 1 (drop) (nip) if ('a at) each

-- EXPECT: TYPE ERROR
-- default of symbols leaves the payload's
{'a 1} 'b ok 'a default at

-- EXPECT: TYPE ERROR
-- default of bodies leaves the payload's
({'b 1}) ok ({'a 1}) default apply 'a at

-- EXPECT: TYPE ERROR
-- each on a list push built
[] {'b 1} push () each 0 (drop [{'a 1}]) () if first 'a at

-- EXPECT: TYPE ERROR
-- a then body that leaves two values
{'a 1} 5 ok (drop {'b 1} 7 ok) then drop 'a at

-- EXPECT: TYPE ERROR
-- a then body that takes nothing
{'a 1} {'b 1} ok (7 ok) then must drop 'a at

-- EXPECT: TYPE ERROR
-- a pthen body that leaves three values
{'a 1} 5 ok 0 (drop {'b 1} 7 8 ok) pthen drop drop 'a at

-- EXPECT: TYPE ERROR
-- an on handler that runs unknown code
{'a 1} (drop [(drop {'b 1})] first apply) 'tick on (drop dup 'a at drop) 'tick on (drop) show

-- EXPECT: TYPE ERROR
-- a bare list output meets a list of records
"a,b" "," str-split first 0 (drop {'a 1}) () if 'a at

-- EXPECT: TYPE ERROR
-- if branches with lists of different element types
1 ([1]) ([{'a 1}]) if first 'a at

-- EXPECT: TYPE ERROR
-- default of an int payload and a record
5 ok {'a 2} default 'a at

-- EXPECT: TYPE ERROR
-- if branches of an int and a record
5 {'a 1} 1 (drop) (nip) if 'a at

-- EXPECT: TYPE ERROR
-- a key read from a recursive call's output that the word may not leave
(dup 0 eq (drop {'b 1}) (1 sub f 'a at drop {'a 1}) if) 'f let 1 f

-- EXPECT: TYPE ERROR
-- a body taken out of a box by lend keeps the key it reads
{'b 1} ('a at) box () lend swap free apply

-- EXPECT: 'then' takes {'ok 'b 'no 'c} either
-- EXPECT: tagged 'x | ..a is not a result.
-- then leaves () for any other tag
5 'x tag (ok) then must

-- EXPECT: 'f' takes {'ok 'b 'no 'c} either
-- EXPECT: tagged 'x | ..a is not a result.
-- a word that thens its input: its callers must pass 'ok or 'no
((ok) then) 'f let 5 'x tag f must

-- EXPECT: 'if' takes int ( ..a -> ..b ) ( ..a -> ..b )
-- EXPECT: int is not a body.
-- a value as the else branch
1 (5) 7 if

-- EXPECT: 'repeat' takes int ( ..a -> ..a )
-- EXPECT: one path leaves 1 more value on the stack than the other
-- a loop body that changes the stack's depth
1 2 3 4 (drop) repeat

-- EXPECT: 'while' takes ( ..a -> ..b int ) ( ..b -> ..a )
-- EXPECT: one path leaves 1 more value on the stack than the other
0 (dup 3 lt) (1 plus 7) while

-- EXPECT: 'if' takes int
-- EXPECT: str is not int.
"s" (1) (2) if

-- ===== The type checker: keys, signatures, tags, literals, ownership =====

-- EXPECT: 'at' needs its key written right before it
{'x 1} 'k let  {'x 1} k at drop

-- EXPECT: 'into' needs its key written right before it
'x 'k let  {} 5 k into drop

-- EXPECT: 'edit' needs its key written right before it, as in `(1 plus) 'name edit`
{'x 1} 'x (1 plus) edit drop

-- EXPECT: 'edit' needs its key written right before it
'x 'k let  {'x 1} (1 plus) k edit drop

-- EXPECT: on needs its event written right before it, as in `(…) 'tick on`
(drop) 5 on

-- EXPECT: on needs its event written right before it, as in `(…) 'tick on`
-- two different names meeting are no longer one name
(drop) (1 0 gt ('a) ('b) if) on

-- EXPECT: 'at' needs its key written right before it
-- a word that takes its key as an input: keys are literal, so keys that are data go in a dict
( dup 'z eq drop {'z 1} swap at ) 'o let
'x o print

-- EXPECT: 'mk' declares
-- a body type in a signature is rigid: the body must work for every stack
'mk [ ( ..a -> ..b ) move out ] effect
( mk ) 'usemk let
( ("s") ) 'mk let
5 usemk apply 1 plus print

-- EXPECT: 'f' declares
-- a signature's 'a stays any type: the body may not ask it to be a number
(dup plus) ['a lent in  'a move out] effect 'f let
"s" f drop

-- EXPECT: a {...} literal is a record, so each value follows its 'key, as in {'x 1 'y 2}. For code that pushes values, write a body: (1 2).
{1 2} drop

-- EXPECT: key 1 is a symbol this literal computes
-- a {...} literal is a record; its keys must be symbols written in it
{['x 'y] 0 get must 5} drop

-- EXPECT: this record literal has 'a twice.
{'a 1 'a 2} drop

-- EXPECT: 'zz
-- a message that shows a record of 35 fields
{} 0 'k0 into 1 'k1 into 2 'k2 into 3 'k3 into 4 'k4 into 5 'k5 into 6 'k6 into 7 'k7 into 8 'k8 into 9 'k9 into 10 'k10 into 11 'k11 into 12 'k12 into 13 'k13 into 14 'k14 into 15 'k15 into 16 'k16 into 17 'k17 into 18 'k18 into 19 'k19 into 20 'k20 into 21 'k21 into 22 'k22 into 23 'k23 into 24 'k24 into 25 'k25 into 26 'k26 into 27 'k27 into 28 'k28 into 29 'k29 into 30 'k30 into 31 'k31 into 32 'k32 into 33 'k33 into 34 'k34 into 'zz at

-- EXPECT: cannot reach the stack below them
-- each's body gets one element; the runtime keeps earlier results under it
"s" [1 2] (over len plus) each print print

-- EXPECT: cannot reach the stack below them
-- edit's body gets the field; the runtime keeps the record under it
5 {'x 1} (over plus) 'x edit print print

-- EXPECT: top-level
-- a body inside a literal is built when the program is read, so it sees only top-level names
( 'n let [ (n) ] ) 'mk let
5 mk first apply 1 plus print

-- EXPECT: declared
-- a forward declaration is defined by a body in its own scope, not by a value
'v [int move out] effect
( 1 ("s" 'v let) () if v ) 'g let
(5) 'v let
g 1 plus print

-- EXPECT: event
(drop) 'tock on

-- EXPECT: cannot reach the stack below them
-- fold's body gets the accumulator and one element; the runtime counts the values below it
"ab" [1 2] 0 (rot "c" cat rot rot plus) fold print print

-- EXPECT: cannot reach the stack below them
"ab" 5 box (swap "c" cat swap 1 plus) mutate free print

-- EXPECT: cannot bind
-- a literal is built when the program is read, so a let inside it would bind for the whole program
( {5 'x let} drop x 1 plus ) 'f let
"s" 'x let
f print

-- EXPECT: cannot run
-- a literal's own code runs when the program is read, before any let
5 'v let
{ (v) apply } apply print

-- EXPECT: bound when the program runs
( 'x let [ 0 'x nth ] ) 'mk let
[5] mk print

-- EXPECT: top-level
-- a literal inside a body inside a literal is built when the program is read, too
[ ( 'n let [ (n) ] ) ] first 'mk let
5 mk apply first apply 1 plus print

-- EXPECT: 'outer' calls itself
-- a call of the outer word inside a nested word belongs to the outer word
( 1 plus  dup 5 lt ( ( "s" outer ) 'inner let inner ) () if ) 'outer let
0 outer print

-- EXPECT: a type from outside the body
-- a signature's 'a may not become a type from outside the body, here 'r's payload
