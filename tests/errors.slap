('f let 42 box (f) mutate free) 'mu let 7 (drop drop 1) mu

-- EXPECT: tcp-close: 1 is not a socket
-- a boxed int that is not a socket
1 box tcp-close 42 print

-- EXPECT: type annotation: a slot needs in or out after its type
-- a slot with no direction
(drop) [int in  {'ok int 'no ()} either] effect 'f1 let

-- EXPECT: type annotation: unknown type word 'strng'
-- a misspelt type inside an either
(drop) [int own in  {'ok strng 'no ()} either move out] effect 'f2 let

-- EXPECT: type annotation: either variants are 'symbols
-- unquoted either variants
(drop) [int own in  {ok int no ()} either move out] effect 'f3 let

-- EXPECT: take-n: count -5 is negative
-- a negative slice count
[1 2 3] -5 take-n drop

-- EXPECT: drop-n: count -3 is negative
[1 2 3 4 5] -3 drop-n drop

-- EXPECT: leaves 0 value(s) but its type declares 1 output(s)
-- a body that calls a user word and leaves nothing
(drop) 'sig-drop let (1 sig-drop) [int move out] effect 'sig-bad let

-- EXPECT: reaches below the 1 input(s) its type declares
-- a body that consumes more than it declares
(plus) [int lent in  int move out] effect 'sig-under let

-- EXPECT: output 1 is list but its type declares int
-- a body whose output has the wrong type
("x") [int move out] effect 'sig-str let

-- EXPECT: reaches below the 1 input(s) its type declares
-- the same check through a forward declaration
'sig-fwd [int lent in  int move out] effect (drop drop 1) 'sig-fwd let

-- EXPECT: 'drop' needs 1 input(s), stack has 0
-- a declared word inside an applied body: its real effect reaches the caller
((drop) [int own in] effect 'f let 1 f) apply drop

-- EXPECT: 'outer' leaves 3 value(s) but its type declares 1 output(s)
-- a declared word defined inside a body does not hide the body's own count
((apply) [tuple lent in  int move out] effect 'inner let (4) inner 1 2) [int move out] effect 'outer let
