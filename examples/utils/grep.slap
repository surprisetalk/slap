-- grep.slap: print the lines of a file that contain a fixed string, like grep -F.
--   cat examples/lib/strings.slap examples/utils/grep.slap | ./slap PATTERN FILE
2 "PATTERN FILE" arg-count
args 0 get must 'pat let
-- A final newline ends the last line; it does not start another.
1 arg-bytes "\n" str-split pop must dup len 0 eq (drop) (push) if
(pat str-find {'ok (drop 1) 'no (drop 0)} case) filter
[] (cat 10 push) fold stdout-write
