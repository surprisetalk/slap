-- Project Euler #20: Factorial Digit Sum
-- Sum of the digits of 100!
-- Answer: 648

-- mul-digits: digits n -> digits' (multiplies big number by n)
(
  'n let 'ds let
  {} 0 'carry into [] 'result into 0 'j into
  (dup 'j at ds len lt)
  (
    dup 'j at ds swap get must n mul over 'carry at plus 'val let
    (val 10 mod push) 'result edit
    (drop val 10 div) 'carry edit
    (1 plus) 'j edit
  )
  while
  (dup 'carry at 0 gt)
  (
    dup 'carry at 'c let
    (c 10 mod push) 'result edit
    (10 div) 'carry edit
  )
  while
  'result at
) 'mul-digits let

('nn let (nn mul-digits) mutate) 'mul-box let

[1] box 2
(dup 100 le)
(dup (mul-box) dip 1 plus)
while
drop
() lend sum swap free print
