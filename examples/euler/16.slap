-- Project Euler #16: Power Digit Sum
-- Sum of the digits of 2^1000.
-- Answer: 1366

-- double-digits: digits -> digits' (doubles the big number)
(
  'ds let
  {'carry 0 'result [] 'j 0}
  (dup 'j at ds len lt)
  (
    dup 'j at ds swap get must 2 mul over 'carry at plus 'val let
    (val 10 mod push) 'result edit
    (drop val 10 div) 'carry edit
    (1 plus) 'j edit
  )
  while
  (dup 'carry at 0 gt)
  (
    dup 'carry at 'c let
    (c 10 mod push) 'result edit
    (10 div) 'carry edit
  )
  while
  'result at
) 'double-digits let

[1] box
1000 ((double-digits) mutate) repeat
() lend sum swap free print
