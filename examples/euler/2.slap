-- Project Euler #2: Even Fibonacci Numbers
-- Sum of even Fibonacci numbers not exceeding 4,000,000.
-- Answer: 4613732

{'total 0 'a 1 'b 1}
(dup 'a at 4000000 le)
(
  dup 'a at 'a let
  a 2 mod 0 eq ((a plus) 'total edit) () if
  dup 'b at 'nb let
  (drop nb) 'a edit (a plus) 'b edit
)
while
'total at print
