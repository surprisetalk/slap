-- feed-app.slap: the feed reader's model, keys and state file. The window is
-- feed-app-sdl.slap; this file holds no SDL word, so its self-test runs in the
-- terminal build:
--
--   cat examples/lib/{strings,parse,http,xml,rss,cbor,icn,ufx,ui}.slap \
--       examples/feed-app.slap | ./slap --headless

-- ===== items =====
-- Titles and summaries are markup from xml-render, so each entity decodes.
-- Tags inside a summary stay as text: stripping them means parsing HTML.
(xml-unescape must) 'plain let
-- The item view shows a screen of text, so a summary keeps its first 4 KiB.
4096 'SUMMARY-CAP let
-- feed-items: (feed name url -- items).  An item is known by its id, else by
-- its link; one with neither cannot stay read, so it stops the app.
('fi-url let 'fi-name let rss-items ('fi let
  fi rss-item-id {'ok () 'no (drop fi rss-item-link {'ok () 'no (drop
    "feed: " fi-url cat ": an item has no id and no link, so it cannot be marked read" cat fail)} case)} case 'fi-id let
  {'feed fi-name
   'title fi rss-item-title {'ok (plain) 'no (drop "(no title)")} case
   'id fi-id
   'summary fi rss-item-summary {'ok (plain SUMMARY-CAP take-n) 'no (drop "")} case}) each) 'feed-items let

-- ===== model and keys =====
-- A model: {'w 'h 'n 'at 'top 'view 'scroll 'lines 'dirty 'read 'marks}. The
-- items stay outside it, since each lookup of the model copies it. 'n counts
-- the items, 'at is the chosen row, 'top the first row on screen, 'view 'list
-- or 'item, 'lines the open item's summary wrapped to the window, 'scroll the
-- first of them on screen, 'dirty 1 when the screen must redraw, 'read the ids
-- opened (all that state.cbor holds), and 'marks 1 for each item read, in item
-- order.
18 'LH let
('mk-read let 'mk-ids let
 {'w 0 'h 0 'n mk-ids len 'at 0 'top 0 'view 'list 'scroll 0 'lines [] 'dirty 1 'read mk-read
  'marks mk-ids ('mki let mk-read mki member) each}) 'feed-model let

-- follow: (m -- m).  Keep 'at on screen.
('fc let fc 'at at 'fc-at let fc 'top at 'fc-top let fc 'h at LH div 1 max 'fc-rows let
 fc fc-at fc-top lt (fc-at) (fc-at fc-top fc-rows plus ge (fc-at fc-rows sub 1 plus) (fc-top) if) if 'top into) 'follow let

-- relines: (m item -- m).  Wrap the item's summary to the window.
('rl-it let 'rl-m let rl-m rl-it 'summary at rl-m 'w at 16 sub wrap-text 'lines into) 'relines let

-- open: (m item ids -- m).  Show the item, and mark it read, with every other
-- item that has its id.
('om-ids let 'om-it let 'om let om 'marks at 'om-marks let om-it 'id at 'oid let
 om om-it relines
 0 om 'n at range ('omi let omi 'om-marks nth must omi 'om-ids nth must oid eq or) each 'marks into
 dup 'read at oid member (dup 'read at) (dup 'read at oid push) if 'read into
 'item 'view into 0 'scroll into 1 'dirty into) 'open let

-- feed-key: (m keycode -- m).  j or down and k or up move in the list and
-- scroll an item, down to its last line; escape goes back to the list. Enter
-- needs the item, so the window opens it.
('fk-k let 'fk-m let
 fk-k 106 eq fk-k 1073741905 eq or 'fk-down let
 fk-k 107 eq fk-k 1073741906 eq or 'fk-up let
 fk-m 'view at 'list eq (
   fk-down (fk-m fk-m 'at at 1 plus fk-m 'n at 1 sub min 0 max 'at into 1 'dirty into)
   (fk-up (fk-m fk-m 'at at 1 sub 0 max 'at into 1 'dirty into) (fk-m) if) if follow
 ) (
   fk-k 27 eq (fk-m 'list 'view into [] 'lines into 1 'dirty into)
   (fk-down (fk-m fk-m 'scroll at 1 plus fk-m 'lines at len 1 sub min 0 max 'scroll into 1 'dirty into)
   (fk-up (fk-m fk-m 'scroll at 1 sub 0 max 'scroll into 1 'dirty into) (fk-m) if) if) if
 ) if) 'feed-key let
(dup 13 eq swap 1073741912 eq or) 'enter-key let

-- ===== state.cbor =====
-- {"read": [id, ...]}, a CBOR map.
('se-ids let [{'name "read" 'value se-ids (ce-str) each ce-list}] ce-map) 'state-encode let
("read" cd-str cd-list cd-field cd-run) 'state-decode let

-- ===== self-test =====
isheadless (
  "examples/feeds/sample.xml" read must rss-parse must "sample" "local/sample.xml" feed-items 'st-items let
  st-items len 2 gt assert
  st-items ('id at) each 'st-ids let
  0 'st-ids nth must 'st-id0 let 1 'st-ids nth must 'st-id1 let
  -- the second item, read in an earlier run, starts marked
  st-ids [] st-id1 push feed-model 640 'w into 480 'h into 'st-m let
  st-m 'marks at 1 get must 1 eq assert
  st-m 'marks at 0 get must 0 eq assert
  -- k at the top stays; j moves; opening item 1 keeps 'read without a repeat; escape returns
  st-m 107 feed-key 'at at 0 eq assert
  st-m 106 feed-key 'at at 1 eq assert
  st-m st-items 1 get must st-ids open 'st-m1 let
  st-m1 'view at 'item eq assert
  st-m1 'read at [] st-id1 push eq assert
  st-m1 'lines at len 0 gt assert
  st-m1 27 feed-key 'view at 'list eq assert
  -- scrolling an item stops at its last line
  st-m1 'lines at len 'st-nl let
  0 st-nl 5 plus range st-m1 (drop 106 feed-key) fold 'scroll at st-nl 1 sub eq assert
  -- opening item 0 adds its id and marks every item with that id
  [st-id0 st-id1 st-id0] [] st-id1 push feed-model 640 'w into 480 'h into st-items 0 get must [st-id0 st-id1 st-id0] open 'st-m2 let
  st-m2 'read at [] st-id1 push st-id0 push eq assert
  st-m2 'marks at 0 get must 1 eq assert
  st-m2 'marks at 2 get must 1 eq assert
  -- j past the end stops at the last row, and 'top follows it on a short screen
  st-items st-m 18 'h into (drop 106 feed-key) fold 'st-m3 let
  st-m3 'at at st-items len 1 sub eq assert
  st-m3 'top at st-m3 'at at eq assert
  13 enter-key assert 1073741912 enter-key assert 106 enter-key not assert
  -- the state file round-trips, and a map without "read" is refused
  [st-id0 st-id1] state-encode state-decode must [st-id0 st-id1] eq assert
  [] state-encode state-decode must [] eq assert
  [] ce-map state-decode {'ok (drop "") 'no ()} case "$: missing field \"read\"" eq assert
  "feed-selftest-ok" print
) () if
