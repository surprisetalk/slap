-- raycast.slap: a grid raycaster, the Wolfenstein 3D way.
--
--   cat examples/raycast.slap examples/raycast-sdl.slap | ./slap-sdl  -- walk around: W/A/S/D, arrows turn
--   ./slap --headless < examples/raycast.slap                         -- run the self-test, print ok
--
-- One ray per screen column, each stepped through the grid with DDA: jump
-- straight from one cell boundary to the next instead of sampling along the
-- ray, so the cost is the number of cells crossed and the hit is exact rather
-- than within a step size. The wall slice is a 1-pixel-wide fill-rect, which is
-- all the SDL layer here has -- there is no line primitive.
--
-- There is no sin or cos either, so fsin below is Bhaskara I's approximation
-- (c. 1150), the same one examples/plasma.slap uses. Everything else is the
-- float family: fsqrt, fabs, ffloor, itof, ftoi.
--
-- The distance used for the wall height is the *perpendicular* one. Using the
-- true ray length instead bends flat walls into a fisheye bulge, and it is the
-- classic bug here, so the self-test pins a straight-on wall rendering flat.

16 'MW let
16 'MH let

"################"
"#..............#"
"#..............#"
"#...##.........#"
"#...##.........#"
"#..............#"
"#.........#....#"
"#.........#....#"
"#.........#....#"
"#..............#"
"#..............#"
"#....######....#"
"#..............#"
"#..............#"
"#..............#"
"################"
cat cat cat cat cat cat cat cat cat cat cat cat cat cat cat
('mc let mc 35 eq (1) (0) if) each 'MAP let

640 'SCRW let
480 'SCRH let
1.0472 'FOV let          -- 60 degrees
0.0000001 'TINY let
1000000.0 'FAR let

-- ===== float helpers =====

-- Bhaskara I: sin t ~ 16 t (pi - t) / (5 pi^2 - 4 t (pi - t)) on [0, pi],
-- reduced to [0, tau) and mirrored. Error stays under 0.002 of a full turn.
('t0 let
 t0 tau fdiv ffloor tau fmul t0 swap fsub 'tr let
 tr pi fgt (tr pi fsub) (tr) if 'tm let
 tm pi tm fsub fmul 'q let
 16.0 q fmul 5.0 pi pi fmul fmul 4.0 q fmul fsub fdiv 'sv let
 tr pi fgt (sv fneg) (sv) if) 'fsin let

(pi 2.0 fdiv fplus fsin) 'fcos let

-- x y off-map -- bool. The two axes are tested against their own bound; with
-- a square map a swap here is invisible, which is exactly why it is written out.
('yv let 'xv let xv 0 lt xv MW ge or  yv 0 lt yv MH ge or  or) 'off-map let

-- ===== DDA =====

-- Step from cell boundary to cell boundary until a wall is hit. Returns the
-- perpendicular distance along the ray direction, or FAR if the ray leaves the
-- map without hitting anything.
-- px py angle -- dist
('ang let 'py let 'px let
 ang fcos 'rdx let
 ang fsin 'rdy let
 rdx fabs TINY flt (FAR) (1.0 rdx fabs fdiv) if 'ddx let
 rdy fabs TINY flt (FAR) (1.0 rdy fabs fdiv) if 'ddy let
 rdx 0.0 flt (-1) (1) if 'sx let
 rdy 0.0 flt (-1) (1) if 'sy let
 px ffloor ftoi 'mx0 let
 py ffloor ftoi 'my0 let
 rdx 0.0 flt (px mx0 itof fsub) (mx0 itof 1.0 fplus px fsub) if ddx fmul 'sdx0 let
 rdy 0.0 flt (py my0 itof fsub) (my0 itof 1.0 fplus py fsub) if ddy fmul 'sdy0 let

 -- DDA tests the cell it steps *into*, so it never looks at the one it starts
 -- in. A player clipped into a wall would otherwise see straight through it.
 mx0 my0 off-map (1) (my0 MW mul mx0 plus 'MAP nth must 1 eq) if 'inside let

 mx0 my0 sdx0 sdy0 0 0
 (dup 0 eq) (
   'hit0 let 'side0 let 'sdy let 'sdx let 'my let 'mx let
   sdx sdy flt 'stepx let
   stepx (mx sx plus) (mx) if 'nmx let
   stepx (my) (my sy plus) if 'nmy let
   stepx (sdx ddx fplus) (sdx) if 'nsdx let
   stepx (sdy) (sdy ddy fplus) if 'nsdy let
   stepx (0) (1) if 'nside let
   nmx nmy off-map (2) (nmy MW mul nmx plus 'MAP nth must 1 eq (1) (0) if) if 'nhit let
   nmx nmy nsdx nsdy nside nhit
 ) while
 'hitv let 'sidev let 'sdyv let 'sdxv let 'myv let 'mxv let
 inside (0.0) (
   hitv 2 eq (FAR) (sidev 0 eq (sdxv ddx fsub) (sdyv ddy fsub) if) if) if) 'cast let

-- ===== player =====

3.5 'PX0 let
3.5 'PY0 let

-- ===== self-test =====

isheadless (

  -- the map parsed into the grid it looks like
  MAP len MW MH mul eq assert
  0 'MAP nth must 1 eq assert                       -- top-left is wall
  1 MW mul 1 plus 'MAP nth must 0 eq assert         -- (1,1) is open
  3 MW mul 4 plus 'MAP nth must 1 eq assert         -- the 2x2 block at (4,3)
  6 MW mul 10 plus 'MAP nth must 1 eq assert        -- the pillar at (10,6)

  -- Hand-computed distances from (1.5, 1.5). Row 1 is "#..............#", so
  -- east hits the wall cell at x=15 (its near face is x=15.0) and west hits the
  -- one at x=0 (its far face is x=1.0). Column 1 is open top to bottom, so
  -- south hits y=15 and north hits y=1.0.
  1.5 1.5 0.0      cast 13.5 fsub fabs 0.01 flt assert   -- east
  1.5 1.5 pi       cast 0.5  fsub fabs 0.01 flt assert   -- west
  1.5 1.5 pi 2.0 fdiv      cast 13.5 fsub fabs 0.01 flt assert   -- south (+y)
  1.5 1.5 pi 1.5 fmul      cast 0.5  fsub fabs 0.01 flt assert   -- north (-y)

  -- Straight at the 2x2 block: from (1.5, 3.5) facing east its near face is
  -- x=4.0, so the distance is 2.5. One cell up at y=2.5 the block is not there
  -- and the ray runs to the far wall instead -- which is what says the y index
  -- is not being used as the x index.
  1.5 3.5 0.0 cast 2.5  fsub fabs 0.01 flt assert
  1.5 2.5 0.0 cast 13.5 fsub fabs 0.01 flt assert

  -- Standing inside a wall returns 0 rather than reporting the next wall out.
  4.5 3.5 0.0 cast fabs 0.01 flt assert

  -- A ray that leaves the map cannot happen here (the border is solid), so the
  -- FAR sentinel must never be the answer for a ray fired from open floor.
  PX0 PY0 0.7 cast FAR flt assert

  -- No fisheye: a wall square to the view renders flat. Sampling three columns
  -- across the field and correcting by cos(offset) must give the same
  -- perpendicular distance for all three. Without the cosine the edges read
  -- further away than the centre and flat walls bow outward.
  -- The west border spans the whole map height, so a +/-15 degree spread off
  -- (3.5, 7.5) lands on it in all three cases and the perpendicular distance is
  -- 3.5 - 1.0 = 2.5 every time. The 2x2 block is only two cells tall and the
  -- spread walks off it, which is why the flat surface has to be the border.
  3.5 7.5 'fy let 'fx let
  fx fy pi cast 'd-mid let
  d-mid 2.5 fsub fabs 0.01 flt assert
  fx fy pi FOV 4.0 fdiv fplus       cast FOV 4.0 fdiv fcos fmul 'd-right let
  fx fy pi FOV 4.0 fdiv fneg fplus  cast FOV 4.0 fdiv fneg fcos fmul 'd-left let
  d-right d-mid fsub fabs 0.02 flt assert
  d-left  d-mid fsub fabs 0.02 flt assert

  "raycast-selftest-ok" print
) () if
