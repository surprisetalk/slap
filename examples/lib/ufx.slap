-- ufx.slap: proportional bitmap font codec. 256 width bytes + ICN-encoded glyphs.
-- Requires icn.slap (icn-decode, icn-encode). Cat icn.slap before ufx.slap.

-- ufx-decode: (bytes -- font ok | msg no)
('ud let
 ud len 256 lt ("ufx: shorter than the 256-byte width table" no) (
 ud len 256 sub 8 mod 0 eq not ("ufx: glyph data is not a whole number of 8-byte tiles" no) (
   {'widths ud 256 take-n 'glyphs ud 256 drop-n 8 chunks (icn-decode) each} ok) if) if) 'ufx-decode let
(dup 'widths at swap 'glyphs at (icn-encode) each flatten cat) 'ufx-encode let

-- ===== tests =====
[]
0 256 range (drop 4) each
60 push 66 push 129 push 129 push 129 push 129 push 66 push 60 push
'ufx-data let
ufx-data ufx-decode must
  dup 'widths at len 256 eq assert
  dup 'widths at 0 get must 4 eq assert
  'glyphs at len 1 eq assert
ufx-data ufx-decode must ufx-encode ufx-data eq assert
"fonts/atari8.uf1" read must dup ufx-decode must ufx-encode eq assert
[1 2 3] ufx-decode {'ok (drop "") 'no ()} case "ufx: shorter than the 256-byte width table" eq assert
ufx-data 1 push ufx-decode {'ok (drop "") 'no ()} case "ufx: glyph data is not a whole number of 8-byte tiles" eq assert
