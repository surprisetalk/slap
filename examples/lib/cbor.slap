-- Nesting: 256 deep reads, 257 deep is refused
[] 256 (129 push) repeat 0 push (ok) cd-run {'ok (drop 1) 'no (drop 0)} case assert
[] 257 (129 push) repeat 0 push (ok) cd-run cerr "cbor: nested deeper than 256 at byte 256" eq assert
[] 257 (161 push 97 push 97 push) repeat 0 push (ok) cd-run cerr "cbor: nested deeper than 256 at byte 768" eq assert

-- Decoders
"182a" _hx cd-int cd-run 42 ok eq assert
"3863" _hx cd-int cd-run -100 ok eq assert
