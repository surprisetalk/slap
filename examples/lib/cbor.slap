"8301f402" _hx cd-int cd-list cd-run cerr "$[1]: expected int, got bool" eq assert
"a0" _hx "a" cd-int cd-field cd-run cerr "$: missing field \"a\"" eq assert
"a161616161" _hx "a" cd-int cd-field cd-run cerr "$.a: expected int, got string" eq assert

-- ce-* build bytes; ce-map dies on a repeated key
"a" ce-str "6161" _hx eq assert
[1 2] ce-bytes "420102" _hx eq assert
1 ce-bool "f5" _hx eq assert
ce-null "f6" _hx eq assert
-7 ce-int "26" _hx eq assert
[] 1 ce-int push 2 ce-int push ce-list "820102" _hx eq assert
[] {} "a" 'name into 1 ce-int 'value into push ce-map "a1616101" _hx eq assert
[] ce-map "a0" _hx eq assert

-- A value written reads back: strings of every byte, a map in a list
0 256 range 'cbor-all-bytes let
cbor-all-bytes 'bytes tag ce-value (ok) cd-run cbor-all-bytes 'bytes tag ok eq assert
cbor-all-bytes 'str tag ce-value (ok) cd-run cbor-all-bytes 'str tag ok eq assert
[] "k" [] 1 _i push "x" 'str tag push -5 _i push 1.25 'float tag push {} 'null tag push 0 'bool tag push 'list tag _ent push 'map tag 'cbor-rt let
cbor-rt ce-value (ok) cd-run cbor-rt ok eq assert
