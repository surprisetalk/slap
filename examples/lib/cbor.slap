"01" _hx cd-int (1 plus) cd-map cd-run 2 ok eq assert
"a0" _hx "a" cd-int cd-field cd-maybe cd-run none ok eq assert
([] cd-str (len) cd-map push cd-int push cd-one-of) 'cbor-len-or-int let
