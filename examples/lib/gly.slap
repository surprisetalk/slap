-- gly.slap: ASCII-inline 1-bit glyph codec. Each char encodes 4 vertical pixels.

-- gly-decode: (text -- image ok | msg no).  Rows are separated by newlines; a byte
-- from ? up holds four vertical pixels in its low bits above 63, and space is blank.
('gin let
 gin ('gc let gc 10 eq gc 32 eq or gc 63 ge gc 126 le and or not) each 1 index-of
 () {'ok (drop "gly: a byte outside ? to ~, space and newline" no) 'no (drop
   gin "\n" str-split dup len 0 gt (dup dup len 1 sub get must len 0 eq (pop drop) () if) () if
   (('gv let gv 32 eq (0) (gv 63 sub) if) each) each 'rows let
   rows 0 (len max) fold 'w let rows len 'nrows let nrows 4 mul 'h let
   0 h range ('y let 0 w range ('c let y 4 div 'r let y 4 mod 'bit let
     rows len r gt (rows r get must dup len c gt (c get must bit shr 1 band) (drop 0) if) (0) if) each) each flatten 'pixels let
   rec w 'width into h 'height into pixels 'pixels into ok)} case) 'gly-decode let
(dup 'width at 'w let dup 'height at 'h let 'pixels at 'px let h 4 div 'nrows let 0 nrows range ('r let 0 w range ('c let 0 4 range 0 ('bit let px r 4 mul bit plus w mul c plus get must bit shl bor) fold 63 plus) each r nrows 1 sub lt (10 push) () if) each flatten) 'gly-encode let

-- ===== tests =====
[68 63] gly-decode must
  dup 'width at 2 eq assert
  dup 'height at 4 eq assert
  drop
[68 63] gly-decode must gly-encode [68 63] eq assert
[72] gly-decode must gly-encode [72] eq assert
[68 10 72] gly-decode must gly-encode [68 10 72] eq assert
[68 1 63] gly-decode () {'ok (drop "") 'no ()} case "gly: a byte outside ? to ~, space and newline" eq assert
