-- xml.slap: Elm-style XML decoder library.
-- An element is a record {'name "tag" 'attrs [{'name "n" 'value "v"}...] 'children [node...]}.
-- A node is `element 'elem tag` or `text 'text tag`.
-- _xml-parse returns the root `element ok`, or `msg no` for input that is not well-formed.
-- Decoders (xd-*) are first-class composable values. Run with xd-run or xd-eval.
-- Errors are XPath-ish strings: "/rss/channel/item[2]: missing <title>".

-- ========== Char predicates ==========

-- These run once per byte, so they keep the byte on the stack rather than bind it: a body that
-- binds a name gets a frame of its own on every run.
(dup 32 eq  over 9 eq or  over 10 eq or  swap 13 eq or) '_x-ws? let

(dup dup 65 ge swap 90 le and
 over dup 97 ge swap 122 le and or
 over 95 eq or
 swap 58 eq or) '_x-name-start? let

(dup dup 65 ge swap 90 le and
 over dup 97 ge swap 122 le and or
 over dup 48 ge swap 57 le and or
 over 45 eq or
 over 95 eq or
 over 58 eq or
 swap 46 eq or) '_x-name-char? let

-- ========== Entities ==========

-- _x-utf8: (codepoint -- bytes ok | msg no)
('cp let
 cp 1 lt cp 1114111 gt or cp 55296 ge cp 57343 le and or ("xml: numeric entity is not a character" no) (
 cp 128 lt ([] cp push ok) (
 cp 2048 lt ([] 192 cp 6 shr bor push 128 cp 63 band bor push ok) (
 cp 65536 lt ([] 224 cp 12 shr bor push 128 cp 6 shr 63 band bor push 128 cp 63 band bor push ok) (
   [] 240 cp 18 shr bor push 128 cp 12 shr 63 band bor push 128 cp 6 shr 63 band bor push 128 cp 63 band bor push ok
 ) if) if) if) if) '_x-utf8 let

-- _x-num-entity: (digits base -- codepoint ok | msg no).  A bad digit poisons the fold with -1.
('xbase let 'xds let
 xds len 0 eq ("xml: empty numeric entity" no) (
 xds len 8 gt ("xml: numeric entity longer than 8 digits" no) (
   xds 0 ('xd let 'xacc let
     xd 48 ge xd 57 le and (xd 48 sub) (
     xbase 16 eq xd 97 ge xd 102 le and and (xd 87 sub) (
     xbase 16 eq xd 65 ge xd 70 le and and (xd 55 sub) (-1) if) if) if 'xdv let
     xacc 0 lt xdv 0 lt or xdv xbase ge or (-1) (xacc xbase mul xdv plus) if) fold
   dup 0 lt (drop "xml: bad digit in a numeric entity" no) (ok) if) if) if) '_x-num-entity let

-- _x-entity: (body -- bytes ok | msg no).  body is what lies between & and ;.
('xb let
 xb len 0 eq ("xml: empty entity &;" no) (
 xb 0 get must 35 eq (
   xb 1 drop-n 'xn let
   xn len 0 gt (xn 0 get must 'xh let xh 120 eq xh 88 eq or) (0) if
   (xn 1 drop-n 16) (xn 10) if _x-num-entity (_x-utf8) then
 ) (
   xb "amp" eq ([] 38 push ok) (
   xb "lt" eq ([] 60 push ok) (
   xb "gt" eq ([] 62 push ok) (
   xb "quot" eq ([] 34 push ok) (
   xb "apos" eq ([] 39 push ok) (
     "xml: unknown entity &" xb cat ";" cat no) if) if) if) if) if) if) if) '_x-entity let

-- ========== Parser ==========
-- _xml-parse binds the source as '_xin and every step reads it by index with
-- `nth`, so no token copies the input and nothing recurses per byte. A step's
-- state is `i ok`, or `msg no` from the first failure; `then` and `pthen`
-- carry a failure past the steps after it.

-- _xml-parse: (source -- record ok | msg no).  The helpers live inside it, so each reads the
-- input it binds as '_xin by name, not a caller's.
('_xin let
  -- _xc: (i -- c).  The byte at i, or -1 past the end.
  ('_xin nth {'ok () 'no (drop -1)} case) '_xc let

  -- _xpos: (msg i -- msg').  Appends " at byte i".  _xhere: (msg i -- msg').  Also appends the byte found there.
  (int-str " at byte " swap cat cat) '_xpos let
  ('xhi0 let xhi0 _xpos xhi0 _xc 'xhc let xhc 0 lt () (
     xhc 32 gt xhc 127 lt and (", found '" cat [] xhc push cat "'" cat) (", found byte " cat xhc int-str cat) if) if) '_xhere let

  -- _xws: (i -- i')
  ((dup _xc _x-ws?) (1 plus) while) '_xws let

  -- _xat: (i lit -- bool).  Does lit start at i?
  ('xl let 'xi let
   0 (dup xl len lt (dup dup xi plus _xc swap 'xl nth must eq) (0) if) (1 plus) while
   xl len eq) '_xat let

  -- _xpast: (i lit -- st).  The index just past the next lit at or after i.
  ('xpl let dup 'xps let
   (dup _xc 0 ge (dup xpl _xat not) (0) if) (1 plus) while
   dup _xc 0 lt (drop "xml: expected " xpl cat " not found after byte " cat xps int-str cat no) (xpl len plus ok) if) '_xpast let

  -- _xslice: (a b -- bytes).  The input from a up to b.
  ('xsb let [] swap (dup xsb lt) ('xsj let xsj _xc push xsj 1 plus) while drop) '_xslice let

  -- _xname: (i -- name st)
  ('xni let xni _xc 'xc0 let
   xc0 _x-name-start? not ([] "xml: expected a name" xni _xhere no) (
     xni (dup _xc _x-name-char?) (1 plus) while 'xne let xni xne _xslice xne ok) if) '_xname let

  -- _xentity: (i -- bytes st).  i is just past '&'.  A body past 32 bytes is unterminated.
  ('xei let
   xei (dup _xc 'xec let xec 59 eq not xec 0 ge and) (1 plus) while 'xej let
   xej _xc 59 eq not xej xei sub 32 gt or ([] "xml: unterminated entity" xei 1 sub _xpos no) (
     xei xej _xslice _x-entity {'ok (xej 1 plus ok) 'no ('xm let [] xm xei 1 sub _xpos no)} case) if) '_xentity let

  -- ========== Text and attributes ==========
  -- The loops below keep what they build at the bottom of the stack and a
  -- `1`/`0` go-on flag on top, with the state between them.

  -- _xtext: (i -- text st).  Runs to the next '<' or the end.
  ('xti let [] xti ok 1
   -- the step runs once per byte, so it keeps the index and the byte on the stack: (text i -- text more st)
   (dup) (drop 0 (dup _xc
       dup 0 lt over 60 eq or (drop 0 swap ok) (
       dup 38 eq (drop 1 plus _xentity (cat) dip 1 swap) (swap (push) dip 1 swap 1 plus ok) if) if) pthen swap) while
   drop) '_xtext let

  -- _xattr-val: (i -- value st).  i is at the opening quote.
  ('xai let xai _xc 'xq let
   xq 34 eq xq 39 eq or not ([] "xml: attribute value must be quoted" xai _xhere no) (
     [] xai 1 plus ok 1
     (dup) (drop 0 ('xaj let xaj _xc 'xac let
         xac 0 lt (0 "xml: unterminated attribute value" xaj _xpos no) (
         xac xq eq (0 xaj 1 plus ok) (
         xac 38 eq (xaj 1 plus _xentity (cat) dip 1 swap) (xac push 1 xaj 1 plus ok) if) if) if) pthen swap) while
     drop) if) '_xattr-val let

  -- _xattrs: (i -- attrs st).  attrs is a list of {'name 'value} records; stops at / or >.
  ([] dict rot ok 1
   (dup) (drop 0 ('xsi let xsi _xws 'xsj let xsj _xc 'xsc let
       xsc 47 eq xsc 62 eq or (0 xsj ok) (
       xsc 0 lt (0 "xml: unexpected end of input in a tag" xsj _xpos no) (
         xsj _xname swap 'xan let
         (_xws 'xse let xse _xc 61 eq (xse 1 plus _xws ok) ("xml: expected = after attribute " xan cat xse _xhere no) if) then
         [] (_xattr-val) pthen swap 'xav let
         (xan of {'ok (drop 1) 'no (drop 0)} case 'xdf let xan 0 insert xdf) dip swap 'xdp let
         ('xdi let xdp ("xml: duplicate attribute " xan cat xsj _xpos no) (xdi ok) if) then
         (({'name xan 'value xav} push) dip) dip 1 swap) if) if) pthen swap) while
   drop swap drop) '_xattrs let

  -- ========== Elements ==========

  -- _xcdata: (i -- text st).  i is just past "<![CDATA[".
  ('xci let xci "]]>" _xpast {'ok ('xck let xci xck 3 sub _xslice xck ok) 'no ([] swap no)} case) '_xcdata let

  -- _xnone: (-- element).  What a failed step leaves in place of an element.
  ({'name "" 'attrs [] 'children []}) '_xnone let

  -- _xelem: (i depth -- element st).  i is at '<'.  The children, up to and
  -- through </name>, are read by _xelem one level deeper.  Nesting past 256 is
  -- refused before it can exhaust the interpreter's recursion limit.
  ('xed let 'xei let
   xed 255 gt (_xnone "xml: elements nested deeper than 256" xei _xpos no) (
   xei _xc 60 eq not (_xnone "xml: expected <" xei _xhere no) (
     xei 1 plus _xname swap 'xen let
     [] (_xattrs) pthen swap 'xea let
     [] ('xri let xri _xws 'xrj let
       xrj "/>" _xat ([] xrj 2 plus ok) (
       xrj _xc 62 eq (
         [] xrj 1 plus ok 1
         (dup) (drop 0 ('xhi let
             xhi _xc 0 lt (0 "xml: unexpected end of input inside <" xen cat ">" cat xhi _xpos no) (
             xhi "<!--" _xat (1 xhi 4 plus "-->" _xpast) (
             xhi "<![CDATA[" _xat (xhi 9 plus _xcdata swap 'text tag swap (push) dip 1 swap) (
             xhi "<?" _xat (1 xhi 2 plus "?>" _xpast) (
             xhi "</" _xat (
               xhi 2 plus _xname swap 'xct let
               (_xws 'xck let xct xen eq not ("xml: expected </" xen cat "> but found </" cat xct cat ">" cat xhi _xpos no) (
                  xck _xc 62 eq (xck 1 plus ok) ("xml: expected > to close </" xct cat ">" cat xck _xhere no) if) if) then
               0 swap) (
             xhi _xc 60 eq (xhi xed 1 plus _xelem swap 'elem tag swap (push) dip 1 swap) (
               xhi _xtext swap 'text tag swap (push) dip 1 swap
             ) if) if) if) if) if) if) pthen swap) while
         drop) ([] "xml: expected > or /> after <" xen cat xrj _xhere no) if) if) pthen swap 'xek let
     {'name xen 'attrs xea 'children xek} swap) if) if) '_xelem let

  -- ========== Document ==========

  -- _xtrivia: (i -- st).  Skips whitespace and comments.
  (ok 1 (dup) (drop 0 ('xvi let xvi _xws 'xvj let xvj "<!--" _xat (1 xvj 4 plus "-->" _xpast) (0 xvj ok) if) pthen swap) while drop) '_xtrivia let

  -- _xdecl: (i -- i' st).  i is just past "<?xml".  Reads version, encoding and standalone, each once, up to ?>.
  -- The encoding may be UTF-8 or US-ASCII, in any case.  The state under the loop is a mask of the names seen.
  ('xy0 let
   0 xy0 ok 1
   (dup) (drop 0 ('xyi let 'xym let
     xyi _xws 'xyj let
     xyj "?>" _xat (xym 0 xyj 2 plus ok) (
     xyj _xc _x-name-start? not (xym 0 "xml: expected version, encoding, standalone or ?> in the declaration" xyj _xhere no) (
       xyj _xname swap 'xyn let must 'xyk let
       xyn "version" eq (1) (xyn "encoding" eq (2) (xyn "standalone" eq (4) (0) if) if) if 'xyb let
       xyb 0 eq (xym 0 "xml: unknown attribute \"" xyn cat "\" in the declaration; expected version, encoding or standalone" cat xyj _xpos no) (
       xym xyb band 0 eq not (xym 0 "xml: duplicate " xyn cat " in the declaration" cat xyj _xpos no) (
       xyk _xws 'xye let
       xye _xc 61 eq not (xym 0 "xml: expected = after " xyn cat xye _xhere no) (
       xye 1 plus _xws 'xyq let xyq _xc 'xyc let
       xyc 34 eq xyc 39 eq or not (xym 0 "xml: " xyn cat " value must be quoted" cat xyq _xhere no) (
         xyq _xattr-val swap 'xyv let {'ok ('xyx let
           xyn "encoding" eq not (xym xyb bor 1 xyx ok) (
           xyv (dup 97 ge over 122 le and (32 sub) () if) each 'xyu let
           xyu "UTF-8" eq xyu "US-ASCII" eq or (xym xyb bor 1 xyx ok) (
             xym 0 "xml: unsupported encoding \"" xyv cat "\"; expected UTF-8 or US-ASCII" cat xyq 1 plus _xpos no) if) if)
           'no ('xyy let xym 0 xyy no)} case) if) if) if) if) if) if) pthen swap) while
   drop swap drop) '_xdecl let

  -- _xmisc: (i -- st).  Skips white space, comments and processing instructions.
  (ok 1 (dup) (drop 0 ('xvi let xvi _xws 'xvj let xvj "<!--" _xat (1 xvj 4 plus "-->" _xpast) (xvj "<?" _xat (1 xvj 2 plus "?>" _xpast) (0 xvj ok) if) if) pthen swap) while drop) '_xmisc let

  -- _xprolog: (i -- st).  A byte-order mark, then trivia, <?xml ...?> and <!DOCTYPE ...>, with processing instructions after trivia.
  ('xp0 let
   xp0 _xc 239 eq xp0 1 plus _xc 187 eq and xp0 2 plus _xc 191 eq and (xp0 3 plus) (xp0) if
   _xtrivia
   ('xp1 let xp1 "<?xml" _xat xp1 5 plus _xc _x-ws? and (xp1 5 plus _xdecl) (xp1 ok) if) then (_xmisc) then
   ('xp2 let xp2 "<!DOCTYPE" _xat (xp2 9 plus ">" _xpast) (xp2 ok) if) then (_xmisc) then) '_xprolog let

  0 _xprolog _xnone (0 _xelem) pthen
  (_xmisc) then ('xz let xz _xc 0 lt (0 ok) ("xml: trailing input after the root element" xz _xhere no) if) then
  {'ok (drop ok) 'no (swap drop no)} case) '_xml-parse let

-- ========== Helpers for decoders ==========
-- Nodes take more than one slot each, so these scan a whole list with `each`,
-- `fold` or `index-of` rather than reading it one index at a time.

-- _x-trim: (s -- s').  Drops leading and trailing whitespace.
('xs let
 0 (dup 'xs nth {'ok (_x-ws?) 'no (drop 0)} case) (1 plus) while 'xa let
 xs len (dup 0 gt (dup 1 sub 'xs nth {'ok (_x-ws?) 'no (drop 0)} case) (0) if) (1 sub) while 'xz let
 xs xz take-n xa drop-n) '_x-trim let

-- _x-find-attr: (attrs name -- value ok | none).
('xfn let 'xfa let
 xfa ('name at) each xfn index-of
 {'ok ('xfk let xfk 'xfa nth must 'value at ok) 'no (drop none)} case) '_x-find-attr let

-- _x-elems: (children keep -- elements).  The element children whose name keep
-- accepts: (name -- bool).
('xk let [] ({'elem ('r let r 'name at xk apply ([] r push) ([]) if) 'text (drop [])} case cat) fold) '_x-elems let

-- _x-collect-text: (children -- text ok | none).  The children's text joined, or
-- none if any child is an element.
("" ok ({'text (ok) 'elem (drop none)} case 'xr let ('xa let xr (xa swap cat ok) then) then) fold) '_x-collect-text let

-- _xa-list: (elements dec -- values ok | msg no).  The first failing element
-- wins, and its index is the count of elements decoded before it: "[1]...".
('d let [] ok ('x let (x d apply {'ok (push ok) 'no ('m let len int-str "[" swap cat "]" cat m cat no)} case) then) fold) '_xa-list let

-- ========== Decoders ==========
-- A decoder is a body (element -- value ok | msg no).  A failure message starts
-- with the path below the element, and each decoder on the way out puts its own
-- step in front; xd-run adds the root's name.

(('children at _x-collect-text {'ok (_x-trim ok) 'no (drop "/text(): element has non-text children" no)} case)) 'xd-text let
(('children at _x-collect-text {'ok (ok) 'no (drop "/text(): element has non-text children" no)} case)) 'xd-raw-text let
(('name at ok)) 'xd-tag let
(('attrs at ok)) 'xd-attrs let

-- xd-attr: (name -- dec).
('n let ('attrs at n _x-find-attr {'ok (ok) 'no (drop ": missing @" n cat no)} case)) 'xd-attr let

-- xd-child: (name dec -- dec').  The first child element with the name.
('d let 'n let ('children at (n eq) _x-elems 0 get
   {'ok (d apply {'ok (ok) 'no ("/" n cat swap cat no)} case)
       'no (drop ": missing <" n cat ">" cat no)} case)) 'xd-child let

-- xd-children: (name dec -- dec').  Every child element with the name.
('d let 'n let ('children at (n eq) _x-elems d _xa-list {'ok (ok) 'no ("/" n cat swap cat no)} case)) 'xd-children let

-- xd-all-children: (dec -- dec').  Every child element.
('d let ('children at (drop 1) _x-elems d _xa-list {'ok (ok) 'no ("/*" swap cat no)} case)) 'xd-all-children let

-- xd-at: (names dec -- dec').  Children nested along names: ["b" "c"] reads /b/c.
(swap reverse swap (swap xd-child) fold) 'xd-at let

-- xd-map: (dec f -- dec').  f: (value -- value').
('f let 'd let (d apply (f apply ok) then)) 'xd-map let

-- xd-map2: (dec1 dec2 f -- dec).  f: (value1 value2 -- value).  Both decoders
-- read the same element; `"t" xd-text "u" xd-text ('u let 't let {'title t 'url u}) xd-map2`
-- builds a record of two fields.
('f let 'd2 let 'd1 let ('e let e d1 apply ('a let e d2 apply (a swap f apply ok) then) then)) 'xd-map2 let

-- xd-and-then: (dec f -- dec').  f: (value -- dec2), and dec2 reads the same element.
('f let 'd let ('e let e d apply (f apply e swap apply) then)) 'xd-and-then let

-- xd-one-of: (decs -- dec).  The first decoder that succeeds wins.  If none does,
-- the error lists each one's: ": oneOf: [0] : missing <a>; [1] ...".
('ds let ('e let
   ds {'n 0 'msg ""} no
   ('dd let {'ok (ok) 'no ('r let e dd apply {'ok (ok) 'no ('m let
       {'n r 'n at 1 plus
        'msg r 'msg at r 'n at 0 gt ("; " cat) () if "[" cat r 'n at int-str cat "] " cat m cat} no)} case)} case) fold
   {'ok (ok) 'no ('r let ": oneOf: " r 'n at 0 eq ("no decoders") (r 'msg at) if cat no)} case)) 'xd-one-of let

-- xd-maybe: (dec -- dec').  value ok ok, or none ok when the child or attribute dec reads is
-- missing.  Every other failure passes through: a child that is there but malformed fails.
-- A missing child or attribute is the one failure whose message starts with ": missing ".
('d let (d apply {'ok (ok ok) 'no ('m let ": missing " dup len m swap take-n eq (none ok) (m no) if)} case)) 'xd-maybe let

('v let (drop v ok)) 'xd-succeed let
('m let (drop ": " m cat no)) 'xd-fail let

-- xd-default-ns: the element's xmlns attribute, or "" if it declares none.
-- Useful for detecting Atom feeds (xmlns="http://www.w3.org/2005/Atom").
("xmlns" xd-attr xd-maybe ("" default) xd-map) 'xd-default-ns let

-- ========== Public entry ==========

-- xd-run: (source dec -- value ok | msg no).
('d let _xml-parse ('root let root d apply {'ok (ok) 'no ("/" root 'name at cat swap cat no)} case) then) 'xd-run let

-- xd-eval: (source (-- dec) -- value ok | msg no).  Builds the decoder, then runs it.
(apply xd-run) 'xd-eval let

-- ========== Builder combinators (xe-*) ==========
-- Nodes for xml-render.

-- xe-text: (string -- node)
('text tag) 'xe-text let

-- xe-elem: (name attrs children -- node).  attrs is a list of {'name 'value} records.
('kids let 'ats let 'nm let {'name nm 'attrs ats 'children kids} 'elem tag) 'xe-elem let

-- ========== Encoder (xml-render) ==========

-- Escape & < > in text, and " too in an attribute value.
([] ('c let c 38 eq ("&amp;" cat) (c 60 eq ("&lt;" cat) (c 62 eq ("&gt;" cat) (c push) if) if) if) fold) '_xe-escape-text let
([] ('c let c 38 eq ("&amp;" cat) (c 60 eq ("&lt;" cat) (c 62 eq ("&gt;" cat) (c 34 eq ("&quot;" cat) (c push) if) if) if) if) fold) '_xe-escape-attr let

-- _xe-render-attrs: (attrs -- string).  ` name="value"` for each {'name 'value} record.
([] ('xp let " " cat xp 'name at cat "=\"" cat xp 'value at _xe-escape-attr cat "\"" cat) fold) '_xe-render-attrs let

-- _xe-name?: (string -- bool).  Does the parser read the string as one name?
(dup len 0 gt (dup 0 get must _x-name-start? swap 1 drop-n swap (_x-name-char? and) fold) (drop 0) if) '_xe-name? let

-- _xe-open: (element -- children start-tag name).  "<name attrs", without its end.  A name the parser refuses, or a repeated attribute name, dies.
(dup 'name at 'nm let dup 'attrs at 'ats let 'children at
  nm _xe-name? not ("xml: element name \"" nm cat "\" is not an XML name; expected a letter, _ or : then letters, digits, - . _ or :" cat fail) () if
  ats dict ('xa let 'xd let xa 'name at 'xn let
    xn _xe-name? not ("xml: attribute name \"" xn cat "\" in <" cat nm cat "> is not an XML name; expected a letter, _ or : then letters, digits, - . _ or :" cat fail) () if
    xd xn of {'ok ("xml: duplicate attribute \"" xn cat "\" in <" cat nm cat ">; the parser refuses it" cat fail) 'no (0 insert)} case) fold drop
  "<" nm cat ats _xe-render-attrs cat nm) '_xe-open let

-- xml-render: (node -- xml-string).
({'text (_xe-escape-text)
     'elem (_xe-open 'nm let 'st let
            0 peek {'ok (drop 1) 'no (drop 0)} case 'more let
            (xml-render) each flatten 'inner let
            st more (">" cat inner cat "</" cat nm cat ">" cat) ("/>" cat) if)} case) 'xml-render let

-- ========== Markup ==========

-- xd-markup: the element's children as XML, trimmed as xd-text trims: text stays escaped, and a
-- child element stays markup.  <t>A <b>AT&amp;T</b></t> gives "A <b>AT&amp;T</b>".
(('children at (xml-render) each flatten _x-trim ok)) 'xd-markup let

-- xml-unescape: (markup -- text ok | msg no).  Decodes each entity and keeps the rest, tags
-- included: "A <b>AT&amp;T</b>" gives "A <b>AT&T</b>".  It undoes xe-text xml-render.
-- The text grows on the stack: a lookup of a bound text would copy it once per entity.  The
-- first part comes off the split list in place (reverse, pop), since a copy of the list could
-- overflow the stack.  str-split gives at least one part.
("&" str-split reverse pop must ok swap reverse swap
 ('xup let (xup ";" str-find
   {'ok ('xk let xup xk take-n _x-entity {'ok (cat xup xk 1 plus drop-n cat ok) 'no (swap drop no)} case)
    'no (drop drop "xml: & starts no entity; expected &name; or &#digits;" no)} case) then) fold) 'xml-unescape let

-- ========== Pretty-print variant ==========

-- _xe-kids-all-text?: (children -- bool).
(({'elem (drop 1) 'text (drop 0)} case) each 1 index-of {'ok (drop 0) 'no (drop 1)} case) '_xe-kids-all-text? let

-- xml-render-pretty: (depth node -- string ending in a newline)
(swap 'xd let
 {'text (_xe-escape-text)
     'elem (_xe-open 'nm let 'st let 'kids let
            [] xd 2 mul (32 push) repeat 'ind let
            ind st cat
            kids len 0 eq ("/>" cat) (
            kids _xe-kids-all-text? (">" cat kids (xml-render) each flatten cat "</" cat nm cat ">" cat) (
              ">" cat [] 10 push cat
              kids (xd 1 plus swap xml-render-pretty) each flatten cat
              ind "</" cat cat nm cat ">" cat) if) if)} case
 [] 10 push cat) 'xml-render-pretty let

-- xml-pretty: (node -- string).  Top-level pretty-print; starts at depth 0.
(0 swap xml-render-pretty) 'xml-pretty let

-- ========== Tests ==========

-- Test helpers: xerr gives a result's error, or "" on success; node-name and
-- node-text read a node, or give "" for the other kind.
({'ok (drop "") 'no ()} case) 'xerr let
({'elem ('name at) 'text (drop "")} case) 'node-name let
({'text () 'elem (drop "")} case) 'node-text let

"<a/>" _xml-parse must 'name at "a" eq assert
"<a/>" _xml-parse must 'attrs at len 0 eq assert
"<a/>" _xml-parse must 'children at len 0 eq assert

"<a>hi</a>" _xml-parse must 'children at 0 get must node-text "hi" eq assert

"<a id=\"1\" cls='x'/>" _xml-parse must 'attrs at 'ats let
ats 0 get must 'name at "id" eq assert
ats 0 get must 'value at "1" eq assert
ats 1 get must 'name at "cls" eq assert
ats 1 get must 'value at "x" eq assert

"<a><b>1</b><c>2</c></a>" _xml-parse must 'children at 'nks let
nks len 2 eq assert
nks 0 get must node-name "b" eq assert
nks 1 get must node-name "c" eq assert

"<a><![CDATA[<not>xml</not>]]></a>" _xml-parse must 'children at 0 get must
  node-text "<not>xml</not>" eq assert

"<a>&amp;&lt;&gt;&quot;&apos;</a>" _xml-parse must 'children at 0 get must
  node-text "&<>\"'" eq assert

"<a>&#65;&#x41;</a>" _xml-parse must 'children at 0 get must
  node-text "AA" eq assert

"<a><!-- skip me -->hi</a>" _xml-parse must 'children at 0 get must
  node-text "hi" eq assert

"<?xml version=\"1.0\"?><a/>" _xml-parse must 'name at "a" eq assert

"<atom:link href='x'/>" _xml-parse must 'name at "atom:link" eq assert

"<a>42</a>" xd-text xd-run "42" ok eq assert
"<a>  42  </a>" xd-text xd-run "42" ok eq assert
"<a>  42  </a>" xd-raw-text xd-run "  42  " ok eq assert

"<item/>" xd-tag xd-run "item" ok eq assert

"<a id=\"7\"/>" "id" xd-attr xd-run "7" ok eq assert

("b" xd-text xd-child) 'b-text let
"<a><b>hi</b></a>" b-text xd-run "hi" ok eq assert

("b" xd-text xd-children) 'b-list let
"<a><b>1</b><b>2</b><c/><b>3</b></a>" b-list xd-run ["1" "2" "3"] ok eq assert

(["b" "c"] xd-text xd-at) 'abc-text let
"<a><b><c>deep</c></b></a>" abc-text xd-run "deep" ok eq assert

"<feed><t>Hi</t><t>Bye</t></feed>"
  ("t" xd-text xd-children) xd-eval ["Hi" "Bye"] ok eq assert

"<a><b>1</b>x<c>2</c></a>" xd-text xd-all-children xd-run ["1" "2"] ok eq assert

("x" xd-attr xd-maybe) 'maybe-x-attr let
"<a/>" maybe-x-attr xd-run none ok eq assert
"<a x=\"1\"/>" maybe-x-attr xd-run "1" ok ok eq assert
-- A missing child is none, and a present child that fails its decoder fails the decode
"<a/>" "b" xd-text xd-child xd-maybe xd-run none ok eq assert
"<a><b><c/></b></a>" "b" xd-text xd-child xd-maybe xd-run xerr "/a/b/text(): element has non-text children" eq assert
"<a><b/></a>" ["b" "c"] xd-text xd-at xd-maybe xd-run xerr "/a/b: missing <c>" eq assert

-- xd-markup: the children as XML, so text stays escaped and an element stays markup
"<a> AT&amp;T </a>" xd-markup xd-run "AT&amp;T" ok eq assert
"<a>A <b>bold</b> post</a>" xd-markup xd-run "A <b>bold</b> post" ok eq assert
-- xml-unescape decodes each entity and keeps the tags
"A <b x=\"&quot;\">AT&amp;T &#65;&lt;</b>" xml-unescape "A <b x=\"\"\">AT&T A<</b>" ok eq assert
"a & b" xml-unescape xerr "xml: & starts no entity; expected &name; or &#digits;" eq assert
"&bogus;" xml-unescape xerr "xml: unknown entity &bogus;" eq assert

([] "wrong" xd-fail push xd-text push xd-one-of) 'first-int-fail-then-text let
"<a>hi</a>" first-int-fail-then-text xd-run "hi" ok eq assert

(xd-tag xd-text ('t let "=" cat t cat) xd-map2) 'tag-eq-text let
"<a>hi</a>" tag-eq-text xd-run "a=hi" ok eq assert

-- Adversarial
"<a/>" "id" xd-attr xd-run xerr "/a: missing @id" eq assert
"<a/>" "b" xd-text xd-child xd-run xerr "/a: missing <b>" eq assert
"<a><b><c/></b></a>" "b" xd-text xd-child xd-run xerr
  "/a/b/text(): element has non-text children" eq assert
"<a><b>1</b><b><c/></b></a>" "b" xd-text xd-children xd-run xerr
  "/a/b[1]/text(): element has non-text children" eq assert

([] xd-one-of) 'empty-one let
"<a/>" empty-one xd-run xerr "/a: oneOf: no decoders" eq assert
([] "x" xd-attr push "y" xd-attr push xd-one-of) 'two-attrs let
"<a/>" two-attrs xd-run xerr "/a: oneOf: [0] : missing @x; [1] : missing @y" eq assert

-- xd-attrs: returns a list of {'name 'value} records
"<a x=\"1\" y=\"2\"/>" xd-attrs xd-run must 'atsv let
atsv len 2 eq assert
atsv 0 get must 'name at "x" eq assert
atsv 0 get must 'value at "1" eq assert

-- xml-render: roundtrip
"<a id=\"1\"><b>hi &amp; bye</b><c/></a>" _xml-parse must 'elem tag xml-render 'rendered let
rendered "<a id=\"1\"><b>hi &amp; bye</b><c/></a>" eq assert

-- render simple self-closing
"<a/>" _xml-parse must 'elem tag xml-render "<a/>" eq assert

-- render with text escaping
"<a>1 &lt; 2 &amp; 3 &gt; 0</a>" _xml-parse must 'elem tag xml-render
  "<a>1 &lt; 2 &amp; 3 &gt; 0</a>" eq assert

-- render with attr containing quote/ampersand
"<a x=\"a &amp; &quot;b&quot;\"/>" _xml-parse must 'elem tag xml-render
  "<a x=\"a &amp; &quot;b&quot;\"/>" eq assert

-- xe-text / xe-elem combinators roundtrip
"hello & friends" xe-text xml-render "hello &amp; friends" eq assert
"p" [] [] "hi" xe-text push xe-elem xml-render "<p>hi</p>" eq assert
"p" [] {'name "id" 'value "a&b"} push {'name "k" 'value "\"v\""} push [] xe-elem xml-render
  "<p id=\"a&amp;b\" k=\"&quot;v&quot;\"/>" eq assert

-- xml-pretty: basic indentation
"<a><b>hi</b><c/></a>" _xml-parse must 'elem tag xml-pretty
  "<a>\n  <b>hi</b>\n  <c/>\n</a>\n" eq assert

-- xml-pretty: self-close
"<a/>" _xml-parse must 'elem tag xml-pretty "<a/>\n" eq assert

-- xml-pretty: nested
"<a><b><c>deep</c></b></a>" _xml-parse must 'elem tag xml-pretty
  "<a>\n  <b>\n    <c>deep</c>\n  </b>\n</a>\n" eq assert

-- xd-default-ns: missing xmlns → ""
"<a/>" xd-default-ns xd-run "" ok eq assert

-- xd-default-ns: present
"<feed xmlns=\"http://www.w3.org/2005/Atom\"/>" xd-default-ns xd-run
  "http://www.w3.org/2005/Atom" ok eq assert


-- ========== Malformed input returns 'no, never a crash ==========

"" _xml-parse xerr "xml: expected < at byte 0" eq assert
"hello" _xml-parse xerr "xml: expected < at byte 0, found 'h'" eq assert
"<a>" _xml-parse xerr "xml: unexpected end of input inside <a> at byte 3" eq assert
"<a></b>" _xml-parse xerr "xml: expected </a> but found </b> at byte 3" eq assert
"<a></a x>" _xml-parse xerr "xml: expected > to close </a> at byte 7, found 'x'" eq assert
"<a b=1/>" _xml-parse xerr "xml: attribute value must be quoted at byte 5, found '1'" eq assert
"<a b=\"1/>" _xml-parse xerr "xml: unterminated attribute value at byte 9" eq assert
"<a b/>" _xml-parse xerr "xml: expected = after attribute b at byte 4, found '/'" eq assert
"<a b=\"1\"" _xml-parse xerr "xml: unexpected end of input in a tag at byte 8" eq assert
"<a /x>" _xml-parse xerr "xml: expected > or /> after <a at byte 3, found '/'" eq assert
"<1/>" _xml-parse xerr "xml: expected a name at byte 1, found '1'" eq assert
"<" _xml-parse xerr "xml: expected a name at byte 1" eq assert
"<a>&bogus;</a>" _xml-parse xerr "xml: unknown entity &bogus; at byte 3" eq assert
"<a>&amp</a>" _xml-parse xerr "xml: unterminated entity at byte 3" eq assert
"<a>&#xZZ;</a>" _xml-parse xerr "xml: bad digit in a numeric entity at byte 3" eq assert
"<a b=\"&bogus;\"/>" _xml-parse xerr "xml: unknown entity &bogus; at byte 6" eq assert
"<a><![CDATA[x</a>" _xml-parse xerr "xml: expected ]]> not found after byte 12" eq assert
"<a><!-- x</a>" _xml-parse xerr "xml: expected --> not found after byte 7" eq assert
"<a/><b/>" _xml-parse xerr "xml: trailing input after the root element at byte 4, found '<'" eq assert
[] 257 ("<a>" cat) repeat _xml-parse xerr "xml: elements nested deeper than 256 at byte 768" eq assert
[] 256 ("<a>" cat) repeat 256 ("</a>" cat) repeat _xml-parse xerr "" eq assert
"<a/>" xd-text xd-run xerr "" eq assert
"<a>" xd-text xd-run xerr "xml: unexpected end of input inside <a> at byte 3" eq assert

-- A repeated attribute name in one element is an error
"<a b=\"1\" b=\"2\"/>" _xml-parse xerr "xml: duplicate attribute b at byte 9" eq assert
"<a b=\"1\" c=\"2\" b=\"3\">x</a>" _xml-parse xerr "xml: duplicate attribute b at byte 15" eq assert
"<a b=\"1\"><c b=\"2\"/></a>" _xml-parse xerr "" eq assert

-- A declared encoding must be UTF-8 or US-ASCII, in any case
"<?xml version=\"1.0\" encoding=\"ISO-8859-1\"?><a/>" _xml-parse xerr
  "xml: unsupported encoding \"ISO-8859-1\"; expected UTF-8 or US-ASCII at byte 30" eq assert
"<?xml version='1.0' encoding='UTF-16'?><a/>" _xml-parse xerr
  "xml: unsupported encoding \"UTF-16\"; expected UTF-8 or US-ASCII at byte 30" eq assert
"<?xml version=\"1.0\" encoding=UTF-8?><a/>" _xml-parse xerr
  "xml: encoding value must be quoted at byte 29, found 'U'" eq assert
"<?xml version=\"1.0\" encoding=\"UTF-8\"?><a/>" _xml-parse xerr "" eq assert
"<?xml version=\"1.0\" encoding='utf-8'?><a/>" _xml-parse xerr "" eq assert
"<?xml version=\"1.0\" encoding=\"us-ascii\" standalone=\"yes\"?><a/>" _xml-parse xerr "" eq assert
"<?xml version=\"1.0\"?><a/>" _xml-parse xerr "" eq assert
-- Only <?xml and white space starts the declaration; any other <?xml... is a processing instruction
"<?xml-stylesheet encoding=\"x\"?><a/>" _xml-parse xerr "" eq assert
"<?xml version=\"1.0\"?><?xml-stylesheet href=\"a\"?><a/><?pi x?>" _xml-parse xerr "" eq assert
-- The declaration holds version, encoding and standalone, each once, in this case
"<?xml version=\"1.0\" ENCODING=\"latin1\"?><a/>" _xml-parse xerr
  "xml: unknown attribute \"ENCODING\" in the declaration; expected version, encoding or standalone at byte 20" eq assert
"<?xml version=\"1.0\" encoding=\"UTF-8\" encoding=\"UTF-8\"?><a/>" _xml-parse xerr
  "xml: duplicate encoding in the declaration at byte 37" eq assert
"<?xml version=\"1.0\" encoding=\"UTF-8\"?\"><a/>" _xml-parse xerr
  "xml: expected version, encoding, standalone or ?> in the declaration at byte 36, found '?'" eq assert
"<?xml version=\"1.0\"" _xml-parse xerr
  "xml: expected version, encoding, standalone or ?> in the declaration at byte 19" eq assert

-- A numeric entity is a character, so it is UTF-8 encoded
"<a>&#8217;</a>" _xml-parse must 'children at 0 get must node-text [] 226 push 128 push 153 push eq assert
"<a>&#0;</a>" _xml-parse xerr "xml: numeric entity is not a character at byte 3" eq assert
