-- xml.slap: Elm-style XML decoder library.
-- An element is a record {'name "tag" 'attrs [[name val]...] 'children [node...]}.
-- A node is `element 'elem tag` or `text 'text tag`.
-- _xml-parse returns the root `element ok`, or `msg no` for input that is not well-formed.
-- Decoders (xd-*) are first-class composable values. Run with xd-run or xd-eval.
-- Errors are XPath-ish strings: "/rss/channel/item[2]/title: missing".

-- ========== Char predicates ==========

-- These run once per byte, so they keep the byte on the stack rather than bind it: a body that
-- binds a name gets a frame of its own on every run.
(dup 32 eq  over 9 eq or  over 10 eq or  swap 13 eq or) '_x-ws? let

(dup dup 65 ge swap 90 le and
 over dup 97 ge swap 122 le and or
 over 95 eq or
 swap 58 eq or) '_x-name-start? let

(dup dup 65 ge swap 90 le and
 over dup 97 ge swap 122 le and or
 over dup 48 ge swap 57 le and or
 over 45 eq or
 over 95 eq or
 over 58 eq or
 swap 46 eq or) '_x-name-char? let

-- ========== Parser ==========
-- _xml-parse binds the source as '_xin and every step reads it by index with
-- `nth`, so no token copies the input and nothing recurses per byte. A step's
-- state is `i ok`, or `msg no` from the first failure; `then` and `pthen`
-- carry a failure past the steps after it.

-- _xml-parse: (source -- record ok | msg no).  The helpers live inside it, so each reads the
-- input it binds as '_xin by name, not a caller's.
('_xin let
  -- _xc: (i -- c).  The byte at i, or -1 past the end.
  ('_xin swap nth () {'ok () 'no (drop -1)} case) '_xc let

  -- _xws: (i -- i')
  ((dup _xc _x-ws?) (1 plus) while) '_xws let

  -- _xat: (i lit -- bool).  Does lit start at i?
  ('xl let 'xi let
   0 (dup xl len lt (dup dup xi plus _xc swap 'xl swap nth must eq) (0) if) (1 plus) while
   xl len eq) '_xat let

  -- _xpast: (i lit -- st).  The index just past the next lit at or after i.
  ('xpl let
   (dup _xc 0 ge (dup xpl _xat not) (0) if) (1 plus) while
   dup _xc 0 lt (drop "xml: expected " xpl cat " not found" cat no) (xpl len plus ok) if) '_xpast let

  -- _xslice: (a b -- bytes).  The input from a up to b.
  ('xsb let list swap (dup xsb lt) ('xsj let xsj _xc push xsj 1 plus) while drop) '_xslice let

  -- _xname: (i -- name st)
  ('xni let xni _xc 'xc0 let
   xc0 0 lt (list "xml: expected a name" no) (
   xc0 _x-name-start? not (list "xml: a name cannot start with '" list xc0 push cat "'" cat no) (
     list xni (dup _xc _x-name-char?) (dup _xc rot swap push swap 1 plus) while ok) if) if) '_xname let

  -- ========== Entities ==========

  -- _x-utf8: (codepoint -- bytes ok | msg no)
  ('cp let
   cp 1 lt cp 1114111 gt or cp 55296 ge cp 57343 le and or ("xml: numeric entity is not a character" no) (
   cp 128 lt (list cp push ok) (
   cp 2048 lt (list 192 cp 6 shr bor push 128 cp 63 band bor push ok) (
   cp 65536 lt (list 224 cp 12 shr bor push 128 cp 6 shr 63 band bor push 128 cp 63 band bor push ok) (
     list 240 cp 18 shr bor push 128 cp 12 shr 63 band bor push 128 cp 6 shr 63 band bor push 128 cp 63 band bor push ok
   ) if) if) if) if) '_x-utf8 let

  -- _x-num-entity: (digits base -- codepoint ok | msg no).  A bad digit poisons the fold with -1.
  ('xbase let 'xds let
   xds len 0 eq ("xml: empty numeric entity" no) (
   xds len 8 gt ("xml: numeric entity longer than 8 digits" no) (
     xds 0 ('xd let 'xacc let
       xd 48 ge xd 57 le and (xd 48 sub) (
       xbase 16 eq xd 97 ge xd 102 le and and (xd 87 sub) (
       xbase 16 eq xd 65 ge xd 70 le and and (xd 55 sub) (-1) if) if) if 'xdv let
       xacc 0 lt xdv 0 lt or xdv xbase ge or (-1) (xacc xbase mul xdv plus) if) fold
     dup 0 lt (drop "xml: bad digit in a numeric entity" no) (ok) if) if) if) '_x-num-entity let

  -- _x-entity: (body -- bytes ok | msg no).  body is what lies between & and ;.
  ('xb let
   xb len 0 eq ("xml: empty entity &;" no) (
   xb 0 get must 35 eq (
     xb 1 drop-n 'xn let
     xn len 0 gt (xn 0 get must 'xh let xh 120 eq xh 88 eq or) (0) if
     (xn 1 drop-n 16) (xn 10) if _x-num-entity (_x-utf8) then
   ) (
     xb "amp" eq (list 38 push ok) (
     xb "lt" eq (list 60 push ok) (
     xb "gt" eq (list 62 push ok) (
     xb "quot" eq (list 34 push ok) (
     xb "apos" eq (list 39 push ok) (
       "xml: unknown entity &" xb cat ";" cat no) if) if) if) if) if) if) if) '_x-entity let

  -- _xentity: (i -- bytes st).  i is just past '&'.  A body past 32 bytes is unterminated.
  ('xei let
   xei (dup _xc 'xec let xec 59 eq not xec 0 ge and) (1 plus) while 'xej let
   xej _xc 59 eq not xej xei sub 32 gt or (list "xml: unterminated entity" no) (
     xei xej _xslice _x-entity () {'ok (xej 1 plus ok) 'no (list swap no)} case) if) '_xentity let

  -- ========== Text and attributes ==========
  -- The loops below keep what they build at the bottom of the stack and a
  -- `1`/`0` go-on flag on top, with the state between them.

  -- _xtext: (i -- text st).  Runs to the next '<' or the end.
  ('xti let list xti ok 1
   -- the step runs once per byte, so it keeps the index and the byte on the stack: (text i -- text more st)
   (dup) (drop 0 (dup _xc
       dup 0 lt over 60 eq or (drop 0 swap ok) (
       dup 38 eq (drop 1 plus _xentity (cat) dip 1 swap) (swap (push) dip 1 swap 1 plus ok) if) if) pthen swap) while
   drop) '_xtext let

  -- _xattr-val: (i -- value st).  i is at the opening quote.
  ('xai let xai _xc 'xq let
   xq 34 eq xq 39 eq or not (list "xml: attribute value must be quoted" no) (
     list xai 1 plus ok 1
     (dup) (drop 0 ('xaj let xaj _xc 'xac let
         xac 0 lt (0 "xml: unterminated attribute value" no) (
         xac xq eq (0 xaj 1 plus ok) (
         xac 38 eq (xaj 1 plus _xentity (cat) dip 1 swap) (xac push 1 xaj 1 plus ok) if) if) if) pthen swap) while
     drop) if) '_xattr-val let

  -- _xattrs: (i -- attrs st).  attrs is a list of [name value] couples; stops at / or >.
  (list swap ok 1
   (dup) (drop 0 ('xsi let xsi _xws 'xsj let xsj _xc 'xsc let
       xsc 47 eq xsc 62 eq or (0 xsj ok) (
       xsc 0 lt (0 "xml: unexpected end of input in a tag" no) (
         xsj _xname swap 'xan let
         (_xws 'xse let xse _xc 61 eq (xse 1 plus _xws ok) ("xml: expected = after attribute " xan cat no) if) then
         list (_xattr-val) pthen swap 'xav let (xan xav couple push) dip 1 swap) if) if) pthen swap) while
   drop) '_xattrs let

  -- ========== Elements ==========

  -- _xcdata: (i -- text st).  i is just past "<![CDATA[".
  ('xci let xci "]]>" _xpast () {'ok ('xck let xci xck 3 sub _xslice xck ok) 'no (list swap no)} case) '_xcdata let

  -- _xnone: (-- element).  What a failed step leaves in place of an element.
  (rec "" 'name into list 'attrs into list 'children into) '_xnone let

  -- _xelem: (i depth -- element st).  i is at '<'.  The children, up to and
  -- through </name>, are read by _xelem one level deeper.  Nesting past 256 is
  -- refused before it can exhaust the interpreter's recursion limit.
  ('xed let 'xei let
   xed 256 gt (_xnone "xml: elements nested deeper than 256" no) (
   xei _xc 60 eq not (_xnone "xml: expected <" no) (
     xei 1 plus _xname swap 'xen let
     list (_xattrs) pthen swap 'xea let
     list ('xri let xri _xws 'xrj let
       xrj "/>" _xat (list xrj 2 plus ok) (
       xrj _xc 62 eq (
         list xrj 1 plus ok 1
         (dup) (drop 0 ('xhi let
             xhi _xc 0 lt (0 "xml: unexpected end of input inside <" xen cat ">" cat no) (
             xhi "<!--" _xat (1 xhi 4 plus "-->" _xpast) (
             xhi "<![CDATA[" _xat (xhi 9 plus _xcdata swap 'text tag swap (push) dip 1 swap) (
             xhi "<?" _xat (1 xhi 2 plus "?>" _xpast) (
             xhi "</" _xat (
               xhi 2 plus _xname swap 'xct let
               (_xws 'xck let xct xen eq not ("xml: expected </" xen cat "> but found </" cat xct cat ">" cat no) (
                  xck _xc 62 eq (xck 1 plus ok) ("xml: expected > to close </" xct cat no) if) if) then
               0 swap) (
             xhi _xc 60 eq (xhi xed 1 plus _xelem swap 'elem tag swap (push) dip 1 swap) (
               xhi _xtext swap 'text tag swap (push) dip 1 swap
             ) if) if) if) if) if) if) pthen swap) while
         drop) (list "xml: expected > or /> after <" xen cat no) if) if) pthen swap 'xek let
     rec xen 'name into xea 'attrs into xek 'children into swap) if) if) '_xelem let

  -- ========== Document ==========

  -- _xtrivia: (i -- st).  Skips whitespace and comments.
  (ok 1 (dup) (drop 0 ('xvi let xvi _xws 'xvj let xvj "<!--" _xat (1 xvj 4 plus "-->" _xpast) (0 xvj ok) if) pthen swap) while drop) '_xtrivia let

  -- _xprolog: (i -- st).  A byte-order mark, then trivia, <?xml ...?> and <!DOCTYPE ...>.
  ('xp0 let
   xp0 _xc 239 eq xp0 1 plus _xc 187 eq and xp0 2 plus _xc 191 eq and (xp0 3 plus) (xp0) if
   _xtrivia
   ('xp1 let xp1 "<?xml" _xat (xp1 5 plus "?>" _xpast) (xp1 ok) if) then (_xtrivia) then
   ('xp2 let xp2 "<!DOCTYPE" _xat (xp2 9 plus ">" _xpast) (xp2 ok) if) then (_xtrivia) then) '_xprolog let

  0 _xprolog _xnone (0 _xelem) pthen
  (_xtrivia) then ('xz let xz _xc 0 lt (0 ok) ("xml: trailing input after the root element" no) if) then
  () {'ok (drop ok) 'no (swap drop no)} case) '_xml-parse let

-- ========== Helpers for decoders ==========
-- Nodes take more than one slot each, so these scan a whole list with `each`,
-- `fold` or `index-of` rather than reading it one index at a time.

-- _x-trim: (s -- s').  Drops leading and trailing whitespace.
('xs let
 0 (dup 'xs swap nth () {'ok (_x-ws?) 'no (drop 0)} case) (1 plus) while 'xa let
 xs len (dup 0 gt (dup 1 sub 'xs swap nth () {'ok (_x-ws?) 'no (drop 0)} case) (0) if) (1 sub) while 'xz let
 xs xz take-n xa drop-n) '_x-trim let

-- _x-find-attr: (attrs name -- value ok | none).  The first attribute with the name wins.
('xfn let 'xfa let
 xfa (0 get must) each xfn index-of
 () {'ok ('xfk let 'xfa xfk nth must 1 get must ok) 'no (drop none)} case) '_x-find-attr let

-- _x-elems: (children keep -- elements).  The element children whose name keep
-- accepts: (name -- bool).
('xk let list (list {'elem ('r let r 'name at xk apply (list r push) (list) if)} case cat) fold) '_x-elems let

-- _x-collect-text: (children -- text ok | none).  The children's text joined, or
-- none if any child is an element.
("" ok (none {'text (ok)} case 'xr let ('xa let xr (xa swap cat ok) then) then) fold) '_x-collect-text let

-- _xa-list: (elements dec -- values ok | msg no).  The first failing element
-- wins, and its index is the count of elements decoded before it: "[1]...".
('d let list ok ('x let (x d apply () {'ok (push ok) 'no ('m let len int-str "[" swap cat "]" cat m cat no)} case) then) fold) '_xa-list let

-- ========== Decoders ==========
-- A decoder is a body (element -- value ok | msg no).  A failure message starts
-- with the path below the element, and each decoder on the way out puts its own
-- step in front; xd-run adds the root's name.

(('children at _x-collect-text () {'ok (_x-trim ok) 'no (drop "/text(): element has non-text children" no)} case)) 'xd-text let
(('children at _x-collect-text () {'ok (ok) 'no (drop "/text(): element has non-text children" no)} case)) 'xd-raw-text let
(('name at ok)) 'xd-tag let
(('attrs at ok)) 'xd-attrs let

-- xd-attr: (name -- dec).
('n let ('attrs at n _x-find-attr () {'ok (ok) 'no (drop "/@" n cat ": missing attribute" cat no)} case)) 'xd-attr let

-- xd-child: (name dec -- dec').  The first child element with the name.
('d let 'n let ('children at (n eq) _x-elems 0 get
   () {'ok (d apply () {'ok (ok) 'no ("/" n cat swap cat no)} case)
       'no (drop "/" n cat ": no such child" cat no)} case)) 'xd-child let

-- xd-children: (name dec -- dec').  Every child element with the name.
('d let 'n let ('children at (n eq) _x-elems d _xa-list () {'ok (ok) 'no ("/" n cat swap cat no)} case)) 'xd-children let

-- xd-all-children: (dec -- dec').  Every child element.
('d let ('children at (drop 1) _x-elems d _xa-list () {'ok (ok) 'no ("/*" swap cat no)} case)) 'xd-all-children let

-- xd-at: (names dec -- dec').  Children nested along names: ["b" "c"] reads /b/c.
(swap reverse swap (swap xd-child) fold) 'xd-at let

-- xd-map: (dec f -- dec').  f: (value -- value').
('f let 'd let (d apply (f apply ok) then)) 'xd-map let

-- xd-map2: (dec1 dec2 f -- dec).  f: (value1 value2 -- value).  Both decoders
-- read the same element; `rec xd-succeed "t" xd-text ('title into) xd-map2`
-- builds a record one field at a time.
('f let 'd2 let 'd1 let ('e let e d1 apply ('a let e d2 apply (a swap f apply ok) then) then)) 'xd-map2 let

-- xd-and-then: (dec f -- dec').  f: (value -- dec2), and dec2 reads the same element.
('f let 'd let ('e let e d apply (f apply e swap apply) then)) 'xd-and-then let

-- xd-one-of: (decs -- dec).  The first decoder that succeeds wins.
('ds let ('e let
   ds ": oneOf: no decoders matched" no
   ('dd let () {'ok (ok) 'no (drop e dd apply)} case) fold
   () {'ok (ok) 'no (drop ": oneOf: no decoders matched" no)} case)) 'xd-one-of let

-- xd-maybe: (dec -- dec').  value ok ok, or none ok when dec fails.
('d let (d apply () {'ok (ok ok) 'no (drop none ok)} case)) 'xd-maybe let

('v let (drop v ok)) 'xd-succeed let
('m let (drop ": " m cat no)) 'xd-fail let

-- xd-default-ns: the element's xmlns attribute, or "" if it declares none.
-- Useful for detecting Atom feeds (xmlns="http://www.w3.org/2005/Atom").
("xmlns" xd-attr xd-maybe ("" default) xd-map) 'xd-default-ns let

-- ========== Public entry ==========

-- xd-run: (source dec -- value ok | msg no).
('d let _xml-parse ('root let root d apply () {'ok (ok) 'no ("/" root 'name at cat swap cat no)} case) then) 'xd-run let

-- xd-eval: (source (-- dec) -- value ok | msg no).  Builds the decoder, then runs it.
(apply xd-run) 'xd-eval let

-- ========== Builder combinators (xe-*) ==========
-- Nodes for xml-render.

-- xe-text: (string -- node)
('text tag) 'xe-text let

-- xe-elem: (name attrs children -- node)
('kids let 'ats let 'nm let rec nm 'name into ats 'attrs into kids 'children into 'elem tag) 'xe-elem let

-- ========== Encoder (xml-render) ==========

-- Escape & < > in text, and " too in an attribute value.
(list ('c let c 38 eq ("&amp;" cat) (c 60 eq ("&lt;" cat) (c 62 eq ("&gt;" cat) (c push) if) if) if) fold) '_xe-escape-text let
(list ('c let c 38 eq ("&amp;" cat) (c 60 eq ("&lt;" cat) (c 62 eq ("&gt;" cat) (c 34 eq ("&quot;" cat) (c push) if) if) if) if) fold) '_xe-escape-attr let

-- _xe-render-attrs: (attrs -- string).  ` name="value"` for each.
(list ('xp let " " cat 'xp 0 nth must cat "=\"" cat 'xp 1 nth must _xe-escape-attr cat "\"" cat) fold) '_xe-render-attrs let

-- _xe-open: (element -- children start-tag name).  "<name attrs", without its end.
(dup 'name at 'nm let dup 'attrs at 'ats let 'children at "<" nm cat ats _xe-render-attrs cat nm) '_xe-open let

-- xml-render: (node -- xml-string).
("" {'text (_xe-escape-text)
     'elem (_xe-open 'nm let 'st let
            0 peek 0 {'ok (drop 1)} case 'more let
            (xml-render) each flatten 'inner let
            st more (">" cat inner cat "</" cat nm cat ">" cat) ("/>" cat) if)} case) 'xml-render let

-- ========== Pretty-print variant ==========

-- _xe-kids-all-text?: (children -- bool).
((0 {'elem (drop 1)} case) each 1 index-of 1 {'ok (drop 0)} case) '_xe-kids-all-text? let

-- xml-render-pretty: (depth node -- string ending in a newline)
(swap 'xd let
 "" {'text (_xe-escape-text)
     'elem (_xe-open 'nm let 'st let 'kids let
            list xd 2 mul (32 push) repeat 'ind let
            ind st cat
            kids len 0 eq ("/>" cat) (
            kids _xe-kids-all-text? (">" cat kids (xml-render) each flatten cat "</" cat nm cat ">" cat) (
              ">" cat list 10 push cat
              kids (xd 1 plus swap xml-render-pretty) each flatten cat
              ind "</" cat cat nm cat ">" cat) if) if)} case
 list 10 push cat) 'xml-render-pretty let

-- xml-pretty: (node -- string).  Top-level pretty-print; starts at depth 0.
(0 swap xml-render-pretty) 'xml-pretty let

-- ========== Tests ==========

-- Test helpers: xerr gives a result's error, or "" on success; node-name and
-- node-text read a node, or give "" for the other kind.
(() {'ok (drop "") 'no ()} case) 'xerr let
("" {'elem ('name at)} case) 'node-name let
("" {'text ()} case) 'node-text let

"<a/>" _xml-parse must 'name at "a" eq assert
"<a/>" _xml-parse must 'attrs at len 0 eq assert
"<a/>" _xml-parse must 'children at len 0 eq assert

"<a>hi</a>" _xml-parse must 'children at 0 get must node-text "hi" eq assert

"<a id=\"1\" cls='x'/>" _xml-parse must 'attrs at 'ats let
ats 0 get must 0 get must "id" eq assert
ats 0 get must 1 get must "1" eq assert
ats 1 get must 0 get must "cls" eq assert
ats 1 get must 1 get must "x" eq assert

"<a><b>1</b><c>2</c></a>" _xml-parse must 'children at 'nks let
nks len 2 eq assert
nks 0 get must node-name "b" eq assert
nks 1 get must node-name "c" eq assert

"<a><![CDATA[<not>xml</not>]]></a>" _xml-parse must 'children at 0 get must
  node-text "<not>xml</not>" eq assert

"<a>&amp;&lt;&gt;&quot;&apos;</a>" _xml-parse must 'children at 0 get must
  node-text "&<>\"'" eq assert

"<a>&#65;&#x41;</a>" _xml-parse must 'children at 0 get must
  node-text "AA" eq assert

"<a><!-- skip me -->hi</a>" _xml-parse must 'children at 0 get must
  node-text "hi" eq assert

"<?xml version=\"1.0\"?><a/>" _xml-parse must 'name at "a" eq assert

"<atom:link href='x'/>" _xml-parse must 'name at "atom:link" eq assert

"<a>42</a>" xd-text xd-run "42" ok eq assert
"<a>  42  </a>" xd-text xd-run "42" ok eq assert
"<a>  42  </a>" xd-raw-text xd-run "  42  " ok eq assert

"<item/>" xd-tag xd-run "item" ok eq assert

"<a id=\"7\"/>" "id" xd-attr xd-run "7" ok eq assert

("b" xd-text xd-child) 'b-text let
"<a><b>hi</b></a>" b-text xd-run "hi" ok eq assert

("b" xd-text xd-children) 'b-list let
"<a><b>1</b><b>2</b><c/><b>3</b></a>" b-list xd-run ["1" "2" "3"] ok eq assert

(["b" "c"] xd-text xd-at) 'abc-text let
"<a><b><c>deep</c></b></a>" abc-text xd-run "deep" ok eq assert

"<feed><t>Hi</t><t>Bye</t></feed>"
  ("t" xd-text xd-children) xd-eval ["Hi" "Bye"] ok eq assert

"<a><b>1</b>x<c>2</c></a>" xd-text xd-all-children xd-run ["1" "2"] ok eq assert

("x" xd-attr xd-maybe) 'maybe-x-attr let
"<a/>" maybe-x-attr xd-run none ok eq assert
"<a x=\"1\"/>" maybe-x-attr xd-run "1" ok ok eq assert

(list "wrong" xd-fail push xd-text push xd-one-of) 'first-int-fail-then-text let
"<a>hi</a>" first-int-fail-then-text xd-run "hi" ok eq assert

(xd-tag xd-text ('t let "=" cat t cat) xd-map2) 'tag-eq-text let
"<a>hi</a>" tag-eq-text xd-run "a=hi" ok eq assert

-- Adversarial
"<a/>" "id" xd-attr xd-run xerr "/a/@id: missing attribute" eq assert
"<a/>" "b" xd-text xd-child xd-run xerr "/a/b: no such child" eq assert
"<a><b><c/></b></a>" "b" xd-text xd-child xd-run xerr
  "/a/b/text(): element has non-text children" eq assert
"<a><b>1</b><b><c/></b></a>" "b" xd-text xd-children xd-run xerr
  "/a/b[1]/text(): element has non-text children" eq assert

(list xd-one-of) 'empty-one let
"<a/>" empty-one xd-run xerr "/a: oneOf: no decoders matched" eq assert

-- xd-attrs: returns list of [name val] couples
"<a x=\"1\" y=\"2\"/>" xd-attrs xd-run must 'atsv let
atsv len 2 eq assert
atsv 0 get must 0 get must "x" eq assert
atsv 0 get must 1 get must "1" eq assert

-- xml-render: roundtrip
"<a id=\"1\"><b>hi &amp; bye</b><c/></a>" _xml-parse must 'elem tag xml-render 'rendered let
rendered "<a id=\"1\"><b>hi &amp; bye</b><c/></a>" eq assert

-- render simple self-closing
"<a/>" _xml-parse must 'elem tag xml-render "<a/>" eq assert

-- render with text escaping
"<a>1 &lt; 2 &amp; 3 &gt; 0</a>" _xml-parse must 'elem tag xml-render
  "<a>1 &lt; 2 &amp; 3 &gt; 0</a>" eq assert

-- render with attr containing quote/ampersand
"<a x=\"a &amp; &quot;b&quot;\"/>" _xml-parse must 'elem tag xml-render
  "<a x=\"a &amp; &quot;b&quot;\"/>" eq assert

-- xe-text / xe-elem combinators roundtrip
"hello & friends" xe-text xml-render "hello &amp; friends" eq assert
"p" list list "hi" xe-text push xe-elem xml-render "<p>hi</p>" eq assert

-- xml-pretty: basic indentation
"<a><b>hi</b><c/></a>" _xml-parse must 'elem tag xml-pretty
  "<a>\n  <b>hi</b>\n  <c/>\n</a>\n" eq assert

-- xml-pretty: self-close
"<a/>" _xml-parse must 'elem tag xml-pretty "<a/>\n" eq assert

-- xml-pretty: nested
"<a><b><c>deep</c></b></a>" _xml-parse must 'elem tag xml-pretty
  "<a>\n  <b>\n    <c>deep</c>\n  </b>\n</a>\n" eq assert

-- xd-default-ns: missing xmlns → ""
"<a/>" xd-default-ns xd-run "" ok eq assert

-- xd-default-ns: present
"<feed xmlns=\"http://www.w3.org/2005/Atom\"/>" xd-default-ns xd-run
  "http://www.w3.org/2005/Atom" ok eq assert


-- ========== Malformed input returns 'no, never a crash ==========

"" _xml-parse xerr "xml: expected <" eq assert
"hello" _xml-parse xerr "xml: expected <" eq assert
"<a>" _xml-parse xerr "xml: unexpected end of input inside <a>" eq assert
"<a></b>" _xml-parse xerr "xml: expected </a> but found </b>" eq assert
"<a b=1/>" _xml-parse xerr "xml: attribute value must be quoted" eq assert
"<a b=\"1/>" _xml-parse xerr "xml: unterminated attribute value" eq assert
"<a b/>" _xml-parse xerr "xml: expected = after attribute b" eq assert
"<1/>" _xml-parse xerr "xml: a name cannot start with '1'" eq assert
"<a>&bogus;</a>" _xml-parse xerr "xml: unknown entity &bogus;" eq assert
"<a>&amp</a>" _xml-parse xerr "xml: unterminated entity" eq assert
"<a>&#xZZ;</a>" _xml-parse xerr "xml: bad digit in a numeric entity" eq assert
"<a><![CDATA[x</a>" _xml-parse xerr "xml: expected ]]> not found" eq assert
"<a><!-- x</a>" _xml-parse xerr "xml: expected --> not found" eq assert
"<a/><b/>" _xml-parse xerr "xml: trailing input after the root element" eq assert
list 300 ("<a>" cat) repeat _xml-parse xerr "xml: elements nested deeper than 256" eq assert
"<a/>" xd-text xd-run xerr "" eq assert
"<a>" xd-text xd-run xerr "xml: unexpected end of input inside <a>" eq assert

-- A numeric entity is a character, so it is UTF-8 encoded
"<a>&#8217;</a>" _xml-parse must 'children at 0 get must node-text list 226 push 128 push 153 push eq assert
"<a>&#0;</a>" _xml-parse xerr "xml: numeric entity is not a character" eq assert
