   24 'sl-a nth must -1.0 fmul 56 'sl-a nth must -38.0 fmul fplus 88 'sl-a nth must 225.0 fmul fplus 120 'sl-a nth must -645.0 fmul fplus 152 'sl-a nth must 1893.0 fmul fplus 184 'sl-a nth must -6237.0 fmul fplus 216 'sl-a nth must 4561.0 fmul fplus 248 'sl-a nth must -43006.0 fmul fplus 280 'sl-a nth must 74630.0 fmul fplus 312 'sl-a nth must 31947.0 fmul fplus 344 'sl-a nth must 8092.0 fmul fplus 376 'sl-a nth must 4063.0 fmul fplus 408 'sl-a nth must 2087.0 fmul fplus 440 'sl-a nth must 294.0 fmul fplus 472 'sl-a nth must 196.0 fmul fplus 504 'sl-a nth must 21.0 fmul fplus m3-pcm
   26 'sl-a nth must -1.0 fmul 58 'sl-a nth must -35.0 fmul fplus 90 'sl-a nth must 222.0 fmul fplus 122 'sl-a nth must -581.0 fmul fplus 154 'sl-a nth must 1952.0 fmul fplus 186 'sl-a nth must -5879.0 fmul fplus 218 'sl-a nth must 5288.0 fmul fplus 250 'sl-a nth must -41176.0 fmul fplus 282 'sl-a nth must 74856.0 fmul fplus 314 'sl-a nth must 33791.0 fmul fplus 346 'sl-a nth must 7640.0 fmul fplus 378 'sl-a nth must 4425.0 fmul fplus 410 'sl-a nth must 2080.0 fmul fplus 442 'sl-a nth must 347.0 fmul fplus 474 'sl-a nth must 202.0 fmul fplus 506 'sl-a nth must 24.0 fmul fplus m3-pcm
   28 'sl-a nth must -1.0 fmul 60 'sl-a nth must -31.0 fmul fplus 92 'sl-a nth must 218.0 fmul fplus 124 'sl-a nth must -519.0 fmul fplus 156 'sl-a nth must 2000.0 fmul fplus 188 'sl-a nth must -5517.0 fmul fplus 220 'sl-a nth must 5959.0 fmul fplus 252 'sl-a nth must -39336.0 fmul fplus 284 'sl-a nth must 74992.0 fmul fplus 316 'sl-a nth must 35640.0 fmul fplus 348 'sl-a nth must 7134.0 fmul fplus 380 'sl-a nth must 4788.0 fmul fplus 412 'sl-a nth must 2063.0 fmul fplus 444 'sl-a nth must 401.0 fmul fplus 476 'sl-a nth must 208.0 fmul fplus 508 'sl-a nth must 26.0 fmul fplus m3-pcm] cat sl-i 1 plus) while drop
 sy-h 576 drop-n) 'm3-synth let

-- m3-sgn: +1.0, or -1.0 at odd positions of odd bands.  The sign change after the IMDCT.
0 576 range (dup 18 div 1 band swap 1 band mul 1 eq (-1.0) (1.0) if) each 'm3-sgn let

-- m3-reorder: (x off sfb -- x').  Short blocks send their 3 windows in runs; from x[off] on, put the windows' values side by side per frequency.
('ro-sfb let 'ro-off let 'ro-x let
 ro-x ro-off drop-n m3-z576 cat 'ro-src let
 [] 0 0 (over 3 mul 'ro-sfb nth must 0 neq) ('ro-o let 'ro-j let
   ro-j 3 mul 'ro-sfb nth must 'ro-len let
   0 ro-len range ('i-i let [ro-o i-i plus 'ro-src nth must  ro-o ro-len plus i-i plus 'ro-src nth must  ro-o ro-len 2 mul plus i-i plus 'ro-src nth must]) each flatten cat
   ro-j 1 plus ro-o ro-len 3 mul plus) while drop drop 'ro-new let
 ro-x ro-off take-n ro-new cat ro-x ro-off ro-new len plus drop-n cat 576 take-n) 'm3-reorder let

-- m3-antialias: (x nb -- x').  Butterflies across the nb band edges, in place.
('aa-nb let 'aa-x let
 aa-nb 0 gt
  (aa-x 10 take-n 0 (dup aa-nb lt) ('aa-e let
     aa-e 18 mul 18 plus 'aa-b let
     [aa-b 7 plus 'aa-x nth must 0.00369997 fmul aa-b 8 sub 'aa-x nth must 0.99999316 fmul fplus
   aa-b 6 plus 'aa-x nth must 0.01419856 fmul aa-b 7 sub 'aa-x nth must 0.99989920 fmul fplus
   aa-b 5 plus 'aa-x nth must 0.04096558 fmul aa-b 6 sub 'aa-x nth must 0.99916056 fmul fplus
   aa-b 4 plus 'aa-x nth must 0.09457419 fmul aa-b 5 sub 'aa-x nth must 0.99551782 fmul fplus
   aa-b 3 plus 'aa-x nth must 0.18191320 fmul aa-b 4 sub 'aa-x nth must 0.98331459 fmul fplus
   aa-b 2 plus 'aa-x nth must 0.31337745 fmul aa-b 3 sub 'aa-x nth must 0.94962865 fmul fplus
   aa-b 1 plus 'aa-x nth must 0.47173197 fmul aa-b 2 sub 'aa-x nth must 0.88174200 fmul fplus
   aa-b 0 plus 'aa-x nth must 0.51449576 fmul aa-b 1 sub 'aa-x nth must 0.85749293 fmul fplus
   aa-b 0 plus 'aa-x nth must 0.85749293 fmul aa-b 1 sub 'aa-x nth must 0.51449576 fmul fsub
   aa-b 1 plus 'aa-x nth must 0.88174200 fmul aa-b 2 sub 'aa-x nth must 0.47173197 fmul fsub
   aa-b 2 plus 'aa-x nth must 0.94962865 fmul aa-b 3 sub 'aa-x nth must 0.31337745 fmul fsub
   aa-b 3 plus 'aa-x nth must 0.98331459 fmul aa-b 4 sub 'aa-x nth must 0.18191320 fmul fsub
   aa-b 4 plus 'aa-x nth must 0.99551782 fmul aa-b 5 sub 'aa-x nth must 0.09457419 fmul fsub
   aa-b 5 plus 'aa-x nth must 0.99916056 fmul aa-b 6 sub 'aa-x nth must 0.04096558 fmul fsub
   aa-b 6 plus 'aa-x nth must 0.99989920 fmul aa-b 7 sub 'aa-x nth must 0.01419856 fmul fsub
   aa-b 7 plus 'aa-x nth must 0.99999316 fmul aa-b 8 sub 'aa-x nth must 0.00369997 fmul fsub] cat
     aa-e 1 plus aa-nb lt ([aa-b 8 plus 'aa-x nth must aa-b 9 plus 'aa-x nth must] cat) () if
     aa-e 1 plus) while drop
   aa-x aa-nb 18 mul 8 plus drop-n cat)
  (aa-x) if) 'm3-antialias let

-- m3-post: (x ov bt nlb ns sfb -- x' ov').  One channel of one granule after stereo: reorder short blocks, antialias, IMDCT and sign change.
-- bt is the block type, nlb the number of leading long bands, ns the short band count (0 for long blocks) and sfb the band widths from the first short band.
('po-sfb let 'po-ns let 'po-nlb let 'po-bt let 'po-ov let 'po-x let
 po-x po-ns 0 neq (po-nlb 18 mul po-sfb m3-reorder) () if po-ns 0 neq (po-nlb 1 sub) (31) if m3-antialias 'po-a let
 [] [] 0 (dup 32 lt) ('po-b let 'po-on let 'po-out let
   po-a po-b 18 mul drop-n 18 take-n po-ov po-b 9 mul drop-n 9 take-n 'po-o let 'po-g let
   po-b po-nlb lt (po-g po-o m3-win0 m3-imd36) (
   po-bt 2 eq (po-g po-o m3-imds) (po-g po-o po-bt 3 eq (m3-win1) (m3-win0) if m3-imd36) if) if
   'po-no let 'po-ng let
   po-out po-ng cat po-on po-no cat po-b 1 plus) while drop 'po-ovn let 'po-xn let
 0 576 range (dup 'po-xn nth must swap 'm3-sgn nth must fmul) each po-ovn) 'm3-post let

-- m3-ms: (l r -- l' r').  Mid/side to left/right over the whole granule.
('ms-r let 'ms-l let
 0 576 range (dup 'ms-l nth must swap 'ms-r nth must fplus) each
 0 576 range (dup 'ms-l nth must swap 'ms-r nth must fsub) each) 'm3-ms let

-- m3-stereo: (l r ist sfb nl ns mpeg1 tms msh -- l' r' ist').  Intensity stereo, and mid/side in the bands that are not intensity.
-- sfb is the band widths ending in 0, nl and ns the long and short band counts, tms the header's MS bit, msh the right channel's scalefac_compress & 1.
('st-msh let 'st-tms let 'st-m1 let 'st-ns let 'st-nl let 'st-sfb let 'st-ist0 let 'st-r let 'st-l let
 st-nl st-ns plus 'st-n let
 st-ns 0 neq (3) (1) if 'st-mb let
 -- the highest band of each of the three windows that has a nonzero right value
 [-1 -1 -1] 0 0 (over st-n lt) ('st-o let 'st-i let
   st-i 'st-sfb nth must 'st-w let
   0 st-w range (st-o plus 'st-r nth must dup 0.0 fgt swap 0.0 flt or) each 0 (or) fold
   (st-i 3 mod st-i set must) () if
   st-i 1 plus st-o st-w plus) while drop drop 'st-mx0 let
 st-nl 0 neq (st-mx0 0 get must st-mx0 1 get must max st-mx0 2 get must max 'st-top let [st-top st-top st-top]) (st-mx0) if 'st-mx let
 -- the top bands take the default position, or the one three bands down
 st-ist0 0 (dup st-mb lt) ('st-k let
   st-n st-mb sub st-k plus 'st-itop let
   st-itop
   st-k 'st-mx nth must st-itop st-mb sub ge (st-m1 0 neq (3) (0) if) (st-itop st-mb sub 'st-ist0 nth must) if
   set must st-k 1 plus) while drop 'st-ist let
 st-m1 0 neq (7) (64) if 'st-maxpos let
 st-tms 0 neq (1.41421356) (1.0) if 'st-s let
 [] [] 0 0 (over 'st-sfb nth must 0 neq) ('st-o let 'st-i let
   st-i 'st-sfb nth must 'st-w let
   st-i 'st-ist nth must 'st-pos let
   st-i 3 mod 'st-mx nth must st-i lt st-pos st-maxpos lt and
   (st-m1 0 neq (st-pos 2 mul 'm3-pan nth must st-s fmul st-pos 2 mul 1 plus 'm3-pan nth must st-s fmul) (
     1.0 st-pos 1 plus 1 shr st-msh shl m3-ldexp 'st-kr let
     st-pos 1 band 1 eq (st-kr st-s fmul 1.0 st-s fmul) (1.0 st-s fmul st-kr st-s fmul) if) if 'st-b let 'st-a let
    0 st-w range (st-o plus 'st-l nth must st-a fmul) each
    0 st-w range (st-o plus 'st-l nth must st-b fmul) each)
   (st-tms 0 neq (
      0 st-w range (st-o plus dup 'st-l nth must swap 'st-r nth must fplus) each
      0 st-w range (st-o plus dup 'st-l nth must swap 'st-r nth must fsub) each) (
      0 st-w range (st-o plus 'st-l nth must) each
      0 st-w range (st-o plus 'st-r nth must) each) if) if
   'st-nr let 'st-nl2 let 'st-ar let 'st-al let
   st-al st-nl2 cat st-ar st-nr cat st-i 1 plus st-o st-w plus) while 'st-o3 let drop 'st-rr let 'st-ll let
 st-ll st-l st-o3 drop-n cat st-rr st-r st-o3 drop-n cat st-ist) 'm3-stereo let

-- m3-new: (-- S).  A decoder before its first frame. 'p is where the next frame is looked for, 'p0 where the played frames start, 'wn the file's length,
-- 'at the sample that the next frame starts at, 'from the first sample played, and 'n the bytes played in this call.
({'p 0 'p0 0 'wn 0 'hp -1 'ffb 0 'rsv [] 'ov m3-z576 'q m3-z576 m3-z576 cat 960 take-n 'ist m3-zi m3-zi cat 78 take-n
  'rate 0 'nch 0 'spf 0 'delay 0 'from 0 'frames -1 'pad 0 'first 0 'at 0 'n 0 'err ""}) 'm3-new let

-- m3-hna: (S -- msg).  Why a stream holds no audio.
('hn-s let
 hn-s 'frames at 'hn-f let
 hn-f 0 ge (hn-f hn-s 'spf at mul) (-1) if 'hn-tot let
 "mp3: holds no audio: expected at least 1 sample after the delay and padding are cut, received 0 of " hn-tot int-str cat " samples per channel (delay " cat hn-s 'delay at int-str cat ", padding " cat hn-s 'pad at int-str cat "); the stream holds only an Info frame or its LAME tag cuts all of it" cat) 'm3-hna let
-- m3-emp: (S -- int).  1 when the frames the decoder has passed hold no audio past the delay and before the padding. 'at is where the next frame starts, and a seek past the end moves it to the last frame's end.
('ep-s let ep-s 'at at 'ep-e let ep-s 'frames at 'ep-f let ep-f ep-s 'spf at mul ep-s 'pad at sub 'ep-t let
 ep-f 0 ge ep-t 0 gt and (ep-t ep-e min) (ep-e) if ep-s 'delay at le) 'm3-emp let

-- m3-go: (bytes S mode arg -- bytes S' res).  The one word behind mp3-open (mode 0), mp3-next (mode 1, arg sample frames wanted) and mp3-seek (mode 2, arg the sample frame).
-- It gives the bytes back, and res is "" ok, pcm ok or msg no.
('go-arg let 'go-mode let 'go-s let 'wb0 let
 go-mode 0 eq (wb0 len) (go-s 'wn at) if 'wn let
 wb0 0 32 range (drop 0) each cat 'wb let
 -- m3-at: (i n -- bytes).  n bytes of the file from i.
 ('at-n let 'at-i let at-i at-i at-n plus range ('wb nth must) each) 'm3-at let
 -- m3-le: (i n -- int).  n bytes from i, little-endian.
 ('le-n let 'le-i let 0 le-n range (le-i plus 'wb nth must) each reverse 0 (swap 8 shl swap bor) fold) 'm3-le let
 -- m3-be: (i n -- int).  n bytes from i, big-endian.
 ('be-n let 'be-i let 0 be-n range (be-i plus 'wb nth must) each 0 (swap 8 shl swap bor) fold) 'm3-be let
 -- The stream ends before an ID3v1 tag, and before an APE tag in front of that.
 -- dr_mp3 reads the APE tag's size from the footer's reserved bytes (offset 24), not its size field, so this does too.
 wn 128 gt (wn 128 sub 3 m3-at "TAG" eq) (0) if 128 mul wn swap sub 'we1 let
 we1 32 gt (we1 32 sub 8 m3-at "APETAGEX" eq) (0) if
   (we1 32 sub 24 plus 4 m3-le 'ape-n let 32 ape-n plus we1 lt (we1 32 sub ape-n sub) (we1) if) (we1) if 'we let
 -- an ID3v2 tag at the start is skipped
 0 3 m3-at "ID3" eq
   (6 'wb nth must 127 band 21 shl 7 'wb nth must 127 band 14 shl bor 8 'wb nth must 127 band 7 shl bor 9 'wb nth must 127 band bor
    5 'wb nth must 16 band 0 neq (10) (0) if plus 10 plus) (0) if 'ws let

 -- m3-hv: (p -- int).  Four bytes at p are a valid header.
 ('hv-p let
  hv-p 'wb nth must 255 eq
  hv-p 1 plus 'wb nth must 'hv-1 let hv-1 240 band 240 eq hv-1 254 band 226 eq or and
  hv-1 1 shr 3 band 0 neq and
  hv-p 2 plus 'wb nth must 'hv-2 let hv-2 4 shr 15 neq and
  hv-2 2 shr 3 band 3 neq and) 'm3-hv let
 -- m3-cmp: (a b -- int).  b is a valid header of the stream a belongs to.
 ('cm-b let 'cm-a let
  cm-b m3-hv
  cm-a 1 plus 'wb nth must cm-b 1 plus 'wb nth must bxor 254 band 0 eq and
  cm-a 2 plus 'wb nth must cm-b 2 plus 'wb nth must bxor 12 band 0 eq and
  cm-a 2 plus 'wb nth must 240 band 0 eq cm-b 2 plus 'wb nth must 240 band 0 eq eq and) 'm3-cmp let
 -- m3-pad: (p -- n).  The padding bytes of the frame at p.
 ('hp-p let hp-p 2 plus 'wb nth must 2 band 0 neq (hp-p 1 plus 'wb nth must 6 band 6 eq (4) (1) if) (0) if) 'm3-pad let
 -- m3-fb: (p ffb -- n).  The frame's bytes without padding; ffb when its bitrate is free.
 ('fb-f let 'fb-p let
  fb-p 1 plus 'wb nth must 'fb-1 let fb-p 2 plus 'wb nth must 'fb-2 let
  fb-1 1 shr 3 band 'fb-l let
  fb-l 3 eq (384) (fb-1 14 band 2 eq (576) (1152) if) if
  fb-1 8 band 0 neq (45) (0) if fb-l 1 sub 15 mul plus fb-2 4 shr plus 'm3-halfrate nth must 2 mul mul 125 mul
  fb-2 2 shr 3 band 'm3-hz nth must fb-1 8 band 0 eq fb-1 16 band 0 eq plus shr div
  fb-l 3 eq (dup 3 band sub) () if
  dup 0 eq (drop fb-f) () if) 'm3-fb let
 -- m3-match: (p mb fb -- int).  Up to 10 more headers follow p, a frame apart.
 ('mf-fb let 'mf-mb let 'mf-p let
  0 0 -1 (dup -1 eq) (drop 'mf-n let 'mf-i let
    mf-p mf-i plus 'mf-q let mf-q mf-fb m3-fb mf-q m3-pad plus mf-i plus 'mf-i2 let
    mf-i2 4 plus mf-mb gt
      (mf-n 0 gt)
      (mf-p mf-p mf-i2 plus m3-cmp not (0) (mf-n 9 ge (1) (-1) if) if) if
    'mf-r let mf-i2 mf-n 1 plus mf-r) while 'mf-res let drop drop mf-res) 'm3-match let
 -- m3-free: (q i mb -- fb fap ffb).  Look for the next header a frame away, for a header with a free bitrate.
 ('fs-mb let 'fs-i let 'fs-q let
  0 4 0 (dup 0 eq) (drop 'fs-k let 'fs-ffb let
    fs-k 2304 lt fs-i 2 fs-k mul plus fs-mb 4 sub lt and not (fs-ffb fs-k -1) (
      fs-q fs-q fs-k plus m3-cmp (
        fs-k fs-q m3-pad sub 'fs-fb let
        fs-fb fs-q fs-k plus m3-pad plus 'fs-nx let
        fs-i fs-k plus fs-nx plus 4 plus fs-mb gt  fs-q fs-q fs-k plus fs-nx plus m3-cmp not  or
          (fs-ffb fs-k 1 plus 0) (fs-fb fs-k fs-fb) if) (fs-ffb fs-k 1 plus 0) if) if) while
  'fs-fbr let 'fs-kr let 'fs-ffbr let
  fs-fbr -1 eq (0 fs-q m3-pad fs-ffbr) (fs-fbr fs-kr fs-ffbr) if) 'm3-free let
 -- m3-find: (p mb -- i fs ffb).  The first frame from p that the headers after it confirm; fs is 0 when none.
 ('ff-mb let 'ff-p let
  0 0 0 (dup 0 eq) (drop 'ff-ffb let 'ff-i let
    ff-i ff-mb 4 sub ge (ff-i ff-ffb -1) (
      ff-p ff-i plus 'ff-q let
      ff-q m3-hv (
        ff-q ff-ffb m3-fb 'ff-fb let
        ff-fb ff-q m3-pad plus 'ff-fap let
        ff-fb 0 eq (ff-q ff-i ff-mb m3-free) (ff-fb ff-fap ff-ffb) if
        'ff-ffb2 let 'ff-fap2 let 'ff-fb2 let
        ff-fb2 0 neq ff-i ff-fap2 plus ff-mb le and (ff-q ff-mb ff-i sub ff-fb2 m3-match) (0) if
          ff-i 0 eq ff-fap2 ff-mb eq and or
        (ff-i ff-ffb2 ff-fap2) (ff-i 1 plus 0 0) if) (ff-i 1 plus ff-ffb 0) if) if) while
  'ff-fs let 'ff-ffbr let 'ff-ir let
  ff-fs -1 eq (ff-mb 0 0) (ff-ir ff-fs ff-ffbr) if) 'm3-find let

 -- m3-sync: (p hp ffb -- i fs ffb' reset).  The next frame at or after p: its offset i from p and its bytes fs, 0 when none.
 -- A frame right after the last one needs only a header that fits the last and one that follows it. Anything else restarts the decoder (reset 1).
 ('sy-ffb let 'sy-hp let 'sy-p let
  we sy-p sub 'sy-mb let
  sy-mb 4 gt sy-hp 0 ge and (
    sy-hp sy-p m3-cmp (
      sy-p sy-ffb m3-fb sy-p m3-pad plus 'sy-fs let
      sy-fs sy-mb eq (sy-fs) (sy-fs 4 plus sy-mb gt (0) (sy-p sy-p sy-fs plus m3-cmp (sy-fs) (0) if) if) if) (0) if) (0) if 'sy-fs0 let
  sy-fs0 0 neq (0 sy-fs0 sy-ffb 0) (
    sy-p sy-mb m3-find 'sy-ffb2 let 'sy-f let 'sy-i let
    sy-f 0 eq sy-i sy-f plus sy-mb gt or (sy-mb 0 0 1) (sy-i sy-f sy-ffb2 1) if) if) 'm3-sync let

 -- rb: (ap n -- ap' v).  n bits at the absolute bit position ap, the position after them and the value.
 ('rb-n let 'rb-p let
  rb-p 3 shr 'rb-i let
  rb-i 'wb nth must 16 shl rb-i 1 plus 'wb nth must 8 shl bor rb-i 2 plus 'wb nth must bor
  24 rb-p 7 band sub rb-n sub shr 1 rb-n shl 1 sub band 'rb-v let
  rb-p rb-n plus rb-v) 'rb let

 -- m3-side: (p -- mdb grs bits).  The side information of the layer III frame at p: the main data begin (-1 when the frame is refused), the granule records and the bits the side information ends at, counted from the first byte after the header.
 ('sd-p let
  sd-p 1 plus 'wb nth must 'sd-h1 let sd-p 2 plus 'wb nth must 'sd-h2 let sd-p 3 plus 'wb nth must 'sd-h3 let
  sd-h1 8 band 0 neq 'sd-m1 let
  sd-h3 192 band 192 eq 'sd-mono let
  sd-mono (1) (2) if 'sd-nch let
  sd-h1 1 band 0 eq (16) (0) if sd-p 4 plus 8 mul plus 'sd-ap0 let
  sd-h2 2 shr 3 band sd-h1 3 shr 1 band sd-h1 4 shr 1 band plus 3 mul plus 'sd-mysr let
  sd-mysr sd-mysr 0 neq (1) (0) if sub 'sd-sri let
  sd-m1 (sd-nch 2 mul) (sd-nch) if 'sd-gc let
  sd-m1
    (sd-ap0 9 rb 'sd-mdb1 let sd-gc 7 plus rb 'sd-sf1 let sd-mdb1 sd-sf1)
    (sd-ap0 8 sd-gc plus rb sd-gc shr 0) if
  'sd-sf0 let 'sd-mdb let 'sd-apx let
  [] sd-apx sd-sf0 0 0 (dup sd-gc lt) ('sd-k let 'sd-bad let 'sd-sf let 'sd-ap let
    sd-mono (sd-sf 4 shl) (sd-sf) if 'sd-sfa let
    sd-ap 12 rb 'sd-p23 let 9 rb 'sd-big let 8 rb 'sd-gain let
    sd-m1 (4) (9) if rb 'sd-comp let
    1 rb 'sd-flag let
    sd-flag
      (2 rb 'sd-bt let 1 rb 'sd-mx let 10 rb 5 shl 'sd-tab let 3 rb 'sd-s0 let 3 rb 'sd-s1 let 3 rb 'sd-s2 let
       sd-bt sd-mx sd-tab sd-s0 sd-s1 sd-s2 sd-bt 2 eq sd-mx 0 eq and (8) (7) if 255)
      (15 rb 'sd-tab2 let 4 rb 'sd-r0 let 3 rb 'sd-r1 let 0 0 sd-tab2 0 0 0 sd-r0 sd-r1) if
    'g-r1 let 'g-r0 let 'g-s2 let 'g-s1 let 'g-s0 let 'g-tab let 'g-mx let 'g-bt let
    g-bt 2 eq (sd-sfa 3855 band) (sd-sfa) if 'sd-sfb let
    sd-m1 (1 rb) (sd-comp 500 ge) if 'g-pre let
    1 rb 'g-ss let 1 rb 'g-c1 let
    'g-ap let
    g-bt 2 eq
      (g-mx 0 eq (m3-sfbs sd-sri 40 mul drop-n 40 take-n 0 39) (m3-sfbm sd-sri 40 mul drop-n 40 take-n sd-m1 (8) (6) if 30) if)
      (m3-sfbl sd-sri 23 mul drop-n 23 take-n 22 0) if 'g-ns let 'g-nl let 'g-sfb let
    {'p23 sd-p23 'big sd-big 'gain sd-gain 'comp sd-comp 'bt g-bt 'mx g-mx 'nl g-nl 'ns g-ns
     'tsel [g-tab 10 shr g-tab 5 shr 31 band g-tab 31 band] 'rc [g-r0 g-r1] 'sbg [g-s0 g-s1 g-s2]
     'pre g-pre 'sscale g-ss 'c1 g-c1 'scfsi sd-sfb 12 shr 15 band 'sfb g-sfb} push
    g-ap sd-sfb 4 shl
    sd-bad sd-big 288 gt or sd-flag 1 eq g-bt 0 eq and or
    sd-k 1 plus) while
  drop 'sd-badf let drop 'sd-apf let 'sd-grs let
  sd-badf (-1) (sd-mdb) if sd-grs sd-apf sd-p 4 plus 8 mul sub) 'm3-side let

 -- m3-frame: (S p fs -- S' ok pcm).  Decode the layer III frame at p, fs bytes long: the new decoder state, whether it gave audio, and the audio as bytes.
 ('fr-fs let 'fr-p let 'fr-s let
  fr-p m3-side 'fr-pos let 'fr-grs let 'fr-mdb let
  fr-p 1 plus 'wb nth must 'fr-h1 let fr-p 2 plus 'wb nth must 'fr-h2 let fr-p 3 plus 'wb nth must 'fr-h3 let
  fr-h1 8 band 0 neq 'fr-m1 let
  fr-h3 192 band 192 eq (1) (2) if 'fr-nch let
  fr-h3 16 band 0 neq 'fr-ist let
  fr-h3 224 band 96 eq 'fr-ms let
  fr-h3 32 band 0 neq 'fr-tms let
  fr-h2 2 shr 3 band fr-h1 3 shr 1 band fr-h1 4 shr 1 band plus 3 mul plus 'fr-mysr let
  fr-fs 4 sub 8 mul 'fr-lim let
  fr-grs 0 ('p23 at plus) fold 'fr-sum let
  fr-mdb 0 lt fr-pos fr-lim gt or fr-sum fr-pos plus fr-lim fr-mdb 8 mul plus gt or
  (fr-s -1 'hp into 0 []) (
   fr-s 'rsv at 'fr-rsv let
   fr-rsv len 'fr-rn let
   fr-rn fr-mdb min 'fr-have let
   fr-lim fr-pos sub 8 div 'fr-fbm let
   fr-rsv fr-rn fr-have sub drop-n fr-p 4 plus fr-pos 8 div plus fr-fbm m3-at cat 'fr-md let
   fr-have fr-fbm plus 8 mul 'fr-mlim let
   fr-md 0 4 range (drop 0) each cat 'fr-md2 let
   0 fr-md2 len 2 sub range ('i-i let i-i 'fr-md2 nth must 16 shl i-i 1 plus 'fr-md2 nth must 8 shl bor i-i 2 plus 'fr-md2 nth must bor) each 'fr-m24 let
   fr-m24 len 1 sub 'fr-m24n let

   -- fr-pk: (p w -- v).  w bits at bit p of the main data.
   ('pk-w let 'pk-p let
    pk-p 3 shr fr-m24n min 'fr-m24 nth must 24 pk-p 7 band sub pk-w sub shr 1 pk-w shl 1 sub band) 'fr-pk let
   -- fr-bits: (p n -- v).  As fr-pk, 0 past the end of the main data.
   ('b-n let 'b-p let b-p b-n plus fr-mlim gt (0) (b-p b-n fr-pk) if) 'fr-bits let
   -- fr-rd: (p bits cnt -- p' list).  cnt fields of the given width.
   ('rd-cnt let 'rd-bits let 'rd-p let
    [] rd-p 0 (dup rd-cnt lt) ('rd-k let 'rd-q let rd-q rd-bits fr-bits push rd-q rd-bits plus rd-k 1 plus) while drop swap) 'fr-rd let

   -- fr-scf: (bp gr ch ist -- bp' scf ist').  Read one channel's scale factors; scf holds the gain of each band, ist the 39 intensity positions.
   ('sf-ist let 'sf-ch let 'sf-gr let 'sf-bp let
    sf-gr 'nl at 'sf-nl let sf-gr 'ns at 'sf-ns let sf-gr 'comp at 'sf-comp let sf-gr 'gain at 'sf-gain let
    sf-gr 'pre at 'sf-pre let sf-gr 'sscale at 'sf-ss let sf-gr 'sbg at 'sf-sbg let sf-gr 'scfsi at 'sf-scfsi1 let
    sf-ss 1 plus 'sf-sh let
    sf-ns 0 neq (1) (0) if sf-nl 0 eq (1) (0) if plus 28 mul 'sf-row let
    fr-m1
      (sf-comp 'm3-scfc nth must 'sf-part let
       [sf-part 2 shr sf-part 2 shr sf-part 3 band sf-part 3 band] sf-row sf-scfsi1)
      (fr-ist sf-ch 0 neq and (1) (0) if 'sf-i2 let
       sf-comp sf-i2 shr sf-i2 12 mul
       (over 0 ge) ('sf-k let 'sf-sfc let
          sf-k 'm3-mod nth must sf-k 1 plus 'm3-mod nth must mul sf-k 2 plus 'm3-mod nth must mul sf-k 3 plus 'm3-mod nth must mul 'sf-mp let
          sf-sfc sf-mp sub sf-k 4 plus) while 'sf-kf let 'sf-sfcf let
       sf-kf 4 sub 'sf-kl let
       sf-kl 'm3-mod nth must 'sf-m0 let sf-kl 1 plus 'm3-mod nth must 'sf-m1b let sf-kl 2 plus 'm3-mod nth must 'sf-m2 let sf-kl 3 plus 'm3-mod nth must 'sf-m3 let
       sf-sfcf sf-m0 sf-m1b mul sf-m2 mul sf-m3 mul plus 'sf-sl let
       [sf-sl sf-m1b sf-m2 mul sf-m3 mul div sf-m0 mod  sf-sl sf-m2 sf-m3 mul div sf-m1b mod  sf-sl sf-m3 div sf-m2 mod  sf-sl sf-m3 mod]
       sf-row sf-kf plus -16) if
    'sf-fl0 let 'sf-off let 'sf-sizes let
    [] [] sf-bp sf-fl0 0 (dup 4 lt) ('sf-gi let 'sf-fl let 'sf-p let 'sf-n let 'sf-a let
       sf-gi sf-off plus 'm3-parts nth must 'sf-cnt let
       sf-cnt 0 eq (sf-a sf-n sf-p sf-fl 4) (
         sf-a len 'sf-pos let
         sf-fl 8 band 0 neq
           (sf-ist sf-pos drop-n sf-cnt take-n 'sf-grpa let sf-a sf-grpa cat sf-n sf-grpa cat sf-p)
           (sf-gi 'sf-sizes nth must 'sf-bits let
            sf-bits 0 eq
              (0 sf-cnt range (drop 0) each 'sf-grpb let sf-a sf-grpb cat sf-n sf-grpb cat sf-p)
              (sf-p sf-bits sf-cnt fr-rd 'sf-grpc let 'sf-p2 let
               sf-fl 0 lt (1 sf-bits shl 1 sub) (-1) if 'sf-max let
               sf-a sf-grpc cat sf-n sf-grpc (dup sf-max eq (drop 255) () if) each cat sf-p2) if) if
         sf-fl 2 mul sf-gi 1 plus) if) while
    drop drop 'sf-bp2 let 'sf-newn let 'sf-iscf0 let
    sf-iscf0 m3-zi cat 45 take-n 'sf-iscf1 let
    sf-ns 0 neq
      (0 45 range ('j-j let j-j 'sf-iscf1 nth must j-j sf-nl ge j-j sf-nl sf-ns plus lt and
         (j-j sf-nl sub 3 mod 'sf-sbg nth must 3 sf-sh sub shl plus 255 band) () if) each)
      (sf-pre 0 neq
        (0 45 range ('j-j let j-j 'sf-iscf1 nth must j-j 11 ge j-j 21 lt and (j-j 11 sub 'm3-preamp nth must plus 255 band) () if) each)
        (sf-iscf1) if) if 'sf-iscf let
    fr-ms (2) (0) if 'sf-ms2 let
    2048.0 44 sf-gain 214 sub sf-ms2 sub sub m3-ldexp 'sf-g let
    0 sf-nl sf-ns plus range ('j-j let sf-g j-j 'sf-iscf nth must sf-sh shl m3-ldexp) each m3-z576 45 take-n cat
    sf-newn sf-ist sf-newn len drop-n cat 39 take-n
    'sf-istr let 'sf-scfr let sf-bp2 sf-scfr sf-istr) 'fr-scf let

   -- fr-val: (p lsb lb one -- p' v).  One value of a pair, its sign bit and linbits read.
   ('vl-one let 'vl-lb let 'vl-lsb let 'vl-p let
    vl-lsb 15 eq vl-lb 0 neq and
      (vl-p vl-lb fr-pk 15 plus 'vl-x let
       vl-p vl-lb plus 'vl-p2 let
       vl-p2 1 plus vl-x m3-pow43 vl-one fmul vl-p2 1 fr-pk 0 neq (fneg) () if)
      (vl-lsb 0 eq (vl-p 0.0) (
         vl-p 1 plus vl-lsb 'm3-p43 nth must vl-one fmul vl-p 1 fr-pk 0 neq (fneg) () if) if) if) 'fr-val let
   -- fr-pair: (dst p cb lb one -- dst' p').  Decode one pair of big values and push it on dst.
   ('pr-one let 'pr-lb let 'pr-cb let 'pr-p let 'pr-dst let
    pr-p 5 pr-cb pr-p 5 fr-pk plus 'm3-tabs nth must
    (dup 0 lt) ('pr-l let 'pr-w let 'pr-q let
       pr-q pr-w plus 'pr-q2 let pr-l 7 band 'pr-w2 let
       pr-q2 pr-w2 pr-cb pr-q2 pr-w2 fr-pk plus 7 pr-l sub 3 shr plus 'm3-tabs nth must) while
    'pr-leaf let drop 'pr-p1 let
    pr-p1 pr-leaf 8 shr plus pr-leaf 15 band pr-lb pr-one fr-val 'pr-v0 let
    pr-leaf 4 shr 15 band pr-lb pr-one fr-val 'pr-v1 let
    pr-dst pr-v0 push pr-v1 push swap) 'fr-pair let
   -- fr-dq: (p leaf bit one -- p' v).  One value of a count1 quad.
   ('dq-one let 'dq-bit let 'dq-leaf let 'dq-p let
    dq-leaf dq-bit band 0 neq (dq-p 1 plus dq-p 1 fr-pk 0 neq (dq-one fneg) (dq-one) if) (dq-p 0.0) if) 'fr-dq let

   -- fr-huf: (bp gr scf limit -- xr).  Decode one channel's 576 values from bit bp to bit limit.
   ('hf-lim let 'hf-scf let 'hf-gr let 'hf-bp let
    hf-gr 'sfb at 'hf-sfb let hf-gr 'tsel at 'hf-tsel let hf-gr 'rc at 'hf-rc let
    0 'hf-rc nth must 1 plus 'hf-e0 let
    hf-e0 1 'hf-rc nth must 1 plus plus 'hf-e1 let
    hf-gr 'c1 at 28 mul 'hf-co let
    -- reload: (np b one -- np' b' one' stop).  Count1 values take the next band's gain when the band is used up.
    ('rl-one let 'rl-b let 'rl-np let
     rl-np 1 sub 'rl-n1 let
     rl-n1 0 eq
       (rl-b 'hf-sfb nth must 2 div 'rl-n2 let
        rl-n2 0 eq (0 rl-b rl-one 1) (rl-n2 rl-b 1 plus rl-b 'hf-scf nth must 0) if)
       (rl-n1 rl-b rl-one 0) if) 'hf-reload let
    -- the big values: dst p one b remaining
    [] hf-bp 0.0 0 hf-gr 'big at (dup 0 gt) ('hf-bc let 'hf-b let 'hf-one0 let 'hf-p let
       hf-b 'hf-sfb nth must 2 div 'hf-np let
       hf-np 0 eq (hf-p hf-one0 hf-b) (
         hf-bc hf-np min 'hf-pairs let
         hf-b 'hf-scf nth must 'hf-one let
         hf-b hf-e0 lt (0 'hf-tsel nth must) (hf-b hf-e1 lt (1 'hf-tsel nth must) (2 'hf-tsel nth must) if) if 'hf-t let
         hf-t 'm3-tabindex nth must 'hf-cb let hf-t 'm3-linbits nth must 'hf-lb let
         hf-p 0 (dup hf-pairs lt) ('hf-k let hf-cb hf-lb hf-one fr-pair hf-k 1 plus) while drop
         hf-one hf-b 1 plus) if
       hf-np 0 eq (0) (hf-bc hf-np sub) if) while
    'hf-bcf let 'hf-bf let 'hf-onef let 'hf-pf let
    -- the count1 quads: dst p np b one go
    hf-pf 1 hf-bcf sub hf-bf hf-onef 1 (dup 0 neq) (drop 'hq-one let 'hq-b let 'hq-np let 'hq-p let
       dup len 576 lt (
         hq-p 4 fr-pk hf-co plus 'm3-c1 nth must 'hq-l0 let
         hq-l0 8 band 0 eq (hf-co hq-l0 3 shr plus hq-p 4 plus hq-l0 3 band fr-pk plus 'm3-c1 nth must) (hq-l0) if 'hq-leaf let
         hq-p hq-leaf 7 band plus 'hq-p1 let
         hq-p1 hf-lim gt (hq-p1 hq-np hq-b hq-one 0) (
           hq-np hq-b hq-one hf-reload 'hq-s1 let 'hq-one1 let 'hq-b1 let 'hq-np1 let
           hq-s1 1 eq (hq-p1 hq-np1 hq-b1 hq-one1 0) (
             hq-p1 hq-leaf 128 hq-one1 fr-dq 'hq-v0 let 'hq-p2 let
             hq-p2 hq-leaf 64 hq-one1 fr-dq 'hq-v1 let 'hq-p3 let
             hq-v0 push hq-v1 push
             hq-np1 hq-b1 hq-one1 hf-reload 'hq-s2 let 'hq-one2 let 'hq-b2 let 'hq-np2 let
             hq-s2 1 eq (hq-p3 hq-np2 hq-b2 hq-one2 0) (
               hq-p3 hq-leaf 32 hq-one2 fr-dq 'hq-v2 let 'hq-p4 let
               hq-p4 hq-leaf 16 hq-one2 fr-dq 'hq-v3 let 'hq-p5 let
               hq-v2 push hq-v3 push hq-p5 hq-np2 hq-b2 hq-one2 1) if) if) if)
       (hq-p hq-np hq-b hq-one 0) if) while
    drop drop drop drop drop m3-z576 cat 576 take-n) 'fr-huf let

   -- fr-gran: (G gi -- G').  Decode granule gi: both channels' values, stereo, IMDCT and synthesis; G is {'bp 'ist 'ov 'q 'pcm}.
   ('gn-gi let 'gn-g let
    gn-gi fr-nch mul 'gn-base let
    -- gn-chan: (G ch -- G' xr).  Scale factors and values of one channel.
    ('ch-ch let 'ch-g let
     ch-g 'bp at 'ch-bp let
     gn-base ch-ch plus 'fr-grs nth must 'ch-gr let
     ch-bp ch-gr 'p23 at plus 'ch-lim let
     ch-g 'ist at ch-ch 39 mul drop-n 39 take-n 'ch-ist0 let
     ch-bp ch-gr ch-ch ch-ist0 fr-scf 'ch-ist1 let 'ch-scf let 'ch-bp2 let
     ch-bp2 ch-gr ch-scf ch-lim fr-huf 'ch-xr let
     ch-g 'ist at ch-ch 39 mul take-n ch-ist1 cat ch-g 'ist at ch-ch 1 plus 39 mul drop-n cat 'ch-ist2 let
     ch-g ch-lim 'bp into ch-ist2 'ist into ch-xr) 'gn-chan let
    gn-g 0 gn-chan 'gn-xr0 let 'gn-g1 let
    fr-nch 2 eq (gn-g1 1 gn-chan) (gn-g1 m3-z576) if 'gn-xr1 let 'gn-g2 let
    gn-base 'fr-grs nth must 'gn-gr0 let
    gn-base fr-nch 1 sub plus 'fr-grs nth must 'gn-gr1 let
    gn-g2 'ist at 39 drop-n 39 take-n 'gn-ist1 let
    fr-ist
      (gn-xr0 gn-xr1 gn-ist1 gn-gr0 'sfb at gn-gr0 'nl at gn-gr0 'ns at fr-m1 fr-tms gn-gr1 'comp at 1 band m3-stereo)
      (fr-ms (gn-xr0 gn-xr1 m3-ms) (gn-xr0 gn-xr1) if gn-ist1) if
    'gn-ist1b let 'gn-xr1b let 'gn-xr0b let
    gn-g2 'ov at 'gn-ov let gn-g2 'q at 'gn-q let
    -- gn-post: (xr gr ch -- xr' ov'), then the synthesis with the saved rows q
    ('po2-ch let 'po2-gr let 'po2-x let
     po2-gr 'mx at (2) (0) if fr-mysr 2 eq (1 shl) () if 'po2-nlb let
     po2-x gn-ov po2-ch 288 mul drop-n 288 take-n po2-gr 'bt at po2-nlb po2-gr 'ns at po2-gr 'sfb at po2-gr 'nl at drop-n m3-post) 'gn-post let
    gn-xr0b gn-gr0 0 gn-post 'gn-ov0 let 'gn-xo0 let
    gn-xo0 gn-q 480 take-n m3-synth 'gn-q0 let 'gn-s0 let
    fr-nch 2 eq
      (gn-xr1b gn-gr1 1 gn-post 'gn-ov1 let 'gn-xo1 let
       gn-xo1 gn-q 480 drop-n m3-synth 'gn-q1 let 'gn-s1 let gn-s1 gn-q0 gn-q1 gn-ov1)
      (gn-s0 gn-q0 gn-q 480 drop-n gn-ov 288 drop-n) if
    'gn-ov1x let 'gn-q1x let 'gn-q0x let 'gn-s1x let
    gn-g2 gn-g2 'ist at 39 take-n gn-ist1b cat 'ist into
    gn-ov0 gn-ov1x cat 'ov into gn-q0x gn-q1x cat 'q into
    'gn-g3 let
    0 576 range gn-g3 'pcm at
      ('pc-i let
       pc-i 'gn-s0 nth must 'pc-l let
       pc-i 'gn-s1x nth must 'pc-r let
       pc-l 255 band push pc-l 8 shr 255 band push pc-r 255 band push pc-r 8 shr 255 band push) fold
    gn-g3 swap 'pcm into) 'fr-gran let

   -- the granules, when the reservoir holds the main data begin
   fr-rn fr-mdb ge
     ({'bp 0 'ist fr-s 'ist at 'ov fr-s 'ov at 'q fr-s 'q at 'pcm []}
      0 (dup fr-m1 (2) (1) if lt) ('gi-i let gi-i fr-gran gi-i 1 plus) while drop)
     ({'bp 0 'ist fr-s 'ist at 'ov fr-s 'ov at 'q fr-s 'q at 'pcm []}) if
   'fr-gf let
   -- the reservoir for the next frame: what the last granule left unread, and at most 511 bytes
   fr-gf 'bp at 7 plus 8 div 'fr-rp0 let
   fr-have fr-fbm plus fr-rp0 sub 'fr-rem0 let
   fr-rem0 511 gt (fr-rp0 fr-rem0 511 sub plus 511) (fr-rp0 fr-rem0 0 max) if 'fr-rem let 'fr-rp let
   fr-s fr-md fr-rp drop-n fr-rem take-n 'rsv into
   fr-rn fr-mdb ge
     (fr-gf 'ist at 'ist into fr-gf 'ov at 'ov into fr-gf 'q at 'q into fr-p 'hp into 1 fr-gf 'pcm at)
     (fr-p 'hp into 0 []) if) if) 'm3-frame let

 -- m3-xing: (S fp fs -- S' tag).  Is the first frame a Xing or Info tag? If so, tag is 1 and S holds the encoder delay, padding and frame count it names.
 -- A tag that is cut short in the middle is not a tag, but a frame count read before the cut stays.
 ('xg-fs let 'xg-p let 'xg-s let
  xg-p m3-side 'xg-pos let drop drop
  xg-p 4 plus xg-pos 8 div plus 'xg-beg let
  -- xg-skip: (alive cur n -- alive' cur').  Step over n bytes when the frame holds them.
  ('sk-n let 'sk-c let 'sk-a let
   sk-a xg-fs sk-c xg-p sub sk-n plus ge and (1 sk-c sk-n plus) (0 sk-c) if) 'xg-skip let
  xg-fs xg-beg xg-p sub 8 plus lt (xg-s 0) (
    xg-beg 4 m3-at 'xg-id let
    xg-id "Xing" eq xg-id "Info" eq or not (xg-s 0) (
      xg-beg 7 plus 'wb nth must 'xg-fl let
      1 xg-beg 8 plus xg-fl 1 band 0 neq (4 xg-skip) () if 'xg-c1 let 'xg-a1 let
      xg-a1 xg-fl 1 band 0 neq and (xg-c1 4 sub 4 m3-be) (-1) if 'xg-frames let
      xg-a1 xg-c1 xg-fl 2 band 0 neq (4 xg-skip) () if 'xg-c2 let 'xg-a2 let
      xg-a2 xg-c2 xg-fl 4 band 0 neq (100 xg-skip) () if 'xg-c3 let 'xg-a3 let
      xg-a3 xg-c3 xg-fl 8 band 0 neq (4 xg-skip) () if 'xg-c4 let 'xg-a4 let
      xg-a4 xg-fs xg-c4 xg-p sub 1 plus ge and 'xg-a5 let
      xg-s xg-frames 'frames into 'xg-s1 let
      xg-a5 0 eq (xg-s1 0) (
        xg-c4 'wb nth must 0 eq (xg-s1 1) (
          xg-fs xg-c4 xg-p sub 36 plus lt (xg-s1 0) (
            xg-c4 21 plus 'xg-lc let
            xg-lc 'wb nth must 4 shl xg-lc 1 plus 'wb nth must 4 shr bor 529 plus 'xg-dl let
            xg-lc 1 plus 'wb nth must 15 band 8 shl xg-lc 2 plus 'wb nth must bor 529 sub 0 max 'xg-pd let
            xg-s1 xg-dl 'delay into xg-pd 'pad into 1) if) if) if) if) if) 'm3-xing let

 -- m3-hzp: (p -- hz).  The sample rate of the frame at p.
 ('hz-p let hz-p 1 plus 'wb nth must 'hz-1 let hz-p 2 plus 'wb nth must 2 shr 3 band 'm3-hz nth must hz-1 8 band 0 eq hz-1 16 band 0 eq plus shr) 'm3-hzp let

 -- m3-lay: (fp -- msg).  The refusal for the frame at fp when it is not layer 3.
 ('ly-p let "mp3: layer " 4 ly-p 1 plus 'wb nth must 1 shr 3 band sub int-str cat " frame at byte " cat ly-p int-str cat "; mp3-decode reads layer 3" cat) 'm3-lay let
 -- m3-none: (-- msg).  The refusal when no frame is played.
 ("mp3: not an MP3 stream: no header repeats at its frame length in the " we ws sub 0 max int-str cat " bytes from byte " cat ws int-str cat) 'm3-none let
 -- m3-main: (fp fs -- bytes).  The main data of the frame at fp, which is fs bytes long.
 ('mn-fs let 'mn-p let
  mn-p m3-side 'mn-bits let drop drop
  mn-bits 3 shr 4 plus 'mn-o let
  mn-p mn-o plus mn-fs mn-o sub 0 max m3-at) 'm3-main let
 -- m3-emit: (out S pcm -- out' S').  Append the part of a frame's samples that lies in [from, lim) to out. The frame starts at sample 'at.
 ('em-pcm let 'em-s let
  em-s 'at at 'em-a let
  em-a em-pcm len 2 shr plus 'em-b let
  em-a em-s 'delay at max em-s 'from at max 'em-lo let
  em-s 'frames at 'em-f let em-f em-s 'spf at mul 'em-t let em-s 'pad at 'em-pd let
  em-f 0 ge em-t em-pd gt and (em-t em-pd sub em-b min) (em-b) if 'em-hi let
  em-lo em-a eq em-hi em-b eq and
    (em-pcm)
    (em-lo em-hi lt (em-pcm em-lo em-a sub 2 shl drop-n em-hi em-lo sub 2 shl take-n) ("") if) if cat
  em-s em-b 'at into (em-hi em-lo sub 0 max 2 shl plus) 'n edit) 'm3-emit let

 -- m3-loop: (out S want upto -- out' S').  Decode frames while fewer than want bytes of audio are in this call's out and the next frame starts before sample upto (-1: no bound).
 ('lp-up let 'lp-want let
  1
 (dup 0 neq) (drop 'dr-s let
   dr-s 'p at dr-s 'hp at dr-s 'ffb at m3-sync 'dr-reset let 'dr-ffb let 'dr-fs let 'dr-i let
   dr-reset 1 eq (dr-s -1 'hp into m3-z576 'ov into m3-z576 m3-z576 cat 960 take-n 'q into m3-zi m3-zi cat 78 take-n 'ist into [] 'rsv into) (dr-s) if
   dr-ffb 'ffb into 'dr-s0 let
   dr-fs 0 eq (dr-s0 we 'p into 0) (
     dr-s 'p at dr-i plus 'dr-fp let
     dr-fp 1 plus 'wb nth must 1 shr 3 band 1 neq
       (dr-s0 dr-fp m3-lay 'err into 0)
       (dr-s0 dr-fp dr-fs plus 'p into dr-fp 'hp into dr-fp dr-fs m3-frame 'dr-pcm let 'dr-ok let 'dr-s1 let
        dr-fp 3 plus 'wb nth must 192 band 192 eq (1) (2) if 'dr-ch let
        dr-ok 0 eq (dr-s1 1) (
          dr-s1 'first at 0 neq dr-s1 'nch at dr-ch neq and
          (dr-s1 "mp3: the frame at byte " dr-fp int-str cat " has " cat dr-ch int-str cat " channel" cat dr-ch 1 neq ("s") ("") if cat "; the first frame has " cat dr-s1 'nch at int-str cat " and a stream keeps its channel count" cat 'err into 0) (
          dr-s1 'first at 0 eq
            (dr-s1 1 'first into dr-ch 'nch into dr-fp m3-hzp 'rate into dr-fp 1 plus 'wb nth must 8 band 0 neq (1152) (576) if 'spf into
             dr-s 'p at dr-i dr-fs plus m3-xing 'dr-tag let 'dr-s2 let
             dr-tag 1 eq (dr-s2 -1 'hp into 1) (dr-s2 dr-pcm m3-emit 1) if)
            (dr-s1 dr-pcm m3-emit 1) if) if) if) if) if
   -- the limits: the string a result holds, the wanted bytes, the bound
   'lm-go let 'lm-s let
   lm-s 'n at 'lm-n let
   lm-n 1073741824 gt
     (lm-s "mp3: decodes to more than 1073741824 bytes of audio, the most a string holds" 'err into 0)
     (lm-s lm-go lm-n lp-want lt and lp-up 0 lt lm-s 'at at lp-up lt or and) if) while drop) 'm3-loop let

 -- m3-seek: (S f -- S').  Place the decoder so that the next chunk starts at sample f of the audio.
 ('sk-f let 'sk-s let
  -- 2^60 bounds the sum: a frame far past the end must clamp to the end, not wrap around
  sk-s 'delay at sk-f 0 max 1152921504606846976 min plus 'sk-t let
  sk-s 'spf at 'sk-spf let
  sk-t sk-spf div 'sk-n let
  -- walk the headers up to frame sk-n, as fp fs ffb triples, and note the last frame that restarts the decoder
  [] sk-s 'p0 at -1 0 0 0 1
  (dup 0 neq) (drop 'wk-r let 'wk-k let 'wk-ffb let 'wk-hp let 'wk-p let
    wk-p wk-hp wk-ffb m3-sync 'wk-reset let 'wk-ffb2 let 'wk-fs let 'wk-i let
    wk-p wk-i plus 'wk-fp let
    wk-fs 0 eq wk-fp 1 plus 'wb nth must 1 shr 3 band 1 neq or
      (wk-p wk-hp wk-ffb wk-k wk-r 0)
      (wk-fp push wk-fs push wk-ffb2 push wk-fp wk-fs plus wk-fp wk-ffb2 wk-k 1 plus wk-reset 1 eq (wk-k) (wk-r) if wk-k sk-n lt) if) while
  drop 'sk-r let 'sk-k let drop drop drop 'sk-l let
  sk-k sk-n le
    (sk-s we 'p into -1 'hp into 1 'first into sk-k sk-spf mul 'at into)
    (sk-r sk-n 2 sub max 'sk-a let
     -- the decoder restarts two frames before sk-f: the second granule before it fixes the overlap and the filter rows
     sk-a 0 eq
       (sk-s sk-s 'p0 at 'p into -1 'hp into 0 'ffb into)
       (sk-a 1 sub 3 mul 'sk-b let
        sk-b 'sk-l nth must sk-b 1 plus 'sk-l nth must plus 'sk-pe let
        sk-s sk-pe 'p into sk-b 'sk-l nth must 'hp into sk-b 2 plus 'sk-l nth must 'ffb into) if
     -- the reservoir: the main data of the frames before it, 511 bytes at most
     sk-a 1 sub [] (over sk-r ge over len 511 lt and) (swap 'rg-j let rg-j 3 mul 'sk-l nth must rg-j 3 mul 1 plus 'sk-l nth must m3-main swap cat rg-j 1 sub swap) while swap drop
     dup len 511 sub 0 max drop-n 'rsv into
     m3-new 'ov at 'ov into m3-new 'q at 'q into m3-new 'ist at 'ist into
     sk-a sk-spf mul 'at into 4611686018427387904 'from into 0 'n into
     sk-a sk-n lt
       ([] swap 4611686018427387904 sk-n sk-spf mul m3-loop swap drop)
       () if
     sk-t 'from into 0 'n into 1 'first into) if) 'm3-seek let

 go-mode 0 eq
  (wn 10 lt (go-s "mp3: not an MP3 stream: " wn int-str cat " bytes; the ID3 check alone reads 10" cat no) (
   go-s ws 'p into 'op-s let
   ws -1 0 m3-sync drop 'op-ffb let 'op-fs let 'op-i let
   op-fs 0 eq (go-s m3-none no) (
    ws op-i plus 'op-fp let
    op-fp 1 plus 'wb nth must 1 shr 3 band 1 neq (go-s op-fp m3-lay no) (
     op-s op-fp 3 plus 'wb nth must 192 band 192 eq (1) (2) if 'nch into op-fp m3-hzp 'rate into
       op-fp 1 plus 'wb nth must 8 band 0 neq (1152) (576) if 'spf into wn 'wn into ws op-i op-fs plus m3-xing
     (op-fp op-fs plus 'p into -1 'hp into op-ffb 'ffb into 1 'first into) () if
     dup 'p at 'p0 into "" ok) if) if) if)
  (go-mode 1 eq
   ([] go-s 0 'n into go-arg 4 mul -1 m3-loop 'lp-s let 'lp-out let
    lp-s 'err at len 0 neq (lp-s lp-s 'err at no) (
     lp-s 'first at 0 eq (lp-s m3-none no) (
      lp-out len 0 eq lp-s m3-emp and (lp-s dup m3-hna no) (lp-s lp-out ok) if) if) if)
   (go-s go-arg m3-seek "" ok) if) if
 'go-res let 'go-sf let wb0 go-sf go-res) 'm3-go let

-- mp3-open: (bytes -- bytes res).  res is dec ok, or msg no. dec holds the decoder's state and no bytes of the file.
(m3-new 0 0 m3-go {'ok (drop ok) 'no (nip no)} case) 'mp3-open let
-- mp3-next: (bytes dec -- bytes dec chunk).  chunk is the next frames' pcm, about 8192 sample frames, ok; "" ok after the last; msg no when the stream fails.
(1 8192 m3-go) 'mp3-next let
-- mp3-seek: (bytes dec frame -- bytes dec).  The next chunk starts at that sample frame, or at the end past it.
(2 swap m3-go {'ok (drop) 'no (fail)} case) 'mp3-seek let
-- m3-fin: (S pcm -- res).  The result of a whole decode, or why there is no audio.
('fn-pcm let 'fn-s let fn-pcm len 0 eq (fn-s m3-hna no) ({'rate fn-s 'rate at 'pcm fn-pcm} ok) if) 'm3-fin let
(m3-new 0 0 m3-go {'ok (drop 1 1152921504606846976 m3-go {'ok (rot drop m3-fin) 'no (nip swap drop no)} case) 'no (nip swap drop no)} case) 'mp3-decode let
-- ===== tests =====
-- mt-hex: (str -- bytes).  Hex text, white space ignored, as bytes.
((32 gt) filter 2 0 m3-hex) 'mt-hex let
(mp3-decode {'ok (drop "") 'no ()} case) 'mt-err let
-- mt-fp: (bytes -- int).  h = h * 31 + byte over the bytes, modulo 2^32.
(0 (swap 31 mul plus 4294967295 band) fold) 'mt-fp let
-- mt-is: (bytes rate frames hash -- pcm).  The file decodes to what read-mp3 gives for it: this rate, frame count and hash of the pcm.
('mt-h let 'mt-n let 'mt-r let mp3-decode must dup 'rate at mt-r eq assert 'pcm at dup len 4 div mt-n eq assert dup mt-fp mt-h eq assert) 'mt-is let
(mp3-decode must 'pcm at) 'mt-pcm let
-- mt-no: (bytes msg --).  The file is refused with this message.
('mt-m let mt-err mt-m eq assert) 'mt-no let
-- mt-z: (n -- bytes).  n zero bytes.
(0 swap range (drop 0) each) 'mt-z let
