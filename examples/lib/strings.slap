-- String helpers. Formerly prelude; cat alongside your program:
--   cat examples/lib/strings.slap myprog.slap | slap

([] 13 push 10 push) 'crlf let

('n let n 0 gt (n 10 mod 48 plus push n 10 div int-str-digits) () if) 'int-str-digits let

-- A negative number splits off its last digit before it negates, since -9223372036854775808 has no positive twin. div truncates.
('n let n 0 lt (n 10 div 'q let [] 45 push q 0 eq () (q neg int-str cat) if q 10 mul n sub 48 plus push) (n 0 eq ([] 48 push) ([] n int-str-digits reverse) if) if) 'int-str let

('sep let 'parts let parts len 0 eq ([]) (parts 1 drop-n parts first (sep swap cat cat) fold) if) 'str-join let

('body let 'headers let 'path let 'host let 'method let method " " cat path cat " HTTP/1.1" cat crlf cat "Host: " cat host cat crlf cat headers cat body len 0 gt ("Content-Length: " cat body len int-str cat crlf cat) () if crlf cat body cat) 'http-request let

-- Dies unless the program got exactly n arguments, naming them as usage does.
('usage let 'n let args len n eq () ("expected " n int-str cat " argument(s): " cat usage cat fail) if) 'arg-count let
-- The bytes of the file named by argument i. Dies naming what is missing.
('i let args i get {'ok ('p let p read {'ok () 'no ('e let "cannot read " e cat fail)} case) 'no (drop "expected a file name as argument" fail)} case) 'arg-bytes let
('s let "/dev/stdout" s write must drop) 'stdout-write let
-- log-line: (name msg --).  Writes "name: msg" and a newline to stderr.
('lm let 'ln let "/dev/stderr" ln ": " cat lm cat [] 10 push cat write must drop) 'log-line let
-- accept-loop: (..s server name (..s client -- ..s continue) -- ..s server).
-- Hands each client to the handler while it leaves anything but 0. tcp-accept
-- skips a client that resets before it is accepted, so a failure here is a fault
-- of the host, such as no free file descriptors: the loop logs it and goes on.
-- On Linux that fault repeats at once without end, so 100 in a row stop the
-- program.
('ah let 'an let
 0 ('fails let tcp-accept {
     'ok (swap (ah apply) dip swap 0 swap)
     'no ('ae let fails 1 plus 'nf let
          nf 100 lt (an "accept failed: " ae cat log-line)
                    (an ": accept failed 100 times in a row; the last: " cat ae cat fail) if
          nf 1)} case) () while
 drop) 'accept-loop let
-- is-missing: (msg path -- int).  1 when read, write or ls failed with msg
-- because path names no file: no such file, a file where a directory should
-- be, or a name too long to exist.
('mp let 'mm let
 mm mp ": No such file or directory" cat eq
 mm mp ": Not a directory" cat eq or
 mm mp ": File name too long" cat eq or) 'is-missing let
