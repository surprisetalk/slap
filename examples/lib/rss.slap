-- rss.slap: RSS 2.0 + Atom feed parser built on xd-*.
-- Requires parse.slap + xml.slap loaded first.
-- Run tests via: cat examples/lib/parse.slap examples/lib/xml.slap examples/lib/rss.slap | ./slap
--
-- rss-parse: (source-string -- feed-record ok | err no)
-- Feed record: {'kind "rss"|"atom" 'title 'link 'description 'items [...]}
-- Item record: {'title 'link 'summary 'published 'id 'attrs}
-- Every field but 'kind, the feed's 'title, 'items and 'attrs is `value ok`, or none when the
-- feed leaves it out.  Titles, 'description and 'summary hold markup, the element's inner XML
-- (xd-markup): AT&amp;T stays AT&amp;T.  'link, 'published and 'id hold text (xd-text).
-- An RSS channel needs <title>, <link> and <description>, and an Atom feed needs <title>.

-- ========== Helpers ==========

-- _rss-opt: (name dec -- dec').  dec on the first <name> child, or none when there is none.
(xd-child xd-maybe) '_rss-opt let

-- _rss-nonempty: (text -- text ok | none).  Empty text counts as absent: an empty link is no link.
(dup "" eq (drop none) (ok) if) '_rss-nonempty let

-- Atom's <summary> falls back to <content>, and <published> to <updated>, when it is absent or empty.
("summary" xd-markup _rss-opt ((_rss-nonempty) then) xd-map
   ({'ok (ok xd-succeed) 'no (drop "content" xd-markup _rss-opt)} case) xd-and-then) '_atom-summary-dec let
("published" xd-text _rss-opt ((_rss-nonempty) then) xd-map
   ({'ok (ok xd-succeed) 'no (drop "updated" xd-text _rss-opt)} case) xd-and-then) '_atom-published-dec let

-- ========== RSS 2.0 ==========

-- Each decoder reads its fields in turn, then builds its record in one literal.
-- The first field that fails ends the decode with its message.
(('e let
   e "title" xd-markup _rss-opt apply ('ttl let
   e "link" xd-text _rss-opt ((_rss-nonempty) then) xd-map apply ('lnk let
   e "description" xd-markup _rss-opt apply ('smy let
   e "pubDate" xd-text _rss-opt apply ('pub let
   e "guid" xd-text _rss-opt apply ('gid let
   e xd-attrs apply ('atl let
   {'title ttl 'link lnk 'summary smy 'published pub 'id gid 'attrs atl} ok) then) then) then) then) then) then)) '_rss2-item let

(('e let
   e "title" xd-markup xd-child apply ('ttl let
   e "link" xd-text xd-child (_rss-nonempty) xd-map apply ('lnk let
   e "description" xd-markup xd-child apply ('dsc let
   e "item" _rss2-item xd-children apply ('its let
   {'kind "rss" 'title ttl 'link lnk 'description dsc ok 'items its} ok) then) then) then) then)) '_rss2-channel let

("channel" _rss2-channel xd-child) '_rss2-feed let

-- ========== Atom ==========

-- Atom <link href="..." rel="alternate"/>: the href of the first <link> whose rel
-- is "alternate" or absent and whose trimmed href is not empty, else none.  Links with rel
-- "self", "replies" and the like are other resources.
("rel" xd-attr xd-maybe ("" default) xd-map
   ('r let r "" eq r "alternate" eq or)
   xd-map
   ('alt let alt ("href" xd-attr xd-maybe ({'ok (_x-trim _rss-nonempty) 'no (drop none)} case) xd-map)
     (none xd-succeed) if) xd-and-then) '_atom-link-href let
("link" _atom-link-href xd-children
   (none ('o let 'acc let acc {'ok (ok) 'no (drop o)} case) fold) xd-map) '_atom-link let

(('e let
   e "title" xd-markup _rss-opt apply ('ttl let
   e _atom-link apply ('lnk let
   e _atom-summary-dec apply ('smy let
   e _atom-published-dec apply ('pub let
   e "id" xd-text _rss-opt apply ('gid let
   e xd-attrs apply ('atl let
   {'title ttl 'link lnk 'summary smy 'published pub 'id gid 'attrs atl} ok) then) then) then) then) then) then)) '_atom-entry let

(('e let
   e "title" xd-markup xd-child apply ('ttl let
   e _atom-link apply ('lnk let
   e "subtitle" xd-markup _rss-opt apply ('dsc let
   e "entry" _atom-entry xd-children apply ('its let
   {'kind "atom" 'title ttl 'link lnk 'description dsc 'items its} ok) then) then) then) then)) '_atom-feed let

-- ========== Dispatch on root tag ==========

('root-tag let
  root-tag "rss" eq (_rss2-feed) (
  root-tag "feed" eq (_atom-feed) (
    "unknown feed format: " root-tag cat xd-fail
  ) if) if) '_rss-dispatch let

-- rss-parse: (source -- feed-record ok | err no)
(xd-tag (_rss-dispatch) xd-and-then xd-run) 'rss-parse let

-- ========== Accessors ==========
('kind at) 'rss-kind let
('title at) 'rss-title let
('link at) 'rss-link let
('description at) 'rss-description let
('items at) 'rss-items let
('title at) 'rss-item-title let
('link at) 'rss-item-link let
('summary at) 'rss-item-summary let
('published at) 'rss-item-published let
('id at) 'rss-item-id let
('attrs at) 'rss-item-attrs let

-- ========== Generation (rss-to-xml) ==========
-- Each element is written from markup.  _rss-kids reads the markup back as XML, so a field
-- that is not markup is refused rather than written.  A text field is escaped first.

-- _rss-esc: (text ok | none -- markup ok | none).
((xe-text xml-render ok) then) '_rss-esc let

-- _rss-kids: (kids fields -- kids' ok | msg no).  fields: [{'name 'markup}], each 'markup
-- `markup ok` or none.  Adds <name>markup</name> to kids for each field that is not none.
(swap ok ('f let (f 'markup at {'ok ('m let 'ks let f 'name at 'n let
    "<" n cat ">" cat m cat "</" cat n cat ">" cat _xml-parse
    {'ok ('elem tag ks swap push ok)
     'no ('e let "rss-to-xml: <" n cat "> must hold XML markup, as rss-parse gives it; escape plain text with xe-text xml-render. In <" cat n cat ">…</" cat n cat ">, where the markup starts at byte " cat n len 2 plus int-str cat ": " cat e cat no)} case)
   'no (drop ok)} case) then) fold) '_rss-kids let

-- _atom-link-elem: (href-str -- link-element).  <link href="..." rel="alternate"/>.
('href let "link" [{'name "href" 'value href} {'name "rel" 'value "alternate"}] [] xe-elem) '_atom-link-elem let

-- _rss-make-item: (kids item -- kids' ok | msg no).  Adds <item>.
('item let 'kids let
  [] [{'name "title"       'markup item rss-item-title}
      {'name "link"        'markup item rss-item-link _rss-esc}
      {'name "description" 'markup item rss-item-summary}
      {'name "pubDate"     'markup item rss-item-published _rss-esc}
      {'name "guid"        'markup item rss-item-id _rss-esc}] _rss-kids
  ('ik let kids "item" [] ik xe-elem push ok) then) '_rss-make-item let

-- _atom-make-entry: (kids item -- kids' ok | msg no).  Adds <entry>.
('item let 'kids let
  [] item rss-item-link {'ok (_atom-link-elem push) 'no (drop)} case
  [{'name "title"     'markup item rss-item-title}
   {'name "summary"   'markup item rss-item-summary}
   {'name "published" 'markup item rss-item-published _rss-esc}
   {'name "id"        'markup item rss-item-id _rss-esc}] _rss-kids
  ('ek let kids "entry" [] ek xe-elem push ok) then) '_atom-make-entry let

-- _rss-make-channel: (feed -- channel-element ok | msg no).  RSS needs a channel link, so an
-- absent one is written empty, which rss-parse reads back as none.
('feed let
  feed rss-description {'ok (ok) 'no (drop "rss-to-xml: an RSS channel needs a description, and this feed's 'description is none; give it one, or write the feed with 'kind \"atom\"" no)} case
  ('d let [] [{'name "title"       'markup feed rss-title ok}
              {'name "link"        'markup feed rss-link "" default xe-text xml-render ok}
              {'name "description" 'markup d ok}] _rss-kids) then
  ('k0 let feed rss-items k0 ok ('it let (it _rss-make-item) then) fold) then
  ('ck let "channel" [] ck xe-elem ok) then) '_rss-make-channel let

-- _atom-make-feed: (feed -- feed-element ok | msg no).
('feed let
  [] feed rss-link {'ok (_atom-link-elem push) 'no (drop)} case
  [{'name "title"    'markup feed rss-title ok}
   {'name "subtitle" 'markup feed rss-description}] _rss-kids
  ('k0 let feed rss-items k0 ok ('it let (it _atom-make-entry) then) fold) then
  ('fk let "feed" [{'name "xmlns" 'value "http://www.w3.org/2005/Atom"}] fk xe-elem ok) then) '_atom-make-feed let

-- rss-to-xml: (feed-record -- xml-string ok | msg no).
-- Dispatches on feed's 'kind field: "rss" → RSS 2.0, "atom" → Atom.  Any other kind is an error.
('feed let
  feed rss-kind "atom" eq (
    feed _atom-make-feed (xml-render ok) then
  ) (
  feed rss-kind "rss" eq (
    feed _rss-make-channel ('ch let "rss" [{'name "version" 'value "2.0"}] [ch] xe-elem xml-render ok) then
  ) ("rss-to-xml: expected kind \"rss\" or \"atom\", got \"" feed rss-kind cat "\"" cat no) if) if) 'rss-to-xml let

-- ========== Tests ==========

-- RSS 2.0 sample
(
"<?xml version=\"1.0\"?>
<rss version=\"2.0\">
  <channel>
    <title>My Blog</title>
    <link>http://example.com</link>
    <description>A sample blog</description>
    <item>
      <title>First Post</title>
      <link>http://example.com/1</link>
      <description>Hello &amp; welcome</description>
      <pubDate>Mon, 01 Jan 2024 00:00:00 +0000</pubDate>
      <guid>http://example.com/1</guid>
    </item>
    <item>
      <title>Second Post</title>
      <link>http://example.com/2</link>
      <description><![CDATA[<p>html body</p>]]></description>
      <pubDate>Tue, 02 Jan 2024 00:00:00 +0000</pubDate>
      <guid>http://example.com/2</guid>
    </item>
  </channel>
</rss>") '_rss-sample let

_rss-sample rss-parse must 'feed let
feed rss-kind "rss" eq assert
feed rss-title "My Blog" eq assert
feed rss-link "http://example.com" ok eq assert
feed rss-description "A sample blog" ok eq assert
feed rss-items 'items let
items len 2 eq assert
items 0 get must rss-item-title "First Post" ok eq assert
items 0 get must rss-item-link "http://example.com/1" ok eq assert
items 0 get must rss-item-summary "Hello &amp; welcome" ok eq assert
items 0 get must rss-item-published "Mon, 01 Jan 2024 00:00:00 +0000" ok eq assert
items 0 get must rss-item-id "http://example.com/1" ok eq assert
items 1 get must rss-item-title "Second Post" ok eq assert
items 1 get must rss-item-summary "&lt;p&gt;html body&lt;/p&gt;" ok eq assert

-- Atom sample
(
"<?xml version=\"1.0\"?>
<feed xmlns=\"http://www.w3.org/2005/Atom\">
  <title>Atom Blog</title>
  <link href=\"http://example.com\" rel=\"alternate\"/>
  <subtitle>A sample atom feed</subtitle>
  <entry>
    <title>Atom First</title>
    <link href=\"http://example.com/a1\"/>
    <summary>first entry</summary>
    <published>2024-01-01T00:00:00Z</published>
    <id>urn:uuid:1</id>
  </entry>
  <entry>
    <title>Atom Second</title>
    <link href=\"http://example.com/a2\"/>
    <summary>second entry</summary>
    <published>2024-01-02T00:00:00Z</published>
    <id>urn:uuid:2</id>
  </entry>
</feed>") '_atom-sample let

_atom-sample rss-parse must 'afeed let
afeed rss-kind "atom" eq assert
afeed rss-title "Atom Blog" eq assert
afeed rss-link "http://example.com" ok eq assert
afeed rss-description "A sample atom feed" ok eq assert
afeed rss-items 'aitems let
aitems len 2 eq assert
aitems 0 get must rss-item-title "Atom First" ok eq assert
aitems 0 get must rss-item-link "http://example.com/a1" ok eq assert
aitems 0 get must rss-item-id "urn:uuid:1" ok eq assert

-- Atom link: the first alternate (or rel-less) link with an href wins.  Self,
-- replies and hrefless links come first here; a feed without one has no link.
(
"<feed><title>F</title>
  <link rel=\"self\" href=\"http://example.com/feed.atom\"/>
  <link rel=\"replies\" href=\"http://example.com/replies\"/>
  <link rel=\"alternate\"/>
  <link href=\"http://example.com/home\"/>
  <entry><title>T</title>
    <link rel=\"replies\" href=\"http://example.com/e/replies\"/>
    <link rel=\"alternate\" href=\"http://example.com/e\"/><id>1</id></entry>
  <entry><title>U</title>
    <link rel=\"self\" href=\"http://example.com/e2.atom\"/><id>2</id></entry>
</feed>") '_atom-links-sample let
_atom-links-sample rss-parse must 'al let
al rss-link "http://example.com/home" ok eq assert
al rss-items 0 get must rss-item-link "http://example.com/e" ok eq assert
al rss-items 1 get must rss-item-link none eq assert

-- An empty href or an empty RSS <link> is no link: a later Atom link wins, and RSS gives none.
"<feed><title>F</title><link rel=\"alternate\" href=\"\"/><link href=\"http://u/after\"/></feed>" rss-parse must
  rss-link "http://u/after" ok eq assert
"<feed><title>F</title><link href=\"  \"/><link href=\" http://u/pad \"/></feed>" rss-parse must
  rss-link "http://u/pad" ok eq assert
"<rss><channel><title>T</title><link></link><description>d</description><item><title>I</title><link/></item></channel></rss>" rss-parse must 'el let
el rss-link none eq assert
el rss-items 0 get must rss-item-link none eq assert

-- Adversarial: unknown root
"<html><body>hi</body></html>" rss-parse xerr
  "/html: unknown feed format: html" eq assert

-- A channel needs its title, link and description; an item needs none of its fields, and an absent one is none
"<rss><channel><link>L</link><description>d</description></channel></rss>" rss-parse xerr "/rss/channel: missing <title>" eq assert
"<rss><channel><title>T</title><description>d</description></channel></rss>" rss-parse xerr "/rss/channel: missing <link>" eq assert
"<rss><channel><title>T</title><link>L</link></channel></rss>" rss-parse xerr "/rss/channel: missing <description>" eq assert
"<feed><entry/></feed>" rss-parse xerr "/feed: missing <title>" eq assert
"<rss><channel><title>T</title><link>L</link><description>d</description><item/></channel></rss>" rss-parse must rss-items 0 get must 'bare let
[bare rss-item-title bare rss-item-summary bare rss-item-published bare rss-item-id] [none none none none] eq assert
"<feed><title>F</title><entry/></feed>" rss-parse must rss-items 0 get must 'abare let
[abare rss-item-title abare rss-item-summary abare rss-item-published abare rss-item-id] [none none none none] eq assert
-- A field that is there but malformed fails the parse
"<rss><channel><title>T</title><link>L</link><description>d</description><item><pubDate><b/></pubDate></item></channel></rss>" rss-parse xerr
  "/rss/channel/item[0]/pubDate/text(): element has non-text children" eq assert

-- Title, description and content hold markup, the element's inner XML
"<rss><channel><title>AT&amp;T</title><link>L</link><description>A <b>bold</b> post</description></channel></rss>" rss-parse must 'mk let
mk rss-title "AT&amp;T" eq assert
mk rss-description "A <b>bold</b> post" ok eq assert
"<feed><title>F</title><entry><content type=\"xhtml\">
  <div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Hi &amp; bye</p></div>
</content></entry></feed>" rss-parse must rss-items 0 get must rss-item-summary
  "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Hi &amp; bye</p></div>" ok eq assert

-- Atom content fallback (no <summary>, has <content>)
(
"<feed><title>F</title>
  <entry><title>T</title><content>body via content</content><id>1</id></entry>
</feed>") '_atom-content-sample let
_atom-content-sample rss-parse must 'ac let
ac rss-items 0 get must rss-item-summary "body via content" ok eq assert

-- Atom updated fallback (no <published>, has <updated>)
(
"<feed><title>F</title>
  <entry><title>T</title><updated>2024-03-01</updated><id>1</id></entry>
</feed>") '_atom-updated-sample let
_atom-updated-sample rss-parse must 'au let
au rss-items 0 get must rss-item-published "2024-03-01" ok eq assert
-- An empty <summary> or <published> counts as absent, so the fallback still fires
"<feed><title>F</title><entry><summary/><content>c</content><published> </published><updated>u</updated></entry></feed>" rss-parse must rss-items 0 get must 'ae let
[ae rss-item-summary ae rss-item-published] ["c" ok "u" ok] eq assert

-- Item attrs exposed (podcast enclosure pattern)
(
"<rss><channel><title>Pod</title><link>L</link><description>d</description>
  <item isPermaLink=\"true\"><title>Ep1</title><guid>ep1</guid></item>
</channel></rss>") '_rss-pod-sample let
_rss-pod-sample rss-parse must 'pod let
pod rss-items 0 get must rss-item-attrs 'pod-attrs let
pod-attrs len 1 eq assert
pod-attrs 0 get must 'name at "isPermaLink" eq assert
pod-attrs 0 get must 'value at "true" eq assert

-- rss-to-xml: roundtrip via parse → generate → reparse.
-- Build a feed record by hand and serialize.
{'kind "rss" 'title "My &amp; Feed" 'link "http://example.com" ok 'description "A <i>feed</i>" ok
 'items [{'title "Post 1" ok 'link "http://a/1" ok 'summary "body 1" ok
          'published "Mon, 01 Jan 2024" ok 'id "http://a/1" ok 'attrs []}]}
'built-feed let

built-feed rss-to-xml must 'xml-out let

-- The generated XML should reparse to the same normalized fields.
xml-out rss-parse must 'rt let
rt rss-kind "rss" eq assert
rt rss-title "My &amp; Feed" eq assert
rt rss-description "A <i>feed</i>" ok eq assert
rt rss-items 0 get must rss-item-title "Post 1" ok eq assert
rt rss-items 0 get must rss-item-link "http://a/1" ok eq assert

-- Atom output roundtrip: build an atom feed, serialize, reparse.
{'kind "atom" 'title "Atom Feed" 'link "http://example.com" ok 'description "Atom desc" ok
 'items [{'title "Atom Post" ok 'link "http://a/1" ok 'summary "atom body" ok
          'published "2024-01-01T00:00:00Z" ok 'id "urn:uuid:1" ok 'attrs []}]}
'atom-feed let

atom-feed rss-to-xml must 'atom-xml let
atom-xml rss-parse must 'art let
art rss-kind "atom" eq assert
art rss-title "Atom Feed" eq assert
art rss-link "http://example.com" ok eq assert
art rss-items 0 get must rss-item-title "Atom Post" ok eq assert
art rss-items 0 get must rss-item-link "http://a/1" ok eq assert
art rss-items 0 get must rss-item-id "urn:uuid:1" ok eq assert

-- rss-to-xml writes no element for an absent field.  RSS needs a channel link,
-- so an absent one is written empty, which reads back as none.
{'title "I" ok 'link none 'summary none 'published none 'id none 'attrs []} 'bare-item let
{'kind "rss" 'title "T" 'link none 'description "d" ok 'items [bare-item]} rss-to-xml must
  "<rss version=\"2.0\"><channel><title>T</title><link/><description>d</description><item><title>I</title></item></channel></rss>" eq assert
{'kind "atom" 'title "T" 'link none 'description none 'items [bare-item]} rss-to-xml must
  "<feed xmlns=\"http://www.w3.org/2005/Atom\"><title>T</title><entry><title>I</title></entry></feed>" eq assert
["rss" "atom"] ('k let
  {'kind k 'title "T" 'link none 'description "d" ok 'items [bare-item]}
  rss-to-xml must rss-parse must 'nl let
  nl rss-link none eq nl rss-items 0 get must rss-item-link none eq and) each [1 1] eq assert

-- rss-to-xml refuses what the format cannot hold or what is not markup
{'kind "rss" 'title "T" 'link none 'description none 'items []} rss-to-xml xerr
  "rss-to-xml: an RSS channel needs a description, and this feed's 'description is none; give it one, or write the feed with 'kind \"atom\"" eq assert
{'kind "atom" 'title "AT&T" 'link none 'description none 'items []} rss-to-xml xerr
  "rss-to-xml: <title> must hold XML markup, as rss-parse gives it; escape plain text with xe-text xml-render. In <title>…</title>, where the markup starts at byte 7: xml: unterminated entity at byte 9" eq assert

-- rss-to-xml accepts the kind "rss" or "atom" only.
["Atom" "RSS" "" "feed"] ('k let
  {'kind k 'title "T" 'link none 'description "d" ok 'items []}
  rss-to-xml xerr "rss-to-xml: expected kind \"rss\" or \"atom\", got \"" k cat "\"" cat eq) each [1 1 1 1] eq assert

-- A feed in another encoding is an error, not UTF-8 misread.
"<?xml version=\"1.0\" encoding=\"ISO-8859-1\"?><rss><channel><title>T</title></channel></rss>" rss-parse xerr
  "xml: unsupported encoding \"ISO-8859-1\"; expected UTF-8 or US-ASCII at byte 30" eq assert
