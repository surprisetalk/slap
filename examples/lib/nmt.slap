-- nmt.slap: nametable cell codec. 3 bytes <-> {addr, color} record.

-- nmt-decode: (bytes -- cells ok | msg no)
('nd let nd len 3 mod 0 eq not ("nmt: cells are 3 bytes each, and the length is not a multiple of 3" no) (
  nd 3 chunks ('c let c 0 get must c 1 get must 8 shl bor 'addr let c 2 get must 'color let {} addr 'addr into color 'color into) each ok) if) 'nmt-decode let
(('r let r 'addr at 'a let [] a byte-mask push a 8 shr byte-mask push r 'color at push) each flatten) 'nmt-encode let

-- ===== tests =====
[0 1 2  3 4 5] nmt-decode must
  dup len 2 eq assert
  dup 0 get must dup 'addr at 256 eq assert 'color at 2 eq assert
  1 get must dup 'addr at 1027 eq assert 'color at 5 eq assert
[0 1 2  3 4 5] nmt-decode must nmt-encode [0 1 2  3 4 5] eq assert
[0 0 0] nmt-decode must nmt-encode [0 0 0] eq assert
[0 1 2 3] nmt-decode {'ok (drop "") 'no ()} case "nmt: cells are 3 bytes each, and the length is not a multiple of 3" eq assert
