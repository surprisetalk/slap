  -- a scan gives up after 4096 sync codes that are no header
  ('hs-hi let 'hs-x let
   sk-bs 0 eq ([255 249]) ([255 248]) if 'hs-sync let
   hs-x 0 -1 0
   ('c-sn let 'c-s let 'c-n let 'c-x let c-x c-n c-s c-sn c-s 0 lt c-x hs-hi lt and c-n 4096 lt and) (
     'b-sn let 'b-s let 'b-n let 'b-x let
     fb b-x drop-n hs-sync str-find
     {'ok ('b-i let b-x b-i plus 'b-c let
           b-c hs-hi lt not (b-c b-n -1 0) (
           b-c fx-chk 'b-v let
           b-v 0 lt (b-c 1 plus b-n 1 plus -1 0) (b-c 1 plus b-n 1 plus b-c b-v) if) if)
