-- flac.slap: native FLAC files as the audio record play takes. Requires strings.slap.

-- A FLAC plays as it decodes, a chunk at a time, so the first sound waits only
-- for the headers. The file's bytes travel apart from the decoder's state: a
-- lookup of a bound record copies all of it, the bytes too.
-- flac-open: (bytes -- bytes res).  res is dec ok, or msg no. dec is {'rate 'ch
--   'bps 'total 'fz 'f0 'bs 'bm 'p 'ic 'at 'skip}: the STREAMINFO fields, the
--   file's length, where the frames start, the fixed block size (0 when it
--   varies) and the largest block size, then the next byte to scan, the
--   frames in the current ask (see "the frames" below), the next sample
--   frame to give, and the sample frames still to drop. The bytes it gives back
--   hold 1 MiB of zero bytes after the file; pass them on as they are.
-- flac-next: (bytes dec -- bytes dec chunk).  chunk is the next whole frames of
--   the file, 8192 sample frames or more unless the file ends, as pcm, ok; ""
--   ok after the last. A file that fails at its end gives msg no, as
--   flac-decode refuses it.
-- flac-seek: (bytes dec frame -- bytes dec).  The next chunk starts at that
--   sample frame, or at the end past it. A frame counts as the frame headers
--   number it, so a damaged file seeks as if it were whole. A seek to 0 or less starts at the first frame. A frame at or past
--   STREAMINFO's total, when it gives one, is the end.
-- flac-decode: (bytes -- {'rate 'pcm} ok | msg no).  The whole file at once, as
--   dr_flac decoded it.
-- pcm holds 16-bit little-endian stereo frames, and mono plays on both sides.
-- flac.slap reads native FLAC of 1 or 2 channels and 1 to 32 bits a sample,
-- after an ID3v2 tag or not. It makes each sample 16 bits as dr_flac does: the
-- top 16 bits of the sample, or the sample shifted up when it has fewer. Where
-- a file is damaged it does what dr_flac does. It checks the CRC-8 of each frame
-- header and the CRC-16 of each frame, and a frame with a bad CRC gives no
-- audio. It scans for the next sync code after a bad header, and after a frame
-- it cannot decode (see "the frames" below). It refuses a file whose STREAMINFO
-- gives a length and that decodes to fewer frames. A refusal names the reason:
-- "flac: 6 channels; flac-decode reads mono or stereo".
-- REVIEW: Refuse Ogg FLAC, which dr_flac reads. Alternative: unwrap the Ogg pages. It costs about 100 lines for a container no file under ~/Music uses.
-- REVIEW: Check both CRCs and skip a bad frame, as dr_flac does. Alternative: refuse a file with a bad CRC. It is simpler, but it refuses files that dr_flac reads when STREAMINFO gives no length.
-- REVIEW: Give the bytes back with the padding, so the bit reader reads past the last byte without a test. Alternative: pad in each flac-next. It copies the file a second time in each chunk.
-- REVIEW: End a chunk at the first frame that reaches 8192 sample frames. Alternative: cut at exactly 8192. It splits a frame, and the next chunk would decode it again.
-- REVIEW: flac-seek bisects the file's bytes: it scans for a sync code with str-find, accepts a CRC-8 header that fits STREAMINFO, and keeps the last header whose sample number is at most the target. Alternative: read the SEEKTABLE block. It misses files without one, and it leaves up to 10 s of frames to decode and drop.
-- REVIEW: Frames are numbered by block when the first sync code in the file is fff8, and then the block size is STREAMINFO's maximum (the last block alone is shorter, and some writers set the minimum from it). Alternative: read the first frame's header. It costs a header parse at open, and the scan for the sync code is cheaper.
-- fq-lz: leading zero bits of a byte, 8 for 0.
 0 256 range (0 swap (dup 0 eq not) (1 shr swap 1 plus swap) while drop 8 swap sub) each 'fq-lz let
 0 256 range (8 (dup 128 band (1 shl 7 bxor 255 band) (1 shl 255 band) if) repeat) each 'fq-c8 let
 0 256 range (8 shl 8 (dup 32768 band (1 shl 32773 bxor 65535 band) (1 shl 65535 band) if) repeat) each 'fq-c16 let
-- flac-open: (bytes -- bytes res).
('fi let fi len 'fz let
 -- the input, then 1 MiB of zero bytes: the bit reader reads past the last byte without a test, and every frame ends with a check that it stayed inside the file
 fi [0] 20 (dup cat) repeat cat 'fb let
 (int-str) 'fv-s let
 (dup 4 plus range ('fb nth must) each) 'fv-id let
 -- fv-u: (i k -- n).  k bytes from i, big-endian.
 ('fu-k let 'fu-i let fu-i fu-i fu-k plus range 0 ('fu-j let 8 shl fu-j 'fb nth must bor) fold) 'fv-u let
 -- fv-open: (-- {'mp 'last 'rate 'ch 'bps 'total} ok | msg no).  The ID3v2 tags, fLaC and STREAMINFO.
 -- mp is the byte after STREAMINFO; last is nonzero when STREAMINFO ends the metadata.
 -- a tag that runs past the end leaves o-p past fz, so the loop stops and the message below names the tag
 (0 (dup 4 plus fz le (dup 'fb nth must 73 eq over 1 plus 'fb nth must 68 eq and over 2 plus 'fb nth must 51 eq and) (0) if) (
    'id-p let
    id-p 10 plus fz gt (id-p 10 plus) (
      id-p 6 plus 'fb nth must 127 band 21 shl id-p 7 plus 'fb nth must 127 band 14 shl bor
      id-p 8 plus 'fb nth must 127 band 7 shl bor id-p 9 plus 'fb nth must 127 band bor
      id-p 5 plus 'fb nth must 16 band 0 eq (0) (10) if plus id-p plus 10 plus) if) while
  'o-p let
  o-p 4 plus fz gt (o-p fz gt ("flac: an ID3v2 tag ends at byte " o-p fv-s cat ", but the file holds " cat fz fv-s cat " bytes" cat no)
    ("flac: the file holds " fz fv-s cat " bytes, but fLaC starts at byte " cat o-p fv-s cat no) if) (
  o-p fv-id "fLaC" eq not (
    o-p fv-id "OggS" eq ("flac: an Ogg FLAC file; flac-decode reads native FLAC" no)
      ("flac: not a FLAC file: it starts " o-p fv-id cat ", not fLaC" cat no) if) (
  o-p 8 plus fz gt ("flac: the file ends at byte " fz fv-s cat ", before the STREAMINFO block header at byte " cat o-p 4 plus fv-s cat no) (
  o-p 4 plus 'fb nth must 'o-h let o-p 5 plus 3 fv-u 'o-z let
  o-h 127 band 0 eq not o-z 34 eq not or
    ("flac: the first metadata block is type " o-h 127 band fv-s cat " of " cat o-z fv-s cat " bytes; a FLAC file starts with STREAMINFO, type 0 of 34 bytes" cat no) (
  o-p 42 plus fz gt ("flac: STREAMINFO holds 34 bytes, but " fz o-p 8 plus sub fv-s cat " remain" cat no) (
  o-p 18 plus 8 fv-u 'o-i let
  o-i 41 shr 7 band 1 plus 'o-c let
  o-c 2 gt ("flac: " o-c fv-s cat " channels; flac-decode reads mono or stereo" cat no) (
  {'mp o-p 42 plus 'last o-h 128 band 'rate o-i 44 shr 1048575 band 'ch o-c 'bps o-i 36 shr 31 band 1 plus 'total o-i 68719476735 band} ok) if) if) if) if) if) if) 'fv-open let
 fv-open (
  'g-r let
  g-r 'rate at 'gr let g-r 'ch at 'gc let g-r 'bps at 'gb let g-r 'total at 'gn let
  -- the metadata blocks, as mp rp go: the next block's byte, the byte dr_flac thinks that is (it counts from 42 even
  -- after an ID3 tag), and 1 to go on, 0 when done, 2 when a block is bad, 3 when the file ends in a block header.
  -- A bad block sends dr_flac to scan from byte 42 for the first frame.
  g-r 'mp at 42 g-r 'last at 0 eq (1) (0) if
  (dup 1 eq) (
    'w-go let 'w-rp let 'w-mp let
    w-mp 4 plus fz gt (w-mp w-rp 3) (
    w-mp 'fb nth must 'w-h let w-mp 1 plus 3 fv-u 'w-z let
    w-h 127 band 'w-t let w-rp 4 plus 'w-r2 let w-mp 4 plus 'w-m2 let
    w-r2 fz gt w-z fz w-r2 sub gt or w-t 127 eq or
      w-t 2 eq w-z 4 lt and or w-t 3 eq w-z 18 mod 0 eq not and or w-t 5 eq w-z 396 lt and or w-t 6 eq w-z 32 lt and or
      (w-m2 w-z plus w-r2 w-z plus 2) (w-m2 w-z plus w-r2 w-z plus w-h 128 band 0 eq (1) (0) if) if) if) while
  'w-go let drop 'w-mp let
  w-go 3 eq ("flac: the file ends inside a metadata block header, where 4 bytes were expected, at byte " w-mp fv-s cat no) (
  g-r 'mp at 34 sub 2 fv-u 'o-bmin let g-r 'mp at 32 sub 2 fv-u 'o-bmax let
  w-go 2 eq (42) (w-mp) if fz min 'o-start let
  -- the first sync code says how the frames number themselves: fff8 by block, fff9 by sample
  -- fi, not fb: a search of the padding copies a MiB and finds nothing
  fi o-start drop-n [255 248] str-find {'ok () 'no (drop fz)} case 'o-xf let
  fi o-start drop-n [255 249] str-find {'ok () 'no (drop fz)} case 'o-xv let
  o-xf o-xv lt (o-bmin o-bmax eq (o-bmin) (o-bmax) if) (0) if 'o-bs let
  {'rate gr 'ch gc 'bps gb 'total gn 'fz fz 'f0 o-start 'bs o-bs 'bm o-bmax 'p o-start 'ic 0 'at 0 'skip 0} ok) if) then
 fb swap) 'flac-open let
-- fx-end: (dec -- res).  "" ok at the end of a whole file, or why the file is refused.
('en-d let en-d 'p at 'en-p let en-d 'at at 'en-n let en-d 'total at 'en-t let
 en-p -2 eq ("flac: decodes to more than 1073741824 bytes of audio, the most a string holds" no) (
 en-t 0 eq not en-n en-t lt and ("flac: cut short: " en-n int-str cat " of " cat en-t int-str cat " frames" cat no) (
 en-n 0 eq ("flac: holds no audio" no) ("" ok) if) if) if) 'fx-end let
-- fx: (bytes dec k mode -- bytes dec chunk).  Mode 0 decodes whole frames until the chunk holds k sample frames, after the dec's skip, or the
-- file ends. Mode 1 points dec at the frame that holds sample frame k, with the sample frames before k to skip, and the chunk is "".
('x-m let 'x-k let 'x-d let 'fb let
 x-d 'rate at 'gr let x-d 'ch at 'gc let x-d 'bps at 'gb let x-d 'total at 'gn let x-d 'fz at 'fz let x-d 'bs at 'sk-bs let x-d 'bm at 'sk-bm let
 -- where a scan for zero bits gives up inside the padding
 fz 262144 plus 'fe let
 -- BIAS makes a prediction positive before the shift: shr is logical
 1 58 shl 'fk let
 -- fv-u: (i k -- n).  k bytes from i, big-endian.
 ('fu-k let 'fu-i let fu-i fu-i fu-k plus range 0 ('fu-j let 8 shl fu-j 'fb nth must bor) fold) 'fv-u let
 ('c8-j let 'c8-i let c8-i c8-j range 0 ('c8-x let c8-x 'fb nth must bxor 'fq-c8 nth must) fold) 'fv-c8 let
 -- fv-c16 takes its range in pieces: a frame of huge Rice codes can pass the 2097152 values a list holds.
 ('c6-j let 'c6-i let 0 c6-i (dup c6-j lt) ('c6-p let c6-p c6-p 65536 plus c6-j min range swap
   ('fb nth must over 8 shr bxor 'fq-c16 nth must swap 8 shl 65535 band bxor) fold c6-p 65536 plus) while drop) 'fv-c16 let
  -- fv-sy: (p -- s).  The first byte at or after p that starts a sync code, or -1.
  (('sy-p let sy-p sy-p fz 1 sub lt sy-p 'fb nth must 255 eq sy-p 1 plus 'fb nth must 2 shr 62 eq and not and) (1 plus) while
   dup fz 1 sub lt () (drop -1) if) 'fv-sy let
  -- fv-hv: (s bc rc ca bpc -- kind x bsz ca bps).  A frame header from its UTF-8 number on.
  -- kind 0: a good header, and x is the first byte after it. kind 1: a bad one, and x is where the scan goes on.
  -- kind 2: the file ends in it, or dr_flac gives up on the frame there, and x is where it goes on.
  ('hv-bpc let 'hv-ca let 'hv-rc let 'hv-bc let 'hv-s let
   hv-s 4 plus 'fb nth must 255 bxor 'fq-lz nth must 'hv-l let
   hv-l 1 eq hv-l 8 eq or (1 hv-s 5 plus 0 0 0) (
   hv-s 4 plus hv-l 0 eq (1) (hv-l) if plus 'hv-p let
   hv-p fz gt (2 fz 0 0 0) (
   hv-bc 6 eq (hv-p 'fb nth must 1 plus hv-p 1 plus) (
   hv-bc 7 eq (hv-p 2 fv-u 1 plus hv-p 2 plus) (
   hv-bc 1 eq (192 hv-p) (hv-bc 6 lt (576 hv-bc 2 sub shl hv-p) (256 hv-bc 8 sub shl hv-p) if) if) if) if 'hv-q let 'hv-z let
   hv-z 65536 eq hv-q fz gt or (2 hv-q 0 0 0) (
   hv-rc 15 eq (1 hv-q 0 0 0) (
   hv-q hv-rc 12 eq (1 plus) (hv-rc 13 eq hv-rc 14 eq or (2 plus) () if) if 'hv-r let
   hv-r fz ge (2 fz 0 0 0) (
   [0 8 12 0 16 20 24 32] hv-bpc get must 'hv-f let
   hv-f 0 eq (gb) (hv-f) if 'hv-b let
   gb 32 lt hv-b 32 eq and gb 32 lt not hv-b 32 eq not and or (2 hv-r 0 0 0) (
   hv-s hv-r fv-c8 hv-r 'fb nth must eq not (1 hv-r 1 plus 0 0 0) (0 hv-r 1 plus hv-z hv-ca hv-b) if) if) if) if) if) if) if) 'fv-hv let
  -- fv-hd: (s -- kind x bsz ca bps).  The frame header at s, an 0xFF whose next byte starts 111110.
  -- Each bad field sends the scan on from the byte dr_flac has read to when it finds it.
  ('hd-s let
   hd-s 1 plus 'fb nth must 'hd-b1 let
   hd-b1 2 band 0 eq not (1 hd-s 2 plus 0 0 0) (
   hd-s 2 plus fz lt not (2 fz 0 0 0) (
   hd-s 2 plus 'fb nth must 'hd-b2 let
   hd-b2 4 shr 0 eq (1 hd-s 3 plus 0 0 0) (
   hd-s 3 plus fz lt not (2 fz 0 0 0) (
   hd-s 3 plus 'fb nth must 'hd-b3 let
   hd-b3 4 shr 'hd-ca let hd-b3 1 shr 7 band 'hd-bp let
   hd-ca 10 gt hd-bp 3 eq or hd-b3 1 band or (1 hd-s 4 plus 0 0 0) (
   hd-s 4 plus fz lt not (2 fz 0 0 0) (
   hd-s hd-b2 4 shr hd-b2 15 band hd-ca hd-bp fv-hv) if) if) if) if) if) if) 'fv-hd let
  -- The bit reader holds a and s: a has the bits of the bytes read so far, and s is the next byte's
  -- index times 64 plus the count of bits in a that are still unread, 63 at most.
  -- fv-rf: (a s -- a s).  Reads bytes until at least 40 bits are unread.
  ((dup 63 band 40 lt) (swap 8 shl over 6 shr 'fb nth must bor swap 72 plus) while) 'fv-rf let
  -- fv-rd, fv-sg: (a s k -- a s v).  The next k bits as an unsigned or a two's-complement number; k is 1 to 40 for fv-sg.
  ('rd-k let fv-rf 'rd-s let 'rd-a let rd-a rd-s rd-k sub rd-a rd-s 63 band rd-k sub shr 1 rd-k shl 1 sub band) 'fv-rd let
  ('sg-k let sg-k fv-rd 'sg-v let sg-v 1 sg-k 1 sub shl lt not (sg-v 1 sg-k shl sub) (sg-v) if) 'fv-sg let
  -- fv-uz: (a s -- a s q).  Counts q zero bits, then reads the one bit that ends them. In the padding it gives up.
  (0 rot rot
   ((dup 63 band 40 lt) (swap 8 shl over 6 shr 'fb nth must bor swap 72 plus) while
    over over 63 band 8 sub shr 255 band 0 eq over 6 shr fe lt and)
   ('uz-s let 'uz-a let 8 plus uz-a uz-s 8 sub) while
   'uz-s let 'uz-a let uz-a uz-s 63 band 8 sub shr 255 band 'fq-lz nth must 'uz-z let uz-z plus uz-a uz-s uz-z 1 plus sub rot) 'fv-uz let
  -- fv-sr: (out a s order cf shift bsz q -- out a s ok).  The residual of a fixed or LPC subframe, and the samples it makes.
  -- out stays at the bottom of the stack and the loops keep their state above it: moving a list moves every element,
  -- and dup copies it, so a loop that did either per sample would take time in proportion to the square of the block.
  -- An order over 8 carries the last 8, 16 or 32 samples as a window w, newest first, so a prediction reads them by name: a bound list reads in place.
  -- An order of 8 or less carries the last 8 samples as eight stack values instead (see the REVIEW at its loop).
  -- q is the bits of a sample. A 32-bit stream decodes in 64 bits in dr_flac, which refuses a frame in two cases: a sample
  -- outside q bits, and a Rice code past 32 bits (a unary count over 0xFFFFFFFF >> k, or the value 0xFFFFFFFF). Here such
  -- a sample becomes 2^40, which no q bits hold, and the subframe ends with a scan for it.
  ('sr-q let 'sr-z let 'sr-h let 'sr-c let 'sr-o let
   gb 32 eq 'sr-big let 1 sr-q 1 sub shl 'sr-hw let
   2 fv-rd 'sr-m let
   sr-m 1 gt (0) (
   4 fv-rd 'sr-po let 1 sr-po shl 'sr-np let
   sr-z sr-np 1 sub band 0 eq not sr-z sr-po shr sr-o lt or (0) (
   sr-z sr-po shr 'sr-ps let
   sr-m 0 eq (4) (5) if 'sr-kb let
   sr-m 0 eq (15) (31) if 'sr-esc let
   fk sr-h shr 'sr-bs let
   -- the coefficients, with zeros past the order, as k1 to k32
   -- REVIEW: Name the 32 coefficients and keep the last 32 samples in a window that a prediction reads by name, with a branch per tier of taps. Alternative: one loop over the taps that peeks at the output list. It is much less code and about a quarter slower on a real track.
   -- REVIEW: Size the window to the tier of taps: 8, 16 or 32. Alternative: always 32. Each sample copies the window, so it costs about four times the copying for the common orders up to 8.
   sr-o 8 gt (sr-o 16 gt (32) (16) if) (8) if 'sr-wl let
   sr-c [0] 5 (dup cat) repeat cat 32 take-n 'sr-cp let
   0 'sr-cp nth must 'k1 let 1 'sr-cp nth must 'k2 let 2 'sr-cp nth must 'k3 let 3 'sr-cp nth must 'k4 let 4 'sr-cp nth must 'k5 let 5 'sr-cp nth must 'k6 let 6 'sr-cp nth must 'k7 let 7 'sr-cp nth must 'k8 let 8 'sr-cp nth must 'k9 let 9 'sr-cp nth must 'k10 let 10 'sr-cp nth must 'k11 let 11 'sr-cp nth must 'k12 let 12 'sr-cp nth must 'k13 let 13 'sr-cp nth must 'k14 let 14 'sr-cp nth must 'k15 let 15 'sr-cp nth must 'k16 let 16 'sr-cp nth must 'k17 let 17 'sr-cp nth must 'k18 let 18 'sr-cp nth must 'k19 let 19 'sr-cp nth must 'k20 let 20 'sr-cp nth must 'k21 let 21 'sr-cp nth must 'k22 let 22 'sr-cp nth must 'k23 let 23 'sr-cp nth must 'k24 let 24 'sr-cp nth must 'k25 let 25 'sr-cp nth must 'k26 let 26 'sr-cp nth must 'k27 let 27 'sr-cp nth must 'k28 let 28 'sr-cp nth must 'k29 let 29 'sr-cp nth must 'k30 let 30 'sr-cp nth must 'k31 let 31 'sr-cp nth must 'k32 let
   -- sr-sm: (out e w -- out w).  Adds the sample with residual e, and gives the window with it.
   -- REVIEW: Predict with exact 64-bit sums and never wrap a sample to 32 bits. Alternative: wrap as dr_flac does. It costs two operations a sample and changes only a corrupt file whose samples overflow their declared width.
   ('ps-w let 'ps-e let
    sr-o 0 eq (0) (0 'ps-w nth must k1 mul 1 'ps-w nth must k2 mul plus 2 'ps-w nth must k3 mul plus 3 'ps-w nth must k4 mul plus sr-o 4 gt (4 'ps-w nth must k5 mul plus 5 'ps-w nth must k6 mul plus 6 'ps-w nth must k7 mul plus 7 'ps-w nth must k8 mul plus sr-o 8 gt (8 'ps-w nth must k9 mul plus 9 'ps-w nth must k10 mul plus 10 'ps-w nth must k11 mul plus 11 'ps-w nth must k12 mul plus sr-o 12 gt (12 'ps-w nth must k13 mul plus 13 'ps-w nth must k14 mul plus 14 'ps-w nth must k15 mul plus 15 'ps-w nth must k16 mul plus sr-o 16 gt (16 'ps-w nth must k17 mul plus 17 'ps-w nth must k18 mul plus 18 'ps-w nth must k19 mul plus 19 'ps-w nth must k20 mul plus 20 'ps-w nth must k21 mul plus 21 'ps-w nth must k22 mul plus 22 'ps-w nth must k23 mul plus 23 'ps-w nth must k24 mul plus sr-o 24 gt (24 'ps-w nth must k25 mul plus 25 'ps-w nth must k26 mul plus 26 'ps-w nth must k27 mul plus 27 'ps-w nth must k28 mul plus 28 'ps-w nth must k29 mul plus 29 'ps-w nth must k30 mul plus 30 'ps-w nth must k31 mul plus 31 'ps-w nth must k32 mul plus) () if) () if) () if) () if) () if) if fk plus sr-h shr sr-bs sub ps-e plus 'ps-x0 let
    sr-big (ps-x0 0 sr-hw sub lt ps-x0 sr-hw 1 sub gt or (1099511627776) (ps-x0) if) (ps-x0) if 'ps-x let
    ps-x push [] ps-x push ps-w sr-wl 1 sub take-n cat) 'sr-sm let
   'sr-s0 let 'sr-a0 let
   dup reverse [0] 5 (dup cat) repeat cat sr-wl take-n 'sr-w0 let
   sr-o 8 gt (
   sr-a0 sr-s0 sr-w0 0
   (dup sr-np lt) (
     'sr-pi let 'sr-w let
     sr-kb fv-rd 'sr-k let
     sr-pi 1 plus sr-ps mul 'sr-e let
     sr-pi 0 eq (sr-o) (sr-pi sr-ps mul) if 'sr-i0 let
     sr-k sr-esc eq (
       5 fv-rd 'sr-eb let
       sr-i0 sr-w (over sr-e lt) (
         'r-w let 'r-i let 'r-s let 'r-a let
         r-a r-s sr-eb 0 eq (0) (sr-eb fv-sg) if 'r-v let 'r-s2 let 'r-a2 let
         r-v r-w sr-sm 'r-w2 let
         r-a2 r-s2 r-i 1 plus r-w2) while) (
       -- a Rice parameter past 24 can need more than the 32 bits the fast path keeps
       sr-k 24 gt 'sr-ks let sr-k 1 plus 'sr-k1 let
       sr-i0 sr-w (over sr-e lt) (
         'h-w let 'h-i let 'h-s let 'h-a let
         h-s 63 band 32 lt
           (h-s 6 shr 'h-bp let
            h-a 32 shl h-bp 'fb nth must 24 shl bor h-bp 1 plus 'fb nth must 16 shl bor h-bp 2 plus 'fb nth must 8 shl bor h-bp 3 plus 'fb nth must bor
            h-s 288 plus)
           (h-a h-s) if 'h-s2 let 'h-a2 let
         h-s2 63 band 'h-n let
         h-a2 h-n 8 sub shr 255 band 'fq-lz nth must 'h-q let
         h-q 8 eq sr-ks or (
           h-a2 h-s2 fv-uz 'h-q2 let sr-k fv-rd 'h-lo let sr-big h-q2 4294967295 sr-k shr gt and (4294967295) (h-q2 sr-k shl h-lo bor) if) (
           h-q sr-k1 plus 'h-u let
           h-a2 h-s2 h-u sub h-a2 h-n h-u sub shr 1 h-u shl 1 sub band h-q 1 sub sr-k shl plus) if
         'h-m let 'h-s5 let 'h-a5 let
         h-m 4294967295 band 'h-mm let
         sr-big h-mm 4294967295 eq and (4611686018427387904) (h-mm 1 shr 0 h-mm 1 band sub bxor) if h-w sr-sm 'h-w2 let
         h-a5 h-s5 h-i 1 plus h-w2) while) if
     'sr-wn let drop sr-wn sr-pi 1 plus) while drop drop
   )
   -- REVIEW: For orders up to 8, which flac -0 to -6 write, carry the samples as stack values and bind them once a sample, in a second copy of the loops. Alternative: one window loop for every order. It builds and copies a list a sample and is about 15% slower on a real track.
   (7 'sr-w0 nth must 6 'sr-w0 nth must 5 'sr-w0 nth must 4 'sr-w0 nth must 3 'sr-w0 nth must 2 'sr-w0 nth must 1 'sr-w0 nth must 0 'sr-w0 nth must sr-a0 sr-s0 0
   (dup sr-np lt) (
     'sr-pi let
     sr-kb fv-rd 'sr-k let
     sr-pi 1 plus sr-ps mul 'sr-e let
     sr-pi 0 eq (sr-o) (sr-pi sr-ps mul) if 'sr-i0 let
     sr-k sr-esc eq 'j-esc let
     j-esc (5 fv-rd) (0) if 'sr-eb let
     -- a Rice parameter past 24 can need more than the 32 bits the fast path keeps
     sr-k 24 gt 'sr-ks let sr-k 1 plus 'sr-k1 let
     sr-i0 (dup sr-e lt) (
       'j-i let 'j-s let 'j-a let 'j-1 let 'j-2 let 'j-3 let 'j-4 let 'j-5 let 'j-6 let 'j-7 let 'j-8 let
       j-esc (
         j-a j-s sr-eb 0 eq (0) (sr-eb fv-sg) if)
         (j-s 63 band 32 lt
           (j-s 6 shr 'j-bp let
            j-a 32 shl j-bp 'fb nth must 24 shl bor j-bp 1 plus 'fb nth must 16 shl bor j-bp 2 plus 'fb nth must 8 shl bor j-bp 3 plus 'fb nth must bor
            j-s 288 plus)
           (j-a j-s) if 'j-s2 let 'j-a2 let
          j-s2 63 band 'j-n let
          j-a2 j-n 8 sub shr 255 band 'fq-lz nth must 'j-q let
          j-q 8 eq sr-ks or (
            j-a2 j-s2 fv-uz 'j-q2 let sr-k fv-rd 'j-lo let sr-big j-q2 4294967295 sr-k shr gt and (4294967295) (j-q2 sr-k shl j-lo bor) if) (
            j-q sr-k1 plus 'j-u let
            j-a2 j-s2 j-u sub j-a2 j-n j-u sub shr 1 j-u shl 1 sub band j-q 1 sub sr-k shl plus) if
          'j-m let 'j-s5 let 'j-a5 let
          j-m 4294967295 band 'j-mm let
          j-a5 j-s5 sr-big j-mm 4294967295 eq and (4611686018427387904) (j-mm 1 shr 0 j-mm 1 band sub bxor) if) if
