       j-1 k1 mul j-2 k2 mul plus j-3 k3 mul plus j-4 k4 mul plus sr-o 4 gt (j-5 k5 mul plus j-6 k6 mul plus j-7 k7 mul plus j-8 k8 mul plus) () if fk plus sr-h shr sr-bs sub j-e plus
       sr-big (dup 0 sr-hw sub lt over sr-hw 1 sub gt or (drop 1099511627776) () if) () if 'j-x let
       j-x push
       j-7 j-6 j-5 j-4 j-3 j-2 j-1 j-x j-a9 j-s9 j-i 1 plus) while
     drop sr-pi 1 plus) while
   drop 'sr-s9 let 'sr-a9 let drop drop drop drop drop drop drop drop sr-a9 sr-s9)
 if
     'sr-ns let 'sr-na let sr-big (dup 0 ('sr-x let sr-x 1099511627776 eq or) fold 0 eq) (1) if 'sr-ok let sr-na sr-ns sr-ok) if) if) 'fv-sr let
  -- fv-sub: (a s sb bsz -- a s out w st).  One subframe of sb bits a sample, as out and its wasted bits w; st 0 ends the audio.
  ('sf-z let 'sf-b let
   8 fv-rd 'sf-h let
   sf-h 128 band 0 eq not ([] 0 0) (
   sf-h 1 shr 63 band 'sf-t let
   sf-t 0 eq (0 0) (sf-t 1 eq (1 0) (sf-t 32 band 0 eq not (3 sf-t 31 band 1 plus) (
     sf-t 8 band 0 eq not (sf-t 7 band 'sf-x let sf-x 4 gt (4 0) (2 sf-x) if) (4 0) if) if) if) if 'sf-o let 'sf-ky let
   sf-ky 4 eq ([] 0 0) (
   sf-h 1 band (fv-uz 1 plus) (0) if 'sf-w let
   sf-b sf-w sub 'sf-q let
   sf-q 1 lt sf-q gb 32 lt (32) (33) if gt or sf-z sf-o lt or ([] 0 0) (
   sf-ky 0 eq (sf-q fv-sg 'sf-v let 0 sf-z range (drop sf-v) each sf-w 1) (
   [] rot rot 0 (dup sf-ky 1 eq (sf-z) (sf-o) if lt) ('v-j let sf-q fv-sg 'v-v let 'v-s let 'v-a let v-v push v-a v-s v-j 1 plus) while drop
   sf-ky 1 eq (rot sf-w 1) (
   sf-ky 3 eq (
     4 fv-rd 'sf-p0 let
     sf-p0 15 eq (rot 0 0) (
     5 fv-rd 'sf-sh let
     sf-sh 15 gt (rot 0 0) (
     [] (dup len sf-o lt) ((sf-p0 1 plus fv-sg) dip swap push) while 'sf-cf let
     sf-o sf-cf sf-sh sf-z sf-q fv-sr 'sf-ok let rot sf-w sf-ok) if) if) (
     [[] [1] [2 -1] [3 -3 1] [4 -6 4 -1]] sf-o get must 'sf-cf let
     sf-o sf-cf 0 sf-z sf-q fv-sr 'sf-ok let rot sf-w sf-ok) if) if) if) if) if) if) 'fv-sub let
  -- fv-fr: (ob n s ds bsz ca bps -- ob n pos d).  The frame whose header starts at s and whose subframes start at ds, added to ob, which holds n bytes.
  -- pos is where the scan for the next frame goes on. d is the frames the frame gave: 0 when its CRC-16 was bad, -1 when
  -- dr_flac gives up on it, -2 when the audio passes the string limit.
  ('fr-b let 'fr-ca let 'fr-z let 'fr-ds let 'fr-s let 'fr-n let
   fr-ca 0 eq (1) (fr-ca 8 lt (fr-ca 1 plus) (2) if) if 'fr-nc let
   fr-nc gc eq not (fr-n fr-ds -1) (
   0 fr-ds 6 shl
   fr-b fr-ca 9 eq (1 plus) () if fr-z fv-sub 'fr-t0 let 'fr-w0 let 'fr-o0 let
   fr-nc 2 eq (fr-t0 (fr-b fr-ca 8 eq fr-ca 10 eq or (1 plus) () if fr-z fv-sub) ([] 0 0) if) ([] 0 1) if 'fr-t1 let 'fr-w1 let 'fr-o1 let
   'fr-s2 let 'fr-a2 let
   fr-s2 6 shr fr-s2 63 band 3 shr sub 'fr-q let
   fr-t0 fr-t1 and not fr-q 2 plus fz gt or (fr-n fr-q fz min -1) (
   fr-s fr-q fv-c16 fr-q 'fb nth must 8 shl fr-q 1 plus 'fb nth must bor eq not (fr-n fr-q 2 plus 0) (
   fr-n fr-z 4 mul plus 1073741824 gt (fr-n -2 -2) (
   fr-w0 0 gt (fr-o0 (fr-w0 shl) each) (fr-o0) if 'fr-x0 let
   fr-w1 0 gt (fr-o1 (fr-w1 shl) each) (fr-o1) if 'fr-x1 let
   -- one pass over the samples: the channels, then 16 bits of each as two bytes, low first. At 16 bits per sample nothing shifts.
   -- REVIEW: Branch on the channel layout in each sample of one fold. Alternative: one loop per layout. It saves 3 ops a sample and costs four copies of the byte code.
   0 fr-z range [] (
     fr-nc 1 eq ('fr-x0 nth must dup) (
       dup 'fr-x0 nth must swap 'fr-x1 nth must
       fr-ca 7 gt (
         fr-ca 10 eq ('o-y let 'o-x let o-y 1 band o-x 1 shl bor 'o-m let o-m o-y plus 2 div o-m o-y sub 2 div) (
         fr-ca 8 eq ('o-y let dup o-y sub) ('o-y let o-y plus o-y) if) if) () if) if
     fr-b 16 eq () (16 shl fr-b shr 65535 band swap 16 shl fr-b shr 65535 band swap) if
     'o-r let 'o-l let
     o-l 255 band push o-l 8 shr 255 band push o-r 255 band push o-r 8 shr 255 band push) fold cat fr-n fr-z 4 mul plus fr-q 2 plus fr-z) if) if) if) if) 'fv-fr let
  -- fx-sn: (s -- n).  The sample number of the frame header at s: its UTF-8 number, times the block size when that is fixed.
  ('sn-s let sn-s 4 plus 'fb nth must 'sn-b let sn-b 255 bxor 'fq-lz nth must 'sn-l let
   sn-l 0 eq (sn-b) (sn-s 5 plus sn-s 4 plus sn-l plus range sn-b 1 7 sn-l sub shl 1 sub band ('sn-x let 6 shl sn-x 'fb nth must 63 band bor) fold) if
   sk-bs 0 eq () (sk-bs mul) if) 'fx-sn let
  -- fx-chk: (s -- sn).  The sample number of the frame header at s, or -1 when s holds no header that fits this stream:
  -- a CRC-8 header with the channels and the sample rate of STREAMINFO, a block size within its maximum, and a sample number inside the file.
  ('ck-s let
   ck-s fv-hd 'ck-b let 'ck-ca let 'ck-z let 'ck-x let 'ck-k let
   ck-s 2 plus 'fb nth must 15 band 'ck-rc let
   ck-k 0 eq not (-1) (
   ck-ca 0 eq (1) (ck-ca 8 lt (ck-ca 1 plus) (2) if) if gc eq not (-1) (
   ck-z sk-bm gt (-1) (
   ck-rc 0 eq ck-rc 11 gt or (1) ([0 88200 176400 192000 8000 16000 22050 24000 32000 44100 48000 96000] ck-rc get must gr eq) if not (-1) (
   ck-s fx-sn 'ck-n let
   gn 0 eq not ck-n gn ge and (-1) (ck-n) if) if) if) if) if) 'fx-chk let
