  x-m 0 eq (
   x-d 'p at 'x-p0 let x-d 'ic at 'x-ic0 let x-d 'skip at 'x-sk0 let
   x-k x-sk0 plus 4 mul 'x-lim let
   -- the stack holds ob n ic p go: go is 0 once p ends the file or the chunk is full
   [] 0 x-ic0 x-p0 x-p0 0 lt not
   (dup) (
    drop 'p let 'ic let
    p fv-sy 'sy let
    sy 0 lt (fz -1) (
      sy fv-hd 'hd-b let 'hd-c let 'hd-z let 'hd-x let 'hd-k let
      hd-k 0 eq (sy hd-x hd-z hd-c hd-b fv-fr) (hd-k 1 eq (hd-x 0) (hd-x -1) if) if) if
    'f-d let 'f-pos let
    -- dr_flac's reader asks for 4096 frames at a time and stops when one ask gives none. A frame it gives up on ends an ask
    -- that already holds frames, and the next ask scans on from there: one retry, then the end. ic counts the frames
    -- in the ask, mod 4096.
    -- REVIEW: Copy those asks, so a damaged frame in mid-file is skipped once, as dr_flac skipped it. Alternative: end the audio at the first frame that fails. It is simpler, but a file whose frames are not 4096 samples long then gives less audio than read-flac.
    f-d -2 eq (ic -2) (f-d -1 eq (ic 0 eq (ic -1) (0 f-pos) if) (ic f-d plus 4096 mod f-pos) if) if
    'np let 'nic let 'nn let
    nn nic np nn x-lim lt np 0 lt not and) while
   drop 'x-p let 'x-ic let 'x-n let
   x-sk0 4 mul x-n min 'x-dr let
   x-dr 0 eq () (x-dr drop-n) if
   fb x-d x-p 'p into x-ic 'ic into x-n x-dr sub 4 div x-d 'at at plus 'at into x-sk0 x-dr 4 div sub 'skip into
   rot) (
   x-d 'f0 at fz fx-hs 'lo-n let 'lo-s let
   lo-s 0 lt (fb x-d -1 'p into x-k 'at into 0 'skip into "") (
    -- lo is a header whose sample number is at most k, and all headers from hi on are past k
    lo-s lo-n fz 0
    ('cq-c let 'cq-h let 'cq-n let 'cq-s let cq-s cq-n cq-h cq-c cq-s 1 plus cq-h lt cq-c 64 lt and) (
      'q-c let 'q-h let 'q-n let 'q-s let
      q-s q-h plus 2 div 'q-x let
      q-x q-h fx-hs 'q-hn let 'q-hs let
      q-hs 0 lt (q-s q-n q-x q-c 1 plus) (
      q-hn x-k gt (q-s q-n q-hs q-c 1 plus) (q-hs q-hn q-h q-c 1 plus) if) if) while
    'z-c let 'z-h let 'z-n let 'z-s let
    z-s 1 plus z-h lt ("flac: seek: " z-c int-str cat " halvings did not find the frame of sample " cat x-k int-str cat "; expected at most 64" cat fail) () if
