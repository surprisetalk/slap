    fb x-d z-s 'p into 0 'ic into z-n z-k plus 'at into z-k 'skip into "") if) if) 'fx let
(flac-open {
  'ok (1099511627776 0 fx 'fd-c let 'fd-d let drop
       fd-d fx-end {'ok (drop {'rate fd-d 'rate at 'pcm fd-c} ok) 'no (no)} case)
  'no (nip no)} case) 'flac-decode let
(dup 'p at 0 lt (dup fx-end) (8192 0 fx dup len 0 eq (drop dup fx-end) (ok) if) if) 'flac-next let
('fs-t let 'fs-d let
 fs-t 0 le (fs-d dup 'f0 at 'p into 0 'ic into 0 'at into 0 'skip into) (
 fs-d 'total at 0 eq not fs-t fs-d 'total at ge and
  (fs-d fs-d 'total at 'at into -1 'p into 0 'skip into) (fs-d fs-t 1 fx drop) if) if) 'flac-seek let

-- ===== tests =====
(flac-decode {'ok (drop "") 'no ()} case) 'ft-err let
(flac-decode must 'pcm at) 'ft-pcm let
-- ft-t0: (bytes -- bytes).  The STREAMINFO length becomes 0, which means unknown.
(dup 22 take-n [0 0 0 0] cat swap 26 drop-n cat) 'ft-t0 let
-- Four small files made by an independent FLAC writer and checked against dr_flac. ft-f1 is stereo 16-bit in four frames
-- of 8 samples: independent channels (verbatim, constant), mid/side (fixed 2, LPC 3 in Rice2 with an escape partition),
-- left/side (LPC 2, fixed 1) and right/side (fixed 3 in two partitions, verbatim). ft-f2 is mono 8-bit with one wasted bit,
-- ft-f3 stereo 24-bit with escape partitions, ft-f4 stereo 12-bit (header code 2) in mid/side.
