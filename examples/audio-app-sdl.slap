-- The window and speakers for audio-app.slap: a directory's tracks, played
-- in order. Run from the repo root with:
--
--   cat examples/lib/{strings,cbor,icn,ufx,ui,wav,flac,mp3}.slap examples/audio-app.slap \
--       examples/lib/ui-sdl.slap examples/audio-app-sdl.slap \
--     | ./slap-sdl state.cbor ~/Music/album
--
-- With no directory named, it opens the directory played last, at its track
-- and place. j k or down up move the highlight; enter plays the highlighted
-- track from its start; space pauses and plays. A track plays to its end,
-- then the next; after the last, it stops at the first. Each pause and track
-- writes the place to the state file, and so does each 10 s of play. Closing
-- the window quits. A track streams: each tick decodes one chunk into play
-- while under a second of audio is queued.

args len 1 lt args len 2 gt or ("audio: usage: ./slap-sdl STATE.cbor [DIR]" fail) () if
args 0 get must 'STATE let

-- A missing state file is a first run. A path inside a plain file counts as
-- missing too; the save at startup then stops the app.
STATE read {
  'ok (state-decode {'ok () 'no ("audio: " STATE cat ": " cat swap cat ". Fix or delete it." cat fail)} case)
  'no ('rd-err let rd-err STATE is-missing ({'dir "" 'track "" 'ms 0}) ("audio: " rd-err cat fail) if)
} case 'STATE0 let
args len 2 eq (args 1 get must) (STATE0 'dir at) if 'DIR let
DIR len 0 eq ("audio: no directory named, and " STATE cat " names none played before. Usage: ./slap-sdl STATE.cbor [DIR]" cat fail) () if
DIR ls {'ok () 'no ("audio: " swap cat fail)} case audio-tracks 'TRACKS let
TRACKS len 0 eq ("audio: " DIR cat " holds no .mp3, .flac or .wav file" cat fail) () if

-- The state's place, in the directory it names; another directory starts at
-- its first track. A track the directory no longer holds stops the app.
STATE0 'dir at DIR eq (
  TRACKS STATE0 'track at index-of {'ok () 'no (drop
    "audio: " STATE cat " places " cat STATE0 'track at cat ", which " cat DIR cat
    " no longer holds. Delete " cat STATE cat " to start from the first track." cat fail)} case
  STATE0 'ms at) (0 0) if 'START-MS let 'START-AT let
START-MS 0 lt ("audio: " STATE cat " places " cat STATE0 'track at cat " at " cat START-MS int-str cat
  " ms, but a place counts from 0. Fix or delete the state file." cat fail) () if

-- keep: (m ms -- m).  The state file now names the track m plays, at ms. It
-- is written at startup too, so a path that cannot be written stops the app
-- before the first track.
('kp-ms let 'kp-m let
 STATE {'dir DIR 'track kp-m 'at at 'TRACKS nth must 'ms kp-ms} state-encode write {'ok (drop) 'no ("audio: " swap cat fail)} case
 kp-m kp-ms 'saved into) 'keep let

-- play-at: (bytes dec m -- bytes dec m).  Open m's track, seek to its 'ms and
-- empty the queue; the ticks then queue its chunks. A track that does not open
-- shows its message and stays paused. An empty pcm empties play's queue.
('pa-m let drop drop DIR "/" cat pa-m 'at at 'TRACKS nth must cat open-track
 dup len 0 eq (drop dec-rate 'pa-r let dec-total 'pa-t let
    pa-r pa-m 'ms at seek-frame seek-dec {'rate 44100 'pcm ""} play
    pa-m pa-r pa-t audio-started)
  ('pa-e let {'rate 44100 'pcm ""} play pa-m pa-e 'err into [] 'run into [] 'total into) if) 'play-at let

-- pause: (bytes dec m -- bytes dec m).  An empty pcm stops the speakers.
('pz-m let pz-m queued audio-pos 'pz-pos let
 {'rate 44100 'pcm ""} play
 pz-m pz-pos 'ms into [] 'run into pz-pos keep) 'pause let

-- advance: (bytes dec m -- bytes dec m).  The next track from its start, or after the last, the
-- first track, paused. The highlight follows unless it was moved away.
('av-m let av-m 'at at 1 plus 'av-at let av-m 'sel at av-m 'at at eq 'av-follow let
 av-at TRACKS len lt (av-m av-at 'at into 0 'ms into play-at) (av-m 0 'at into 0 'ms into [] 'run into [] 'total into) if
 av-follow (dup 'at at 'sel into) () if 0 keep) 'advance let

-- draw: (view --).  The highlight shows inverted and the playing track on
-- dark grey; the status takes the last row.
('dv let 0 clear dv 'w at 'dw let dv 'h at 'dh let dw dh audio-layout 'dl let
 dl 's at 'ds let dl 'lh at 'dlh let dl 'x at 'dx let
 dv 'rows at 0 ('dr let 'di let dlh di dlh mul plus 'dy let
   dr 'sel at (dx ds sub dy dw dx 2 mul sub ds 2 mul plus dlh 3 fill-rect 0) (
     dr 'at at (dx ds sub dy dw dx 2 mul sub ds 2 mul plus dlh 1 fill-rect 3) (3) if) if 'dc let
   dr 'text at dx dy ds plus dc ds dw dx sub text di 1 plus) fold drop
 dv 'status at dx dh dlh 2 mul sub 2 ds dw dx sub text) 'draw let

"" {} 'none tag TRACKS START-AT START-MS audio-model START-MS keep

-- pump: (bytes dec m -- bytes dec m).  Decode one chunk and queue it. A chunk
-- that fails shows its message and stops the track there.
('pu-m let next-dec {
  'ok ('pu-p let pu-p len 0 eq (pu-m run-done) (
    pu-m 'run at 0 get must 'rate at 'pu-r let
    {'rate pu-r 'pcm pu-p} play pu-m pu-p len run-add) if)
  'no ('pu-e let pu-m pause [pu-m 'at at 'TRACKS nth must ": " cat pu-e cat] 'err into)} case) 'pump let

-- step: (bytes dec m -- bytes dec m).  While playing: a track ends when its
-- decoder is done and play has nothing queued; else a chunk is decoded when
-- under a second of audio is queued.
(dup 'run at 'sp-r let sp-r len 0 eq () (
   sp-r 0 get must 'sp-t let
   sp-t 'done at 1 eq (queued 0 eq (advance) () if) (queued sp-t 'rate at 4 mul lt (pump) () if) if) if) 'step let

('rh let 'rw let rw 'w into rh 'h into [] 'shown into) 'resize on
('kk let 'km let
 kk 13 eq (km km 'sel at 'at into 0 'ms into play-at 0 keep) (
 kk 32 eq (km 'run at len 0 gt (km pause) (km play-at) if) (km kk audio-key) if) if) 'keydown on
('tf let step 'tk let
 tk queued audio-pos 'tp let
 tk 'run at len 0 gt tp tk 'saved at sub 10000 ge and (tk tp keep) (tk) if 'tq let
 [tq tp audio-view] 'tv let
 tv tq 'shown at eq (tq) (0 'tv nth must draw tq tv 'shown into) if) 'tick on

(drop) show
