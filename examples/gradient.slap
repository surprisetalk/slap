-- Fantasy console: a gradient that fills the window
-- Run with: ./slap-sdl < examples/gradient.slap

-- model is the canvas size
{'w 0 'h 0}

-- on resize: keep the new size. show runs this once before the first frame
-- and again each time the window changes size.
('rh let 'rw let rw 'w into rh 'h into) 'resize on

-- render: four diagonal bands, black at the top left to white at the bottom
-- right. Band c holds the pixels whose x + y falls in [c*B, (c+1)*B), so each
-- row is four fill-rects; pixel by pixel, a full-screen canvas is too slow.
('m let m 'w at 'W let m 'h at 'H let
  W H plus 4 div 1 plus 'B let
  0 (dup H lt) ('y let
    0 (dup 4 lt) ('c let c B mul y sub y B 1 c fill-rect c 1 plus) while drop
    y 1 plus) while drop
) show
