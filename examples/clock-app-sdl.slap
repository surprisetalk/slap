-- The window for clock-app.slap: the time, big, with the date and the
-- stopwatch under it. Run from the repo root with:
--
--   cat examples/lib/{strings,icn,ufx,ui}.slap examples/clock-app.slap \
--       examples/lib/ui-sdl.slap examples/clock-app-sdl.slap | ./slap-sdl
--
-- Space starts and stops the stopwatch, r sets it to zero. Closing the window
-- quits.

-- centred: (str y color scale w --).  Centred in a window w wide.
('cw-w let 'cw-s let 'cw-col let 'cw-y let 'cw-str let
 cw-str cw-w cw-str text-width cw-s mul sub 2 div cw-y cw-col cw-s cw-w text) 'centred let

-- draw: (w h lines --).  The first line fills 9/10 of the width or half the
-- height. Each other line is a third of its size, or less to fit that width.
-- A gap of a quarter line goes above each other line. A glyph cell is 16
-- pixels high.
('dl let 'dh let 'dw let 0 clear
 0 'dl nth must 'd0 let dw 9 mul 10 div 'dfit let
 dfit d0 text-width 1 max div dh 2 div 16 div min 1 max 'ds0 let
 dl 1 drop-n 'drest let
 drest ds0 3 div (text-width 1 max dfit swap div min) fold 1 max 'ds1 let
 16 ds0 mul drest len 20 ds1 mul mul plus 'dtall let
 dh dtall sub 2 div 'dy let
 d0 dy 3 ds0 dw centred
 drest dy 16 ds0 mul plus 4 ds1 mul plus ('rl let 'ry let rl ry 2 ds1 dw centred ry 20 ds1 mul plus) fold drop) 'draw let

clock-model

('rh let 'rw let rw 'w into rh 'h into [] 'shown into) 'resize on
('kk let 'km let km kk millis clock-key) 'keydown on
('tf let 'tm let tm datetime millis clock-lines 'tl let
 tl tm 'shown at eq (tm) (tm 'w at tm 'h at tl draw tm tl 'shown into) if) 'tick on

(drop) show
