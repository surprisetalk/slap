-- feed.slap: RSS 2.0 and Atom feed reader. Prints a plain-text digest.
--
--   cat examples/lib/strings.slap examples/lib/parse.slap examples/lib/xml.slap \
--       examples/lib/rss.slap examples/feed.slap | ./slap [feed.xml]
--
-- Default source is examples/feeds/sample.xml. rss-parse normalizes both
-- formats to one record shape, so nothing below this line knows which it read.
--
([] 10 push) 'LF let

args len 0 gt (args 0 get must) ("examples/feeds/sample.xml") if 'SRC let
64 'SUM-CAP let
512 'TEXT-CAP let

-- cut: (s n -- s').  At most n bytes of s. When byte n is inside a UTF-8
-- character, the cut moves back to the character's first byte, so no character
-- splits. A character spans at most 4 bytes, so the first byte is at most 3
-- back; a continuation byte (10xxxxxx) with no first byte that close is not
-- part of a character, and the cut stays at n.
('n let 'u let
 u len n gt (
   n (dup dup n 3 sub gt swap 0 gt and (dup 'u nth must 192 band 128 eq) (0) if) (1 sub) while 'k let
   k 'u nth must 'b let
   -- the character's length from its first byte; 0 for a continuation byte
   b 128 lt (1) (b 224 band 192 eq (2) (b 240 band 224 eq (3) (b 248 band 240 eq (4) (0) if) if) if) if
   n k sub gt (u k take-n) (u n take-n) if) (u) if) 'cut let

-- Feed text carries the source document's newlines and indentation. Collapse
-- every run of whitespace to one space, then trim both ends. Pairing the string
-- with itself shifted by one is how each byte gets to see its predecessor.
--
-- Cut to TEXT-CAP first: collapsing runs only shortens a string, so cutting
-- before is the same as cutting after for anything that reaches the screen.
('sq-in let
 sq-in TEXT-CAP cut
 [] ('c let c 33 lt (32) (c) if push) fold 'norm let
 norm [] 32 push norm cat zip
   (dup 0 get must 32 eq swap 1 get must 32 eq and not) filter
   (0 get must) each
 dup len 0 gt (dup 0 get must 32 eq (1 drop-n) () if) () if
 dup len 0 gt (dup dup len 1 sub get must 32 eq (dup len 1 sub take-n) () if) () if
) 'squeeze let

('cl let cl squeeze 'cs let
 cs len SUM-CAP gt (cs SUM-CAP cut "..." cat) (cs) if) 'clip let

('n let n int-str dup len 2 lt (" " swap cat) () if) 'num2 let

-- plain: (markup -- text).  Titles, descriptions and summaries are markup, so
-- AT&amp;T prints as AT&T; tags print as they are. The markup comes from
-- xml-render, so each entity in it decodes.
(xml-unescape must) 'plain let

-- A field the feed leaves out prints nothing, and so does an empty one: a feed
-- that omits <pubDate> should look omitted, not blank.
({'ok ('iv let iv len 0 gt ("    " iv squeeze cat LF cat) ("") if) 'no (drop "")} case) 'field let

-- item-block: (item -- text).  Everything after the item's number.
('it let it rss-item-title {'ok (plain squeeze) 'no (drop "")} case LF cat
  it rss-item-published field cat
  it rss-item-link field cat
  it rss-item-summary (plain clip ok) then field cat) 'item-block let

-- A read that fails is fatal: a digest of a file we could not open would be an
-- empty digest, which reads as an empty feed. `must` prints the path it failed
-- on, so nothing here has to restate it.
SRC read must 'RAW let

RAW rss-parse 'PARSED let

PARSED {'ok (drop "") 'no ()} case 'PERR let
PERR len 0 gt ("feed: " SRC cat " is not a feed -- " cat PERR cat fail) () if

PARSED must 'FEED let

-- The digest is built as one string and written once: a write per line opens
-- /dev/stdout each time. Items are numbered by zipping a list of "N. " prefixes
-- with the rendered items, since reading `ITEMS i get` would walk the list for
-- every item.
FEED rss-items 'ITEMS let
"== " FEED rss-title plain squeeze cat " (" cat FEED rss-kind cat ")" cat LF cat
FEED rss-link field cat
FEED rss-description (plain ok) then field cat
1 ITEMS len 1 plus range (num2 ". " cat LF swap cat) each
ITEMS (item-block) each zip ('p let p 0 get must p 1 get must cat) each
swap (cat) fold
LF cat ITEMS len int-str cat " item" cat ITEMS len 1 eq ("") ("s") if cat LF cat
"/dev/stdout" swap write must drop
