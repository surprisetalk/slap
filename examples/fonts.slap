-- Font Book — two-pane viewer with editable preview
-- Run with: ./slap-sdl < examples/fonts.slap

-- Draw one byte as 8 horizontal pixels (MSB = leftmost)
(
  'dc let 'py let 'px let 'b let
  b 128 band 0 neq (px     py dc pixel) () if
  b  64 band 0 neq (px 1 plus py dc pixel) () if
  b  32 band 0 neq (px 2 plus py dc pixel) () if
  b  16 band 0 neq (px 3 plus py dc pixel) () if
  b   8 band 0 neq (px 4 plus py dc pixel) () if
  b   4 band 0 neq (px 5 plus py dc pixel) () if
  b   2 band 0 neq (px 6 plus py dc pixel) () if
  b   1 band 0 neq (px 7 plus py dc pixel) () if
) 'draw-byte let

-- Draw one character from raw font bytes; nth reads raw by name, so no per-byte copy
(
  'dc let 'gy let 'gx let 'ch let 'n let 'raw let
  ch n n mul 8 mul mul 256 plus 'base let
  0
  (dup n n mul lt) (
    dup 'ti let
    ti n div 8 mul gx plus 'tx let
    ti n mod 8 mul gy plus 'ty let
    0
    (dup 8 lt) (
      dup 'row let
      base ti 8 mul plus row plus 'raw nth must
      tx ty row plus dc draw-byte
      1 plus
    ) while
    drop
    1 plus
  ) while
  drop
) 'draw-char let

-- Draw a string, no wrapping
(
  'dc let 'sy let 'sx let 'str let 'n let 'raw let
  sx 0
  (dup str len lt) (
    dup 'si let
    swap 'cx-cur let
    str si get must 'ch let
    ch 'raw nth must 'w let
    w 0 gt (
      raw n ch cx-cur sy dc draw-char
      cx-cur w plus 1 plus
    ) (cx-cur) if
    swap
    1 plus
  ) while
  drop drop
) 'draw-text let

-- Draw text with wrapping, clipped at row mh; returns cur-x cur-y on stack
(
  'dc let 'mh let 'maxw let 'sy let 'sx let 'str let 'n let 'raw let
  n 8 mul 'rh let
  sx sy 0
  (dup str len lt) (
    dup 'si let
    rot 'cx-cur let swap 'cy-cur let
    str si get must 'ch let
    ch 'raw nth must 'w let
    w 0 gt (
      cx-cur w plus sx maxw plus gt
        (sx cy-cur rh 2 plus plus) (cx-cur cy-cur) if
      'cy2 let 'cx2 let
      cy2 mh lt (
        raw n ch cx2 cy2 dc draw-char
      ) () if
      cx2 w plus 1 plus cy2
    ) (cx-cur cy-cur) if
    rot
    1 plus
  ) while
  drop
) 'draw-text-wrap let

-- N from filename last char
(last 49 sub 1 plus) 'font-n let

-- Font catalog
[
  "chicago12.uf2"
  "geneva12.uf2"        "geneva14.uf2"        "geneva24.uf3"
  "helvetica12.uf2"     "helvetica14.uf2"     "helvetica24.uf3"
  "times12.uf2"         "times15.uf2"         "times24.uf3"
  "newyork12.uf2"       "newyork14.uf2"       "newyork24.uf3"
  "palatino12.uf2"      "palatino14.uf2"      "palatino24.uf3"
  "monaco12.uf2"        "courier12.uf2"       "terminal12.uf2"
  "venice14.uf2"        "losangeles12.uf2"
  "sapphire14.uf2"      "sapphire19.uf3"
  "diamond12.uf2"       "diamond20.uf3"
  "cream.uf2"           "fool.uf2"            "jgs7.uf2"
  "sans10-regular.uf2"  "sans10-bold.uf2"
  "sans12-regular.uf2"  "sans12-bold.uf2"
  "sans14-regular.uf2"  "sans14-bold.uf2"
  "msx816.uf2"          "irisdot.uf3"
  "atari8.uf1"          "acorn8-regular.uf1"  "acorn8-italic.uf1"
  "bbcmicro8.uf1"       "orca8.uf1"           "specter8.uf1"
  "left8.uf1"           "816.uf1"
] 'fnames let
fnames len 'nf let

-- Layout
180 'PW let

-- Each font file is read once: the label font here, the selected font on selection
"fonts/chicago12.uf2" read must 'lf let
('s let "fonts/" s 'fnames nth must cat read must) 'load-font let

-- State: record on stack, modified by keydown, read must by show.
-- w and h are the canvas size.
{} 0 'sel into "The quick brown fox jumps over the lazy dog" 'txt into
0 'w into 0 'h into 0 load-font 'raw into

-- on resize: keep the canvas size
('rh let 'rw let rw 'w into rh 'h into) 'resize on

(
  'key let
  key 1073741906 eq ((1 sub 0 max) 'sel edit  dup 'sel at load-font 'raw into) (
  key 1073741905 eq ((1 plus nf 1 sub min) 'sel edit  dup 'sel at load-font 'raw into) (
  key 8 eq key 127 eq or (
    dup 'txt at len 0 gt ((dup len 1 sub take-n) 'txt edit) () if
  ) (
    key 32 ge key 126 le and ((key push) 'txt edit) () if
  ) if) if) if
) 'keydown on

(
  drop
  dup 'sel at 'sel-v let
  dup 'txt at 'txt-v let
  dup 'raw at 'raw let
  dup 'w at 'cw let
  dup 'h at 'ch let
  3 clear

  -- Auto-scroll left pane so selection is visible
  sel-v 16 mul 'sely let
  sely ch 2 div 10 sub sub 0 max 'lscr let

  -- Left pane header
  0 0 PW 14 1 fill-rect
  lf 2 "Fonts" 4 0 3 draw-text

  -- Font list
  0
  (dup nf lt) (
    dup 'li let
    li 16 mul 16 plus lscr sub 'ly let
    ly 14 ge ly 16 plus ch le and (
      li 'fnames nth must dup len 4 sub take-n 'dn let
      li sel-v eq (
        0 ly PW 16 0 fill-rect
        lf 2 dn 4 ly 1 plus 3 draw-text
      ) (
        lf 2 dn 4 ly 1 plus 0 draw-text
      ) if
    ) () if
    1 plus
  ) while
  drop

  -- Right pane header
  PW 1 plus 0 cw PW sub 1 sub 14 1 fill-rect

  -- Divider (full height, over headers)
  PW 0 1 ch 1 fill-rect
  sel-v 'fnames nth must dup len 4 sub take-n 'sdn let
  lf 2 sdn PW 8 plus 0 3 draw-text

  sel-v 'fnames nth must font-n 'pn let
  pn 8 mul 'ph let
  cw PW sub 16 sub 'pw let

  -- Editable text preview
  raw pn txt-v PW 8 plus 22 pw ch 0 draw-text-wrap
  'cur-y let 'cur-x let

  -- Cursor
  millis 500 div 2 mod 1 eq (
    cur-x cur-y ph plus cur-x cur-y sub 1 min 1 0 fill-rect
    cur-x cur-y 1 ph 0 fill-rect
  ) () if

  -- Separator
  PW 2 plus cur-y ph plus 8 plus pw 1 1 fill-rect

  -- Glyph grid: fixed cell len, 16 columns
  pn 8 mul 2 plus 'gw let
  16 'cols let
  cur-y ph plus 16 plus 'gy0 let
  32
  (dup 128 lt) (
    dup 'gc let
    gc 32 sub 'gi let
    gi cols mod gw mul PW 8 plus plus 'gcx let
    gi cols div ph 2 plus mul gy0 plus 'gcy let
    gcy ph plus ch le (
      raw pn gc gcx gcy 0 draw-char
    ) () if
    1 plus
  ) while
  drop
) show
