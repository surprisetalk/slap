-- maze-sdl.slap: the SDL shell for maze.slap. It draws a maze, and any key
-- builds another. The cells grow to the largest whole-pixel size that fits the
-- window, and the maze sits in the middle.
--
--   cat examples/maze.slap examples/maze-sdl.slap | ./slap-sdl

-- model: the maze and the canvas size
{'w 0 'h 0 'st build}

(drop (drop build) 'st edit) 'keydown on

('rh let 'rw let rw 'w into rh 'h into) 'resize on

('m let
  m 'w at 'cw let  m 'h at 'ch let  m 'st at 'st let
  cw GW div 'sw let  ch GH div 'sh let
  sw sh min 'S let
  cw GW S mul sub 2 div 'OX let
  ch GH S mul sub 2 div 'OY let
  0 clear
  0 (dup GN lt) (
    'i let
    i 'st nth must 'v let
    v 1 eq (0) (v 2 eq (3) (1) if) if 'col let
    i GW mod S mul OX plus  i GW div S mul OY plus  S S col fill-rect
    i 1 plus
  ) while drop) show
