-- plasma.slap: render a plasma field and write it as a real 24-bit TGA. No SDL.
--
--   cat examples/lib/strings.slap examples/lib/parse.slap examples/lib/tga.slap examples/plasma.slap | ./slap [OUT.tga] [SIZE]
--
-- Defaults: plasma.tga at 64x64. Open the result in any image viewer.
--
-- Two things about the format that tga.slap does not enforce and a writer has
-- to get right: channels are stored B, G, R (not R, G, B), and with descriptor
-- byte 17 set to 0 the origin is bottom-left, so the first row written is the
-- bottom row of the picture. Get either wrong and the file is still a valid
-- TGA -- just colour-swapped or upside down.

([] 10 push) 'LF let
('st let "/dev/stdout" st LF cat write must drop) 'say let
('et let "/dev/stderr" et LF cat write must drop 0 assert) 'die let

args len 0 gt (args 0 get must) ("plasma.tga") if 'OUT let
args len 1 gt (args 1 get must ok parse-int must len 0 eq assert) (64) if 'N let

N 1 lt (
  "plasma: size must be at least 1" die) () if

-- ===== float helpers =====

-- fsin: Bhaskara I's sine approximation, c. 1150. Maximum error about 0.0016
-- over a full turn, which is under one step of a 256-level channel.
--   sin t ~ 16 t (pi - t) / (5 pi^2 - 4 t (pi - t))    for 0 <= t <= pi
-- Reduce to [0, tau) with ffloor, then mirror the upper half and negate.
-- There is no sin primitive; this is the whole reason the float family exists
-- on this page.
('t0 let
 t0 tau fdiv ffloor tau fmul t0 swap fsub 'tr let
 tr pi fgt (tr pi fsub) (tr) if 'tm let
 tm pi tm fsub fmul 'q let
 16.0 q fmul 5.0 pi pi fmul fmul 4.0 q fmul fsub fdiv 'sv let
 tr pi fgt (sv fneg) (sv) if) 'fsin let

(pi 2.0 fdiv fplus fsin) 'fcos let

-- 0.0..1.0 float to a 0..255 byte, saturating rather than wrapping
('cv let cv 1.0 flt (cv) (1.0) if dup 0.0 fgt () (drop 0.0) if 255.0 fmul fround ftoi) 'chan let

-- ===== the field =====

-- Plane waves in x, y and x+y, a radial ripple, and a logarithmic spiral
-- (angle plus log radius is what makes the arms curl rather than radiate).
-- Sums to roughly -5..5.
('ny let 'nx let
 6.0 nx fmul fsin
 6.0 ny fmul fsin fplus
 5.0 nx ny fplus fmul fsin fplus
 nx nx fmul ny ny fmul fplus fsqrt 'rr let
 8.0 rr fmul fsin fplus
 ny nx fatan2 3.0 fmul  rr 1.0 fplus flog 6.0 fmul  fplus fsin fplus) 'field let

-- exp(-r^2): a soft vignette, so the frame is dark and the eye lands centre
('vr let vr vr fmul fneg fexp) 'vignette let

-- ===== render =====

N itof 2.0 fdiv 'HALF let

-- y counts from the bottom, which is the order a descriptor-0 TGA stores rows,
-- so no flip is needed anywhere.
0 N range [] ('py let
  py itof HALF fsub HALF fdiv 'ny let
  0 N range ('px let
    px itof HALF fsub HALF fdiv 'nx let
    nx nx fmul ny ny fmul fplus fsqrt vignette 'vg let
    nx ny field 5.0 fdiv 'v let
    []
      0.5 0.5 pi v fmul tau 2.0 fmul 3.0 fdiv fplus fsin fmul fplus vg fmul chan push   -- B
      0.5 0.5 pi v fmul tau 3.0 fdiv fplus fsin fmul fplus vg fmul chan push           -- G
      0.5 0.5 pi v fmul fsin fmul fplus vg fmul chan push                            -- R
  ) each flatten
  cat) fold
'PIXELS let

PIXELS len N N mul 3 mul eq assert

OUT N N 24 PIXELS tga-header write must drop

-- ===== self-test: read back what we just wrote =====

OUT read must tga-decode must 'IMG let
IMG 'width  at N eq assert
IMG 'height at N eq assert
IMG 'depth  at 24 eq assert
IMG 'pixels at len N N mul 3 mul eq assert
-- a plasma that came out one flat colour means the field collapsed
IMG 'pixels at dedup len 1 gt assert

"plasma: wrote " OUT cat " (" cat N int-str cat "x" cat N int-str cat ", 24-bit TGA)" cat say
