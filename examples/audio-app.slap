-- audio-app.slap: the player's tracks, places, keys and state file. The
-- window and the speakers are audio-app-sdl.slap; this file holds no SDL
-- word, so its self-test runs in the terminal build:
--
--   cat examples/lib/{strings,cbor,icn,ufx,ui}.slap examples/audio-app.slap \
--     | ./slap --headless

-- ===== tracks =====
-- str-lt: (a b -- int).  1 when a sorts before b, byte by byte.
('sl-b let 'sl-a let sl-a len sl-b len min 'sl-n let
 0 (dup sl-n lt (dup 'sl-a nth must over 'sl-b nth must eq) (0) if) (1 plus) while 'sl-i let
 sl-i sl-n lt (sl-i 'sl-a nth must sl-i 'sl-b nth must lt) (sl-a len sl-b len lt) if) 'str-lt let

-- sort-strs: (strs -- strs).  An insertion sort: quadratic, but a
-- directory of tracks holds tens of names, not thousands.
([] ('ss-x let 'ss-acc let ss-acc (ss-x str-lt) filter ss-x push ss-acc (ss-x str-lt not) filter cat) fold) 'sort-strs let

-- track-ext: (name -- ext).  The name after its last dot, in lower case;
-- "" for a name with no dot.
("." str-split dup len 2 lt (drop "") (dup len 1 sub get must lower) if) 'track-ext let

-- audio-tracks: (names -- tracks).  The names a directory lists that audio
-- plays, in byte order.
((track-ext 'tx-e let tx-e "mp3" eq tx-e "flac" eq or tx-e "wav" eq or) filter sort-strs) 'audio-tracks let

-- ===== decoders =====
-- A track's file bytes and its decoder travel on the stack under the model, never in it: show copies the
-- model each frame, and a lookup of a bound value copies it. dec is one tagged value: 'wav, 'flac and
-- 'mp3 hold the decoder's state, 'none holds {} when no track is open.
-- REVIEW: One tagged dec, dispatched by case. Alternative: a record of the three words per format. It needs a body in the dec, and a body in the model's stack breaks show's copy.

-- rate-err: (dec path -- dec err).  err is [] or [msg]. A rate play refuses is refused at open, so the app shows it and keeps running.
('re-p let dup 'rate at 're-r let re-r 8000 lt re-r 384000 gt or
 (re-p ": " cat re-r int-str cat " Hz; play takes 8000 to 384000" cat [] swap push) ([]) if) 'rate-err let

-- open-no: (msg path -- dec err).  The refusal, led by the path.
('on-p let 'on-m let {} 'none tag [] on-p ": " cat on-m cat push) 'open-no let

-- open-track: (path -- bytes dec err).  The file's bytes and its decoder, by the extension. err is [] or [msg].
('ot-p let ot-p track-ext 'ot-e let
 ot-p read {
  'ok (ot-e "mp3" eq
        (mp3-open {'ok (ot-p rate-err swap 'mp3 tag swap) 'no (ot-p open-no)} case)
        (ot-e "flac" eq
          (flac-open {'ok (ot-p rate-err swap 'flac tag swap) 'no (ot-p open-no)} case)
          (wav-open {'ok (ot-p rate-err swap 'wav tag swap) 'no (ot-p open-no)} case) if) if)
  'no ([] swap push 'ot-x let "" {} 'none tag ot-x)} case) 'open-track let

-- seek-dec: (bytes dec frame -- bytes dec).
(swap {'wav (swap wav-seek 'wav tag) 'flac (swap flac-seek 'flac tag) 'mp3 (swap mp3-seek 'mp3 tag) 'none (swap drop 'none tag)} case) 'seek-dec let

-- next-dec: (bytes dec -- bytes dec chunk).  chunk is pcm ok, "" ok after the last, or msg no.
({'wav (wav-next swap 'wav tag swap) 'flac (flac-next swap 'flac tag swap) 'mp3 (mp3-next swap 'mp3 tag swap) 'none ('none tag "" ok)} case) 'next-dec let

-- dec-rate: (dec -- dec rate).
(dup {'wav ('rate at) 'flac ('rate at) 'mp3 ('rate at) 'none (drop 0)} case) 'dec-rate let

-- dec-total: (dec -- dec frames).  0 when the format does not say: an MP3, or a FLAC whose header gives no length.
(dup {'wav ('n at) 'flac ('total at) 'mp3 (drop 0) 'none (drop 0)} case) 'dec-total let

-- seek-frame: (rate ms -- frame).  The frame at ms. A place past 10^12 ms (31 years) is past any file, and
-- its product with the rate could wrap, so it maps to a frame past any file.
('sf-ms let 'sf-r let sf-ms 1000000000000 gt (1000000000000000) (sf-ms sf-r mul 1000 div) if) 'seek-frame let

-- ===== model, places and keys =====
-- A model: {'w 'h 'tracks 'sel 'at 'ms 'run 'total 'err 'saved 'shown}.
-- 'sel is the highlighted row and 'at the track that plays. 'ms is where
-- the track last started or paused. 'run is [] while paused, or
-- [{'rate 'sent 'done}] while playing: the rate, the bytes play took since the
-- track started at 'ms, and 1 once the decoder gave its last chunk. 'total
-- holds the track's length in ms when its file says, 'err the message of a track
-- that would not load, and 'saved the place last written.
('mm-ms let 'mm-at let 'mm-tracks let
 {'w 0 'h 0 'tracks mm-tracks 'sel mm-at 'at mm-at 'ms mm-ms 'run [] 'total [] 'err [] 'saved mm-ms 'shown []}) 'audio-model let

-- audio-pos: (m queued -- ms).  Where the track is: while playing, its start
-- plus the bytes play took less those still queued, at 4 bytes a frame.
('mp-q let 'mp-m let mp-m 'ms at
 mp-m 'run at dup len 0 eq (drop) (0 get must 'mp-r let mp-r 'sent at mp-q sub 1000 mul mp-r 'rate at 4 mul div plus) if) 'audio-pos let

-- audio-started: (m rate frames -- m).  The model once a track opened and
-- play's queue is empty: playing, with the track's length known when frames is
-- not 0.
('as-n let 'as-r let
 [{'rate as-r 'sent 0 'done 0}] 'run into
 as-n 0 eq ([]) ([as-n 1000 mul as-r div]) if 'total into [] 'err into) 'audio-started let

-- run-add: (m n -- m).  play took n more bytes.
('ra-n let 'ra-m let ra-m 'run at 0 get must 'ra-r let
 ra-m [ra-r ra-r 'sent at ra-n plus 'sent into] 'run into) 'run-add let

-- run-done: (m -- m).  The decoder gave its last chunk.
('rd-m let rd-m 'run at 0 get must 'rd-r let rd-m [rd-r 1 'done into] 'run into) 'run-done let

-- audio-key: (m keycode -- m).  j and down move the highlight down, k and
-- up move it up; it stops at the ends.
('mk-k let 'mk-m let mk-m 'sel at
 mk-k 106 eq mk-k 1073741905 eq or (1 plus) () if
 mk-k 107 eq mk-k 1073741906 eq or (1 sub) () if
 mk-m 'tracks at len 1 sub min 0 max 'mk-s let mk-m mk-s 'sel into) 'audio-key let

-- clock: (ms -- str).  m:ss.
(1000 div 'ck-s let ck-s 60 div int-str ":" cat ck-s 60 mod 10 lt ("0") ("") if cat ck-s 60 mod int-str cat) 'clock let

-- audio-layout: (w h -- layout).  The text scale grows with the window. A
-- line is 18 pixels at scale 1. The last row holds the status.
('ml-h let 'ml-w let ml-w 640 div ml-h 360 div min 1 max 'ml-s let 18 ml-s mul 'ml-lh let
 {'s ml-s 'lh ml-lh 'x ml-lh 'rows ml-h ml-lh 3 mul sub ml-lh div 1 max}) 'audio-layout let

-- audio-view: (m pos -- view).  What the window shows: the rows of the page
-- that holds the highlight, each with whether it is the highlight or the
-- track that plays, and the status line.
('mv-pos let 'mv-m let mv-m 'w at 'mv-w let mv-m 'h at 'mv-h let mv-w mv-h audio-layout 'rows at 'mv-rows let
 mv-m 'sel at mv-rows div mv-rows mul 'mv-top let mv-m 'tracks at 'mv-tr let
 mv-m 'err at dup len 0 gt (0 get must) (drop
   mv-m 'run at len 0 eq ("paused ") ("playing ") if mv-pos clock cat
   mv-m 'total at dup len 0 eq (drop "") (0 get must clock " / " swap cat) if cat) if 'mv-status let
 {'w mv-w 'h mv-h 'status mv-status
  'rows mv-top mv-top mv-rows plus mv-tr len min range ('vr-i let
    {'text vr-i 'mv-tr nth must 'sel vr-i mv-m 'sel at eq 'at vr-i mv-m 'at at eq}) each})'audio-view let

-- ===== state.cbor =====
-- {"dir": path, "track": name, "ms": int}, a CBOR map: the directory played
-- last, its track, and where in it.
('se-s let [{'name "dir" 'value se-s 'dir at ce-str} {'name "track" 'value se-s 'track at ce-str}
 {'name "ms" 'value se-s 'ms at ce-int}] ce-map) 'state-encode let
(('sd-cv let sd-cv "dir" cd-str cd-field apply ('sd-dir let sd-cv "track" cd-str cd-field apply ('sd-track let
  sd-cv "ms" cd-int cd-field apply ('sd-ms let {'dir sd-dir 'track sd-track 'ms sd-ms} ok) then) then) then) cd-run) 'state-decode let

-- ===== self-test =====
isheadless (
  "a" "b" str-lt assert  "b" "a" str-lt not assert  "a" "ab" str-lt assert  "ab" "ab" str-lt not assert
  "" "a" str-lt assert  "a" "" str-lt not assert
  ["b.mp3" "notes.txt" "A.FLAC" "a.wav" "mp3" "c.Mp3" "cover.jpg"] audio-tracks ["A.FLAC" "a.wav" "b.mp3" "c.Mp3"] eq assert
  [] sort-strs [] eq assert
  "x.tar.gz" track-ext "gz" eq assert  "README" track-ext "" eq assert
  -- each format opens and gives its chunks; the FLAC and the WAV hold the same tone
  "tests/audio/tone.wav" open-track 'ts-e let dec-rate 'ts-r let drop drop ts-e [] eq assert ts-r 44100 eq assert
  "tests/audio/tone.wav" open-track drop next-dec must dup len 17640 eq assert 'ts-v1 let next-dec must "" eq assert drop drop
  "tests/audio/tone.flac" open-track drop next-dec must ts-v1 eq assert next-dec must "" eq assert drop drop
  -- a FLAC with one flipped byte near its end gives a chunk, then refuses
  "tests/audio/tone.flac" read must 'ts-b let
  ts-b ts-b len 8 sub ts-b ts-b len 8 sub get must 255 bxor set must flac-open must 'flac tag next-dec drop next-dec 'ts-c let drop drop
  ts-c {'ok (drop "") 'no ()} case "flac: cut short: 4096 of 4410 frames" eq assert
  "tests/audio/tone.mp3" open-track drop dec-rate 44100 eq assert next-dec must len "tests/audio/tone.mp3" read must mp3-decode must 'pcm at len eq assert drop drop
  "tests/audio/mono48.flac" open-track drop dec-rate 48000 eq assert dec-total 2400 eq assert next-dec must "tests/audio/mono48.flac" read must flac-decode must 'pcm at eq assert drop drop
  -- 50 ms in is frame 2205: the rest of the tone follows
  "tests/audio/tone.wav" open-track drop dec-total 4410 eq assert 44100 50 seek-frame seek-dec next-dec must len 8820 eq assert drop drop
  "tests/audio/tone.flac" open-track drop 2205 seek-dec next-dec must len 8820 eq assert drop drop
  "tests/audio/tone.wav" open-track drop 99999 seek-dec next-dec must "" eq assert drop drop
  -- a place past the end, however far, is past every frame
  44100 100 seek-frame 4410 eq assert  44100 4611686018427387904 seek-frame 1000000000000000 eq assert
  "tests/audio/nope.wav" open-track nip nip ["tests/audio/nope.wav: No such file or directory"] eq assert
  "tests/audio/bad/rate4k.wav" open-track nip nip ["tests/audio/bad/rate4k.wav: 4000 Hz; play takes 8000 to 384000"] eq assert
  "tests/audio/pizzicato.sf2" open-track nip nip ["tests/audio/pizzicato.sf2: wav: not a WAV file: it starts RIFF ... sfbk, not RIFF ... WAVE"] eq assert
  ["a.mp3" "b.mp3" "c.mp3"] 1 0 audio-model 'ts-m let
  ts-m 0 audio-pos 0 eq assert
  ts-m 44100 4410 audio-started 'ts-p let
  ts-p 'run at [{'rate 44100 'sent 0 'done 0}] eq assert  ts-p 'total at [100] eq assert
  ts-m 44100 0 audio-started 'total at [] eq assert
  -- play took 8820 bytes: all still queued is the place the track started at; none queued is 50 ms on
  ts-p 8820 run-add 'ts-w let
  ts-w 'run at [{'rate 44100 'sent 8820 'done 0}] eq assert
  ts-w 8820 audio-pos 0 eq assert  ts-w 0 audio-pos 50 eq assert
  ts-w 1000 'ms into 0 audio-pos 1050 eq assert
  ts-w run-done 'run at [{'rate 44100 'sent 8820 'done 1}] eq assert
  ts-m 106 audio-key 'sel at 2 eq assert  ts-m 106 audio-key 106 audio-key 'sel at 2 eq assert
  ts-m 107 audio-key 107 audio-key 'sel at 0 eq assert  ts-m 120 audio-key 'sel at 1 eq assert
  61000 clock "1:01" eq assert  0 clock "0:00" eq assert  600000 clock "10:00" eq assert
  -- a window three rows high pages by three
  ts-m 640 'w into 18 6 mul 'h into 'ts-v let
  ts-v 0 audio-view 'status at "paused 0:00" eq assert
  ts-v 0 audio-view 'rows at [{'text "a.mp3" 'sel 0 'at 0} {'text "b.mp3" 'sel 1 'at 1} {'text "c.mp3" 'sel 0 'at 0}] eq assert
  ["a" "b" "c" "d" "e"] 0 61000 audio-model 640 'w into 18 6 mul 'h into 4 'sel into 0 audio-view 'rows at
    [{'text "d" 'sel 0 'at 0} {'text "e" 'sel 1 'at 0}] eq assert
  ts-w 640 'w into 18 6 mul 'h into 4410 audio-pos 'ts-q let ts-q 25 eq assert
  ts-w 640 'w into 18 6 mul 'h into ts-q audio-view 'status at "playing 0:00 / 0:00" eq assert
  ts-v [ "a.mp3: not an MP3 stream" ] 'err into 0 audio-view 'status at "a.mp3: not an MP3 stream" eq assert
  -- the state file round-trips
  {'dir "m" 'track "b.mp3" 'ms 1234} 'ts-s let
  ts-s state-encode state-decode must ts-s eq assert
  [] ce-map state-decode {'ok (drop "") 'no ()} case "$: missing field \"dir\"" eq assert
  "audio-selftest-ok" print
) () if
