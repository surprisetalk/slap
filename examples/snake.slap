-- Snake game
-- Run with: ./slap-sdl < examples/snake.slap

-- Draw filled 20x20 cell
(
  'c let 'gy let 'gx let
  gx 20 mul gy 20 mul 20 20 c fill-rect
) 'draw-cell let

-- Draw 16x16 cell inset by 2px (grid lines effect)
(
  'c let 'gy let 'gx let
  gx 20 mul 2 plus gy 20 mul 2 plus 16 16 c fill-rect
) 'draw-inset let

-- Decode grid position (cell index, column count)
(mod) 'pos-x let
(div) 'pos-y let

-- Map SDL arrow key to direction, -1 if unknown
(
  dup 1073741906 eq (drop 0) (
  dup 1073741905 eq (drop 2) (
  dup 1073741904 eq (drop 3) (
  dup 1073741903 eq (drop 1) (
  drop -1
  ) if) if) if) if
) 'key-dir let

-- New game: three cells ending at the board's center, food anywhere on the board
(
  dup 'cols at 'cs let  dup 'rows at 'rs let
  cs 2 div 2 max cs 1 sub min 'hx let
  rs 2 div cs mul hx plus 'head let
  [] hx 2 ge (head 2 sub push) () if
     hx 1 ge (head 1 sub push) () if
     head push 'snk let
  0 'state into
  0 'death-at into
  snk 'snake into
  1 'dir into
  cs rs mul random 'food into
) 'reset let

-- State record on stack: the board is the canvas in 20px cells
{}
  0 'w into
  32 'cols into  24 'rows into
  0 'frame into
  reset

-- on resize: keep the canvas size and restart on the new board.
-- show runs this once before the first frame.
(
  'rh let 'rw let
  rw 'w into
  rw 20 div 1 max 'cols into
  rh 20 div 1 max 'rows into
  reset
) 'resize on

(
  key-dir 'kd let
  kd -1 neq (
    dup 'state at 0 eq (
      kd 'dir into (drop 1) 'state edit
    ) (
      dup 'state at 1 eq (
        kd over 'dir at sub abs 2 neq (
          kd 'dir into
        ) () if
      ) () if
    ) if
  ) () if
) 'keydown on

(
  drop
  (1 plus) 'frame edit
  dup 'frame at 'frm let

  dup 'state at 1 eq (
    frm 6 mod 0 eq (
      dup 'snake at last 'head let
      dup 'cols at 'cs let  dup 'rows at 'rs let
      head cs pos-x 'hx let
      head cs pos-y 'hy let
      dup 'dir at 'dr let
      dr 0 eq (hx hy 1 sub) (
      dr 1 eq (hx 1 plus hy) (
      dr 2 eq (hx hy 1 plus) (
                hx 1 sub hy
      ) if) if) if
      'ny let 'nx let

      nx 0 lt nx cs ge or ny 0 lt or ny rs ge or (
        frm 'death-at into (drop 2) 'state edit
      ) (
        ny cs mul nx plus 'nh let
        dup 'snake at nh member (
          frm 'death-at into (drop 2) 'state edit
        ) (
          dup 'snake at nh push 'snk2 let
          nh over 'food at eq (
            snk2 'snake into cs rs mul random 'food into
          ) (
            snk2 1 drop-n 'snake into
          ) if
        ) if
      ) if
    ) () if
  ) (
    dup 'state at 2 eq (
      frm over 'death-at at sub 90 gt (
        reset
      ) () if
    ) () if
  ) if
) 'tick on

(
  drop
  dup 'frame at 'frm let
  dup 'state at 'stv let
  dup 'food at 'fd let
  dup 'cols at 'cs let
  dup 'w at 'W let
  dup 'snake at 'snk let
  0 clear

  stv 2 eq (
    dup 'death-at at 'da let
    frm da sub 4 div 2 mod 'flash let
    snk (dup cs pos-x swap cs pos-y flash 1 eq (3) (1) if draw-cell 0) each drop
  ) (
    snk (dup cs pos-x swap cs pos-y 2 draw-inset 0) each drop
    snk last dup cs pos-x swap cs pos-y 3 draw-inset

    stv 0 eq frm 20 div 2 mod 0 eq and (
      fd cs pos-x fd cs pos-y 3 draw-cell
    ) (
      fd cs pos-x fd cs pos-y 1 draw-inset
    ) if
  ) if

  snk len 3 sub 'score let
  score 0 gt (
    0 (dup score lt over 20 mul W lt and) (
      dup 20 mul 0 20 2 3 fill-rect
      1 plus
    ) while drop
  ) () if
) show
