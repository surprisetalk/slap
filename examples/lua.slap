 LN-I mget 'ln5 let lhk ln5 hset ln5) '_tlen let

-- A cell's value lives at heap key [7 id]; a closure's i-th outer cell at [5 id i].
('ci let [7] ci _ikey cat) '_cellkey let
('cv0 let CELLN-I mget 1 plus 'cn0 let cn0 MAX-CELLS gt ("more than 1000000 cells made" _rfail) () if
