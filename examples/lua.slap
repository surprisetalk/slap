-- lua.slap: a Lua interpreter for pico8's dialect, the base of a pico8 cart runner.
--
--   cat examples/lib/strings.slap examples/lua.slap | ./slap prog.lua
--
-- runs prog.lua and writes what its `print` calls print. tests/run_lua.py diffs
-- that against the system `lua` on tests/lua/*.lua.
--
-- ===== what this is =====
--
-- Source -> tokens -> a flat int bytecode list -> a `while` loop that steps it.
-- Nothing recurses per token or per instruction; the compiler recurses only per
-- nesting level of an expression, and a bound caps that.
--
-- A Lua value is one int, payload*8 + tag:
--   0 nil  1 bool  2 number  3 string  4 table  5 closure  6 builtin  7 cell
-- nil is 0, false is 1, true is 9. A number's payload is pico8's signed 16.16
-- fixed point, so 1 is 65536*8+2. Tagged slap values lose here: they span
-- several slots, so `nth` over a list of them walks the list.
--
-- A string's payload is where its bytes live: a payload p >= 0 is the record at
-- p in the token list (the compiler's string literals and names stay there), and
-- p < 0 is the record at -1-p in the machine's string area, which concatenation
-- and tostr fill. Either record is [len bytes...]. Strings are never interned:
-- `==` on two strings compares bytes.
--
-- ===== the one discipline rule =====
--
-- While the program runs, the stack holds `machine heap`: the machine, one flat
-- int list, and above it the heap, one dict. A dict is one slot, so `dip` over
-- it is O(1), and every machine read or write runs in a dip. Never swap, dip
-- over or let-bind the machine; never let-bind the heap either, since a lookup
-- of a bound dict copies it.

-- ===== tokens =====
-- A token is a record in one flat int list, so `nth` reads it in O(1):
--   name [1 line len bytes...]   number [2 line raw]   string [3 line len bytes...]
--   end of input [4 line]        keyword or symbol [id line]
-- A keyword's id is 10 plus its index in KW, a symbol's 40 plus its index in SY.
["and" "break" "do" "else" "elseif" "end" "false" "for" "function" "goto" "if" "in"
 "local" "nil" "not" "or" "repeat" "return" "then" "true" "until" "while"] 'KW let
-- Longest first wherever one symbol starts another: the lexer takes the first match.
["..." "..=" ".." ">>>=" ">>>" ">><=" ">><" ">>=" ">>" "<<>=" "<<>" "<<=" "<<" "^^=" "^^" "==" "~=" "!="
 "<=" ">=" "+=" "-=" "*=" "/=" "%=" "\\=" "^=" "|=" "&=" "::" "+" "-" "*" "/" "%" "^" "#"
 "&" "~" "|" "<" ">" "=" "(" ")" "{" "}" "[" "]" ";" ":" "," "." "\\" "?"] 'SY let
('s let KW s index-of must 10 plus) 'kw-id let
('s let SY s index-of must 40 plus) 'sy-id let

1 'T-NAME let  2 'T-NUM let  3 'T-STR let  4 'T-EOF let

-- _hexv: (c -- d).  A hex digit's value, upper or lower case, or -1.
('hv let hv 48 ge hv 57 le and (hv 48 sub) (hv 97 ge hv 102 le and (hv 87 sub) (hv 65 ge hv 70 le and (hv 55 sub) (-1) if) if) if) '_hexv let
-- _tdig: (c base -- d).  The digit's value in that base, or -1.
('db let _hexv 'dv let dv db lt (dv) (-1) if) '_tdig let

-- Lines past these are pico8's prelude and the frame loop, which lua.slap adds
-- around a program; _lwhere names them in messages.
1000000 'PRELUDE-LINE let  2000000 'POSTLUDE-LINE let
('wl let wl POSTLUDE-LINE ge ("the frame loop's line " wl POSTLUDE-LINE sub int-str cat) (
 wl PRELUDE-LINE ge ("pico8's prelude line " wl PRELUDE-LINE sub int-str cat) ("line " wl int-str cat) if) if) '_lwhere let

-- lua-lex: (src line -- toks).  The first line is numbered `line`.  Dies on input
-- that is not a token, naming the line.
('_lstart let '_lsrc let
  _lsrc len '_ln let
  -- _lc: (i -- c).  The byte at i, or -1 past the end.
  ('_lsrc nth {'ok () 'no (drop -1)} case) '_lc let
  ('c let c 97 ge c 122 le and c 65 ge c 90 le and or c 95 eq or) '_lalpha let
  ('c let c 48 ge c 57 le and) '_ldigit let
  (dup _lalpha swap _ldigit or) '_lalnum let
  ('ln let "lua: " ln _lwhere cat ": " cat swap cat fail) '_lfail let

  -- _lline: (i -- i').  Skips to the newline that ends the line, not past it.
  ((dup _lc 'c let c 10 eq not c 13 eq not and c 0 ge and) (1 plus) while) '_lline let
  -- _lnl: (i -- i').  Past the newline at i: LF, CR, CR LF or LF CR, each one line, as in Lua.
  ('ni let ni _lc 'na let ni 1 plus _lc 'nb let
   na nb plus 23 eq na nb eq not and (ni 2 plus) (ni 1 plus) if) '_lnl let
  -- _lopen: (i -- level).  At `[`, the number of `=` before the next `[`, or -1.
  ('oi let oi 1 plus (dup _lc 61 eq) (1 plus) while 'oj let oj _lc 91 eq (oj oi sub 1 sub) (-1) if) '_lopen let

  -- _llong: (i ln level -- i' ln' bytes).  i is just past the opening bracket.
  -- Reads to the closing bracket of the same level, counting lines.  As in Lua,
  -- each newline reads as LF, and one right after the opening bracket is dropped.
  ('lv let 'lln let 'li let
   li _lc 'l0 let l0 10 eq l0 13 eq or (li _lnl lln 1 plus) (li lln) if 'ln0 let 'i0 let
   [] i0 ln0 0
   (dup 0 eq)
   (drop 'ln1 let 'i1 let i1 _lc 'c let
     c 0 lt ("unfinished long string or comment" lln _lfail) (
     c 93 eq 1 lv 1 plus range 1 ('k let i1 k plus _lc 61 eq and) fold i1 lv plus 1 plus _lc 93 eq and and (i1 lv plus 2 plus ln1 1) (
     c 10 eq c 13 eq or (10 push i1 _lnl ln1 1 plus 0) (
     c push i1 1 plus ln1 0) if) if) if)
   while drop rot) '_llong let

  -- _lmatch: (i s -- 1 or 0).  Does s appear at i?
  ('ms let 'mi let 0 ms len range 1 ('k let mi k plus _lc k 'ms nth must eq and) fold) '_lmatch let
  -- _lsym: (i ln -- i' ln' rec)
  ('sln let 'si let
   SY (si swap _lmatch) each 1 index-of {
     'ok ('sk let si sk 'SY nth must len plus sln [] sk 40 plus push sln push)
     'no (drop "unexpected character " si _lc int-str cat sln _lfail)} case) '_lsym let

  -- _lname: (i ln -- i' ln' rec)
  ('nln let 'ni let
   [] ni (dup _lc _lalnum) ('nj let nj _lc push nj 1 plus) while 'ne let 'nb let
   KW nb index-of {
     'ok ('nk let ne nln [] nk 10 plus push nln push)
     'no (drop ne nln [] T-NAME push nln push nb len push nb cat)} case) '_lname let

  -- _ldigits: (n i base max -- n' i' count).  Folds at most max digits at i, in base 2, 10 or 16.
  ('dm let 'db let 0
   (dup dm lt 'dk let over _lc db _tdig 0 ge dk and)
   ('dn let 'di let 'dv let di _lc db _tdig 'dd let
    dv 1099511627776 lt (dv db mul dd plus) (dv) if di 1 plus dn 1 plus) while) '_ldigits let

  -- _lnum: (i ln -- i' ln' rec).  The raw value is 16.16 fixed point, wrapped to
  -- 32 bits as pico8 does, so 0xffff is -1.  As in zepto8, a decimal fraction
  -- truncates to 1/65536 (strtod, then the cast), and a hex or binary fraction
  -- keeps its first 16 bits and reads past the rest.
  ('uln let 'ui let
   ui _lc 48 eq ui 1 plus _lc 'u1 let u1 120 eq u1 88 eq or and (16 ui 2 plus) (
   ui _lc 48 eq u1 98 eq u1 66 eq or and (2 ui 2 plus) (10 ui) if) if 'ua let 'ub let
   0 ua ub 99 _ldigits 'uc let 'ui2 let 'un let
   ui2 _lc 46 eq ui2 1 plus _lc 46 eq not and (
     0 ui2 1 plus ub ub 10 eq (99) (ub 16 eq (4) (16) if) if _ldigits 'fc let 'fi let 'fv let
     fi (dup _lc _hexv 0 ge ub 10 eq not and) (1 plus) while 'fi2 let
     ub 10 eq (
       fc 9 gt ("a decimal fraction has more than 9 digits" uln _lfail) () if
       1 fc (10 mul) repeat 'fs let fv 65536 mul fs div)
     (fv 16 ub 16 eq (4) (1) if fc mul sub shl) if fi2) (0 ui2) if 'ue let 'uf let
   uc 0 eq ue ui2 1 plus le and ("expected a digit" uln _lfail) () if
   un 1099511627776 ge ("number is too large" uln _lfail) () if
   ue _lc _lalnum ue _lc 46 eq or ("malformed number" uln _lfail) () if
   un 65536 mul uf plus 2147483648 plus 4294967295 band 2147483648 sub 'uv let
   ue uln [] T-NUM push uln push uv push) '_lnum let

  -- _lstr: (i ln -- i' ln' rec).  i is at the quote.  As in Lua, a backslash
  -- before a newline keeps the newline, and \z skips the white space after it.
  ('qln let 'qi let qi _lc 'qq let
   [] qi 1 plus qln 0
   (dup 0 eq)
   (drop 'ql let 'qj let qj _lc 'qc let
     qc 0 lt qc 10 eq or qc 13 eq or ("unfinished string" qln _lfail) (
     qc qq eq (qj 1 plus ql 1) (
     qc 92 eq (
       qj 1 plus _lc 'qe let
       qe 0 lt ("unfinished string" qln _lfail) () if
       qe 10 eq qe 13 eq or (10 push qj 1 plus _lnl ql 1 plus 0) (
       qe 122 eq (qj 2 plus ql
         (over _lc 'zc let zc 32 eq zc 9 eq or zc 11 eq or zc 12 eq or zc 10 eq or zc 13 eq or)
         ('zl let 'zi let zi _lc 'zc2 let zc2 10 eq zc2 13 eq or (zi _lnl zl 1 plus) (zi 1 plus zl) if) while 0) (
       qe 110 eq (10 qj 2 plus) (qe 116 eq (9 qj 2 plus) (qe 114 eq (13 qj 2 plus) (
       qe 97 eq (7 qj 2 plus) (qe 98 eq (8 qj 2 plus) (qe 102 eq (12 qj 2 plus) (qe 118 eq (11 qj 2 plus) (
       qe 92 eq qe 34 eq or qe 39 eq or (qe qj 2 plus) (
       qe 120 eq (0 qj 2 plus 16 2 _ldigits 2 eq not ("\\x needs two hex digits" qln _lfail) () if) (
       qe _ldigit (0 qj 1 plus 10 3 _ldigits drop 'qn let 'qv let qv 255 gt ("escape \\" qv int-str cat " is past 255" cat qln _lfail) () if qv qn) (
         "unknown escape \\" [] qe push cat qln _lfail) if) if) if) if) if) if) if) if) if) if 'qk let 'qb let
       qb push qk ql 0) if) if) (
     qc push qj 1 plus ql 0) if) if) if)
   while drop 'qend2 let 'qend let 'qbytes let
   qend qend2 [] T-STR push qln push qbytes len push qbytes cat) '_lstr let

  [] 0 _lstart
  (over _ln lt)
  ('ln let 'i let i _lc 'c let
   c 10 eq c 13 eq or (i _lnl ln 1 plus []) (
   c 32 eq c 9 eq or c 11 eq or c 12 eq or (i 1 plus ln []) (
   c 45 eq i 1 plus _lc 45 eq and (
     i 2 plus _lc 91 eq (i 2 plus _lopen) (-1) if 'cv let
     cv 0 ge (i cv plus 4 plus ln cv _llong drop []) (i _lline ln []) if) (
   c 47 eq i 1 plus _lc 47 eq and (i _lline ln []) (
   c _lalpha (i ln _lname) (
   c _ldigit c 46 eq i 1 plus _lc _ldigit and or (i ln _lnum) (
   c 34 eq c 39 eq or (i ln _lstr) (
   c 91 eq (i _lopen) (-1) if 'sv let
   sv 0 ge (i sv plus 2 plus ln sv _llong 'lb let [] T-STR push ln push lb len push lb cat) (
   c 91 eq i 1 plus _lc 61 eq and ("expected [ after [= to start a long string" ln _lfail) (
     i ln _lsym) if) if) if) if) if) if) if) if) if
   'r let 'ln2 let 'i2 let r cat i2 ln2) while
  'eln let drop [] T-EOF push eln push cat) 'lua-lex let

-- lua-index: (toks -- tix).  The base of each token record, so token t is at `t 'tix nth`.
('xt let xt len 'xn let
 [] 0 (dup xn lt)
 ('xb let xb push
  xb 'xt nth must 'xk let
  xk T-NAME eq xk T-STR eq or (xb 2 plus 'xt nth must 3 plus) (xk T-NUM eq (3) (2) if) if xb plus) while drop) 'lua-index let

-- ===== bytecode =====
-- An instruction is three ints, [op arg line]; jumps are relative, so a compiled
-- fragment means the same wherever it lands.
-- REVIEW: Relative jumps. Alternative: absolute targets, as the design said. They need a fix-up pass once fragments are joined.
["RET" "POP" "PUSHK" "GETG" "SETG" "CALL" "JMP" "JF" "JFK" "JTK"
 "ADD" "SUB" "MUL" "DIV" "IDIV" "MOD" "POW" "CONCAT" "EQ" "NE" "LT" "LE" "GT" "GE"
 "BAND" "BOR" "BXOR" "SHL" "SHR" "LSHR" "ROTL" "ROTR" "NEG" "NOT" "LEN" "BNOT"
 "GETL" "SETL" "CLOSURE" "BREAK" "FORPREP" "FORCHK" "FORINC"
 "FUNC" "GETU" "SETU" "CAPTL" "CAPTU" "DECL" "PARAM" "GETLC" "SETLC" "DECLC" "BOXL"
 "NEWT" "GETT" "SETT" "SETTK" "SETTD" "SETMULTI" "SELF" "DUP2" "JNIL"] 'OPS let
('s let OPS s index-of must) 'op-id let
"RET" op-id 'O-RET let  "POP" op-id 'O-POP let  "PUSHK" op-id 'O-PUSHK let
"GETG" op-id 'O-GETG let  "SETG" op-id 'O-SETG let  "CALL" op-id 'O-CALL let
"JMP" op-id 'O-JMP let  "JF" op-id 'O-JF let  "JFK" op-id 'O-JFK let  "JTK" op-id 'O-JTK let
"GETL" op-id 'O-GETL let  "SETL" op-id 'O-SETL let  "CLOSURE" op-id 'O-CLOSURE let  "BREAK" op-id 'O-BREAK let
"FORPREP" op-id 'O-FORPREP let  "FORCHK" op-id 'O-FORCHK let  "FORINC" op-id 'O-FORINC let
"FUNC" op-id 'O-FUNC let  "GETU" op-id 'O-GETU let  "SETU" op-id 'O-SETU let  "CAPTL" op-id 'O-CAPTL let
"CAPTU" op-id 'O-CAPTU let  "DECL" op-id 'O-DECL let  "PARAM" op-id 'O-PARAM let  "GETLC" op-id 'O-GETLC let
"SETLC" op-id 'O-SETLC let  "DECLC" op-id 'O-DECLC let  "BOXL" op-id 'O-BOXL let
"NEWT" op-id 'O-NEWT let  "GETT" op-id 'O-GETT let  "SETT" op-id 'O-SETT let  "SETTK" op-id 'O-SETTK let
"SETTD" op-id 'O-SETTD let  "SETMULTI" op-id 'O-SETMULTI let  "SELF" op-id 'O-SELF let  "DUP2" op-id 'O-DUP2 let
"JNIL" op-id 'O-JNIL let
(8 mul 2 plus) '_num let

-- BIN[kind] packs a binary operator as op*256 + left*16 + right, its op and
-- Lua's precedences; 0 is no binary operator.  UN[kind] is a unary op, or -1.
-- `and` and `or` compile to JFK and JTK around their right side.
('rp let 'lp let 'bo let 'bk let bk bo 256 mul lp 16 mul plus rp plus set must) '_bin! let
0 100 range (drop 0) each
 "or" kw-id O-JTK 1 1 _bin!  "and" kw-id O-JFK 2 2 _bin!
 "<" sy-id "LT" op-id 3 3 _bin!  ">" sy-id "GT" op-id 3 3 _bin!  "<=" sy-id "LE" op-id 3 3 _bin!
 ">=" sy-id "GE" op-id 3 3 _bin!  "~=" sy-id "NE" op-id 3 3 _bin!  "!=" sy-id "NE" op-id 3 3 _bin!
 "==" sy-id "EQ" op-id 3 3 _bin!
 "|" sy-id "BOR" op-id 4 4 _bin!  "~" sy-id "BXOR" op-id 5 5 _bin!  "^^" sy-id "BXOR" op-id 5 5 _bin!
 "&" sy-id "BAND" op-id 6 6 _bin!
 "<<" sy-id "SHL" op-id 7 7 _bin!  ">>" sy-id "SHR" op-id 7 7 _bin!  ">>>" sy-id "LSHR" op-id 7 7 _bin!
 "<<>" sy-id "ROTL" op-id 7 7 _bin!  ">><" sy-id "ROTR" op-id 7 7 _bin!
 ".." sy-id "CONCAT" op-id 9 8 _bin!
 "+" sy-id "ADD" op-id 10 10 _bin!  "-" sy-id "SUB" op-id 10 10 _bin!
 "*" sy-id "MUL" op-id 11 11 _bin!  "/" sy-id "DIV" op-id 11 11 _bin!  "%" sy-id "MOD" op-id 11 11 _bin!
 "\\" sy-id "IDIV" op-id 11 11 _bin!
 "^" sy-id "POW" op-id 14 13 _bin!
'BIN let
12 'UNARY-PREC let
('uo let 'uk let uk uo set must) '_un! let
0 100 range (drop -1) each
 "not" kw-id "NOT" op-id _un!  "-" sy-id "NEG" op-id _un!  "#" sy-id "LEN" op-id _un!  "~" sy-id "BNOT" op-id _un!
'UN let

-- ===== carts =====
-- A .p8 cart is text: a header line, then sections that each start with a line
-- such as __lua__.  __gfx__ is up to 128 rows of 128 hex digits, a pixel each;
-- __gff__ up to 2 rows of 256, two digits a sprite's flags; __map__ up to 32
-- rows of 256, two digits a tile.  Missing rows are zero, as pico8's memory is.
-- REVIEW: The map's rows 32-63 come from the gfx bytes at load and stay apart from them after. Alternative: one shared memory, as pico8 has, which matters only to carts that draw sprites over map rows 32-63 and then mset them.
('h let h len 4 ge (h 2 take-n "__" eq h len 2 sub 'hl let h hl drop-n "__" eq and) (0) if) '_csec? let
-- lua-cart: (bytes -- cart).  {'lua str 'gfx 'map 'flags}, each an int list.
('cb let cb "\n" str-split (dup len 0 gt (dup len 1 sub peek must 13 eq) (0) if (pop must drop) () if) each 'cl let
 -- _cpart: (name -- start lines).  The section's first line number and its lines, or [] if it is absent.
 ('sn let cl sn index-of {
   'ok ('sh let cl sh 1 plus drop-n 'sr let sh 2 plus sr sr (_csec?) each 1 index-of {'ok (take-n) 'no (drop)} case)
   'no (drop 0 [])} case) '_cpart let
 -- _crows: (name rows width digits -- values).  Hex rows, `digits` per value; empty rows at the end do not count.
 ('rd let 'rw let 'rr let 'rn let rn _cpart (dup len 0 gt (dup len 1 sub peek must len 0 eq) (0) if) (pop must drop) while 'rl let 'r0 let
  rl len rr gt ("lua: cart line " r0 rr plus int-str cat ": " cat rn cat " has more than " cat rr int-str cat " rows" cat fail) () if
  0 rl len range [] ('ri let 'acc let ri 'rl nth must 'row let
    row len rw eq not ("lua: cart line " r0 ri plus int-str cat ": a " cat rn cat " row has " cat row len int-str cat " digits, not " cat rw int-str cat fail) () if
    0 rw rd div range acc ('rk let 'acc2 let
      0 rd range 0 ('rj let 'racc let rk rd mul rj plus 'row nth must _hexv 'rv let
        rv 0 lt ("lua: cart line " r0 ri plus int-str cat ": " cat rn cat " has a digit that is not hex" cat fail) () if
        racc 16 mul rv plus) fold 'rval let acc2 rval push) fold) fold
  rr rl len sub rw rd div mul (0 push) repeat) '_crows let
 "__lua__" _cpart 'll let 'l0 let
 l0 0 eq ("lua: the cart has no __lua__ section" fail) () if
 [] l0 1 sub 0 max ("" push) repeat ll cat "\n" str-join 'lsrc let
 {'lua lsrc 'gfx "__gfx__" 128 128 1 _crows 'flags "__gff__" 2 256 2 _crows 'map "__map__" 32 256 2 _crows}) 'lua-cart let

-- ===== the program =====
args len 1 ge args len 2 le and () ("usage: cat examples/lib/strings.slap examples/lua.slap | ./slap prog.lua|cart.p8 [frames]" fail) if
args 0 get must 'lua-path let
lua-path read {'ok () 'no ('e let "lua: cannot read " e cat fail)} case 'lua-bytes let
lua-bytes 16 take-n "pico-8 cartridge" eq 'IS-CART let
IS-CART (lua-bytes lua-cart) ({'lua lua-bytes 'gfx [] 16384 (0 push) repeat 'flags [] 256 (0 push) repeat 'map [] 4096 (0 push) repeat}) if 'CART let
args len 2 eq IS-CART not and ("lua: a frame count needs a .p8 cart" fail) () if
args len 2 eq (args 1 get must) ("0") if 'FARG let
FARG ('c let c 48 lt c 57 gt or) filter len 0 eq FARG len 1 ge and FARG len 5 le and
 (FARG 0 ('c let 10 mul c 48 sub plus) fold) (-1) if 'FRAMES let
FRAMES 0 lt FRAMES 32767 gt or ("lua: the frame count must be 1 to 5 digits up to 32767, got \"" FARG cat "\"" cat fail) () if

-- pico8's API, where plain Lua can say it.  Only `function name` statements:
-- a local here would be in the program's scope.
["function flr(x) return (x or 0) \\ 1 end"
 "function ceil(x) return -((-(x or 0)) \\ 1) end"
 "function abs(x) x = x or 0 if x < 0 then return -x end return x end"
 "function sgn(x) if (x or 0) < 0 then return -1 end return 1 end"
 "function min(a, b) a, b = a or 0, b or 0 if a < b then return a end return b end"
 "function max(a, b) a, b = a or 0, b or 0 if a > b then return a end return b end"
 "function mid(x, y, z) x, y, z = x or 0, y or 0, z or 0"
 "  if x > y then if y > z then return y end return min(x, z) end if x > z then return x end return min(y, z) end"
 "function band(a, b) return (a or 0) & (b or 0) end"
 "function bor(a, b) return (a or 0) | (b or 0) end"
 "function bxor(a, b) return (a or 0) ^^ (b or 0) end"
 "function bnot(a) return ~(a or 0) end"
 "function shl(a, n) return (a or 0) << (n or 0) end"
 "function shr(a, n) return (a or 0) >> (n or 0) end"
 "function lshr(a, n) return (a or 0) >>> (n or 0) end"
 "function rotl(a, n) return (a or 0) <<> (n or 0) end"
 "function rotr(a, n) return (a or 0) >>< (n or 0) end"
 "function count(c) local cnt, max = 0, #c for i = 1, max do if (c[i] != nil) cnt += 1 end return cnt end"
 "function add(c, x, i) if c != nil then i = i and mid(1, i \\ 1, #c + 1) or #c + 1"
 "  for j = #c, i, -1 do c[j + 1] = c[j] end c[i] = x return x end end"
 "function del(c, v) if c != nil then local max = #c for i = 1, max do if c[i] == v then"
 "  for j = i, max do c[j] = c[j + 1] end return v end end end end"
 "function deli(c, i) if c != nil then i = i and mid(1, i \\ 1, #c) or #c local v = c[i]"
 "  for j = i, #c do c[j] = c[j + 1] end return v end end"
 "function all(c) if (c == nil or #c == 0) return function() end"
 "  local i, prev = 1, nil"
 "  return function() if (c[i] == prev) i += 1"
 "    while (i <= #c and c[i] == nil) i += 1"
 "    prev = c[i] return prev end end"
 "function foreach(c, f) for v in all(c) do f(v) end end"
 "function rnd(x) if type(x) == 'table' then if #x == 0 then return nil end return x[flr(__rnd(#x)) + 1] end return __rnd(x) end"
 "function pal(a, b, c) if type(a) == 'table' then for k, v in pairs(a) do __pal(k, v, b) end return end return __pal(a, b, c) end"
 "function t() return time() end"
 "function mapdraw(a, b, c, d, e, f, g) return map(a, b, c, d, e, f, g) end"
] "\n" str-join PRELUDE-LINE 1 plus lua-lex dup len 2 sub take-n 'PRE-TOKS let
-- The frame loop: _init once, then lua-frame calls __frame once per frame.
IS-CART (["if _init then _init() end"
  "function __frame() if _update60 then _update60() elseif _update then _update() end if _draw then _draw() end end"
 ] "\n" str-join) ("") if POSTLUDE-LINE 1 plus lua-lex 'POST-TOKS let

-- Two name tokens after the end: a method's hidden `self` parameter, and the
-- `print` that pico8's `?` calls.
('nm let [] T-NAME push 0 push nm len push nm cat) '_name-tok let
PRE-TOKS CART 'lua at 1 lua-lex cat POST-TOKS cat "print" _name-tok cat "self" _name-tok cat 'toks let
toks lua-index 'tix let
tix len 1 sub 'SELF-TOK let  tix len 2 sub 'PRINT-TOK let

-- ===== compiler =====
-- Each compile word takes a token index and leaves `code t'`: the code it
-- compiled, then the index past it.  It dies on code it cannot compile,
-- naming the line.
('tix nth must) '_tb let
(_tb 'toks nth must) '_tk let
(_tb 1 plus 'toks nth must) '_tl let
(_tb 2 plus 'toks nth must) '_ta let
-- _tbytes: (t -- bytes).  A name's or string's text.
(_tb 'tsb let 0 tsb 2 plus 'toks nth must range (tsb 3 plus plus 'toks nth must) each) '_tbytes let
-- _tstr: (t -- v).  A name or string token as a Lua string; its text stays in toks.
(_tb 2 plus 8 mul 3 plus) '_tstr let
-- _tdesc: (t -- str).  The token, as an error message names it.
('dt let dt _tk 'dk let
 dk T-NAME eq ("'" dt _tbytes cat "'" cat) (
 dk T-NUM eq ("a number") (
 dk T-STR eq ("a string") (
 dk T-EOF eq ("the end of the input") (
 dk 40 lt (dk 10 sub 'KW nth must) (dk 40 sub 'SY nth must) if "'" swap cat "'" cat) if) if) if) if) '_tdesc let
('ln let "lua: " ln _lwhere cat ": " cat swap cat fail) '_cfail-at let
-- _cwant: (what t -- ).  Dies with "expected what, found <token>".
('wt let "expected " swap cat ", found " cat wt _tdesc cat wt _tl _cfail-at) '_cwant let
-- _cskip: (t kind what -- t+1).  t must be a token of that kind.
('sw let 'sk let 'st let st _tk sk eq (st 1 plus) (sw st _cwant) if) '_cskip let
-- _cins: (op arg line -- code).  One instruction.
('il let 'ia let 'io let [] io push ia push il push) '_cins let
-- _crep: (op n line -- code).  The instruction [op 0 line], n times.
('rl let 'rn let 'ro let [] rn (ro 0 rl _cins cat) repeat) '_crep let
-- _clastcall: (code -- 1 or 0).  Does the code end in a call?
('cc let cc len 3 lt (0) (cc len 3 sub 'cc nth must O-CALL eq) if) '_clastcall let
-- _cnres: (code n -- code).  The call that ends the code leaves n results, or all for -1; CALL's byte holds 254 at most.
('sn let 'scc let sn 254 gt ("a call expects more than 254 results" scc len 1 sub 'scc nth must _cfail-at) () if
 scc len 2 sub 'si let scc si si 'scc nth must 256 div 256 mul sn 1 plus plus set must) '_cnres let
-- _clast: (code -- op).  The last instruction's op, or -1.  _cdroplast: (code -- code).  Without it.
('lq let lq len 3 lt (-1) (lq len 3 sub 'lq nth must) if) '_clast let
(dup len 3 sub take-n) '_cdroplast let
-- _cresolve: (body after -- body).  Each break in the loop body jumps to the
-- loop's end, `after` ints past the body.  Inner loops resolved their own.
('rx let 'rb let rb len 'rn let rb 0
 (dup rn lt)
 ('rp let rp peek must O-BREAK eq (rp O-JMP set must rp 1 plus rn rx plus rp 3 plus sub set must) () if rp 3 plus) while drop) '_cresolve let

-- A compile context is a flat int list, [nl loop lvl na one] and then a triple
-- [name-token slot level] per local in scope, innermost last.  nl is the most
-- slots the function has needed, loop is 1 inside a loop, lvl counts the
-- functions around the code, na the function's locals in scope, one the line
-- of the pico8 one-line body the code is in, or 0.  A hidden
-- local (a for loop's counters) has name-token 0, which never declares a name.
--
-- Closures: a local that a nested function uses lives in a cell, made each
-- time its declaration runs, so a loop makes a fresh one per pass.  While a
-- function compiles, a local's instructions carry slot + 65536*token, and an
-- outer local's carry 65536*token: GETL, SETL, DECL (a declaration), PARAM, and
-- GETU, SETU, CAPTU (an outer local a nested closure takes), CAPTL (a local of
-- this function it takes).  When the function ends, _cfin reads which of its
-- locals a CAPTL names, makes those cell instructions, and numbers its outer
-- locals.  A nested function's body sits between FUNC, which jumps over it, and
-- its CLOSURE, and the scans skip it: it was finished on its own.
0 'C-NL let  1 'C-LOOP let  2 'C-LVL let  3 'C-NA let  4 'C-ONE let  5 'C-SCOPE let
-- _teq: (t1 t2 -- 1 or 0).  Do two name tokens spell one name?
('eb let 'ea let ea _tb 'ba let eb _tb 'bb let ba 2 plus 'toks nth must 'la let
 bb 2 plus 'toks nth must la eq (0 la range 1 ('k let ba 3 plus k plus 'toks nth must bb 3 plus k plus 'toks nth must eq and) fold) (0) if) '_teq let
-- _clookup: (t ctx -- slot level token), the local the name at t means, or -1 -1 0 for a global.
('lc let 'lt0 let lc len 3 sub
 (dup C-SCOPE ge (dup 'lc nth must 'le9 let le9 0 gt (le9 lt0 _teq) (0) if not) (0) if) (3 sub) while 'li let
 li C-SCOPE ge (li 1 plus 'lc nth must li 2 plus 'lc nth must li 'lc nth must) (-1 -1 0) if) '_clookup let
-- _cfindtok: (ctx token -- slot level).  The local that token declared.
('ft2 let 'fc2 let fc2 len 3 sub (dup 'fc2 nth must ft2 eq not) (3 sub) while 'fi2 let
 fi2 1 plus 'fc2 nth must fi2 2 plus 'fc2 nth must) '_cfindtok let
-- _cdeclare: (ctx t -- ctx' slot).  A new local named by token t.
('dt let 'dc let C-NA 'dc nth must 'ds let
 dc dt push ds push C-LVL 'dc nth must push
 C-NA ds 1 plus set must C-NL C-NL 'dc nth must ds 1 plus max set must ds) '_cdeclare let
-- _ckeep: (ctx inner -- ctx).  Back to ctx's scope, keeping the slots inner needed.
('ki let C-NL C-NL 'ki nth must set must) '_ckeep let
-- _cvar: (t ctx get -- code).  Reads (get 1) or writes (get 0) the name at t.
('vg let 'vc let 'vt let vt vc _clookup 'vtk let 'vlv let 'vsl let
 vsl 0 lt (vg (O-GETG) (O-SETG) if vt _tstr vt _tl _cins) (
 vlv C-LVL 'vc nth must eq (vg (O-GETL) (O-SETL) if vsl vtk 65536 mul plus vt _tl _cins) (
   vg (O-GETU) (O-SETU) if vtk 65536 mul vt _tl _cins) if) if) '_cvar let

-- _cscan: (code ops -- tokens).  The tokens the instructions with those ops
-- name, each once, in order; nested functions skipped.
('so let 'sc let sc len 'sn let [] 0
 (dup sn lt)
 ('sp let sp 'sc nth must 'sop let
  sop O-FUNC eq (sp 3 plus sp 1 plus 'sc nth must plus) (
    so sop index-of {'ok (drop sp 1 plus 'sc nth must 65536 div 'stk let dup stk index-of {'ok (drop) 'no (drop stk push)} case) 'no (drop)} case
    sp 3 plus) if) while drop) '_cscan let
-- _crewrite: (code ups capt -- code).  Locals in capt become cells; outer
-- locals become indices into ups; slots lose their tokens.
('wc let 'wu let 'wb let wb len 'wn let wb 0
 (dup wn lt)
 ('wp let wp peek must 'wop let wp 1 plus peek must 'warg let
  warg 65536 div 'wtk let warg 65536 mod 'wsl let wtk 0 gt wc wtk index-of {'ok (drop 1) 'no (drop 0)} case and 'wcap let
  wop O-FUNC eq (wp 3 plus warg plus) (
  wop O-GETL eq (wp wcap (O-GETLC) (O-GETL) if set must wp 1 plus wsl set must wp 3 plus) (
  wop O-SETL eq (wp wcap (O-SETLC) (O-SETL) if set must wp 1 plus wsl set must wp 3 plus) (
  wop O-DECL eq (wp wcap (O-DECLC) (O-SETL) if set must wp 1 plus wsl set must wp 3 plus) (
  wop O-PARAM eq (wp wcap (O-BOXL) (O-JMP) if set must wp 1 plus wcap (wsl) (0) if set must wp 3 plus) (
  wop O-CAPTL eq (wp 1 plus wsl set must wp 3 plus) (
  wop O-GETU eq wop O-SETU eq or wop O-CAPTU eq or (wp 1 plus wu wtk index-of must set must wp 3 plus) (
    wp 3 plus) if) if) if) if) if) if) if) while drop) '_crewrite let
-- _cfin: (code -- code ups).  Finishes a function's code; ups are the outer locals it uses.
('fz let fz [O-GETU O-SETU O-CAPTU] _cscan 'fu let fz [O-CAPTL] _cscan 'fcap let
 fu len 254 gt ("a function uses more than 254 outer locals" fz 2 'fz nth must _cfail-at) () if
 fz fu fcap _crewrite fu) '_cfin let

-- CMPD[kind] is the op of a compound assignment such as +=, or 0.
('co let 'ck let ck co set must) '_cmpd! let
0 100 range (drop 0) each
 "+=" sy-id "ADD" op-id _cmpd!  "-=" sy-id "SUB" op-id _cmpd!  "*=" sy-id "MUL" op-id _cmpd!
 "/=" sy-id "DIV" op-id _cmpd!  "%=" sy-id "MOD" op-id _cmpd!  "\\=" sy-id "IDIV" op-id _cmpd!
 "^=" sy-id "POW" op-id _cmpd!  "|=" sy-id "BOR" op-id _cmpd!  "&=" sy-id "BAND" op-id _cmpd!
 "^^=" sy-id "BXOR" op-id _cmpd!  "<<=" sy-id "SHL" op-id _cmpd!  ">>=" sy-id "SHR" op-id _cmpd!
 ">>>=" sy-id "LSHR" op-id _cmpd!  "..=" sy-id "CONCAT" op-id _cmpd!
 "<<>=" sy-id "ROTL" op-id _cmpd!  ">><=" sy-id "ROTR" op-id _cmpd!
'CMPD let

'_cexp [int int int int 'list tag] [int 'list tag int] effect
'_ctable [int int int 'list tag] [int 'list tag int] effect
'_cblock [int int 'list tag] [int 'list tag int int 'list tag] effect

-- _cexplist: (t ctx want depth -- code k dyn t').  Expressions separated by
-- commas, adjusted to want values as Lua adjusts them.  With want -1 a call at
-- the end leaves all its results: dyn is 1, and k counts the values before it.
('ed let 'ew let 'ec let 'et let
 et 0 ed ec _cexp 'e1 let 1 e1
 (dup _tk "," sy-id eq) ('e3 let 'e2 let e3 1 plus 0 ed ec _cexp 'e4 let cat e2 1 plus e4) while
 'ef let 'em let 'ecode let et _tl 'el let
 ecode _clastcall (
   ew 0 lt (ecode -1 _cnres em 1 sub 1) (
     ew em 1 sub sub 0 max 'en let
     ecode en _cnres O-POP em 1 sub en plus ew sub 0 max el _crep cat ew 0) if) (
   ew 0 lt (ecode em 0) (
     ecode O-PUSHK ew em sub 0 max el _crep cat O-POP em ew sub 0 max el _crep cat ew 0) if) if ef) '_cexplist let

-- _cargs: (t depth ctx -- code nargs t').  t is at `(`.  nargs is fixed*2 + dyn.
('ac let 'ad let 'gt0 let
 gt0 1 plus _tk ")" sy-id eq ([] 0 gt0 2 plus) (
   gt0 1 plus ac -1 ad 1 plus _cexplist 'a3 let swap 2 mul plus a3
   ")" sy-id "')' to close the arguments" _cskip) if) '_cargs let
-- _cargsany: (t depth ctx -- code nargs t').  Arguments in parentheses, or one string, or one table.
('yc let 'yd let 'yt let yt _tk 'yk let
 yk "(" sy-id eq (yt yd yc _cargs) (
 yk T-STR eq (O-PUSHK yt _tstr yt _tl _cins 2 yt 1 plus) (
 yk "{" sy-id eq (yt yd yc _ctable 'yt2 let 2 yt2) ("arguments" yt _cwant) if) if) if) '_cargsany let

'_cfunc [int int 'list tag int] [int 'list tag int] effect

-- _csuffix: (code t depth ctx -- code t').  Field reads and calls after a prefix
-- expression.  A call compiles for one result; a call statement changes its
-- count to none.  `a:m(x)` is SELF, which leaves a.m and a, then the call.
('xc let 'xd let
 (dup _tk 'xk0 let xk0 "(" sy-id eq xk0 T-STR eq or xk0 "{" sy-id eq or xk0 "." sy-id eq or xk0 "[" sy-id eq or xk0 ":" sy-id eq or)
 ('xt let xt _tk 'xk let xt _tl 'xl let
  xk "." sy-id eq (xt 1 plus T-NAME "a name after '.'" _cskip 'xt2 let O-PUSHK xt2 1 sub _tstr xl _cins cat O-GETT 0 xl _cins cat xt2) (
  xk "[" sy-id eq (xt 1 plus 0 xd 1 plus xc _cexp "]" sy-id "']' to close the index" _cskip 'xt2 let cat O-GETT 0 xl _cins cat xt2) (
  xk ":" sy-id eq (xt 1 plus T-NAME "a name after ':'" _cskip 'xt2 let O-SELF xt2 1 sub _tstr xl _cins cat
    xt2 xd xc _cargsany 'xt3 let 'xn let cat O-CALL xn 2 plus 256 mul 2 plus xl _cins cat xt3) (
    xt xd xc _cargsany 'xt2 let 'xn let cat O-CALL xn 256 mul 2 plus xl _cins cat xt2) if) if) if) while) '_csuffix let

-- _cprimary: (t depth ctx -- code t')
('pc let 'pd let 'pt let pt _tk 'pk let pt _tl 'pl let
 pk T-NUM eq (O-PUSHK pt _ta 8 mul 2 plus pl _cins pt 1 plus) (
 pk T-STR eq (O-PUSHK pt _tstr pl _cins pt 1 plus) (
 pk "nil" kw-id eq (O-PUSHK 0 pl _cins pt 1 plus) (
 pk "false" kw-id eq (O-PUSHK 1 pl _cins pt 1 plus) (
 pk "true" kw-id eq (O-PUSHK 9 pl _cins pt 1 plus) (
 pk T-NAME eq (pt pc 1 _cvar pt 1 plus pd pc _csuffix) (
 -- A parenthesized call leaves one result: the no-op jump after it keeps
 -- _clastcall from widening it.
 pk "(" sy-id eq (pt 1 plus 0 pd 1 plus pc _cexp ")" sy-id "')' to close the parenthesis" _cskip 'pt2 let
   dup _clastcall (O-JMP 0 pl _cins cat) () if pt2 pd pc _csuffix) (
 pk "..." sy-id eq ("varargs (...) are not supported" pl _cfail-at) (
 pk "function" kw-id eq (pt 1 plus pc 0 _cfunc) (
 pk "{" sy-id eq (pt pd pc _ctable pd pc _csuffix) (
   "an expression" pt _cwant) if) if) if) if) if) if) if) if) if) if) '_cprimary let

-- _cexp: (t limit depth ctx -- code t').  Precedence climbing: it takes binary
-- operators whose left precedence is above limit.  It recurses once per nesting
-- level, so depth bounds the C stack.
('cc let 'cd let 'cl let 'ct let
 cd 200 gt ("an expression nests deeper than 200 levels" ct _tl _cfail-at) () if
 ct _tk 'UN nth must 'cu let
 cu 0 ge (ct 1 plus UNARY-PREC cd 1 plus cc _cexp 'cut let cu 0 ct _tl _cins cat cut) (ct cd cc _cprimary) if
 (dup _tk 'BIN nth must 'cb let cb 0 gt cb 16 div 15 band cl gt and)
 ('bt let bt _tk 'BIN nth must 'bb let bb 256 div 'bo let bb 15 band 'br let
  bt 1 plus br cd 1 plus cc _cexp 'rt let 'rc let
  bo O-JFK eq bo O-JTK eq or (bo rc len bt _tl _cins cat rc cat) (rc cat bo 0 bt _tl _cins cat) if rt) while) '_cexp let

-- _ctable: (t depth ctx -- code t').  t is at `{`.  NEWT, then a SETTK per
-- field; a call as the last positional field leaves all its results (SETMULTI).
('tc let 'td let 'tt let
 O-NEWT 0 tt _tl _cins tt 1 plus 1
 (over _tk "}" sy-id eq not)
 ('ti let 'tp let tp _tk 'tk let tp _tl 'tl0 let
  tk "[" sy-id eq (
    tp 1 plus 0 td 1 plus tc _cexp "]" sy-id "']' to close the key" _cskip "=" sy-id "'=' after the key" _cskip
    0 td 1 plus tc _cexp 'tq let cat O-SETTK 0 tl0 _cins cat cat tq ti) (
  tk T-NAME eq tp 1 plus _tk "=" sy-id eq and (
    O-PUSHK tp _tstr tl0 _cins tp 2 plus 0 td 1 plus tc _cexp 'tq let cat O-SETTK 0 tl0 _cins cat cat tq ti) (
    tp 0 td 1 plus tc _cexp 'tq let 'tv let
    tq _tk "}" sy-id eq tq _tk "," sy-id eq tq _tk ";" sy-id eq or tq 1 plus _tk "}" sy-id eq and or 'tlast let
    tlast tv _clastcall and (tv -1 _cnres O-SETMULTI ti 65536 mul _num tl0 _cins cat cat tq ti) (
      O-PUSHK ti 65536 mul _num tl0 _cins tv cat O-SETTK 0 tl0 _cins cat cat tq ti 1 plus) if) if) if
  'ti2 let 'tp2 let tp2 _tk 'tsep let
  tsep "," sy-id eq tsep ";" sy-id eq or (tp2 1 plus) (tsep "}" sy-id eq (tp2) ("',' or '}' in the table" tp2 _cwant) if) if ti2)
 while drop 1 plus) '_ctable let

-- _cfunc: (t ctx self -- code t').  t is at the parameters' `(`; with self 1 a hidden `self` comes first.  The code jumps
-- over the function's body, whose first instruction is its header
-- [nparams nslots nups], then makes a closure of it.
-- The closure's descriptors follow CLOSURE: CAPTL for a local of this
-- function, CAPTU for one of its own outer locals, one per outer local the new
-- function uses, in its order.
('fself let 'fc let 'ft let
 ft "(" sy-id "'(' to start the parameters" _cskip 'fp let
 [0 0] C-LVL 'fc nth must 1 plus push 0 push 0 push fc C-SCOPE drop-n cat 'fc00 let
 fself (fc00 SELF-TOK _cdeclare drop) (fc00) if 'fc0 let
 fp _tk T-NAME eq (
   fc0 fp _cdeclare drop fp 1 plus fself 1 plus
   (over _tk "," sy-id eq) ('fnn let 'fp1 let fp1 1 plus T-NAME "a parameter name after ','" _cskip 'fp2 let fp2 1 sub _cdeclare drop fp2 fnn 1 plus) while)
   (fc0 fp fself) if
 'np let 'fp3 let 'fc1 let
 fp3 _tk "..." sy-id eq ("varargs (...) are not supported" fp3 _tl _cfail-at) () if
 fp3 ")" sy-id "')' to close the parameters" _cskip fc1 _cblock 'fc2 let 'fb let 'body let
 fb "end" kw-id "'end' to close the function" _cskip 'fe let
 fc1 len np 3 mul sub 'pb let
 0 np range [] ('k let pb k 3 mul plus 'pe let O-PARAM pe 1 plus 'fc1 nth must pe 'fc1 nth must 65536 mul plus ft _tl _cins cat) fold
 body cat O-RET 0 fb _tl _cins cat _cfin 'fups let 'full let
 [] np push C-NL 'fc2 nth must push fups len push full cat 'fcode let
 C-LVL 'fc nth must 'flv let
 O-FUNC fcode len ft _tl _cins fcode cat O-CLOSURE 0 fcode len 3 plus sub ft _tl _cins cat
 fups [] ('fk let fc fk _cfindtok 'dlv let 'dsl let
   dlv flv eq (O-CAPTL dsl fk 65536 mul plus) (O-CAPTU fk 65536 mul) if ft _tl _cins cat) fold cat fe) '_cfunc let


-- _cassign: (targets rhs line -- code).  Each target is the code that reads
-- it: a name's one GET, or a field's object and key code and GETT.  The fields'
-- objects and keys stay below the values; SETTD n reaches one n slots under its
-- value, and the POPs clear them after.  One field target is a plain SETT.
('al let 'ar let 'ats let ats len 'an let
 ats [] ('x let x _clast O-GETT eq (x _cdroplast) ([]) if cat) fold ar cat
 [] 0 an 1 sub
 (dup 0 ge)
 ('aj let 'ap let aj 'ats nth must 'ax let ax _clast 'axo let
  axo O-GETT eq (an 1 eq (O-SETT 0 al _cins) (O-SETTD aj ap plus al _cins) if cat ap 2 plus) (
    axo O-GETL eq (O-SETL) (axo O-GETG eq (O-SETG) (O-SETU) if) if 1 'ax nth must al _cins cat ap) if
  aj 1 sub) while drop 'atp let
 cat an 1 eq () (O-POP atp al _crep cat) if) '_cassign let
-- _ctarget: (code t -- ).  Dies unless the code reads a name or a field.
('gt2 let 'gc let gc _clast 'go let
 go O-GETT eq go O-GETL eq go O-GETG eq or go O-GETU eq or gc len 3 eq and gt2 _tk T-NAME eq and or not
   ("a name or a field to assign to" gt2 _cwant) () if) '_ctarget let

-- ===== statements =====
-- Each takes `t ctx` and leaves `code t' ctx'`.
('k let k "end" kw-id eq k "else" kw-id eq or k "elseif" kw-id eq or k "until" kw-id eq or k T-EOF eq or) '_cbend let

-- _cstats: statements up to the end of the block, in the block's own scope.
'_cstat [int int 'list tag] [int 'list tag int int 'list tag] effect
('bc let 'bt let [] bt bc
 (over _tk _cbend not)
 ('bc2 let 'bt2 let bt2 bc2 _cstat 'bc3 let 'bt3 let cat bt3 bc3) while) '_cstats let
('kc let 'kt let kt kc _cstats 'kc2 let kc kc2 _ckeep) '_cblock let
-- _cline: (t ctx line -- code t' ctx').  pico8's one-line bodies: statements while they start on that line.
('ll let 'lc let 'lt5 let [] lt5 lc C-ONE ll set must
 (over 'lt9 let lt9 _tk _cbend not lt9 _tl ll eq and)
 ('lc2 let 'lt2 let lt2 lc2 _cstat 'lc3 let 'lt3 let cat lt3 lc3) while 'lc4 let lc lc4 _ckeep) '_cline let

-- In a one-line body, the line's end also ends the block.
('rc let 'rt let rt 1 plus _tk 'rk let C-ONE 'rc nth must 'rone let
 ('et let et _tk _cbend rone 0 gt et _tl rone eq not and or) '_rend let
 rt 1 plus _rend rk ";" sy-id eq or ([] rt 1 plus) (rt 1 plus rc -1 0 _cexplist 'rt2 let drop drop rt2) if 'rt3 let 'rcode let
 rt3 _tk ";" sy-id eq (rt3 1 plus) (rt3) if 'rt4 let
 rt4 _rend not ("the end of the block after 'return'" rt4 _cwant) () if
 rcode O-RET 0 rt _tl _cins cat rt4 rc) '_creturn let

('lc let 'lt5 let lt5 1 plus 'l1 let
 l1 _tk "function" kw-id eq (
   l1 1 plus 'ln1 let ln1 T-NAME "a name after 'local function'" _cskip drop
   lc ln1 _cdeclare 'lsl let 'lc2 let
   lsl ln1 65536 mul plus 'lsa let
   O-PUSHK 0 ln1 _tl _cins O-DECL lsa ln1 _tl _cins cat
   ln1 1 plus lc2 0 _cfunc 'lt2 let cat O-SETL lsa ln1 _tl _cins cat lt2 lc2) (
   l1 T-NAME "a name after 'local'" _cskip 'l2 let [] l1 push l2
   (dup _tk "," sy-id eq) ('n1 let n1 1 plus T-NAME "a name after ','" _cskip 'n3 let n3 1 sub push n3) while
   'tn let 'names let names len 'nn let
   tn _tk "<" sy-id eq ("local attributes (<const>, <close>) are not supported" tn _tl _cfail-at) () if
   tn _tk "=" sy-id eq (tn 1 plus lc nn 0 _cexplist 'lt3 let drop drop lt3) (O-PUSHK nn tn _tl _crep tn) if 'lt4 let 'lcode let
   C-NA 'lc nth must 'ls0 let
   lcode 0 nn range reverse [] ('k let O-DECL ls0 k plus k 'names nth must 65536 mul plus l1 _tl _cins cat) fold cat lt4
   names lc (_cdeclare drop) fold) if) '_clocal let

-- function a.b.c:m(...): the target reads a.b.c.m; with `:` the function takes self.
('fc let 'ft let ft 1 plus 'fnm let fnm T-NAME "a name after 'function'" _cskip 'fn2 let
 fnm fc 1 _cvar fn2
 (dup _tk "." sy-id eq) ('fq let fq 1 plus T-NAME "a name after '.'" _cskip 'fq2 let
   O-PUSHK fq2 1 sub _tstr fq _tl _cins cat O-GETT 0 fq _tl _cins cat fq2) while
 'fq3 let fq3 _tk ":" sy-id eq (fq3 1 plus T-NAME "a name after ':'" _cskip 'fq4 let
   O-PUSHK fq4 1 sub _tstr fq3 _tl _cins cat O-GETT 0 fq3 _tl _cins cat fq4 1) (fq3 0) if 'fself let 'fq5 let 'ftgt let
 fq5 fc fself _cfunc 'fn3 let 'fcl let
 [] ftgt push fcl ft _tl _cassign fn3 fc) '_cfuncstat let

-- while: cond JF body JMP; a break jumps past the JMP.
('wc let 'wt let wt _tl 'wl let wt 1 plus 0 0 wc _cexp 'wt2 let 'cond let
 wc C-LOOP 1 set must 'wcl let
 wt2 _tk "do" kw-id eq (
   wt2 1 plus wcl _cblock 'wc2 let "end" kw-id "'end' to close 'while'" _cskip wc2) (
   wt 1 plus _tk "(" sy-id eq not ("'do' after the condition" wt2 _cwant) () if
   wt2 wcl wl _cline) if 'wc3 let 'wt3 let 3 _cresolve 'body let
 cond O-JF body len 3 plus wl _cins cat body cat O-JMP 0 cond len body len plus 6 plus sub wl _cins cat
 wt3 wc wc3 _ckeep) '_cwhile let

-- repeat: body cond JF back; until sees the body's locals.
('pc let 'pt let pt _tl 'pl let pt 1 plus pc C-LOOP 1 set must _cstats 'pc2 let 'pt2 let 'body let
 pt2 "until" kw-id "'until' to close 'repeat'" _cskip 0 0 pc2 _cexp 'pt3 let 'cond let
 body cond len 3 plus _cresolve cond cat O-JF 0 body len cond len plus 3 plus sub pl _cins cat pt3 pc pc2 _ckeep) '_crepeat let

-- if: cond JF then-block [JMP rest] rest.  elseif recurses, once per clause.
'_cif [int int 'list tag] [int 'list tag int int 'list tag] effect
('ic let 'it let it _tl 'il0 let it 1 plus 0 0 ic _cexp 'it2 let 'cond let
 it2 _tk "then" kw-id eq (
   it2 1 plus ic _cblock 'ic2 let 'it3 let
   it3 _tk 'ik let
   ik "elseif" kw-id eq (it3 ic2 _cif) (
   ik "else" kw-id eq (it3 1 plus ic2 _cblock 'ic3 let "end" kw-id "'end' to close 'if'" _cskip ic3) (
     [] it3 "end" kw-id "'end' to close 'if'" _cskip ic2) if) if) (
   it 1 plus _tk "(" sy-id eq not ("'then' after the condition" it2 _cwant) () if
   it2 ic il0 _cline 'ic2 let 'it3 let
   it3 _tk "else" kw-id eq it3 _tl il0 eq and (it3 1 plus ic2 il0 _cline) ([] it3 ic2) if) if
 'ic4 let 'it4 let 'rcode2 let 'tcode let
 tcode rcode2 len 0 eq () (O-JMP rcode2 len il0 _cins cat) if 'tcode2 let
 cond O-JF tcode2 len il0 _cins cat tcode2 cat rcode2 cat it4 ic ic4 _ckeep) '_cif let

-- for v = a, b, c: three hidden slots (counter, limit, step), then v.
--   a b c FORPREP s; top: FORCHK s; JF end; GETL s; SETL v; body; FORINC s; JF end; JMP top; end:

-- for a, b in explist: three hidden slots (iterator, state, control), then the names.
--   explist(3) DECL c, s, f; top: GETL f, s, c; CALL with n results; DECL the names, last first;
--   GETL a; SETL c; GETL a; JNIL end; body; JMP top; end:
('gc let 'gt3 let gt3 _tl 'gl let gt3 1 plus 'g1 let
 g1 T-NAME "a name after 'for'" _cskip 'g2 let [] g1 push g2
 (dup _tk "," sy-id eq) ('g3 let g3 1 plus T-NAME "a name after ','" _cskip 'g4 let g4 1 sub push g4) while
 'g5 let 'gnames let gnames len 'gn let
 gn 254 gt ("a for has more than 254 names" gl _cfail-at) () if
 g5 "in" kw-id "'=' or 'in' after the for's names" _cskip gc 3 0 _cexplist 'g6 let drop drop 'ginit let
 g6 _tk "do" kw-id eq not ("'do' after the for's expressions" g6 _cwant) () if
 gc C-LOOP 1 set must 0 _cdeclare 'gf let 0 _cdeclare 'gs let 0 _cdeclare 'gcs let
 gnames swap ('gk let gk _cdeclare drop) fold 'gc1 let
 C-NA 'gc1 nth must gn sub 'gv0 let gv0 g1 65536 mul plus 'ga0 let
 g6 1 plus gc1 _cblock 'gc2 let "end" kw-id "'end' to close 'for'" _cskip 'gt4 let 3 _cresolve 'body let
 0 gn range reverse [] ('k let O-DECL gv0 k plus k 'gnames nth must 65536 mul plus gl _cins cat) fold 'gdecls let
 ginit O-DECL gcs gl _cins cat O-DECL gs gl _cins cat O-DECL gf gl _cins cat
 O-GETL gf gl _cins cat O-GETL gs gl _cins cat O-GETL gcs gl _cins cat O-CALL 4 256 mul gn 1 plus plus gl _cins cat
 gdecls cat O-GETL ga0 gl _cins cat O-SETL gcs gl _cins cat O-GETL ga0 gl _cins cat O-JNIL body len 3 plus gl _cins cat
 body cat O-JMP 0 gdecls len body len plus 27 plus sub gl _cins cat gt4 gc gc2 _ckeep) '_cforin let

('oc let 'ot let ot _tl 'ol let ot 1 plus 'ov let ov T-NAME "a name after 'for'" _cskip 'oe let
 oe 1 plus 0 0 oc _cexp "," sy-id "',' after the for's start" _cskip 0 0 oc _cexp 'o2 let cat
 o2 _tk "," sy-id eq (o2 1 plus 0 0 oc _cexp 'o3 let cat o3) (O-PUSHK 65536 _num ol _cins cat o2) if 'ot2 let 'init let
 ot2 _tk "do" kw-id eq not ("'do' after the for's bounds" ot2 _cwant) () if
 oc C-LOOP 1 set must 0 _cdeclare 'os let 0 _cdeclare drop 0 _cdeclare drop ov _cdeclare 'vs let 'oc1 let
 ot2 1 plus oc1 _cblock 'oc2 let "end" kw-id "'end' to close 'for'" _cskip 'ot3 let 9 _cresolve 'body let
 init O-FORPREP os ol _cins cat O-FORCHK os ol _cins cat O-JF body len 15 plus ol _cins cat
 O-GETL os ol _cins cat O-DECL vs ov 65536 mul plus ol _cins cat body cat O-FORINC os ol _cins cat O-JF 3 ol _cins cat
 O-JMP 0 body len 21 plus sub ol _cins cat ot3 oc oc2 _ckeep) '_cfornum let
('oc let 'ot let ot _tl 'ol let ot 1 plus 'ov let ov T-NAME "a name after 'for'" _cskip 'oe let
 oe _tk "=" sy-id eq (ot oc _cfornum) (ot oc _cforin) if) '_cfor let


-- An expression statement: a call, an assignment, or pico8's `a += b`.
('ec let 'et let et 0 ec _cprimary 'et2 let 'ecode let et2 _tk 'ek let et _tl 'el let
 ek "=" sy-id eq ek "," sy-id eq or (
   ecode et _ctarget
   [] ecode push et2
   (dup _tk "," sy-id eq) ('a1 let a1 1 plus 'a2 let a2 0 ec _cprimary 'a3 let dup a2 _ctarget push a3) while
   'a4 let 'ts let ts len 'tn let
   a4 "=" sy-id "'=' in the assignment" _cskip ec tn 0 _cexplist 'a5 let drop drop 'arhs let
   ts arhs el _cassign a5 ec) (
 ek 'CMPD nth must 'co let co 0 gt (
   ecode et _ctarget
   et2 1 plus 0 0 ec _cexp 'a6 let 'aexp let
   ecode _clast O-GETT eq (
     ecode _cdroplast O-DUP2 0 el _cins cat O-GETT 0 el _cins cat aexp cat co 0 el _cins cat O-SETT 0 el _cins cat) (
     [] ecode push ecode aexp cat co 0 el _cins cat el _cassign) if a6 ec) (
 ecode _clastcall (ecode 0 _cnres et2 ec) ("a statement" et _cwant) if) if) if) '_cexpstat let

('sc let 'st let st _tk 'sk let st _tl 'sl let
 sk ";" sy-id eq ([] st 1 plus sc) (
 sk "local" kw-id eq (st sc _clocal) (
 sk "function" kw-id eq (st sc _cfuncstat) (
 sk "return" kw-id eq (st sc _creturn) (
 sk "break" kw-id eq (C-LOOP 'sc nth must 0 eq ("break outside a loop" sl _cfail-at) () if O-BREAK 0 sl _cins st 1 plus sc) (
 sk "do" kw-id eq (st 1 plus sc _cblock 'dc let "end" kw-id "'end' to close 'do'" _cskip dc) (
 sk "while" kw-id eq (st sc _cwhile) (
 sk "repeat" kw-id eq (st sc _crepeat) (
 sk "if" kw-id eq (st sc _cif) (
 sk "for" kw-id eq (st sc _cfor) (
 sk "goto" kw-id eq sk "::" sy-id eq or ("goto and labels are not supported" sl _cfail-at) (
 -- pico8's `?a, b` is print(a, b): the global, which a cart's print draws.
 sk "?" sy-id eq (O-GETG PRINT-TOK _tstr sl _cins st 1 plus sc -1 0 _cexplist 'qt let swap 2 mul plus 'qn let cat O-CALL qn 256 mul 1 plus sl _cins cat qt sc) (
   st sc _cexpstat) if) if) if) if) if) if) if) if) if) if) if) if) '_cstat let


-- The main chunk is a function's body with no parameters: the prelude and the
-- program, up to the program's end of input.  The frame loop follows as a
-- chunk of its own, so the program's locals never reach it.
0 [0 0 0 0 0] _cstats 'mc let 'mt let 'mcode let
mt _tk T-EOF eq not ("the end of the input" mt _cwant) () if
mt 1 plus [0 0 0 0 0] _cstats 'postc let 'postt let 'pcode let
postt _tk T-EOF eq not ("the end of the input" postt _cwant) () if
mcode pcode cat O-RET 0 mt _tl _cins cat _cfin len 0 eq () ("the main chunk uses an outer local" fail) if 'chunk let
-- The trampoline: lua-frame starts here with __frame on the stack, calls it for
-- no results, and returns, which stops the machine.
chunk len 'TRAMP let
chunk O-CALL 1 0 _cins cat O-RET 0 0 _cins cat 'code let
code len 16777216 ge ("lua: the program compiles to more than 16777216 ints" fail) () if
C-NL 'mc nth must C-NL 'postc nth must max 'MAIN-NL let

-- ===== machine =====
0 'PC-I let     -- index of the next instruction in code
1 'SP-I let     -- next free cell of the value stack
2 'RUN-I let    -- 1 until RET leaves the main chunk
3 'STRN-I let   -- runtime strings made so far
4 'STEPS-I let  -- instructions run
5 'ARGI-I let   -- scratch: the argument print is at
6 'BASE-I let   -- the running function's slot 0
7 'FTOP-I let   -- past its slots: a statement's values start here
8 'CSP-I let    -- next free call record
9 'MRET-I let   -- how many results the last all-results call left
10 'CA-I let  11 'CB-I let  12 'CN-I let   -- scratch for _mcopy and _mnil
13 'CLOS-I let  -- the running closure's id, 0 when it takes no outer locals
14 'CLOSN-I let -- closure ids made so far
15 'CELLN-I let -- cells made so far
16 'UI-I let    -- scratch: CLOSURE's descriptor
17 'TABN-I let  -- tables made so far; table 1 holds the globals
18 'NX-I let    -- scratch: next's key
19 'LN-I let    -- scratch: #'s border
20 'MJ-I let    -- scratch: SETMULTI's index
-- pico8's draw state
21 'COLOR-I let  22 'CAMX-I let  23 'CAMY-I let
24 'CLIPX0-I let  25 'CLIPY0-I let  26 'CLIPX1-I let  27 'CLIPY1-I let   -- x1, y1 exclusive
28 'CURX-I let  29 'CURY-I let  30 'BTN-I let  31 'FRAME-I let  32 'RNGA-I let  33 'RNGB-I let
36 'PSX-I let   -- where print's lines start
37 'BTNH-B let  -- 8 cells: how many frames each button has been held
45 'SPAL-B let  -- 16 cells: the screen palette, which only the display reads
61 'TICK-I let  -- 60 Hz ticks since the first frame
64 'STK-B let  16384 'STK-N let
-- A call record is [return-pc base ftop callee nres+1 closure].
STK-B STK-N plus 'CS-B let  6 'CS-W let  1000 'CS-MAX let
CS-B CS-W CS-MAX mul plus 'SCREEN-B let
-- The screen, the sprites and the map hold one pixel or tile per cell.
SCREEN-B 16384 plus 'GFX-B let  GFX-B 16384 plus 'MAP-B let  MAP-B 8192 plus 'FLAGS-B let
-- The draw palette holds pico8's color | 16 for a transparent one, as zepto8's does.
FLAGS-B 256 plus 'DPAL-B let
-- REVIEW: The main chunk, and each frame, stop after 20,000,000 instructions, about 40 s. Alternative: no bound; a cart that loops forever then hangs make test.
20000000 'MAX-STEPS let
1000000 'MAX-STRS let
-- REVIEW: No garbage collector, so cells and closures that take outer locals count against a bound. Alternative: mark and sweep the heap, about as much code again as the VM.
1000000 'MAX-CELLS let  1000000 'MAX-CLOS let  1000000 'MAX-TABLES let
16777216 'PROTO-SPAN let   -- a closure's payload is id*PROTO-SPAN + its header's index in code

-- The stack is `machine heap strs` from here on: heap is a dict of ints (globals,
-- and later tables), strs a dict of runtime strings keyed by their 4-byte number.
('ma let ((ma peek must) dip) dip rot) 'mget let
('mw let 'ma let ((ma mw set must) dip) dip) 'mset let
('n let [] n 24 shr 255 band push n 16 shr 255 band push n 8 shr 255 band push n 255 band push) '_ikey let

-- _rfail: (msg -- ).  Dies naming the line of the instruction that runs.
('rm let PC-I mget 1 sub 'code nth must 'rl let "lua: " rl _lwhere cat ": " cat rm cat fail) '_rfail let

('pv let SP-I mget 'ps let ps STK-B STK-N plus ge ("stack overflow: more than 16384 values" _rfail) () if
 ps pv mset SP-I ps 1 plus mset) 'vpush let
(SP-I mget 1 sub 'qs let SP-I qs mset qs mget) 'vpop let

-- ===== values =====
('v let v 7 band 2 eq) '_isnum let
('v let v 7 band 3 eq) '_isstr let
(2 sub 8 div) '_raw let
('v let v 0 eq v 1 eq or) '_falsy let
(2147483648 plus 4294967295 band 2147483648 sub) '_wrap let
-- _fdiv: (x d -- q).  Floor division; slap's div truncates.
('fd let 'fx let fx fd div 'fq let fx fq fd mul sub 0 eq not fx 0 lt fd 0 lt neq and (fq 1 sub) (fq) if) '_fdiv let
('gd let 'gx let gx gx gd _fdiv gd mul sub) '_fmod let
('v let v 7 band 'tg let
 tg 0 eq ("nil") (tg 1 eq ("boolean") (tg 2 eq ("number") (tg 3 eq ("string") (
 tg 4 eq ("table") (tg 7 eq ("cell") ("function") if) if) if) if) if) if) '_tname let

-- _sbytes: (v -- bytes).  A string's text; strs is right below.
('sv let sv 3 sub 8 div 'sp let
 sp 0 ge (0 sp 'toks nth must range (sp 1 plus plus 'toks nth must) each)
         (-1 sp sub _ikey of must) if) '_sbytes let
-- _snew: (bytes -- v).  A new runtime string.
('nb let STRN-I mget 'nn let nn MAX-STRS ge ("more than 1000000 strings made" _rfail) () if
 STRN-I nn 1 plus mset nn _ikey nb insert -1 nn sub 8 mul 3 plus) '_snew let

-- _numstr: (raw -- bytes).  pico8's tostr: the integer part, then up to 4 decimals.
-- REVIEW: Decimals round to the nearest 1/10000. Alternative: truncate. It needs checking against pico8 itself.
('nr let nr 0 lt (0 nr sub) (nr) if 'na let
 na 65535 band 10000 mul 32768 plus 65536 div 'nf let
 na 65536 div nf 10000 eq (1 plus 0) (nf) if 'nf2 let 'ni let
 nr 0 lt nf2 0 gt ni 0 gt or and ("-") ("") if ni int-str cat
 nf2 0 eq () (
   "." cat nf2 10000 plus int-str 1 drop-n
   (dup len 0 gt (dup len 1 sub peek must 48 eq) (0) if) (pop must drop) while cat) if) '_numstr let

-- _tostr: (v -- bytes)
('tv let tv 7 band 'tt let
 tt 0 eq ("nil") (tt 1 eq (tv 9 eq ("true") ("false") if) (tt 2 eq (tv _raw _numstr) (tt 3 eq (tv _sbytes) (
   tv _tname ": " cat tv 3 shr int-str cat) if) if) if) if) '_tostr let

-- _streq: (a b -- 1 or 0).  Both strings; strs is right below.
('eb let 'ea let ea _sbytes 'ex let eb _sbytes 'ey let ex ey eq) '_streq let
-- _strcmp: (a b -- -1, 0 or 1).  Compares bytes, as Lua's < on strings does.
('cb let 'ca let ca _sbytes 'cx let cb _sbytes 'cy let cx len 'cxn let cy len 'cyn let
 0 (dup cxn lt over cyn lt and (dup 'cx nth must over 'cy nth must eq) (0) if) (1 plus) while 'ck let
 ck cxn lt ck cyn lt and (ck 'cx nth must ck 'cy nth must lt (-1) (1) if) (
   cxn cyn lt (-1) (cyn cxn lt (1) (0) if) if) if) '_strcmp let

-- _hkey: (tid v -- key).  A heap key: kind 0, the table id, then the Lua key:
-- a string by its text, so equal strings are one key, anything else by its int.
('hv let 'ht let hv _isstr (hv _sbytes [3] swap cat) (hv _ikey [9] swap cat hv 32 shr _ikey cat) if 'hb let
 [0] ht 16 shr 255 band push ht 8 shr 255 band push ht 255 band push hb cat) '_hkey let
('gk let (gk of {'ok () 'no (drop 0)} case) dip swap) 'hget let
('sv2 let 'sk2 let (sk2 sv2 insert) dip) 'hset let
1 'GLOBALS let
('hk3 let (hk3 of {'ok (drop 1) 'no (drop 0)} case) dip swap) 'hhas let
('hk4 let (hk4 remove) dip) 'hdel let

-- ===== tables =====
-- Table id's entry for key k is at heap key [0 id k] (_hkey), [1 id] holds a
-- hint for #, [2 id] the first key set and [3 id] the last, and [4 id k] the
-- key set after k, or nil.  Setting a key to nil removes its entry but leaves
-- it in the order, so next skips it, and setting it again keeps its place.
-- REVIEW: Keys set to nil stay in the order list for good. Alternative: unlink them, which needs a back link per key.
('ti0 let [] ti0 16 shr 255 band push ti0 8 shr 255 band push ti0 255 band push) '_t3 let
(4 sub 8 div) '_tid let
('tg let tg 7 band 4 eq not ("attempt to index a " tg _tname cat " value" cat _rfail) () if tg _tid) '_tcheck let
('lk0 let 'lt0 let lt0 lk0 _hkey 0 4 set must) '_lkey let
-- _tset: (id k v -- )
('sv3 let 'sk3 let 'st3 let
 sk3 0 eq ("table index is nil" _rfail) () if
 st3 sk3 _hkey 'vk3 let
 sv3 0 eq (vk3 hdel) (
   st3 sk3 _lkey 'lk3 let
   lk3 hhas not (
     [3] st3 _t3 cat 'tk3 let tk3 hget 'tl3 let
     tl3 0 eq ([2] st3 _t3 cat 'hk5 let hk5 sk3 hset) (st3 tl3 _lkey 'lk5 let lk5 sk3 hset) if
     tk3 sk3 hset lk3 0 hset) () if
   sk3 _isnum (sk3 _raw 'kr let kr 65535 band 0 eq kr 0 gt and (
     kr 65536 div 'kn let [1] st3 _t3 cat 'hk7 let hk7 hget 'hv7 let kn hv7 gt (hk7 kn hset) () if) () if) () if
   vk3 sv3 hset) if) '_tset let
-- _tnext: (id k -- k' v'), or 0 0 past the last key.
('nk let 'nt let
 nk 0 eq ([2] nt _t3 cat 'nh let nh hget) (nt nk _lkey 'nl let nl hhas not ("invalid key to 'next'" _rfail) () if nl hget) if 'n0 let
 NX-I n0 mset
 (NX-I mget 'nc let nc 0 eq not (nt nc _hkey 'nck let nck hget 0 eq) (0) if)
 (NX-I mget 'nc2 let nt nc2 _lkey 'ncl let ncl hget 'nn2 let NX-I nn2 mset) while
 NX-I mget 'nr let nr 0 eq (0 0) (nt nr _hkey 'nrk let nrk hget 'nrv let nr nrv) if) '_tnext let
-- _tlen: (id -- n).  A border, as Lua's # gives: t[n] is not nil and t[n+1] is.
-- The hint holds the highest whole key ever set, so t[hint+1] is nil, and a
-- walk down from it finds the border; the walk stores what it found.
-- REVIEW: # walks down from the highest whole key ever set. Alternative: Lua 5.2's array part and binary search, which pico8 has and which differs only for sparse tables.
('tl9 let [1] tl9 _t3 cat 'lhk let lhk hget 'lh let LN-I lh mset
 (LN-I mget 'l3 let l3 0 gt (tl9 l3 65536 mul _num _hkey 'lk7 let lk7 hget 0 eq) (0) if) (LN-I mget 1 sub 'l4 let LN-I l4 mset) while
 LN-I mget 'ln5 let lhk ln5 hset ln5) '_tlen let

-- A cell's value lives at heap key [7 id]; a closure's i-th outer cell at [5 id i].
('ci let [7] ci _ikey cat) '_cellkey let
('cv0 let CELLN-I mget 1 plus 'cn0 let cn0 MAX-CELLS gt ("more than 1000000 cells made" _rfail) () if
 CELLN-I cn0 mset cn0 _cellkey cv0 hset cn0 8 mul 7 plus) '_cellnew let
(7 sub 8 div _cellkey hget) '_cellget let
('cw let 7 sub 8 div _cellkey cw hset) '_cellset let
('ui0 let 'uc0 let [5] uc0 _ikey cat ui0 push) '_upkey let

-- ===== instructions =====
-- Each takes its arg; the stack below is `machine heap strs`.
(vpop 'nb let vpop 'na let
 na _isnum not ("attempt to perform arithmetic on a " na _tname cat " value" cat _rfail) () if
 nb _isnum not ("attempt to perform arithmetic on a " nb _tname cat " value" cat _rfail) () if
 na _raw nb _raw) '_nums let
(vpop 'nx let nx _isnum not ("attempt to perform arithmetic on a " nx _tname cat " value" cat _rfail) () if nx _raw) '_num1 let
-- _cmp: ( -- -1, 0 or 1).  Pops b, then a, and compares a with b.
(vpop 'mb let vpop 'ma let
 ma _isnum mb _isnum and (ma mb lt (-1) (mb ma lt (1) (0) if) if) (
 ma _isstr mb _isstr and (ma mb _strcmp) (
   "attempt to compare " ma _tname cat " with " cat mb _tname cat _rfail) if) if) '_cmp let
-- Shifts take the integer part of the count, as pico8 does; past 31 the value is gone.
'_shr [int int] [int] effect
('hn let 'ha let hn 0 lt (ha 0 hn sub _shr) (hn 31 gt (0) (ha hn shl _wrap) if) if) '_shl let
('rn let 'ra let rn 0 lt (ra 0 rn sub _shl) (rn 31 gt (ra 0 lt (-1) (0) if) (ra 1 rn shl _fdiv) if) if) '_shr let
('ln let 'la let ln 0 lt ln 31 gt or (0) (la 4294967295 band ln shr _wrap) if) '_lshr let
('rn2 let 'oa let oa 4294967295 band 'ou let rn2 31 band 'om let
 ou om shl ou 32 om sub shr bor 4294967295 band _wrap) '_rotl let
(65536 _fdiv) '_int let
('ja let PC-I mget ja plus 'jt let PC-I jt mset) '_jump let

-- _mcopy: (src dst n -- ).  Copies n cells upward; dst <= src.
('cn let 'cd let 'cs let CA-I cs mset CB-I cd mset CN-I cn mset
 (CN-I mget 0 gt)
 (CA-I mget 'ca let CB-I mget 'cb let ca mget 'cv let cb cv mset
  CA-I ca 1 plus mset CB-I cb 1 plus mset CN-I mget 1 sub 'cn2 let CN-I cn2 mset) while) '_mcopy let
-- _mnil: (a n -- ).  Sets n cells from a to nil.
('nn let 'na let CA-I na mset CN-I nn mset
 (CN-I mget 0 gt)
 (CA-I mget 'ca let ca 0 mset CA-I ca 1 plus mset CN-I mget 1 sub 'cn2 let CN-I cn2 mset) while) '_mnil let
-- _results: (at n nres -- ).  n results sit at `at`; leave nres of them, padding
-- with nil, or all n for nres -1, which MRET then counts.
('rr let 'rn let 'ra let
 rr 0 lt (MRET-I rn mset SP-I ra rn plus mset) (
   ra rr plus STK-B STK-N plus gt ("stack overflow: more than 16384 values" _rfail) () if
   rn rr lt (ra rn plus rr rn sub _mnil) () if SP-I ra rr plus mset) if) '_results let

-- ===== builtins =====
-- Each takes the callee's slot and the argument count, sets SP to the callee's
-- slot, pushes its results there, and leaves how many it pushed.
('ai let 'an let 'af let ai an lt (af 1 plus ai plus 'aa let aa mget) (0) if) '_arg let
('bn let 'bv let bv 7 band 4 eq not ("bad argument #1 to '" bn cat "' (table expected, got " cat bv _tname cat ")" cat _rfail) () if bv _tid) '_targ let
-- pico8's tables, from zepto8: SINTAB is sin(x)-4x per 4 steps of a quarter
-- turn (one 0 more at the end, which the reduction reaches), ATANTAB is atan per
-- 1/2048 of the tangent, FONT is the bios font, 4 ints of 32 pixels per row.
[0 9 18 27 37 46 55 64 73 82 91 100 110 119 128 137 146 155 164 174 183 192 201 210 219 228 237 247 256 265 274 283
