('hn let 'ha let hn 0 lt (ha 0 hn sub _lshr) (hn 31 gt (0) (ha hn shl _wrap) if) if) '_shl let
('rn let 'ra let rn 0 lt (ra 0 rn sub _shl) (ra 1 rn 31 min shl _fdiv) if) '_shr let
('ln let 'la let ln 0 lt (la 0 ln sub _shl) (ln 31 gt (0) (la 4294967295 band ln shr _wrap) if) if) '_lshr let
('rn2 let 'oa let oa 4294967295 band 'ou let rn2 31 band 'om let
 ou om shl ou 32 om sub shr bor 4294967295 band _wrap) '_rotl let
(65536 _fdiv) '_int let
('ja let PC-I mget ja plus 'jt let PC-I jt mset) '_jump let

-- _mcopy: (src dst n -- ).  Copies n cells upward; dst <= src.
('cn let 'cd let 'cs let CA-I cs mset CB-I cd mset CN-I cn mset
