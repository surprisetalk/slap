('gk let (gk of {'ok () 'no (drop 0)} case) dip swap) 'hget let
('sv2 let 'sk2 let (sk2 sv2 insert) dip) 'hset let
1 'GLOBALS let
('hk3 let (hk3 of {'ok (drop 1) 'no (drop 0)} case) dip swap) 'hhas let
('hk4 let (hk4 remove) dip) 'hdel let

-- ===== tables =====
-- Table id's entry for key k is at heap key [0 id k] (_hkey), [1 id] holds a
-- hint for #, [2 id] the first key set and [3 id] the last, and [4 id k] the
-- key set after k, or nil.  Setting a key to nil removes its entry but leaves
-- it in the order, so next skips it, and setting it again keeps its place.
-- REVIEW: Keys set to nil stay in the order list for good. Alternative: unlink them, which needs a back link per key.
('ti0 let [] ti0 16 shr 255 band push ti0 8 shr 255 band push ti0 255 band push) '_t3 let
(4 sub 8 div) '_tid let
('tg let tg 7 band 4 eq not ("attempt to index a " tg _tname cat " value" cat _rfail) () if tg _tid) '_tcheck let
('lk0 let 'lt0 let lt0 lk0 _hkey 0 4 set must) '_lkey let
-- _tset: (id k v -- )
('sv3 let 'sk3 let 'st3 let
 sk3 0 eq ("table index is nil" _rfail) () if
 st3 sk3 _hkey 'vk3 let
