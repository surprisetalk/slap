-- repeat: body cond JF back; until sees the body's locals.
('pc let 'pt let pt _tl 'pl let pt 1 plus pc C-LOOP 1 set must _cstats 'pc2 let 'pt2 let 'body let
 pt2 "until" kw-id "'until' to close 'repeat'" _cskip 0 0 pc2 _cexp 'pt3 let 'cond let
 body cond len 3 plus _cresolve cond cat O-JF 0 body len cond len plus 3 plus sub pl _cins cat pt3 pc pc2 _ckeep) '_crepeat let

-- if: cond JF then-block [JMP rest] rest.  elseif recurses, once per clause.
'_cif [int int 'list tag] [int 'list tag int int 'list tag] effect
('ic let 'it let it _tl 'il0 let it 1 plus 0 0 ic _cexp 'it2 let 'cond let
 it2 _tk "then" kw-id eq (
   it2 1 plus ic _cblock 'ic2 let 'it3 let
   it3 _tk 'ik let
   ik "elseif" kw-id eq (it3 ic2 _cif) (
   ik "else" kw-id eq (it3 1 plus ic2 _cblock 'ic3 let "end" kw-id "'end' to close 'if'" _cskip ic3) (
     [] it3 "end" kw-id "'end' to close 'if'" _cskip ic2) if) if) (
   it 1 plus _tk "(" sy-id eq not ("'then' after the condition" it2 _cwant) () if
   it2 ic il0 _cline 'ic2 let 'it3 let
   it3 _tk "else" kw-id eq it3 _tl il0 eq and (it3 1 plus ic2 il0 _cline) ([] it3 ic2) if) if
 'ic4 let 'it4 let 'rcode2 let 'tcode let
 tcode rcode2 len 0 eq () (O-JMP rcode2 len il0 _cins cat) if 'tcode2 let
 cond O-JF tcode2 len il0 _cins cat tcode2 cat rcode2 cat it4 ic ic4 _ckeep) '_cif let

-- for v = a, b, c: three hidden slots (counter, limit, step), then v.
--   a b c FORPREP s; top: FORCHK s; JF end; GETL s; SETL v; body; FORINC s; JF end; JMP top; end:

-- for a, b in explist: three hidden slots (iterator, state, control), then the names.
--   explist(3) DECL c, s, f; top: GETL f, s, c; CALL with n results; DECL the names, last first;
--   GETL a; SETL c; GETL a; JNIL end; body; JMP top; end:
('gc let 'gt3 let gt3 _tl 'gl let gt3 1 plus 'g1 let
 g1 T-NAME "a name after 'for'" _cskip 'g2 let [] g1 push g2
 (dup _tk "," sy-id eq) ('g3 let g3 1 plus T-NAME "a name after ','" _cskip 'g4 let g4 1 sub push g4) while
 'g5 let 'gnames let gnames len 'gn let
 gn 254 gt ("a for has more than 254 names" gl _cfail-at) () if
 g5 "in" kw-id "'=' or 'in' after the for's names" _cskip gc 3 0 _cexplist 'g6 let drop drop 'ginit let
 g6 _tk "do" kw-id eq not ("'do' after the for's expressions" g6 _cwant) () if
 gc C-LOOP 1 set must 0 _cdeclare 'gf let 0 _cdeclare 'gs let 0 _cdeclare 'gcs let
 gnames swap ('gk let gk _cdeclare drop) fold 'gc1 let
 C-NA 'gc1 nth must gn sub 'gv0 let gv0 g1 65536 mul plus 'ga0 let
 g6 1 plus gc1 _cblock 'gc2 let "end" kw-id "'end' to close 'for'" _cskip 'gt4 let 3 _cresolve 'body let
 0 gn range reverse [] ('k let O-DECL gv0 k plus k 'gnames nth must 65536 mul plus gl _cins cat) fold 'gdecls let
 ginit O-DECL gcs gl _cins cat O-DECL gs gl _cins cat O-DECL gf gl _cins cat
 O-GETL gf gl _cins cat O-GETL gs gl _cins cat O-GETL gcs gl _cins cat O-CALL 4 256 mul gn 1 plus plus gl _cins cat
 gdecls cat O-GETL ga0 gl _cins cat O-SETL gcs gl _cins cat O-GETL ga0 gl _cins cat O-JNIL body len 3 plus gl _cins cat
 body cat O-JMP 0 gdecls len body len plus 27 plus sub gl _cins cat gt4 gc gc2 _ckeep) '_cforin let

('oc let 'ot let ot _tl 'ol let ot 1 plus 'ov let ov T-NAME "a name after 'for'" _cskip 'oe let
 oe 1 plus 0 0 oc _cexp "," sy-id "',' after the for's start" _cskip 0 0 oc _cexp 'o2 let cat
 o2 _tk "," sy-id eq (o2 1 plus 0 0 oc _cexp 'o3 let cat o3) (O-PUSHK 65536 _num ol _cins cat o2) if 'ot2 let 'init let
 ot2 _tk "do" kw-id eq not ("'do' after the for's bounds" ot2 _cwant) () if
 oc C-LOOP 1 set must 0 _cdeclare 'os let 0 _cdeclare drop 0 _cdeclare drop ov _cdeclare 'vs let 'oc1 let
 ot2 1 plus oc1 _cblock 'oc2 let "end" kw-id "'end' to close 'for'" _cskip 'ot3 let 9 _cresolve 'body let
