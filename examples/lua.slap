  CA-I ca 1 plus mset CB-I cb 1 plus mset CN-I mget 1 sub 'cn2 let CN-I cn2 mset) while) '_mcopy let
-- _mnil: (a n -- ).  Sets n cells from a to nil.
('nn let 'na let CA-I na mset CN-I nn mset
 (CN-I mget 0 gt)
 (CA-I mget 'ca let ca 0 mset CA-I ca 1 plus mset CN-I mget 1 sub 'cn2 let CN-I cn2 mset) while) '_mnil let
-- _results: (at n nres -- ).  n results sit at `at`; leave nres of them, padding
-- with nil, or all n for nres -1, which MRET then counts.
('rr let 'rn let 'ra let
 rr 0 lt (MRET-I rn mset SP-I ra rn plus mset) (
   ra rr plus STK-B STK-N plus gt ("stack overflow: more than 16384 values" _rfail) () if
   rn rr lt (ra rn plus rr rn sub _mnil) () if SP-I ra rr plus mset) if) '_results let

-- ===== builtins =====
-- Each takes the callee's slot and the argument count, sets SP to the callee's
-- slot, pushes its results there, and leaves how many it pushed.
('ai let 'an let 'af let ai an lt (af 1 plus ai plus 'aa let aa mget) (0) if) '_arg let
('bn let 'bv let bv 7 band 4 eq not ("bad argument #1 to '" bn cat "' (table expected, got " cat bv _tname cat ")" cat _rfail) () if bv _tid) '_targ let
-- pico8's tables, from zepto8: SINTAB is sin(x)-4x per 4 steps of a quarter
-- turn (one 0 more at the end, which the reduction reaches), ATANTAB is atan per
-- 1/2048 of the tangent, FONT is the bios font, 4 ints of 32 pixels per row.
-- They are hex text, 4 or 8 digits a value: a string checks at once, where a
-- list of ints checks element by element.
