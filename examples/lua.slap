   ecode et _ctarget
   et2 1 plus 0 0 ec _cexp 'a6 let 'aexp let
   ecode _clast O-GETT eq (
     ecode _cdroplast O-DUP2 0 el _cins cat O-GETT 0 el _cins cat aexp cat co 0 el _cins cat O-SETT 0 el _cins cat) (
     [] ecode push ecode aexp cat co 0 el _cins cat el _cassign) if a6 ec) (
 ecode _clastcall (ecode 0 _cnres et2 ec) ("a statement" et _cwant) if) if) if) '_cexpstat let

('sc let 'st let st _tk 'sk let st _tl 'sl let
 sk ";" sy-id eq ([] st 1 plus sc) (
 sk "local" kw-id eq (st sc _clocal) (
 sk "function" kw-id eq (st sc _cfuncstat) (
 sk "return" kw-id eq (st sc _creturn) (
 sk "break" kw-id eq (C-LOOP 'sc nth must 0 eq ("break outside a loop" sl _cfail-at) () if O-BREAK 0 sl _cins st 1 plus sc) (
 sk "do" kw-id eq (st 1 plus sc _cblock 'dc let "end" kw-id "'end' to close 'do'" _cskip dc) (
 sk "while" kw-id eq (st sc _cwhile) (
