-- ===== pico8's API =====
-- Each word below follows zepto8's (github.com/samhocevar/zepto8), which
-- matches pico8 pixel for pixel: gfx.cpp for drawing, vm.cpp for the PRNG,
-- z8lua's lpico8lib.c for the math.  Coordinates are floored to integers;
-- a missing or nil number argument reads as 0.
('nv let nv 0 eq (0) (nv _isnum (nv _raw) ("expected a number, got " nv _tname cat _rfail) if) if) '_num0 let
(_num0 65536 _fdiv) '_int0 let
(_arg _int0) '_ia let
(_arg 0 eq not) '_has let
(65536 mul _num) '_inum let
-- _pen: (v -- c).  A color argument sets the pen; the result is the pen through the draw palette.
('pv0 let pv0 0 eq not (pv0 _int0 255 band 'pn0 let COLOR-I pn0 mset) () if
 COLOR-I mget 15 band 'pk let DPAL-B pk plus 'pa let pa mget 15 band) '_pen let
-- _clip: ( -- x0 y0 x1 y1).  The clip rectangle, x1 and y1 exclusive.
(CLIPX0-I mget 'k0 let CLIPY0-I mget 'k1 let CLIPX1-I mget 'k2 let CLIPY1-I mget 'k3 let k0 k1 k2 k3) '_clip let
-- _px: (x y c -- ).  set_pixel: one screen pixel, if the clip holds it.
('pc0 let 'py0 let 'px0 let _clip 'k3 let 'k2 let 'k1 let 'k0 let
 px0 k0 ge px0 k2 lt and py0 k1 ge and py0 k3 lt and (SCREEN-B py0 128 mul plus px0 plus 'pa0 let pa0 pc0 mset) () if) '_px let
-- _hline: (x1 x2 y c -- ) and _vline: (x y1 y2 c -- ), clipped.
('hc let 'hy let 'hx2 let 'hx1 let _clip 'k3 let 'k2 let 'k1 let 'k0 let
 hy k1 ge hy k3 lt and (
   hx1 hx2 min k0 max 'xa let hx1 hx2 max k2 1 sub min 'xb let SCREEN-B hy 128 mul plus 'row let
   xa (dup xb le) ('hx let row hx plus 'ha let ha hc mset hx 1 plus) while drop) () if) '_hline let
('vc let 'vy2 let 'vy1 let 'vx let _clip 'k3 let 'k2 let 'k1 let 'k0 let
 vx k0 ge vx k2 lt and (
   vy1 vy2 min k1 max 'ya let vy1 vy2 max k3 1 sub min 'yb let
   ya (dup yb le) ('vy let SCREEN-B vy 128 mul plus vx plus 'va let va vc mset vy 1 plus) while drop) () if) '_vline let
(CAMX-I mget 'cx let CAMY-I mget 'cy let cx cy) '_cam let
-- _sget: (x y -- c).  A sprite sheet pixel, 0 off the sheet.
('sy let 'sx let sx 0 ge sx 128 lt and sy 0 ge and sy 128 lt and (GFX-B sy 128 mul plus sx plus 'sa let sa mget) (0) if) '_sget let
-- _spx: (x y col -- ).  A sprite pixel: through the draw palette, unless transparent.
('sc let 'sy let 'sx let DPAL-B sc plus 'sa let sa mget 'sp let sp 240 band 0 eq (sx sy sp 15 band _px) () if) '_spx let
-- _circle: (x y r c fill -- ).  The midpoint circle both circ and circfill draw.
('cfl let 'cc let 'cr let 'cy let 'cx let _cam 'ky let 'kx let cx kx sub 'x0 let cy ky sub 'y0 let
 x0 cr plus 0 lt x0 cr sub 128 ge or y0 cr plus 0 lt or y0 cr sub 128 ge or () (
   cr 0 0
   ('ce let 'cdy let 'cdx let cdx cdy ce cdx cdy ge)
   ('ee let 'ey let 'ex let
    cfl (x0 ex sub x0 ex plus y0 ey sub cc _hline  x0 ex sub x0 ex plus y0 ey plus cc _hline
         x0 ey sub x0 ey plus y0 ex sub cc _hline  x0 ey sub x0 ey plus y0 ex plus cc _hline) (
      x0 ex plus y0 ey plus cc _px  x0 ey plus y0 ex plus cc _px  x0 ey sub y0 ex plus cc _px  x0 ex sub y0 ey plus cc _px
      x0 ex sub y0 ey sub cc _px  x0 ey sub y0 ex sub cc _px  x0 ey plus y0 ex sub cc _px  x0 ex plus y0 ey sub cc _px) if
    ey 1 plus 'ny let
    ee cr 1 sub lt (ex ny ee 1 plus 2 ny mul plus) (ex 1 sub 'nx let nx ny ee 1 plus 2 ny nx sub mul plus) if) while
   drop drop drop) if) '_circle let
-- _lmix: (a b n d -- r).  round(mix(a, b, n / d)) in doubles, as zepto8's line does.
('ld let 'ln let 'lb let 'la let la itof lb itof la itof fsub ln itof ld itof fdiv fmul fplus fround ftoi) '_lmix let
-- _line: (x0 y0 x1 y1 c -- )
('lc let 'ly1 let 'lx1 let 'ly0 let 'lx0 let _cam 'ky let 'kx let
 lx0 kx sub 'x0 let ly0 ky sub 'y0 let lx1 kx sub 'x1 let ly1 ky sub 'y1 let
 x1 x0 sub abs y1 y0 sub abs ge 'horiz let x0 x1 le (1) (-1) if 'sdx let y0 y1 le (1) (-1) if 'sdy let
 x1 -1 128 clamp 'xend let y1 -1 128 clamp 'yend let
 x0 -1 128 clamp y0 -1 128 clamp 1
 (dup)
 (drop 'ly let 'lx let lx ly lc _px
  horiz (lx xend eq (lx ly 0) (lx sdx plus 'nx let nx y0 y1 nx x0 sub x1 x0 sub _lmix 1) if) (
        ly yend eq (lx ly 0) (ly sdy plus 'ny let x0 x1 ny y0 sub y1 y0 sub _lmix ny 1) if) if) while
 drop drop drop) '_line let

-- The PRNG: two 32-bit words.
(RNGA-I mget 'a let RNGB-I mget 'b let a 16 shr a 16 shl 4294967295 band bor b plus 4294967295 band 'a2 let
 RNGA-I a2 mset b a2 plus 4294967295 band 'b2 let RNGB-I b2 mset) '_prng let
-- srand: the seed's bits without the sign, or 0xdeadbeef for 0; a is b ^ 0xbead29ba.
('sd let sd _num0 2147483647 band 'sb0 let sb0 0 eq (57005 16 shl 48879 bor) (sb0) if 'sb let
 RNGB-I sb mset sb 48813 16 shl 10682 bor bxor 'sa let RNGA-I sa mset 32 (_prng) repeat) '_srand let

-- sin: pico8's table of sin(x)-4x, the angle reduced to a quarter turn.
('sx let sx 16384 band 0 eq (sx) (-1 sx bxor) if 16383 band 2 plus 'sa let
 sa 2 shr 4 shl sa 2 shr 'SINTAB nth must plus 'sr let sx 32768 band 0 eq (0 sr sub) (sr) if) '_sin let
('ay let 'ax let 16384 'ab0 let
 ax 0 eq (ab0) (
   ay abs 16 shl ax abs div 'q let
   q 65536 gt (ab0 4294967296 q div 5 shr 'ATANTAB nth must sub) (q 5 shr 'ATANTAB nth must) if) if 'ab1 let
 ax 0 lt (32768 ab1 sub) (ab1) if 'ab2 let
 ay 0 gt (0 ab2 sub 65535 band) (ab2) if 'ab3 let
 ax 0 eq not ay -2147483648 eq and (0 ab3 sub 65535 band) (ab3) if) '_atan2 let
-- sqrt: the abacus algorithm on the 16.16 bits shifted up 16.
('qx let qx 16 shl 0 70368744177664
 (dup 0 gt)
 ('qa let 'qr let 'qv let qv qa qr plus ge (qv qa qr plus sub qr qa 1 shl plus) (qv qr) if 'qr2 let 'qv2 let qv2 qr2 1 shr qa 2 shr) while
 drop nip qx 0 gt () (drop 0) if) '_sqrt let
-- _rect: (x0 y0 x1 y1 c fill -- )
('rf let 'rc let 'ry1 let 'rx1 let 'ry0 let 'rx0 let _cam 'ky let 'kx let
 rx0 kx sub 'x0 let ry0 ky sub 'y0 let rx1 kx sub 'x1 let ry1 ky sub 'y1 let
 rf (
   y0 y1 min -1 max 'ya let y0 y1 max 128 min 'yb let
   x0 x1 gt (x0 0 lt x1 128 ge or) (x1 0 lt x0 128 ge or) if () (
     ya (dup yb le) ('ry let x0 x1 ry rc _hline ry 1 plus) while drop) if) (
   x0 x1 min 'xa let x0 x1 max 'xb let y0 y1 min 'ya let y0 y1 max 'yb let
   xb 0 lt xa 128 ge or yb 0 lt or ya 128 ge or () (
     xa xb ya rc _hline xa xb yb rc _hline
     ya 1 plus yb lt (xa ya 1 plus yb 1 sub rc _vline xb ya 1 plus yb 1 sub rc _vline) () if) if) if) '_rect let

(32768 plus 65535 band 32768 sub) '_w16 let
-- _spr: (n x y w8 h8 fx fy -- ).  It walks only the rows and columns on the screen.
('fy let 'fx let 'h8 let 'w8 let 'sy0 let 'sx0 let 'sn let _cam 'ky let 'kx let sx0 kx sub 'x let sy0 ky sub 'y let
 x w8 plus 0 le x 128 ge or y h8 plus 0 le or y 128 ge or () (
   0 y sub 0 max (dup h8 128 y sub min lt) ('j let
     0 x sub 0 max (dup w8 128 x sub min lt) ('i let fx (w8 1 sub i sub) (i) if 'di let fy (h8 1 sub j sub) (j) if 'dj let
       sn 16 mod 8 mul di plus sn 16 div 8 mul dj plus _sget 'col let x i plus y j plus col _spx i 1 plus) while drop
     j 1 plus) while drop) if) '_spr let

-- _map: (cel_x cel_y sx sy cel_w cel_h layer -- ); cel_w -1 for the default size.
-- zepto8 clips the source rectangle to the screen and draws it pixel by pixel;
-- this walks it a tile at a time, so a skipped tile costs one lookup.
('ml let 'mch let 'mcw let 'msy let 'msx let 'mcy let 'mcx let _cam 'ky let 'kx let msx kx sub 'sx let msy ky sub 'sy let
 mcw -1 eq (1024 256) (mcw 8 mul mch 8 mul) if 'sh0 let 'sw0 let
 0 sx sub 0 max 'mx let 0 sy sub 0 max 'my let
 mcx 8 mul mx plus 'srcx let mcy 8 mul my plus 'srcy let
 sw0 mx sw0 sx plus 128 sub 0 max plus sub 'sw let sh0 my sh0 sy plus 128 sub 0 max plus sub 'sh let
 sx mx plus srcx sub 'ox let sy my plus srcy sub 'oy let
 srcx 0 max 'x0 let srcx sw plus 1024 min 'x1 let srcy 0 max 'y0 let srcy sh plus 512 min 'y1 let
 sw 0 gt sh 0 gt and x0 x1 lt and y0 y1 lt and (
   y0 8 div (dup y1 1 sub 8 div le) ('ty let
     x0 8 div (dup x1 1 sub 8 div le) ('tx let
       MAP-B ty 128 mul plus tx plus 'ma let ma mget 'spn let FLAGS-B spn plus 'fa let fa mget 'bits let
       ml 0 eq bits ml band 0 eq not or spn 0 eq not and (
         ty 8 mul y0 max 'py0 let ty 8 mul 8 plus y1 min 'py1 let tx 8 mul x0 max 'px0 let tx 8 mul 8 plus x1 min 'px1 let
         py0 (dup py1 lt) ('cy let
           px0 (dup px1 lt) ('cx let
             spn 16 mod 8 mul cx 8 mod plus spn 16 div 8 mul cy 8 mod plus _sget 'col let ox cx plus oy cy plus col _spx cx 1 plus) while drop
           cy 1 plus) while drop) () if
       tx 1 plus) while drop
     ty 1 plus) while drop) () if) '_map let

-- _scroll: (rows -- ).  Moves the screen up, blank rows below.  It cuts the
-- machine into three lists, which costs a few copies of it, where a cell at a
-- time costs two dips per pixel.
('sr0 let sr0 128 min 'sr let ((dup SCREEN-B take-n swap SCREEN-B drop-n dup 16384 take-n swap 16384 drop-n
   (sr 128 mul drop-n [] sr 128 mul (0 push) repeat cat) dip (cat) dip cat) dip) dip) '_scroll let
-- _cls: (c -- ).  The whole screen one color, cut in as _scroll does.
('cc0 let ((dup SCREEN-B take-n swap SCREEN-B 16384 plus drop-n [] 16384 (cc0 push) repeat swap cat cat) dip) dip) '_cls let
-- _glyph: (ch x y c -- ).  One character of pico8's font, 4x5 below 128, 8x5 from 128.
('gc let 'gy let 'gx let 'gch let gch 128 lt (gch) (2 gch mul 128 sub) if 'off let
 off 32 mod 4 mul 'fx0 let off 32 div 6 mul 'fy0 let gch 128 lt (4) (8) if 'gw let
 0 (dup 5 lt) ('dy let
   0 (dup gw lt) ('dx let fy0 dy plus 4 mul fx0 dx plus 32 div plus 'FONT nth must 31 fx0 dx plus 32 mod sub shr 1 band
     (gx dx plus gy dy plus gc _px) () if dx 1 plus) while drop
   dy 1 plus) while drop) '_glyph let
-- _print: (bytes x y c coords -- endx).  Draws text from x, y; \n starts a line.
-- Without coords it prints at the cursor and moves it down a line, scrolling at the bottom.
('pco let 'pcc let 'py let 'px let 'pb let pb len 'pn let _cam 'ky let 'kx let
 px py 0 0
 (dup pn lt)
 ('pk9 let 'ph let 'cy let 'cx let pk9 'pb nth must 'ch let
  ch 10 eq (px cy 6 plus 6) (
  ch 13 eq (px cy ph) (
  ch 9 eq (cx 16 plus cx 16 mod sub cy ph) (
  ch 16 lt ("print's control code " ch int-str cat " is not supported" cat _rfail) (
    pco not (cy 6 plus 128 sub 'fy let fy 0 gt (fy _scroll cy fy sub) (cy) if) (cy) if 'cy2 let
    ch cx kx sub cy2 ky sub pcc _glyph cx ch 128 lt (4) (8) if plus cy2 6) if) if) if) if
  pk9 1 plus) while
 drop 'ph2 let 'cy3 let 'cx3 let
 pco not (cy3 ph2 plus 6 plus 128 sub 'fz let fz 0 gt (6 _scroll cy3 6 sub) (cy3) if) (cy3) if 'cy4 let
 CURX-I px 255 band mset CURY-I cy4 6 plus 255 band mset PSX-I px 255 band mset cx3) '_print let

-- _p8str: (v -- bytes).  tostr's text for one value.
('tv let tv 7 band 'tt let
 tt 0 eq ("[nil]") (tt 1 eq (tv 9 eq ("true") ("false") if) (tt 2 eq (tv _raw _numstr) (tt 3 eq (tv _sbytes) (
   "[" tv _tname cat "]" cat) if) if) if) if) '_p8str let
('h4 let [] h4 12 shr 15 band push h4 8 shr 15 band push h4 4 shr 15 band push h4 15 band push ("0123456789abcdef" swap get must) each) '_hex4 let
-- _tonum: (bytes -- raw 1), or 0 0 for text that is not a number: an optional
-- -, then decimal digits or 0x and hex digits, then an optional point and fraction.
('tb let tb len 'tl let
 ('ti let ti tl lt (ti 'tb nth must) (-1) if) '_tc let
 0 _tc 45 eq (1 1) (0 0) if 'p0 let 'isneg let
 p0 _tc 48 eq p0 1 plus _tc 'c1 let c1 120 eq c1 88 eq or and (16 p0 2 plus) (10 p0) if 'p1 let 'base let
 0 p1 (dup _tc base _tdig 0 ge) ('pp let pp _tc base _tdig 'd let dup 1099511627776 lt (base mul d plus) () if pp 1 plus) while 'p2 let 'ip let
 p2 _tc 46 eq (
   0 1 p2 1 plus (dup _tc base _tdig 0 ge) ('pq let 'fs let 'fv let pq _tc base _tdig 'd let
     fs 1000000000 lt (fv base mul d plus fs base mul) (fv fs) if pq 1 plus) while 'p3 let 'fs2 let 'fv2 let
   fv2 65536 mul fs2 div p3) (0 p2) if 'p4 let 'fr let
 p4 tl eq p2 p1 gt p4 p2 1 plus gt or and ip 1099511627776 lt and (
   ip 65536 mul fr plus isneg (0 swap sub) () if _wrap 1) (0 0) if) '_tonum let
-- _strtol10: (bytes -- n).  C's strtol in base 10: an optional -, then the digits up to the first other byte.
('lb let lb len 'lbn let lbn 0 gt (0 'lb nth must 45 eq) (0) if 'lneg let
 0 lneg (1) (0) if
 (dup lbn lt (dup 'lb nth must 10 _tdig 0 ge) (0) if)
 ('lp let dup 1099511627776 lt (10 mul lp 'lb nth must 48 sub plus) () if lp 1 plus) while drop lneg (0 swap sub) () if) '_strtol10 let
-- _sbtn: (i -- held frames)
('bi let BTNH-B bi plus 'ba let ba mget) '_sbtn let

-- The API's builtins, numbered after the core ones, each a name and a body (callee nargs -- nresults).
-- sfx and music do nothing: lua.slap has no audio.
('n let 'f let SP-I f mset n) '_ret0 let
('rv let 'f let SP-I f mset rv vpush 1) '_ret1 let
[
  {'name "cls" 'body ('nn let 'nf let nf nn 0 _ia 15 band _cls
   CURX-I 0 mset CURY-I 0 mset PSX-I 0 mset CLIPX0-I 0 mset CLIPY0-I 0 mset CLIPX1-I 128 mset CLIPY1-I 128 mset nf 0 _ret0)}
  {'name "pset" 'body ('nn let 'nf let nf nn 0 _ia 'x let nf nn 1 _ia 'y let nf nn 2 _arg _pen 'c let
   _cam 'ky let 'kx let x kx sub y ky sub c _px nf 0 _ret0)}
  {'name "pget" 'body ('nn let 'nf let nf nn 0 _ia 'x let nf nn 1 _ia 'y let _cam 'ky let 'kx let x kx sub 'gx let y ky sub 'gy let
   _clip 'k3 let 'k2 let 'k1 let 'k0 let
   gx k0 ge gx k2 lt and gy k1 ge and gy k3 lt and (SCREEN-B gy 128 mul plus gx plus 'ga let ga mget) (0) if _inum 'r let nf r _ret1)}
  {'name "rectfill" 'body ('nn let 'nf let nf nn 0 _ia 'x0 let nf nn 1 _ia 'y0 let nf nn 2 _ia 'x1 let nf nn 3 _ia 'y1 let
   nf nn 4 _arg _pen 'c let x0 y0 x1 y1 c 1 _rect nf 0 _ret0)}
  {'name "rect" 'body ('nn let 'nf let nf nn 0 _ia 'x0 let nf nn 1 _ia 'y0 let nf nn 2 _ia 'x1 let nf nn 3 _ia 'y1 let
   nf nn 4 _arg _pen 'c let x0 y0 x1 y1 c 0 _rect nf 0 _ret0)}
  {'name "circfill" 'body ('nn let 'nf let nf nn 0 _ia 'x let nf nn 1 _ia 'y let nf nn 2 _ia 'r let nf nn 3 _arg _pen 'c let
   x y r c 1 _circle nf 0 _ret0)}
  {'name "circ" 'body ('nn let 'nf let nf nn 0 _ia 'x let nf nn 1 _ia 'y let nf nn 2 _ia 'r let nf nn 3 _arg _pen 'c let
   x y r c 0 _circle nf 0 _ret0)}
  {'name "line" 'body ('nn let 'nf let nf nn 3 _has not ("line with fewer than 4 coordinates (polyline) is not supported" _rfail) () if
   nf nn 0 _ia 'x0 let nf nn 1 _ia 'y0 let nf nn 2 _ia 'x1 let nf nn 3 _ia 'y1 let nf nn 4 _arg _pen 'c let
   x0 y0 x1 y1 c _line nf 0 _ret0)}
  {'name "spr" 'body ('nn let 'nf let nf nn 0 _ia 'n let nf nn 1 _ia 'x let nf nn 2 _ia 'y let
   nf nn 3 _has (nf nn 3 _arg _num0 8 mul 65536 _fdiv _w16) (8) if 'w8 let
   nf nn 4 _has (nf nn 4 _arg _num0 8 mul 65536 _fdiv _w16) (8) if 'h8 let
   nf nn 5 _arg _falsy not 'fx let nf nn 6 _arg _falsy not 'fy let
   n x y w8 h8 fx fy _spr nf 0 _ret0)}
  {'name "sspr" 'body ('nn let 'nf let nf nn 0 _ia 'ssx let nf nn 1 _ia 'ssy let nf nn 2 _ia 'sw let nf nn 3 _ia 'sh let
   nf nn 4 _ia 'dx0 let nf nn 5 _ia 'dy0 let
   nf nn 6 _has (nf nn 6 _ia) (sw) if 'dw0 let nf nn 7 _has (nf nn 7 _ia) (sh) if 'dh0 let
   nf nn 8 _arg _falsy not 'fx0 let nf nn 9 _arg _falsy not 'fy0 let _cam 'ky let 'kx let
   dw0 0 lt (0 dw0 sub dx0 kx sub 0 dw0 sub 1 sub sub fx0 not) (dw0 dx0 kx sub fx0) if 'fx let 'dx let 'dw let
   dh0 0 lt (0 dh0 sub dy0 ky sub 0 dh0 sub 1 sub sub fy0 not) (dh0 dy0 ky sub fy0) if 'fy let 'dy let 'dh let
   dx dw plus 0 le dx 128 ge or dy dh plus 0 le or dy 128 ge or () (
     0 dy sub 0 max (dup dh 128 dy sub min lt) ('j let
       0 dx sub 0 max (dup dw 128 dx sub min lt) ('i let fx (dw 1 sub i sub) (i) if 'di let fy (dh 1 sub j sub) (j) if 'dj let
         ssx sw di mul dw div plus ssy sh dj mul dh div plus _sget 'col let dx i plus dy j plus col _spx i 1 plus) while drop
       j 1 plus) while drop) if nf 0 _ret0)}
  {'name "map" 'body ('nn let 'nf let nf nn 0 _ia 'cx let nf nn 1 _ia 'cy let nf nn 2 _ia 'sx let nf nn 3 _ia 'sy let
   nf nn 4 _has 'h4 let nf nn 5 _has 'h5 let nf nn 4 _ia 'cw0 let nf nn 5 _ia 'ch0 let nf nn 6 _ia 'ly let
   h4 h5 or (cw0 ch0) (-1 -1) if 'ch let 'cw let
   cx cy sx sy cw ch ly _map nf 0 _ret0)}
  {'name "mget" 'body ('nn let 'nf let nf nn 0 _ia 'x let nf nn 1 _ia 'y let
   x 0 ge x 128 lt and y 0 ge and y 64 lt and (MAP-B y 128 mul plus x plus 'ma let ma mget) (0) if _inum 'r let nf r _ret1)}
  {'name "mset" 'body ('nn let 'nf let nf nn 0 _ia 'x let nf nn 1 _ia 'y let nf nn 2 _ia 255 band 'v let
   x 0 ge x 128 lt and y 0 ge and y 64 lt and (MAP-B y 128 mul plus x plus 'ma let ma v mset) () if nf 0 _ret0)}
  {'name "fget" 'body ('nn let 'nf let nf nn 0 _has not (nf 0 _ret0) (
   nf nn 0 _ia 'n let n 0 ge n 256 lt and (FLAGS-B n plus 'fa let fa mget) (0) if 'bits let
   nf nn 1 _has (nf nn 1 _ia 'f let f 0 ge f 8 lt and (bits 1 f shl band 0 eq not) (0) if (9) (1) if 'r let nf r _ret1) (bits _inum 'r2 let nf r2 _ret1) if) if)}
  {'name "fset" 'body ('nn let 'nf let nf nn 0 _ia 'n let nf nn 1 _ia 'f let
   nf nn 0 _has 'hn let nf nn 1 _has 'hf let hn hf and n 0 ge and n 256 lt and (
     FLAGS-B n plus 'fa let nf nn 2 _arg 'b let
     b 0 eq (f 255 band) (fa mget 'old let b _falsy (old 1 f 15 band shl -1 bxor band) (old 1 f 15 band shl bor) if) if 'nv let fa nv mset) () if
   nf 0 _ret0)}
  {'name "__pal" 'body ('nn let 'nf let nf nn 0 _has 'h0 let nf nn 1 _has 'h1 let
   h0 h1 and not (
     nf nn 0 _ia 'a0 let h0 a0 0 eq not and () (
       0 (dup 16 lt) ('i let DPAL-B i plus 'da let da i i 0 eq (16) (0) if bor mset SPAL-B i plus 'sa let sa i mset i 1 plus) while drop) if
     nf 0 _ret0) (
     nf nn 0 _ia 15 band 'c0 let nf nn 1 _ia 'c1 let nf nn 2 _ia 'p let
     p 2 eq ("pal's raster palette (p = 2) is not supported" _rfail) () if
     p 1 eq (SPAL-B c0 plus) (DPAL-B c0 plus) if 'pa let pa mget 'prev let
     p 1 eq (c1 255 band) (prev 16 band c1 15 band bor) if 'nv let pa nv mset prev 15 band _inum 'r let nf r _ret1) if)}
  {'name "palt" 'body ('nn let 'nf let nf nn 1 _has (
     nf nn 0 _ia 15 band 'c let DPAL-B c plus 'pa let pa mget 'old let nf nn 1 _arg _falsy not 't let
     pa old 15 band t (16) (0) if bor mset old 16 band 0 eq (1) (9) if 'r let nf r _ret1) (
     nf nn 0 _has 'hc let nf nn 0 _ia 'cbits let
     0 0 (dup 16 lt) ('i let 'acc let DPAL-B i plus 'pa let pa mget 'old let
       hc (cbits 1 15 i sub shl band 0 eq not) (i 0 eq) if 'tr let pa old 15 band tr (16) (0) if bor mset
       acc old 240 band 0 eq not (1 15 i sub shl) (0) if bor i 1 plus) while drop _inum 'r let nf r _ret1) if)}
  {'name "color" 'body ('nn let 'nf let COLOR-I mget 'prev let nf nn 0 _has (nf nn 0 _ia) (6) if 255 band 'c let COLOR-I c mset
   prev _inum 'r let nf r _ret1)}
  {'name "camera" 'body ('nn let 'nf let _cam 'py let 'px let nf nn 0 _ia 'x let nf nn 1 _ia 'y let CAMX-I x mset CAMY-I y mset
   SP-I nf mset px _inum vpush py _inum vpush 2)}
  {'name "clip" 'body ('nn let 'nf let _clip 'p3 let 'p2 let 'p1 let 'p0 let nf nn 4 _arg _falsy not 'isect let
   isect (p0 p1 p2 p3) (0 0 128 128) if 'y2 let 'x2 let 'y1 let 'x1 let
   nf nn 3 _has (nf nn 0 _ia 'x let nf nn 1 _ia 'y let nf nn 2 _ia 'w let nf nn 3 _ia 'h let
     x1 x max x2 x w 0 max plus min y1 y max y2 y h 0 max plus min) (x1 x2 y1 y2) if
   'ny2 let 'ny1 let 'nx2 let 'nx1 let
   -- zepto8 keeps the bounds in bytes, so they wrap; here they also stay on the screen, past which drawing would land in the sprite sheet.
   CLIPX0-I nx1 255 band 128 min mset CLIPY0-I ny1 255 band 128 min mset CLIPX1-I nx2 255 band 128 min mset CLIPY1-I ny2 255 band 128 min mset
   SP-I nf mset p0 _inum vpush p1 _inum vpush p2 _inum vpush p3 _inum vpush 4)}
  {'name "cursor" 'body ('nn let 'nf let CURX-I mget 'ox let CURY-I mget 'oy let COLOR-I mget 'oc let
   nf nn 0 _ia 255 band 'x let nf nn 1 _ia 255 band 'y let CURX-I x mset CURY-I y mset PSX-I x mset
   nf nn 2 _has (nf nn 2 _ia 255 band 'c let COLOR-I c mset) () if
   SP-I nf mset ox _inum vpush oy _inum vpush oc _inum vpush 3)}
  {'name "print" 'body ('nn let 'nf let nn 0 eq (nf 0 _ret0) (
   nf nn 0 _arg _p8str 'pb let nf nn 2 _has 'co let
   co (nf nn 1 _ia 'x1 let nf nn 2 _ia 'y1 let nf nn 3 _arg 'c1 let x1 y1 c1) (CURX-I mget 'kx0 let CURY-I mget 'ky0 let nf nn 1 _arg 'c2 let kx0 ky0 c2) if
   'cv let 'y let 'x let cv _pen 'c let pb x y c co _print _inum 'r let nf r _ret1) if)}
  {'name "btn" 'body ('nn let 'nf let nf nn 0 _has (
     nf nn 0 _ia 'b let nf nn 1 _ia 'p let b 0 ge b 8 lt and p 0 eq and (b _sbtn 0 gt) (0) if (9) (1) if 'r let nf r _ret1) (
     0 0 (dup 8 lt) ('i let 'acc let i _sbtn 0 gt (acc 1 i shl bor) (acc) if i 1 plus) while drop _inum 'r2 let nf r2 _ret1) if)}
  {'name "btnp" 'body ('nn let 'nf let nf nn 0 _has (
     nf nn 0 _ia 'b let nf nn 1 _ia 'p let b 0 ge b 8 lt and p 0 eq and (b _sbtn 'h let h 1 eq h 15 gt h 16 sub 4 mod 0 eq and or) (0) if (9) (1) if 'r let nf r _ret1) (
     0 0 (dup 8 lt) ('i let 'acc let i _sbtn 'h let h 1 eq h 15 gt h 16 sub 4 mod 0 eq and or (acc 1 i shl bor) (acc) if i 1 plus) while drop _inum 'r2 let nf r2 _ret1) if)}
  {'name "__rnd" 'body ('nn let 'nf let nf nn 0 _has 'hr let nf nn 0 _arg _num0 'rb let
   hr rb 0 eq and (0) (_prng RNGA-I mget 'a let hr (rb 4294967295 band) (65536) if 'rrange let rrange 0 gt (a rrange mod) (0) if) if
   _wrap _num 'r let nf r _ret1)}
  {'name "srand" 'body ('nn let 'nf let nf nn 0 _arg _srand nf 0 _ret0)}
  {'name "sin" 'body ('nn let 'nf let nf nn 0 _arg _num0 _sin _wrap _num 'r let nf r _ret1)}
  {'name "cos" 'body ('nn let 'nf let nf nn 0 _arg _num0 16384 sub _sin _wrap _num 'r let nf r _ret1)}
  {'name "atan2" 'body ('nn let 'nf let nf nn 0 _arg _num0 'ax0 let nf nn 1 _arg _num0 'ay0 let ax0 ay0 _atan2 _num 'r let nf r _ret1)}
  {'name "sqrt" 'body ('nn let 'nf let nf nn 0 _arg _num0 _sqrt _wrap _num 'r let nf r _ret1)}
  {'name "time" 'body ('nn let 'nf let TICK-I mget 65536 mul 60 div _wrap _num 'r let nf r _ret1)}
  {'name "tostr" 'body ('nn let 'nf let nn 0 eq ("") (nf nn 0 _arg 'v let nf nn 1 _arg 'fl let
     fl 1 eq fl 0 eq or (0) (fl 9 eq (1) (fl _int0) if) if 'flags let
     v _isnum flags 0 gt and (v _raw 4294967295 band 'b let
       flags 3 band 3 eq ("0x" b 16 shr _hex4 cat b 65535 band _hex4 cat) (
       flags 2 band 2 eq (b 2147483648 plus 4294967295 band 2147483648 sub int-str) (
         "0x" b 16 shr _hex4 cat "." cat b 65535 band _hex4 cat) if) if) (v _p8str) if) if _snew 'r let nf r _ret1)}
  {'name "tonum" 'body ('nn let 'nf let nf nn 0 _arg 'v let nf nn 1 _ia 'fl let
   v _isnum (nf v _ret1) (v 7 band 1 eq (v 9 eq (65536) (0) if _num 'r let nf r _ret1) (
   v _isstr (
     v _sbytes 'tb let
     -- With flags, zepto8 reads hex (1), with any other character as 0, or decimal (2), and
     -- 2 then keeps the top 16 bits: the result is that integer.
     fl 3 band 0 eq (tb _tonum 'tok let 'tn let tok (tn _num 'r let nf r _ret1) (nf 0 _ret0) if) (
       fl 1 band 0 eq not (tb 8 take-n 0 ('c let 16 mul c _hexv 0 max plus) fold) (tb _strtol10) if 4294967295 band
       fl 2 band 0 eq not (16 shr) () if 65536 mul _wrap _num 'r2 let nf r2 _ret1) if) (nf 0 _ret0) if) if) if)}
  {'name "sub" 'body ('nn let 'nf let nf nn 0 _arg 'sv let
   sv _isstr sv _isnum or not ("bad argument #1 to 'sub' (string expected, got " sv _tname cat ")" cat _rfail) () if
   sv _p8str 'sb let sb len 'sl let nf nn 1 _has (nf nn 1 _ia) (1) if 'i0 let nf nn 2 _has (nf nn 2 _ia) (-1) if 'j0 let
   i0 0 lt (sl i0 plus 1 plus 1 max) (i0 0 eq (1) (i0) if) if 'i let j0 0 lt (sl j0 plus 1 plus) (j0 sl min) if 'j let
   i j gt ("") (sb i 1 sub drop-n j i sub 1 plus take-n) if _snew 'r let nf r _ret1)}
  {'name "chr" 'body ('nn let 'nf let [] 0 (dup nn lt) ('ci let 'cl let nf nn ci _ia 255 band 'cb let cl cb push ci 1 plus) while drop
   _snew 'r let nf r _ret1)}
  {'name "ord" 'body ('nn let 'nf let nf nn 0 _arg 'sv let
   sv _isstr (sv _sbytes) ([]) if 'sb let nf nn 1 _has (nf nn 1 _ia) (1) if 'i let nf nn 2 _has (nf nn 2 _ia) (1) if 'n let
   SP-I nf mset 0 (dup n lt) ('k let i k plus 'p let p 1 ge p sb len le and (p 1 sub 'sb nth must _inum vpush) () if k 1 plus) while drop
   0 n range (i plus 'p let p 1 ge p sb len le and) filter len)}
  {'name "printh" 'body ('nn let 'nf let nf nn 0 _arg _p8str "\n" cat stdout-write nf 0 _ret0)}
  {'name "sfx" 'body ('nn let 'nf let nf 0 _ret0)}
  {'name "music" 'body ('nn let 'nf let nf 0 _ret0)}
  {'name "sget" 'body ('nn let 'nf let nf nn 0 _ia 'gx0 let nf nn 1 _ia 'gy0 let gx0 gy0 _sget _inum 'r let nf r _ret1)}
  {'name "sset" 'body ('nn let 'nf let nf nn 0 _ia 'x let nf nn 1 _ia 'y let nf nn 2 _has (nf nn 2 _ia) (COLOR-I mget) if 15 band 'c let
   DPAL-B c plus 'pa let pa mget 15 band 'pc let
   x 0 ge x 128 lt and y 0 ge and y 128 lt and (GFX-B y 128 mul plus x plus 'ga let ga pc mset) () if nf 0 _ret0)}
] 'API let
-- pico8 functions lua.slap leaves out: a call dies naming it.
["peek" "poke" "peek2" "poke2" "peek4" "poke4" "memcpy" "memset" "reload" "cstore" "fillp" "tline" "oval" "ovalfill"
 "stat" "cartdata" "dget" "dset" "menuitem" "extcmd" "serial" "setmetatable" "getmetatable" "rawset" "rawget"
 "rawequal" "rawlen" "cocreate" "coresume" "costatus" "yield" "load" "run" "split" "flip" "assert" "select" "error"] 'UNSUPPORTED let

[ ('pn let 'pf let                                                              -- 1 print
   ARGI-I 0 mset
   (ARGI-I mget pn lt)
   (ARGI-I mget 'ai let ai 0 gt ("\t" stdout-write) () if pf 1 plus ai plus 'pa let pa mget _tostr stdout-write ARGI-I ai 1 plus mset) while
   "\n" stdout-write SP-I pf mset 0)
  ('nn let 'nf let nf nn 0 _arg "next" _targ 'nt let nf nn 1 _arg 'nk let      -- 2 next
   nt nk _tnext 'nv let 'nk2 let SP-I nf mset nk2 0 eq (0 vpush 1) (nk2 vpush nv vpush 2) if)
  ('nn let 'nf let nf nn 0 _arg 'pv let pv "pairs" _targ drop                   -- 3 pairs
   SP-I nf mset 22 vpush pv vpush 0 vpush 3)
  ('nn let 'nf let nf nn 0 _arg 'pv let pv "ipairs" _targ drop                  -- 4 ipairs
   SP-I nf mset 46 vpush pv vpush 0 _num vpush 3)
  ('nn let 'nf let nf nn 0 _arg _tid 'it let nf nn 1 _arg _raw 65536 plus _num 'ii let   -- 5 ipairs' iterator
   it ii _hkey 'ik let ik hget 'iv let SP-I nf mset iv 0 eq (0 vpush 1) (ii vpush iv vpush 2) if)
  ('nn let 'nf let nf nn 0 _arg _tname _snew 'tv let SP-I nf mset tv vpush 1)  -- 6 type
  ('nn let 'nf let nf nn 0 _arg _tostr _snew 'tv let SP-I nf mset tv vpush 1)  -- 7 tostring
] API ('body at) each cat UNSUPPORTED ('un let ('nn let 'nf let "pico8's '" un cat "' is not supported" cat _rfail)) each cat 'BUILTINS let
-- The globals that hold builtins, with their ids: the core ones, then the API from 8, then the unsupported ones.
[{'name "next" 'id 2} {'name "pairs" 'id 3} {'name "ipairs" 'id 4}
 {'name "type" 'id 6} {'name "tostring" 'id 7}] 'BUILTIN-NAMES let

-- CALL's arg is nargs*256 + nres+1, where nargs is fixed*2 + dyn: with dyn 1
-- the last argument was a call that left MRET values.
('ca let ca 256 div 'cx let ca 255 band 1 sub 'cr let
 cx 2 div 'ck let cx 1 band (MRET-I mget ck plus) (ck) if 'cn let
 SP-I mget cn sub 1 sub 'cf let cf mget 'fv let
 fv 7 band 6 eq (
   fv 6 sub 8 div 1 sub 'bid let cf cn bid 'BUILTINS nth must apply 'bn2 let cf bn2 cr _results) (
 fv 7 band 5 eq (
   fv 5 sub 8 div 'fpay let fpay PROTO-SPAN mod 'fa let fpay PROTO-SPAN div 'fcl let
   fa 'code nth must 'np let fa 1 plus 'code nth must 'nl let
   CSP-I mget 'cp let cp CS-B CS-W CS-MAX mul plus ge ("stack overflow: more than 1000 nested calls" _rfail) () if
   PC-I mget 'rpc let BASE-I mget 'rbase let FTOP-I mget 'rftop let CLOS-I mget 'rcl let
   cp rpc mset cp 1 plus rbase mset cp 2 plus rftop mset cp 3 plus cf mset cp 4 plus cr 1 plus mset cp 5 plus rcl mset
   CSP-I cp CS-W plus mset
   cf 1 plus 'nb let
   cn np lt (nb cn plus np cn sub _mnil) () if
   nb nl plus STK-B STK-N plus gt ("stack overflow: more than 16384 values" _rfail) () if
   BASE-I nb mset FTOP-I nb nl plus mset SP-I nb nl plus mset PC-I fa 3 plus mset CLOS-I fcl mset)
   ("attempt to call a " fv _tname cat " value" cat _rfail) if) if) '_call let

-- RET: the results are the values above the function's slots.
(drop FTOP-I mget 'rf let SP-I mget rf sub 'rn let CSP-I mget 'cp let
 cp CS-B eq (RUN-I 0 mset) (
   cp CS-W sub 'crec let CSP-I crec mset
   crec mget 'rpc let crec 1 plus mget 'rbase let crec 2 plus mget 'rftop let crec 3 plus mget 'rcf let crec 4 plus mget 1 sub 'rnres let crec 5 plus mget 'rcl let
   rf rcf rn _mcopy rcf rn rnres _results
   PC-I rpc mset BASE-I rbase mset FTOP-I rftop mset CLOS-I rcl mset) if) '_ret let

-- CLOSURE: arg is the header's offset; one descriptor per outer local follows.
('cl let PC-I mget 'cpc let cpc cl plus 'fa let fa 2 plus 'code nth must 'nu let
 nu 0 eq (fa) (
   CLOSN-I mget 1 plus 'cid let cid MAX-CLOS gt ("more than 1000000 closures made" _rfail) () if CLOSN-I cid mset
   UI-I 0 mset
   (UI-I mget nu lt)
   (UI-I mget 'ui let cpc ui 3 mul plus 'dp let dp 'code nth must 'dop let dp 1 plus 'code nth must 'darg let
    dop O-CAPTL eq (BASE-I mget darg plus 'dsl let dsl mget) (CLOS-I mget 'pcl let pcl darg _upkey hget) if 'cell let
    cid ui _upkey cell hset UI-I ui 1 plus mset) while
   PC-I cpc nu 3 mul plus mset
   cid PROTO-SPAN mul fa plus) if 8 mul 5 plus vpush) '_closure let

-- FORPREP pops step, limit and start into slots s..s+2, which must hold numbers.
('fs let BASE-I mget fs plus 'fb let vpop 'fst let vpop 'flim let vpop 'fi let
 fi _isnum not ("'for' start must be a number" _rfail) () if
 flim _isnum not ("'for' limit must be a number" _rfail) () if
 fst _isnum not ("'for' step must be a number" _rfail) () if
 fst _raw 0 eq ("'for' step is zero" _rfail) () if
 fb fi mset fb 1 plus flim mset fb 2 plus fst mset) '_forprep let
('fs let BASE-I mget fs plus 'fb let fb mget _raw 'fi let fb 1 plus mget _raw 'fl let fb 2 plus mget _raw 'fst let
 fst 0 gt (fi fl le) (fi fl ge) if (9) (1) if vpush) '_forchk let
-- FORINC leaves false when the counter would pass 32767 or -32768: pico8's numbers wrap.
('fs let BASE-I mget fs plus 'fb let fb mget _raw 'fi let fb 2 plus mget _raw 'fst let fi fst plus 'fnx let
 fnx fnx _wrap eq (fnx _num 'fv let fb fv mset 9) (1) if vpush) '_forinc let

[ (_ret)                                                                        -- RET
  (drop vpop drop)                                                               -- POP
  (vpush)                                                                        -- PUSHK
  ('ga let GLOBALS ga _hkey hget vpush)                                          -- GETG
  ('sa let vpop 'sv let GLOBALS sa _hkey sv hset)                                -- SETG
  (_call)                                                                        -- CALL
  (_jump)                                                                        -- JMP
  ('ja let vpop _falsy (ja _jump) () if)                                         -- JF
  ('ja let SP-I mget 1 sub mget _falsy (ja _jump) (vpop drop) if)                -- JFK
  ('ja let SP-I mget 1 sub mget _falsy (vpop drop) (ja _jump) if)                -- JTK
  (drop _nums plus _wrap _num vpush)                                             -- ADD
  (drop _nums sub _wrap _num vpush)                                              -- SUB
  (drop _nums mul 65536 _fdiv _wrap _num vpush)                                  -- MUL
  (drop _nums 'db let 'da let db 0 eq ("division by zero" _rfail) () if
   da 65536 mul db _fdiv _wrap _num vpush)                                       -- DIV
  (drop _nums 'db let 'da let db 0 eq ("division by zero" _rfail) () if
   da db _fdiv 65536 mul _wrap _num vpush)                                       -- IDIV
  (drop _nums 'db let 'da let db 0 eq ("modulo by zero" _rfail) () if
   da db _fmod _num vpush)                                                       -- MOD
  (drop _nums 'pb let 'pa let pb 65535 band 0 eq pb 0 ge and pb 2147418112 le and not
     ("^ takes a whole exponent from 0 to 32767" _rfail) () if
   65536 pb _int (pa mul 65536 _fdiv _wrap) repeat _num vpush)                  -- POW
  (drop vpop 'kb let vpop 'ka let
   ka _isstr ka _isnum or not ("attempt to concatenate a " ka _tname cat " value" cat _rfail) () if
   kb _isstr kb _isnum or not ("attempt to concatenate a " kb _tname cat " value" cat _rfail) () if
   ka _tostr 'kx let kb _tostr 'ky let kx ky cat _snew vpush)                   -- CONCAT
  (drop vpop 'eb let vpop 'ea let ea _isstr eb _isstr and (ea eb _streq) (ea eb eq) if (9) (1) if vpush)     -- EQ
  (drop vpop 'eb let vpop 'ea let ea _isstr eb _isstr and (ea eb _streq) (ea eb eq) if (1) (9) if vpush)     -- NE
  (drop _cmp -1 eq (9) (1) if vpush)                                             -- LT
  (drop _cmp 1 lt (9) (1) if vpush)                                              -- LE
  (drop _cmp 1 eq (9) (1) if vpush)                                              -- GT
  (drop _cmp -1 gt (9) (1) if vpush)                                             -- GE
  (drop _nums band _num vpush)                                                   -- BAND
  (drop _nums bor _num vpush)                                                    -- BOR
  (drop _nums bxor _num vpush)                                                   -- BXOR
  (drop _nums _int _shl _num vpush)                                              -- SHL
  (drop _nums _int _shr _num vpush)                                              -- SHR
  (drop _nums _int _lshr _num vpush)                                             -- LSHR
  (drop _nums _int _rotl _num vpush)                                             -- ROTL
  (drop _nums _int 32 swap sub _rotl _num vpush)                                 -- ROTR
  (drop _num1 0 swap sub _wrap _num vpush)                                       -- NEG
  (drop vpop _falsy (9) (1) if vpush)                                            -- NOT
  (drop vpop 'lv let lv _isstr (lv _sbytes len 65536 mul _num vpush) (
   lv 7 band 4 eq (lv _tid _tlen 65536 mul _num vpush) (
     "attempt to get the length of a " lv _tname cat " value" cat _rfail) if) if)   -- LEN
  (drop _num1 -1 bxor _num vpush)                                                -- BNOT
  ('gl let BASE-I mget gl plus 'ga let ga mget vpush)                            -- GETL
  ('sl let vpop 'sv let BASE-I mget sl plus 'sa let sa sv mset)                 -- SETL
  (_closure)                                                                     -- CLOSURE
  (drop "a break outside a loop reached the machine" _rfail)                     -- BREAK
  (_forprep)                                                                     -- FORPREP
  (_forchk)                                                                      -- FORCHK
  (_forinc)                                                                      -- FORINC
  (_jump)                                                                        -- FUNC
  ('gu let CLOS-I mget 'gc let gc gu _upkey hget _cellget vpush)                -- GETU
  ('su let vpop 'sv let CLOS-I mget 'sc let sc su _upkey hget sv _cellset)     -- SETU
  (drop "a closure's descriptor reached the machine" _rfail)                     -- CAPTL
  (drop "a closure's descriptor reached the machine" _rfail)                     -- CAPTU
  (drop "a declaration was not finished by _cfin" _rfail)                       -- DECL
  (drop "a parameter was not finished by _cfin" _rfail)                         -- PARAM
  ('gl let BASE-I mget gl plus 'ga let ga mget _cellget vpush)                   -- GETLC
  ('sl let vpop 'sv let BASE-I mget sl plus 'sa let sa mget sv _cellset)        -- SETLC
  ('sl let vpop _cellnew 'sv let BASE-I mget sl plus 'sa let sa sv mset)        -- DECLC
  ('sl let BASE-I mget sl plus 'sa let sa mget _cellnew 'sv let sa sv mset)     -- BOXL
  (drop TABN-I mget 1 plus 'tn let tn MAX-TABLES gt ("more than 1000000 tables made" _rfail) () if
   TABN-I tn mset tn 8 mul 4 plus vpush)                                         -- NEWT
  (drop vpop 'gk let vpop _tcheck 'gt9 let gt9 gk _hkey 'gh let gh hget vpush)  -- GETT
  (drop vpop 'sv let vpop 'sk let vpop _tcheck 'st let st sk sv _tset)         -- SETT
  (drop vpop 'sv let vpop 'sk let SP-I mget 1 sub 'sp9 let sp9 mget _tcheck 'st let st sk sv _tset)   -- SETTK
  ('sn let vpop 'sv let SP-I mget 1 sub sn sub 'kp let kp mget 'sk let kp 1 sub 'tp9 let tp9 mget _tcheck 'st let
   st sk sv _tset)                                                               -- SETTD
  ('si let si _raw 65536 div 'si2 let MRET-I mget 'mn let SP-I mget mn sub 'mb let mb 1 sub 'mt9 let mt9 mget _tcheck 'mtt let
   MJ-I 0 mset
   (MJ-I mget mn lt)
   (MJ-I mget 'mj let mb mj plus 'mvp let mvp mget 'mv let mtt si2 mj plus 65536 mul _num mv _tset MJ-I mj 1 plus mset) while
   SP-I mb mset)                                                                 -- SETMULTI
  ('sn let vpop 'so let so _tcheck 'st let st sn _hkey 'sh let sh hget vpush so vpush)   -- SELF
  (drop SP-I mget 'dp let dp 2 sub 'da let da mget 'd1 let dp 1 sub 'db let db mget 'd2 let d1 vpush d2 vpush)  -- DUP2
  ('ja let vpop 0 eq (ja _jump) () if)                                           -- JNIL
] 'OPTAB let
OPTAB len OPS len eq () ("OPTAB and OPS differ in length" fail) if

(PC-I mget 'pc let
 pc 'code nth must 'op let pc 1 plus 'code nth must 'arg let
 PC-I pc 3 plus mset
 STEPS-I mget 'ns let ns MAX-STEPS ge ("ran more than 20000000 instructions" _rfail) () if
 STEPS-I ns 1 plus mset
 arg op 'OPTAB nth must apply) 'step let

MAIN-NL STK-N gt ("lua: the main chunk needs more than 16384 local slots" fail) () if
-- The map's rows 32-63 are the bytes of the sprite rows 64-127, two pixels a byte, the left one low.
CART 'gfx at 'CGFX let
CART 'map at
 0 4096 range ('b let 4096 b plus 2 mul 'pa let pa 'CGFX nth must pa 1 plus 'CGFX nth must 16 mul plus) each cat 'CMAP let
CART 'flags at 'CFLAGS let
[] SCREEN-B (0 push) repeat [] 16384 (0 push) repeat cat CGFX cat CMAP cat CFLAGS cat [16] 1 16 range cat cat
 0 16 range swap ('i let SPAL-B i plus i set must) fold
 BASE-I STK-B set must FTOP-I STK-B MAIN-NL plus set must SP-I STK-B MAIN-NL plus set must
 CSP-I CS-B set must RUN-I 1 set must TABN-I GLOBALS set must
 COLOR-I 6 set must CLIPX1-I 128 set must CLIPY1-I 128 set must
-- _gkey: (name -- key).  The heap key of a global: GLOBALS' entry for that string, as _hkey makes it.
-- _bval: (id -- v).  A builtin's value.
([0] GLOBALS _t3 cat [3] cat swap cat) '_gkey let
(8 mul 6 plus) '_bval let
BUILTIN-NAMES dict ('b let b 'name at _gkey b 'id at _bval insert) fold
 0 API len range swap ('i let i 'API nth must 'name at _gkey i 8 plus _bval insert) fold
 0 UNSUPPORTED len range swap ('i let i 'UNSUPPORTED nth must _gkey i API len 8 plus plus _bval insert) fold
 -- print writes to stdout in a .lua program and to the screen in a cart.
 "print" _gkey IS-CART (API ('name at) each "print" index-of must 8 plus) (1) if _bval insert
dict
-- REVIEW: The PRNG starts from srand(0), so every run is the same. Alternative: pico8's clock seed, which makes runs differ and cannot be tested.
0 _srand
-- lua-run: steps until the machine stops.  lua-frame: one frame of a cart.
((RUN-I mget) (step) while) 'lua-run let
lua-run
"__frame" _gkey hget 'FRAME-FN let
-- A frame is 1/60 s with _update60 and 1/30 s without, as TICK-I counts for time().
(STEPS-I 0 mset "_update60" _gkey hget 0 eq (2) (1) if 'dt let TICK-I mget dt plus 'tk let TICK-I tk mset
 0 (dup 8 lt) ('bi let BTN-I mget 'bm let BTNH-B bi plus 'ba let ba mget 'bh let
   bm 1 bi shl band 0 eq (0) (bh 1 plus) if 'bn let ba bn mset bi 1 plus) while drop
 FTOP-I mget 'ft let SP-I ft mset FRAME-FN vpush PC-I TRAMP mset RUN-I 1 mset lua-run
 FRAME-I mget 1 plus 'fr let FRAME-I fr mset) 'lua-frame let
-- With a frame count, the screen goes to stdout: 128 lines of 128 hex digits.
-- Without one, `machine heap strs` stays for an SDL shell to drive.
FRAMES (lua-frame) repeat
-- lua-screen: ( -- pixels).  A copy of the screen, a palette index per pixel.
(((dup SCREEN-B drop-n 16384 take-n) dip) dip rot) 'lua-screen let
FRAMES 0 gt (
  lua-screen ('px let px "0123456789abcdef" swap get must) each 128 chunks
  [] ("\n" cat cat) fold stdout-write) () if
