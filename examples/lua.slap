-- _strtol10: (bytes -- n).  C's strtol in base 10: an optional -, then the digits up to the first other byte.
('lb let lb len 'lbn let lbn 0 gt (0 'lb nth must 45 eq) (0) if 'lneg let
 0 lneg (1) (0) if
 (dup lbn lt (dup 'lb nth must 10 _tdig 0 ge) (0) if)
 ('lp let dup 1099511627776 lt (10 mul lp 'lb nth must 48 sub plus) () if lp 1 plus) while drop lneg (0 swap sub) () if) '_strtol10 let
-- _arith: (v -- raw).  An arithmetic operand: a number, or a string that reads as one, as Lua 5.2 coerces it.
('av let av _isnum (av _raw) (av _isstr (av _sbytes _tonum 'aok let 'ar let aok (ar) ("attempt to perform arithmetic on a string value" _rfail) if) (
   "attempt to perform arithmetic on a " av _tname cat " value" cat _rfail) if) if) '_arith let
(vpop 'nb let vpop 'na let na _arith 'ra let nb _arith 'rb let ra rb) '_nums let
(vpop _arith) '_num1 let
-- The 16.16 operations below follow z8lua's fix32.h.  _fixdiv: (a b -- q).  The quotient
-- truncated, as C divides; b = 1 gives a; past the range, or for b = 0, 0x7fff.ffff, or
-- 0x8000.0001 when the signs differ.
('qb let 'qa let qa qb bxor 0 ge (2147483647) (-2147483647) if 'qsat let
 qb 65536 eq (qa) (qb 0 eq (qsat) (qa 65536 mul qb div 'qr let qr abs 2147483647 le (qr) (qsat) if) if) if) '_fixdiv let
-- _fixabs: (a -- |a|), where |0x8000| is 0x7fff.ffff.
('fa let fa 0 ge (fa) (fa -2147483648 eq (2147483647) (0 fa sub) if) if) '_fixabs let
-- _cmp: ( -- -1, 0 or 1).  Pops b, then a, and compares a with b.
(vpop 'mb let vpop 'ma let
 ma _isnum mb _isnum and (ma mb lt (-1) (mb ma lt (1) (0) if) if) (
