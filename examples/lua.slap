 na 65536 div nf 10000 eq (1 plus 0) (nf) if 'nf2 let 'ni let
 nr 0 lt nf2 0 gt ni 0 gt or and ("-") ("") if ni int-str cat
 nf2 0 eq () (
   "." cat nf2 10000 plus int-str 1 drop-n
   (dup len 0 gt (dup len 1 sub peek must 48 eq) (0) if) (pop must drop) while cat) if) '_numstr let

-- _tostr: (v -- bytes)
('tv let tv 7 band 'tt let
 tt 0 eq ("nil") (tt 1 eq (tv 9 eq ("true") ("false") if) (tt 2 eq (tv _raw _numstr) (tt 3 eq (tv _sbytes) (
   tv _tname ": " cat tv 3 shr int-str cat) if) if) if) if) '_tostr let

-- _streq: (a b -- 1 or 0).  Both strings; strs is right below.
('eb let 'ea let ea _sbytes 'ex let eb _sbytes 'ey let ex ey eq) '_streq let
-- _strcmp: (a b -- -1, 0 or 1).  Compares bytes, as Lua's < on strings does.
