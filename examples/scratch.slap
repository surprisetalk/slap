-- System 7 Note Pad, filling the window
-- ./slap-sdl [file.txt] < examples/scratch.slap

-- Draw one byte as 8 horizontal pixels (MSB = leftmost)
(
  'dc let 'py let 'px let 'b let
  b 128 band 0 neq (px     py dc pixel) () if
  b  64 band 0 neq (px 1 plus py dc pixel) () if
  b  32 band 0 neq (px 2 plus py dc pixel) () if
  b  16 band 0 neq (px 3 plus py dc pixel) () if
  b   8 band 0 neq (px 4 plus py dc pixel) () if
  b   4 band 0 neq (px 5 plus py dc pixel) () if
  b   2 band 0 neq (px 6 plus py dc pixel) () if
  b   1 band 0 neq (px 7 plus py dc pixel) () if
) 'draw-byte let

-- Draw one character from raw ufx font bytes
(
  'dc let 'gy let 'gx let 'ch let 'n let 'raw let
  ch n n mul 8 mul mul 256 plus 'base let
  0
  (dup n n mul lt) (
    dup 'ti let
    ti n div 8 mul gx plus 'tx let
    ti n mod 8 mul gy plus 'ty let
    0
    (dup 8 lt) (
      dup 'row let
      raw base ti 8 mul plus row plus get must
      tx ty row plus dc draw-byte
      1 plus
    ) while
    drop
    1 plus
  ) while
  drop
) 'draw-char let

-- Draw a string (no wrapping)
(
  'dc let 'sy let 'sx let 'str let 'n let 'raw let
  sx 0
  (dup str len lt) (
    dup 'si let
    swap 'cx-cur let
    str si get must 'ch let
    raw ch get must 'w let
    w 0 gt (
      raw n ch cx-cur sy dc draw-char
      cx-cur w plus 1 plus
    ) (cx-cur) if
    swap
    1 plus
  ) while
  drop drop
) 'draw-text let

-- Fonts
"fonts/geneva12.uf2" read must 'body-font let
"fonts/chicago12.uf2" read must 'chic let
2 'FN let
FN 8 mul 'FH let
FH 2 plus 'LH let

-- Layout
20 'BAR-H let
BAR-H 4 plus 'PAD-Y let
16 'PAD-X let

-- State: gap buffer and canvas size as record on stack
{'before [] 'after [] 'w 0 'h 0}

-- on resize: keep the canvas size
('rh let 'rw let rw 'w into rh 'h into) 'resize on

-- File I/O
args 'argv let
argv len 0 gt (argv 0 get must) ("") if 'fpath let
argv len 0 gt (
  fpath read must 'fbytes let
  (
    0
    (dup fbytes len lt) (
      dup 'fi let
      (fi 'fbytes nth must push) dip
      1 plus
    ) while
    drop
  ) 'before edit
) () if

(
  argv len 0 gt (
    dup 'before at 'sav-bef let
    dup 'after at 'sav-aft let
    [] 0
    (dup sav-bef len lt) (
      dup 'wi let
      (wi 'sav-bef nth must push) dip
      1 plus
    ) while
    drop
    sav-aft len 1 sub
    (dup 0 ge) (
      dup 'wj let
      (wj 'sav-aft nth must push) dip
      1 sub
    ) while
    drop
    fpath swap write {'ok (drop) 'no ("scratch: cannot save " swap cat print)} case
  ) () if
) 'do-save let

-- Chrome
(
  'tw let
  0 0 tw BAR-H 1 fill-rect
  2
  (dup BAR-H 2 sub lt) (
    dup 'by let
    by 2 mod 0 eq (0 by tw 1 2 fill-rect) () if
    1 plus
  ) while
  drop
  -- Close box
  4 4 12 12 3 fill-rect
  4 4 12 1 0 fill-rect
  4 15 12 1 0 fill-rect
  4 4 1 12 0 fill-rect
  15 4 1 12 0 fill-rect
  -- Title
  tw 120 sub 2 div 'bx let
  bx 2 120 16 3 fill-rect
  chic FN "Note Pad" bx 8 plus 3 0 draw-text
  -- Bottom border
  0 BAR-H 1 sub tw 1 0 fill-rect
) 'draw-titlebar let

(
  'tw let
  0
  (dup tw lt) (
    dup 'tx let
    tx BAR-H 4 2 tx 4 div 2 mod 0 eq (2) (3) if fill-rect
    4 plus
  ) while
  drop
  0 BAR-H 2 plus tw 1 1 fill-rect
) 'draw-torn let

(
  'th let 'tw let
  PAD-Y LH plus
  (dup th lt) (
    dup 'ry let
    0 ry tw 1 2 fill-rect
    LH plus
  ) while
  drop
) 'draw-rules let

-- Render gap buffer text
(
  'th let 'tw let 'aft let 'bef let
  tw PAD-X 2 mul sub 'lw let

  -- Before cursor: stack carries rcx, rcy, ri
  PAD-X PAD-Y 2 plus 0
  (dup bef len lt) (
    dup 'ri let
    rot 'rcx-cur let swap 'rcy-cur let
    ri 'bef nth must 'rch let
    rch 10 eq (
      PAD-X rcy-cur LH plus
    ) (
      rcy-cur th lt (
        body-font FN rch rcx-cur rcy-cur 0 draw-char
        rcx-cur body-font rch get must plus 1 plus 'rcx-new let
        rcx-new PAD-X lw plus gt
          (PAD-X rcy-cur LH plus) (rcx-new rcy-cur) if
      ) (rcx-cur rcy-cur) if
    ) if
    rot 1 plus
  ) while
  drop
  -- stack: rcx, rcy

  -- Cursor
  over over
  millis 500 div 2 mod 1 eq (
    1 FH 0 fill-rect
  ) (drop drop) if

  -- After cursor (reversed): stack carries rcx, rcy, ra
  aft len 1 sub
  (dup 0 ge) (
    dup 'ra let
    rot 'rcx-cur let swap 'rcy-cur let
    ra 'aft nth must 'rch let
    rch 10 eq (
      PAD-X rcy-cur LH plus
    ) (
      rcy-cur th lt (
        body-font FN rch rcx-cur rcy-cur 0 draw-char
        rcx-cur body-font rch get must plus 1 plus 'rcx-new let
        rcx-new PAD-X lw plus gt
          (PAD-X rcy-cur LH plus) (rcx-new rcy-cur) if
      ) (rcx-cur rcy-cur) if
    ) if
    rot 1 sub
  ) while
  drop
  drop drop
) 'render-text let

-- Click to move cursor
(
  'my let 'mx let
  my PAD-Y ge (
    dup 'w at PAD-X 2 mul sub 'lw let
    -- Build full text: before + reversed after
    dup 'before at 'mbef let
    dup 'after at 'maft let
    [] 0
    (dup mbef len lt) (
      dup 'mfi let
      (mfi 'mbef nth must push) dip
      1 plus
    ) while
    drop
    maft len 1 sub
    (dup 0 ge) (
      dup 'mfj let
      (mfj 'maft nth must push) dip
      1 sub
    ) while
    drop
    'full let
    -- Walk text computing positions, find closest index
    -- Walk state record: hx, hy, best, bestd
    {'hx PAD-X 'hy PAD-Y 2 plus 'best 0 'bestd 1000000}
    0
    (dup full len lt) (
      dup 'hi let
      swap 'ws let
      hi 'full nth must 'hch let
      mx ws 'hx at sub dup mul my ws 'hy at sub dup mul plus 'hd let
      hd ws 'bestd at lt
        (ws hi 'best into hd 'bestd into)
        (ws)
      if
      hch 10 eq (
        PAD-X 'hx into (LH plus) 'hy edit
      ) (
        body-font hch get must 'hw let
        hw 0 gt (
          (hw plus 1 plus) 'hx edit
          dup 'hx at PAD-X lw plus gt (
            PAD-X 'hx into (LH plus) 'hy edit
          ) () if
        ) () if
      ) if
      swap
      1 plus
    ) while
    drop
    -- Check end-of-text position
    'ws-end let
    mx ws-end 'hx at sub dup mul my ws-end 'hy at sub dup mul plus 'end-d let
    end-d ws-end 'bestd at lt
      (full len) (ws-end 'best at) if
    'best-pos let
    -- Rebuild gap buffer at best-pos
    [] 0
    (dup best-pos lt) (
      dup 'rbi let
      (rbi 'full nth must push) dip
      1 plus
    ) while
    drop
    'before into
    [] full len 1 sub
    (dup best-pos ge) (
      dup 'raj let
      (raj 'full nth must push) dip
      1 sub
    ) while
    drop
    'after into
  ) () if
) 'mousedown on

-- Input
(
  'key let
  key 8 eq (
    dup 'before at len 0 gt (
      dup 'before at pop drop 'before into do-save
    ) () if
  ) (
  key 13 eq (
    (10 push) 'before edit do-save
  ) (
  key 127 eq (
    dup 'after at len 0 gt (
      dup 'after at pop drop 'after into do-save
    ) () if
  ) (
  key 1073741904 eq (
    dup 'before at len 0 gt (
      dup 'before at pop must 'mc let 'before into
      (mc push) 'after edit
    ) () if
  ) (
  key 1073741903 eq (
    dup 'after at len 0 gt (
      dup 'after at pop must 'mc let 'after into
      (mc push) 'before edit
    ) () if
  ) (
    key 32 ge key 127 lt and (
      (key push) 'before edit do-save
    ) () if
  ) if) if) if) if) if
) 'keydown on

(
  drop
  dup 'before at 'show-bef let
  dup 'after at 'show-aft let
  3 clear
  dup 'w at 'cw let
  dup 'h at 'ch let
  cw draw-titlebar
  cw draw-torn
  cw ch draw-rules
  show-bef show-aft cw ch render-text
) show
